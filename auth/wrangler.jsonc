{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hara-auth",
  "main": "worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://www.hara-lang.org,http://localhost:8000,http://localhost:8001,http://localhost:8002"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
