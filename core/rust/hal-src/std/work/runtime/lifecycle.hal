(ns std.work.runtime.lifecycle
  (:require [std.work.runtime.coordinator :as coordinator]))

;; Deprecated compatibility namespace. Runtime lifecycle coordination now
;; lives in std.work.runtime.coordinator.
(def runtime-root coordinator/runtime-root)
(def definition-version coordinator/definition-version)
(def register-work coordinator/register-work)
(def initial-frame coordinator/initial-frame)
(def complete-run! coordinator/complete-run!)
(def execute-run! coordinator/execute-run!)
(def start-run coordinator/start-run)
(def query-run coordinator/query-run)
(def resume-run coordinator/resume-run)
(def terminal-status? coordinator/terminal-status?)
(def cancel-run coordinator/cancel-run)
(def path-last coordinator/path-last)
(def checkpoint-selected? coordinator/checkpoint-selected?)
(def selected-checkpoint coordinator/selected-checkpoint)
(def copy-checkpoints-before! coordinator/copy-checkpoints-before!)
(def fork-run coordinator/fork-run)
(def command-run coordinator/command-run)
