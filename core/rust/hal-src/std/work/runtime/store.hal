(ns std.work.runtime.store)

(def run-operations
  [:next-run-id
   :validate-run-id
   :create-run
   :load-run
   :list-runs])

(def transaction-operations
  [:transact])

(def event-operations
  [:list-events])

(def checkpoint-operations
  [:load-checkpoint
   :list-checkpoints])

(def outbox-operations
  [:list-outbox
   :claim-outbox
   :ack-outbox])

(def mandatory-capabilities
  [:runs
   :transactions
   :events
   :checkpoints
   :outbox])

(defn capability?
  [provider capability]
  (reduce
   (fn [found installed]
     (or found (= capability installed)))
   false
   (or (:provider/capabilities provider) [])))

(defn operations
  [provider]
  (or (:provider/operations provider) provider))

(defn operations-installed?
  [provider required]
  (let [installed (operations provider)]
    (reduce
     (fn [valid operation]
       (and valid (not (nil? (get installed operation)))))
     true
     required)))

(defn missing-operations
  [provider required]
  (let [installed (operations provider)]
    (reduce
     (fn [missing operation]
       (if (nil? (get installed operation))
         (conj missing operation)
         missing))
     []
     required)))

(defn inferred-capabilities
  [provider]
  (let [capabilities #{}
        capabilities
        (if (operations-installed? provider run-operations)
          (conj capabilities :runs)
          capabilities)
        capabilities
        (if (operations-installed? provider transaction-operations)
          (conj capabilities :transactions)
          capabilities)
        capabilities
        (if (operations-installed? provider event-operations)
          (conj capabilities :events)
          capabilities)
        capabilities
        (if (operations-installed? provider checkpoint-operations)
          (conj capabilities :checkpoints)
          capabilities)]
    (if (operations-installed? provider outbox-operations)
      (conj capabilities :outbox)
      capabilities)))

(defn legacy-provider
  [backend]
  {:provider/role :work/store
   :provider/id (or (:provider/id backend) :legacy-backend)
   :provider/capabilities (inferred-capabilities backend)
   :provider/operations backend
   :provider/legacy backend
   :provider/state (:state backend)})

(defn assert-role!
  [provider]
  (if (not= :work/store (:provider/role provider))
    (throw
     (ex-info "Work provider does not have the store role"
              {:provider/role (:provider/role provider)
               :provider/id (:provider/id provider)})))
  provider)

(defn assert-operations!
  [provider required capability]
  (let [missing (missing-operations provider required)]
    (if (not (empty? missing))
      (throw
       (ex-info "Work store provider is missing required operations"
                {:provider/id (:provider/id provider)
                 :provider/capability capability
                 :provider/missing missing}))))
  provider)

(defn require-capability!
  [provider capability]
  (if (not (capability? provider capability))
    (throw
     (ex-info "Work store provider does not support the required capability"
              {:provider/id (:provider/id provider)
               :provider/capability capability})))
  provider)

(defn validate-provider
  [provider]
  (let [provider (assert-role! provider)
        provider
        (if (:provider/capabilities provider)
          provider
          (assoc provider
                 :provider/capabilities
                 (inferred-capabilities provider)))]
    (reduce
     (fn [validated capability]
       (require-capability! validated capability))
     provider
     mandatory-capabilities)
    (assert-operations! provider run-operations :runs)
    (assert-operations! provider transaction-operations :transactions)
    (assert-operations! provider event-operations :events)
    (assert-operations! provider checkpoint-operations :checkpoints)
    (assert-operations! provider outbox-operations :outbox)
    provider))

(defn normalise-provider
  [provider]
  (cond
    (nil? provider)
    (throw (ex-info "Work runtime requires a store provider" {}))

    (and (map? provider)
         (= :work/store (:provider/role provider)))
    (validate-provider provider)

    (and (map? provider)
         (:provider/role provider))
    (assert-role! provider)

    (map? provider)
    (validate-provider (legacy-provider provider))

    :else
    (throw
     (ex-info "Work store provider must be a descriptor or operation map"
              {:provider provider}))))

(defn assert-profile!
  [provider mode]
  ;; All execution profiles now use the same operational-store contract.
  ;; Persistence, claims, and leases remain capability extensions rather than
  ;; alternate write paths.
  (validate-provider provider))

(defn call
  [provider operation & arguments]
  (let [function (get (operations provider) operation)]
    (if function
      (apply function arguments)
      (throw
       (ex-info "Work store operation is not installed"
                {:provider/id (:provider/id provider)
                 :operation operation})))))

(defn load-run!
  [provider run-id]
  (let [run (call provider :load-run run-id)]
    (if (nil? run)
      (throw (ex-info "Work run does not exist" {:run/id run-id})))
    run))

(defn transition-request
  [run-id expected-revision changes]
  (merge
   {:transition/run-id run-id
    :transition/expected-revision expected-revision
    :transition/run-updates {}
    :transition/checkpoints []
    :transition/events []
    :transition/outbox []}
   (or changes {})
   {:transition/run-id run-id
    :transition/expected-revision expected-revision}))

(defn transact-current!
  [provider run-id changes]
  (let [run (load-run! provider run-id)]
    (call provider
          :transact
          (transition-request run-id
                              (or (:run/revision run) 0)
                              changes))))
