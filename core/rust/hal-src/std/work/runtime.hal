(ns std.work.runtime
  (:require [std.work.provider.inline :as inline]
            [std.work.provider.memory :as memory]
            [std.work.runtime.base :as base]
            [std.work.runtime.coordinator :as coordinator]
            [std.work.runtime.execution :as execution]
            [std.work.runtime.frame :as frame]
            [std.work.runtime.receipt :as receipt]
            [std.work.runtime.store :as store]))

(def work-value base/work-value)
(def work-spec-map base/work-spec-map)
(def work-reference base/work-reference)
(def reference-id base/reference-id)
(def observer base/observer)
(def recording-observer base/recording-observer)
(def observer-events base/observer-events)

;; Retained public compatibility constructor. Runtime construction normalises
;; this legacy operation map into a role-specific store provider.
(def memory-backend memory/memory-backend)
(def memory-store memory/memory-store)

(def checkpoint-key frame/checkpoint-key)
(def manifest-values frame/manifest-values)
(def register-work coordinator/register-work)

(defn configured-store
  [options]
  (store/normalise-provider
   (or (:store options)
       (:backend options)
       (memory/memory-store))))

(defn configured-executor
  [options]
  (let [provider
        (execution/normalise-provider
         (or (:executor options)
             (inline/inline-executor)))]
    (execution/with-handlers provider (:handlers options))))

(defn runtime
  [mode options]
  (let [options (or options {})
        store-provider (configured-store options)
        _ (store/assert-profile! store-provider mode)
        executor-provider (configured-executor options)
        receipt-provider (receipt/normalise-provider (:receipt options))]
    (std.work.runtime.base/Runtime
     mode
     store-provider
     executor-provider
     receipt-provider
     (:observer options)
     (atom {})
     (or (:runtime-version options) 1)
     (or (:schema-version options) 1))))

(defn local-runtime
  ([]
   (local-runtime {}))
  ([options]
   (runtime :local options)))

(defn durable-runtime
  ([]
   (durable-runtime {}))
  ([options]
   (runtime :durable options)))

(defn with-handler
  [runtime operation handler]
  (std.work.runtime.base/Runtime
   (base/runtime-mode runtime)
   (base/runtime-store runtime)
   (execution/with-handler
    (base/runtime-executor runtime)
    operation
    handler)
   (base/runtime-receipt runtime)
   (base/runtime-observer runtime)
   (base/runtime-definitions runtime)
   (base/runtime-code-version runtime)
   (base/runtime-schema-version runtime)))

(defn handler-operations
  [runtime]
  (vec (keys (base/runtime-handlers runtime))))
