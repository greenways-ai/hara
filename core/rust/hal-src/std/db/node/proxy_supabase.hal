;; ============================================================================
;; std.db.node.proxy-supabase — forwarding handlers for Supabase actions.
;; ============================================================================
(ns std.db.node.proxy-supabase
  (:require [std.db.node.kernel-supabase :as supabase]
            [std.db.node.proxy-util :as proxy]
            [std.lib.substrate.protocol :as substrate]))

(def ACTIONS supabase/ACTIONS)

(defn request-proxy
  [space args request node]
  (proxy/request-proxy space args request node))

(defn init-proxy-handlers
  "Installs forwarding handlers for every Supabase runtime action."
  [node]
  (reduce (fn [current action]
            (substrate/register-handler current action request-proxy {})
            current)
          node
          ACTIONS)
  node)
