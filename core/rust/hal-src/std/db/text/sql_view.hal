;; ============================================================================
;; std.db.text.sql-view — compatibility view planning and SQL rendering.
;; ============================================================================
(ns std.db.text.sql-view
  (:require [std.db.text.base-tree :as tree]
            [std.db.text.sql-graph :as graph]))

(defn- compatible-get
  [value lookup-key]
  (cond
    (not (map? value)) nil
    (has? value lookup-key) (get value lookup-key)
    (string? lookup-key) (get value (keyword lookup-key))
    (keyword? lookup-key) (get value (name lookup-key))
    :else nil))

(defn tree-control-array [control]
  (tree/tree-control-array control))

(defn tree-base [schema table-name select-query clause returning options]
  (tree/tree-base schema table-name select-query clause returning options))

(defn tree-count [schema entry clause options]
  (tree/tree-count schema entry clause options))

(defn tree-select [schema entry clause options]
  (tree/tree-select schema entry clause options))

(defn tree-return [schema entry select-query clause options]
  (tree/tree-return schema entry select-query clause options))

(defn tree-combined [schema select-entry return-entry return-omit clause options]
  (tree/tree-combined schema
                      select-entry
                      return-entry
                      return-omit
                      clause
                      options))

(defn query-fill-input [query-tree args input-spec drop-first]
  (tree/tree-fill-input query-tree args input-spec drop-first))

(defn- render-or-tree
  [schema query-tree options as-tree]
  (if as-tree
    query-tree
    (graph/select-return schema query-tree 0 options)))

(defn query-select
  [schema entry args options as-tree]
  (render-or-tree schema
                  (tree/plan-select schema entry args options)
                  options
                  as-tree))

(defn query-count
  [schema entry args options as-tree]
  (render-or-tree schema
                  (tree/plan-count schema entry args options)
                  options
                  as-tree))

(defn query-return
  [schema entry id args options as-tree]
  (render-or-tree schema
                  (tree/plan-return schema entry id args options)
                  options
                  as-tree))

(defn query-return-bulk
  [schema entry ids args options as-tree]
  (render-or-tree schema
                  (tree/plan-return-bulk schema entry ids args options)
                  options
                  as-tree))

(defn query-combined
  [schema select-entry select-args return-entry return-args return-omit options as-tree]
  (let [select-input (or (compatible-get select-entry :input) [])
        return-input (or (compatible-get return-entry :input) [])
        initial (tree/tree-combined schema
                                    select-entry
                                    return-entry
                                    return-omit
                                    []
                                    options)
        query-tree (tree/tree-fill-input initial
                                         (vec (concat return-args select-args))
                                         (vec (concat return-input select-input))
                                         true)]
    (render-or-tree schema query-tree options as-tree)))
