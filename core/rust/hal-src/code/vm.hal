(ns code.vm
  (:require [code.vm.model :as model]
            [code.vm.source :as source]
            [code.vm.interpreter :as interpreter]
            [code.vm.halc :as halc]
            [code.vm.bytecode :as bytecode]))

(def kinds model/+vm-kinds+)
(def statuses model/+vm-statuses+)
(def terminal-statuses model/+terminal-statuses+)
(def default-limits model/+default-limits+)

(def normalize-limits model/normalize-limits)
(def machine? model/machine?)
(def machine model/machine)
(def transition? model/transition?)
(def transition model/transition)
(def advance model/advance)
(def snapshot model/snapshot)
(def trace model/trace)
(def terminal? model/terminal?)

(def source? source/source?)
(def source-form? source/form?)
(def source-index source/index)
(def source-forms source/forms)
(def source-form-at source/form-at)
(def source-form-by-span source/form-by-span)
(def source-entry-form source/entry-form)
(def source-resolve source/resolve)

(def interpreter-journal-schema interpreter/+journal-schema+)
(def interpreter-journal? interpreter/journal?)
(def interpreter-machine? interpreter/interpreter-machine?)
(def interpreter-create interpreter/create)
(def interpreter-source-index interpreter/source-index)
(def interpreter-step interpreter/step)
(def interpreter-run interpreter/run)
(def interpreter-from-journal interpreter/from-journal)

(def halc-trace-schema halc/+trace-schema+)
(def halc-stages halc/+stages+)
(def halc-trace? halc/trace?)
(def halc-machine? halc/halc-machine?)
(def halc-create halc/create)
(def halc-source-index halc/source-index)
(def halc-step halc/step)
(def halc-run halc/run)
(def halc-from-trace halc/from-trace)

(def bytecode-trace-schema bytecode/+trace-schema+)
(def bytecode-event-kinds bytecode/+event-kinds+)
(def bytecode-trace? bytecode/trace?)
(def bytecode-machine? bytecode/bytecode-machine?)
(def bytecode-create bytecode/create)
(def bytecode-source-index bytecode/source-index)
(def bytecode-step bytecode/step)
(def bytecode-resume bytecode/resume)
(def bytecode-run bytecode/run)
(def bytecode-from-trace bytecode/from-trace)
