(ns lang.runtime.basic.impl.process-lua
  (:require [lang.core.runtime :as runtime]
            [lang.runtime.basic.type-basic :as basic]
            [lang.runtime.basic.type-common :as common]
            [lang.runtime.basic.type-oneshot :as oneshot]
            [lang.runtime.basic.type-verify :as verify]))

(def +lua-init+
  (common/put-program-options
   :lua
   {:default {:oneshot :lua
              :verify :lua
              :basic :lua}
    :env {:lua {:exec "lua"
                :extension "lua"
                :flags {:oneshot ["-e"]
                        :verify ["-e" "local loader=loadstring or load; assert(loader(io.read('*a'), '@<hara>'))"]
                        :basic ["-e"]}}}}))

(def +lua-oneshot-config+
  (common/set-context-options
   [:lua :oneshot :default]
   {:main {} :emit {} :json :full}))

(def +lua-verify-config+
  (common/set-context-options
   [:lua :verify :default]
   {:main {}
    :emit {}
    :json false
    :transport :process-stdin}))

(def +lua-basic-config+
  (common/set-context-options
   [:lua :basic :default]
   {:main {} :emit {} :json :full :timeout 2000
    :transport :process-socket}))

(def +lua-oneshot+
  (runtime/install-type!
   :lua :oneshot
   {:type :tahto/rt.oneshot
    :instance {:create oneshot/rt-oneshot:create
               :raw-eval oneshot/raw-eval-oneshot}}))

(def +lua-verify+
  (runtime/install-type!
   :lua :verify
   {:type :tahto/rt.verify
    :instance {:create oneshot/rt-oneshot:create
               :raw-eval verify/raw-eval-verify}}))

(def +lua-basic+
  (runtime/install-type!
   :lua :basic
   {:type :tahto/rt.basic
    :config {:layout :full}
    :instance {:create basic/rt-basic:create
               :start basic/start-basic
               :stop basic/stop-basic
               :raw-eval basic/raw-eval-basic}}))

(def +init+
  {:lang :lua :program +lua-init+
   :oneshot +lua-oneshot+
   :verify +lua-verify+
   :basic +lua-basic+})
