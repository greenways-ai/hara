(ns lang.common.emit-rewrite
  (:require [lang.common.compat :as compat]))

(defn stage-transforms
  "returns rewrite transforms for a compile stage"
  {:added "4.1"}
  [grammar stage]
  (vec (or (get-in grammar [:rewrite stage]) [])))

(defn- xtalk-context
  [mopts]
  (let [module (:module mopts)
        entry (:entry mopts)
        namespace-value (or (:ns mopts)
                            (:namespace entry)
                            (:namespace module)
                            (:id module))
        aliases (or (:aliases mopts)
                    (:aliases entry)
                    (:alias module))]
    (if (or namespace-value (> (count (or aliases {})) 0))
      {:ns namespace-value
       :aliases (or aliases {})
       :env {}
       :preserve-unknown true}
      nil)))

(defn- infer-environment
  [form context]
  (let [infer (:infer context)]
    (if infer
      (try
        (let [result (infer form context)
              environment (:env result)]
          (if environment
            (assoc context :env (merge (:env context) environment))
            context))
        (catch Throwable error context))
      context)))

(defn- contains-dot?
  [form]
  (cond
    (list? form)
    (or (= '. (first form))
        (reduce (fn [found value]
                  (or found (contains-dot? value)))
                false form))

    (vector? form)
    (reduce (fn [found value]
              (or found (contains-dot? value)))
            false form)

    (map? form)
    (reduce-kv (fn [found key value]
                 (or found
                     (contains-dot? key)
                     (contains-dot? value)))
               false form)

    :else false))

(defn- rewrite-symbol-value [value aliases]
  (if (and (symbol? value) (namespace value))
    (let [target (get aliases (symbol (namespace value)))]
      (if target
        (symbol (str target) (name value))
        value))
    value))

(defn- array-target? [target environment]
  (= :array (get-in environment [target :kind])))

(defn- canonical-lower [value aliases environment]
  (cond
    (symbol? value) (rewrite-symbol-value value aliases)
    (vector? value) (vec (map (fn [item]
                                (canonical-lower item aliases environment))
                              value))
    (map? value) (reduce-kv
                  (fn [output key item]
                    (assoc output
                           (canonical-lower key aliases environment)
                           (canonical-lower item aliases environment)))
                  {} value)
    (list? value)
    (let [items (vec value)]
      (if (and (= '. (first items))
               (= 3 (count items))
               (vector? (nth items 2))
               (= 1 (count (nth items 2))))
        (let [target (canonical-lower (second items) aliases environment)
              key (canonical-lower (first (nth items 2)) aliases environment)]
          (cond (string? key) (list 'x:get-key target key)
                (or (number? key) (array-target? target environment))
                (list 'x:get-idx target key)
                :else (apply list
                             (map (fn [item]
                                    (canonical-lower item aliases environment))
                                  items))))
        (apply list
               (map (fn [item]
                      (canonical-lower item aliases environment))
                    items))))
    :else value))

(defn canonical-stage
  "rewrites canonical XTalk access forms when type or module context is available"
  {:added "4.1"}
  [form context]
  (let [mopts (:mopts context)
        explicit (compat/read-key mopts :lang/xtalk-context)
        module (:module mopts)
        inferred-context (or explicit (xtalk-context mopts))
        inferred-context (if (and inferred-context (contains-dot? form))
                           (infer-environment form inferred-context)
                           inferred-context)
        aliases (or (:aliases inferred-context)
                    (:aliases mopts)
                    (:alias module)
                    {})
        environment (or (:env inferred-context) {})
        enabled (or inferred-context
                    (:id module)
                    (:namespace module)
                    (> (count aliases) 0))]
    (if enabled
      (canonical-lower form aliases environment)
      form)))

(defn rewrite-stage
  "applies language rewrite transforms for a compile stage"
  {:added "4.1"}
  [stage form grammar mopts]
  (let [canonical (if (= stage :canonical)
                    form
                    (canonical-stage form {:stage :canonical
                                           :grammar grammar
                                           :mopts mopts}))]
    (reduce (fn [output transform]
              (transform output {:stage stage
                                 :grammar grammar
                                 :mopts mopts}))
            canonical
            (stage-transforms grammar stage))))
