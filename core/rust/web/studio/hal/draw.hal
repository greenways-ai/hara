(ns studio.draw
  (:require [studio.node :as node]
            [std.foundation.host :as host]))

(defn next-frame [canvas]
  (host/call "studio.canvas" "next-frame" (node/current-id) canvas))

(defn render [canvas frame]
  (host/call "studio.canvas" "render" (node/current-id) canvas frame))

(defn publish [canvas frame]
  (host/call "studio.canvas" "publish" (node/current-id) canvas frame))
