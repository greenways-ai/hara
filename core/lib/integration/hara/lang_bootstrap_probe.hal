(ns integration.hara.lang-bootstrap-probe)

(defn probe [label namespace]
  (println (str "lang bootstrap probe: " label))
  (require namespace)
  (println (str "lang bootstrap probe passed: " label)))

(probe "postgres v1" 'lang.model.v1.spec-postgres)
(probe "postgres v2" 'lang.model.v2.spec-postgres)
(probe "postgres v3" 'lang.model.v3.spec-postgres)
(probe "postgres v4" 'lang.model.v4.spec-postgres)
(probe "postgres v5" 'lang.model.v5.spec-postgres)
(probe "postgres v6" 'lang.model.v6.spec-postgres)
(probe "runtime basic" 'lang.runtime.basic)

(println "lang bootstrap probe complete")
