(ns postgres.typed.export.json-schema-test
  (:require [postgres.typed.export.json-schema :as json-schema]
            [postgres.typed.typed-common :as types])
  (:use code.test))

(fact "resolves primitive, enum, and fallback schema types"
  (json-schema/resolve-type (types/make-type-ref :primitive nil :uuid) :jschema)
  => {:type "string" :format "uuid"}
  (json-schema/resolve-type {:type :enum :enum-ref {:ns 'Status}} :jschema)
  => {:$ref "#/definitions/Status"}
  (json-schema/resolve-type :unknown :jschema) => {:type "string"})

(fact "converts field descriptors"
  (json-schema/field->json-schema {:type :uuid :nullable? false})
  => {:type "string" :format "uuid"}
  (json-schema/field->json-schema {:type :array :items {:type :text}})
  => {:type "array" :items {:type "string"}}
  (json-schema/field->json-schema {:is-ref? true})
  => {:type "string" :format "uuid"})

(fact "converts nested shapes and preserves literal keys"
  (let [nested (types/make-jsonb-shape
                {"UserEmail" {:type :array :items {:type :jsonb}}})
        value (types/make-jsonb-shape
               {"db/remove" {:type :jsonb :shape nested}})
        result (json-schema/shape->json-schema value)]
    [(get-in result [:properties "db/remove" :type])
     (get-in result [:properties "db/remove" :properties "UserEmail" :type])
     (get-in result [:properties "db_remove"])])
  => ["object" "array" nil])

(fact "marks non-nullable fields as required"
  (json-schema/shape->json-schema
   (types/make-jsonb-shape {:id {:type :uuid :nullable? false}
                            :bio {:type :text :nullable? true}}))
  => {:type "object"
      :properties {"id" {:type "string" :format "uuid"}
                   "bio" {:type "string"}}
      :required ["id"]
      :additionalProperties false})

(fact "generates definitions from the registry"
  (types/clear-registry!)
  (types/register-type! 'demo/User
                        (types/make-table-def "demo" "User" [] :id))
  (types/register-type! 'demo/Status
                        (types/make-enum-def "demo" "Status" [:active :disabled] nil))
  (let [result (json-schema/generate-json-schema)]
    [(:$schema result)
     (get-in result [:definitions "User" :type])
     (get-in result [:definitions "Status" :type])])
  => ["http://json-schema.org/draft-07/schema#" "object" "string"])
