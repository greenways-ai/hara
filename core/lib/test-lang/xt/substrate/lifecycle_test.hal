(ns xt.substrate.lifecycle-test
  (:use code.test)
  (:require [lang.core :as l]))

^{:seedgen/root {:all true, :langs [:js :lua :python]}}
(l/script- :js
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.spec-promise :as promise]
             [xt.substrate :as node]
             [xt.substrate.base-frame :as frame]
             [xt.substrate.base-request :as request]
             [xt.substrate.base-pubsub :as pubsub]
             [xt.substrate.base-router :as router]]})

(l/script- :lua
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.spec-promise :as promise]
             [xt.substrate :as node]
             [xt.substrate.base-frame :as frame]
             [xt.substrate.base-request :as request]
             [xt.substrate.base-pubsub :as pubsub]
             [xt.substrate.base-router :as router]]})

(l/script- :python
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.spec-promise :as promise]
             [xt.substrate :as node]
             [xt.substrate.base-frame :as frame]
             [xt.substrate.base-request :as request]
             [xt.substrate.base-pubsub :as pubsub]
             [xt.substrate.base-router :as router]]})

(fact:global
 {:setup [(l/rt:restart)]
  :teardown [(l/rt:stop)]})

^{:refer xt.substrate/node-create :added "4.1"}
(fact "creates declaratively configured transport-neutral nodes"

  (!.js
    (var n
      (node/node-create
       {:id "node-a"
        :meta {:cluster "test"}
        :services {:cache {:kind "memory"}}
        :spaces {"room/a" {:state {:count 1}
                                   :meta {:owner "alpha"}}}
        :handlers {"echo" (fn [space args request current-node]
                            (return args))}
        :triggers {"event/updated" (fn [space stream current-node]
                                     (return stream))}}))
    [(node/node? n)
     (. n ["id"])
     (. (node/get-space-state n "room/a") ["count"])
     (. (node/get-service n "cache") ["kind"])
     (xt/x:is-function? (. (node/get-handler n "echo") ["fn"]))
     (xt/x:is-function? (. (node/get-trigger n "event/updated") ["fn"]))
     (. n ["meta"] ["cluster"])])
  => [true "node-a" 1 "memory" true true "test"]

  (!.lua
    (var n
      (node/node-create
       {:id "node-a"
        :meta {:cluster "test"}
        :services {:cache {:kind "memory"}}
        :spaces {"room/a" {:state {:count 1}
                                   :meta {:owner "alpha"}}}
        :handlers {"echo" (fn [space args request current-node]
                            (return args))}
        :triggers {"event/updated" (fn [space stream current-node]
                                     (return stream))}}))
    [(node/node? n)
     (. n ["id"])
     (. (node/get-space-state n "room/a") ["count"])
     (. (node/get-service n "cache") ["kind"])
     (xt/x:is-function? (. (node/get-handler n "echo") ["fn"]))
     (xt/x:is-function? (. (node/get-trigger n "event/updated") ["fn"]))
     (. n ["meta"] ["cluster"])])
  => [true "node-a" 1 "memory" true true "test"]

  (!.py
    (var n
      (node/node-create
       {:id "node-a"
        :meta {:cluster "test"}
        :services {:cache {:kind "memory"}}
        :spaces {"room/a" {:state {:count 1}
                                   :meta {:owner "alpha"}}}
        :handlers {"echo" (fn [space args request current-node]
                            (return args))}
        :triggers {"event/updated" (fn [space stream current-node]
                                     (return stream))}}))
    [(node/node? n)
     (. n ["id"])
     (. (node/get-space-state n "room/a") ["count"])
     (. (node/get-service n "cache") ["kind"])
     (xt/x:is-function? (. (node/get-handler n "echo") ["fn"]))
     (xt/x:is-function? (. (node/get-trigger n "event/updated") ["fn"]))
     (. n ["meta"] ["cluster"])])
  => [true "node-a" 1 "memory" true true "test"])

^{:refer xt.substrate/request :added "4.1"}
(fact "issues local requests through registered handlers"

  (!.js
    (var calls [])
    (var n (node/node-create {:id "node-a"}))
    (node/register-handler
     n "sum"
     (fn [space args incoming current-node]
       (xt/x:arr-push calls [(. space ["id"])
                             (. incoming ["action"])
                             (. current-node ["id"])
                             args])
       (return (+ (xt/x:get-idx args 0)
                  (xt/x:get-idx args 1))))
     nil)
    (var output (node/request n "room/a" "sum" [2 3] {:local true}))
    [(promise/x:promise-native? output)
     calls
     (node/list-spaces n)])
  => [true [["room/a" "sum" "node-a" [2 3]]] ["room/a"]]

  (!.lua
    (var calls [])
    (var n (node/node-create {:id "node-a"}))
    (node/register-handler
     n "sum"
     (fn [space args incoming current-node]
       (xt/x:arr-push calls [(. space ["id"])
                             (. incoming ["action"])
                             (. current-node ["id"])
                             args])
       (return (+ (xt/x:get-idx args 0)
                  (xt/x:get-idx args 1))))
     nil)
    (var output (node/request n "room/a" "sum" [2 3] {:local true}))
    [(promise/x:promise-native? output)
     calls
     (node/list-spaces n)])
  => [true [["room/a" "sum" "node-a" [2 3]]] ["room/a"]]

  (!.py
    (var calls [])
    (var n (node/node-create {:id "node-a"}))
    (node/register-handler
     n "sum"
     (fn [space args incoming current-node]
       (xt/x:arr-push calls [(. space ["id"])
                             (. incoming ["action"])
                             (. current-node ["id"])
                             args])
       (return (+ (xt/x:get-idx args 0)
                  (xt/x:get-idx args 1))))
     nil)
    (var output (node/request n "room/a" "sum" [2 3] {:local true}))
    [(promise/x:promise-native? output)
     calls
     (node/list-spaces n)])
  => [true [["room/a" "sum" "node-a" [2 3]]] ["room/a"]])

^{:refer xt.substrate.base-request/settle-pending :added "4.1"}
(fact "settles pending remote requests by response reply id"

  (!.js
    (var n (node/node-create {:id "node-a"}))
    (var resolved [])
    (var rejected [])
    (var incoming (frame/request-frame "room/a" "echo" [] {:id "req-1"}))
    (request/add-pending n incoming
                         (fn [value] (xt/x:arr-push resolved value))
                         (fn [value] (xt/x:arr-push rejected value))
                         {:transport_id "peer-a"})
    (request/settle-pending
     n
     (frame/response-ok-frame "req-1" "room/a" {:ok true} {:id "res-1"}))
    [resolved rejected (xt/x:obj-keys (. n ["pending"]))])
  => [[{"ok" true}] [] []]

  (!.lua
    (var n (node/node-create {:id "node-a"}))
    (var resolved [])
    (var rejected [])
    (var incoming (frame/request-frame "room/a" "echo" [] {:id "req-1"}))
    (request/add-pending n incoming
                         (fn [value] (xt/x:arr-push resolved value))
                         (fn [value] (xt/x:arr-push rejected value))
                         {:transport_id "peer-a"})
    (request/settle-pending
     n
     (frame/response-ok-frame "req-1" "room/a" {:ok true} {:id "res-1"}))
    [resolved rejected (xt/x:obj-keys (. n ["pending"]))])
  => [[{"ok" true}] [] []]

  (!.py
    (var n (node/node-create {:id "node-a"}))
    (var resolved [])
    (var rejected [])
    (var incoming (frame/request-frame "room/a" "echo" [] {:id "req-1"}))
    (request/add-pending n incoming
                         (fn [value] (xt/x:arr-push resolved value))
                         (fn [value] (xt/x:arr-push rejected value))
                         {:transport_id "peer-a"})
    (request/settle-pending
     n
     (frame/response-ok-frame "req-1" "room/a" {:ok true} {:id "res-1"}))
    [resolved rejected (xt/x:obj-keys (. n ["pending"]))])
  => [[{"ok" true}] [] []])

^{:refer xt.substrate.base-pubsub/receive-publish :added "4.1"}
(fact "dispatches stream frames through registered triggers"

  (!.js
    (var n (node/node-create {:id "node-a"}))
    (node/register-trigger
     n "event/updated"
     (fn [space stream current-node]
       (node/set-space-state current-node (. space ["id"]) (. stream ["data"]))
       (return true))
     nil)
    (var output
      (pubsub/receive-publish
       n
       (frame/stream-frame "room/a" "event/updated" {:value 9} {:id "evt-1"} nil)))
    [(promise/x:promise-native? output)
     (node/get-space-state n "room/a")])
  => [true {"value" 9}]

  (!.lua
    (var n (node/node-create {:id "node-a"}))
    (node/register-trigger
     n "event/updated"
     (fn [space stream current-node]
       (node/set-space-state current-node (. space ["id"]) (. stream ["data"]))
       (return true))
     nil)
    (var output
      (pubsub/receive-publish
       n
       (frame/stream-frame "room/a" "event/updated" {:value 9} {:id "evt-1"} nil)))
    [(promise/x:promise-native? output)
     (node/get-space-state n "room/a")])
  => [true {"value" 9}]

  (!.py
    (var n (node/node-create {:id "node-a"}))
    (node/register-trigger
     n "event/updated"
     (fn [space stream current-node]
       (node/set-space-state current-node (. space ["id"]) (. stream ["data"]))
       (return true))
     nil)
    (var output
      (pubsub/receive-publish
       n
       (frame/stream-frame "room/a" "event/updated" {:value 9} {:id "evt-1"} nil)))
    [(promise/x:promise-native? output)
     (node/get-space-state n "room/a")])
  => [true {"value" 9}])

^{:refer xt.substrate/attach-transport :added "4.1"}
(fact "starts and stops transport implementations while maintaining router state"

  (!.js
    (var started [])
    (var stopped [])
    (var n (node/node-create {:id "node-a"}))
    (var transport
      (node/transport-create
       "peer-a"
       {:start_fn (fn [listener]
                    (xt/x:arr-push started (xt/x:is-function? listener))
                    (return {:token "listener-a"}))
        :stop_fn (fn [listener]
                   (xt/x:arr-push stopped (. listener ["token"]))
                   (return true))
        :send_fn (fn [outgoing] (return outgoing))}))
    (var attached (node/attach-transport n "peer-a" transport))
    (var after-attach [(node/transport-list n)
                       (xt/x:obj-keys (router/get-connections n))
                       started])
    (var detached (node/detach-transport n "peer-a"))
    [(promise/x:promise-native? attached)
     after-attach
     (promise/x:promise-native? detached)
     (node/transport-list n)
     stopped])
  => [true [["peer-a"] ["peer-a"] [true]] true [] ["listener-a"]]

  (!.lua
    (var started [])
    (var stopped [])
    (var n (node/node-create {:id "node-a"}))
    (var transport
      (node/transport-create
       "peer-a"
       {:start_fn (fn [listener]
                    (xt/x:arr-push started (xt/x:is-function? listener))
                    (return {:token "listener-a"}))
        :stop_fn (fn [listener]
                   (xt/x:arr-push stopped (. listener ["token"]))
                   (return true))
        :send_fn (fn [outgoing] (return outgoing))}))
    (var attached (node/attach-transport n "peer-a" transport))
    (var after-attach [(node/transport-list n)
                       (xt/x:obj-keys (router/get-connections n))
                       started])
    (var detached (node/detach-transport n "peer-a"))
    [(promise/x:promise-native? attached)
     after-attach
     (promise/x:promise-native? detached)
     (node/transport-list n)
     stopped])
  => [true [["peer-a"] ["peer-a"] [true]] true [] ["listener-a"]]

  (!.py
    (var started [])
    (var stopped [])
    (var n (node/node-create {:id "node-a"}))
    (var transport
      (node/transport-create
       "peer-a"
       {:start_fn (fn [listener]
                    (xt/x:arr-push started (xt/x:is-function? listener))
                    (return {:token "listener-a"}))
        :stop_fn (fn [listener]
                   (xt/x:arr-push stopped (. listener ["token"]))
                   (return true))
        :send_fn (fn [outgoing] (return outgoing))}))
    (var attached (node/attach-transport n "peer-a" transport))
    (var after-attach [(node/transport-list n)
                       (xt/x:obj-keys (router/get-connections n))
                       started])
    (var detached (node/detach-transport n "peer-a"))
    [(promise/x:promise-native? attached)
     after-attach
     (promise/x:promise-native? detached)
     (node/transport-list n)
     stopped])
  => [true [["peer-a"] ["peer-a"] [true]] true [] ["listener-a"]])

^{:refer xt.substrate/publish :added "4.1"}
(fact "routes published streams only to subscribed transports"

  (!.js
    (var sent [])
    (var n (node/node-create {:id "node-a"}))
    (xt/x:set-key
     (. n ["transports"])
     "peer-a"
     (node/transport-create
      "peer-a"
      {:send_fn (fn [outgoing]
                  (xt/x:arr-push sent [(. outgoing ["kind"])
                                       (. outgoing ["signal"])
                                       (. outgoing ["data"] ["value"])])
                  (return outgoing))}))
    (router/register-connection n "peer-a" nil)
    (router/add-subscription n "peer-a" "room/a" "event/updated" "sub-1" nil)
    (var output (node/publish n "room/a" "event/updated" {:value 12} nil))
    [(promise/x:promise-native? output) sent])
  => [true [["stream" "event/updated" 12]]]

  (!.lua
    (var sent [])
    (var n (node/node-create {:id "node-a"}))
    (xt/x:set-key
     (. n ["transports"])
     "peer-a"
     (node/transport-create
      "peer-a"
      {:send_fn (fn [outgoing]
                  (xt/x:arr-push sent [(. outgoing ["kind"])
                                       (. outgoing ["signal"])
                                       (. outgoing ["data"] ["value"])])
                  (return outgoing))}))
    (router/register-connection n "peer-a" nil)
    (router/add-subscription n "peer-a" "room/a" "event/updated" "sub-1" nil)
    (var output (node/publish n "room/a" "event/updated" {:value 12} nil))
    [(promise/x:promise-native? output) sent])
  => [true [["stream" "event/updated" 12]]]

  (!.py
    (var sent [])
    (var n (node/node-create {:id "node-a"}))
    (xt/x:set-key
     (. n ["transports"])
     "peer-a"
     (node/transport-create
      "peer-a"
      {:send_fn (fn [outgoing]
                  (xt/x:arr-push sent [(. outgoing ["kind"])
                                       (. outgoing ["signal"])
                                       (. outgoing ["data"] ["value"])])
                  (return outgoing))}))
    (router/register-connection n "peer-a" nil)
    (router/add-subscription n "peer-a" "room/a" "event/updated" "sub-1" nil)
    (var output (node/publish n "room/a" "event/updated" {:value 12} nil))
    [(promise/x:promise-native? output) sent])
  => [true [["stream" "event/updated" 12]]])
