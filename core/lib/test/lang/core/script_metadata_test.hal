(ns lang.core.script-metadata-test
  (:use code.test)
  (:require [lang.core.script :as script]))

(defn current-module
  []
  (symbol (str (current-namespace))))

(def results
  [(fact "module records retain target and compiler metadata"
     (let [module (current-module)
           require-spec (vector 'demo.dependency :as 'dependency)
           _ (reset! script/+modules+ {})
           configured
           (script/configure-module!
            :postgres
            {:require [require-spec]
             :link {'ledger.contract 'ledger.backend}
             :static {:mode :build}
             :application {:name "ledger"}
             :schema {:ledger {:version 1}}
             :source {:path "gw/ledger/base.hal"}})]
       [(:lang configured)
        (= [require-spec] (:require configured))
        (= module (get-in configured [:link '-]))
        (get-in configured [:link 'dependency])
        (get-in configured [:link 'ledger.contract])
        (:static configured)
        (:application configured)
        (:schema configured)
        (:source configured)
        (:code configured)
        (:fragment configured)])
     => [:postgres
         true
         true
         'demo.dependency
         'ledger.backend
         {:mode :build}
         {:name "ledger"}
         {:ledger {:version 1}}
         {:path "gw/ledger/base.hal"}
         {}
         {}])

   (fact "reconfiguration preserves registered code, fragments, and native data"
     (let [module (current-module)
           _ (reset! script/+modules+
                     {module {:id module
                              :lang :xtalk
                              :link {'- module}
                              :code {'function {:id 'function}}
                              :fragment {'macro {:id 'macro}}
                              :native {:provider :fixture}}})
           configured
           (script/configure-module!
            :postgres
            {:schema {:ledger {:version 2}}})]
       [(= {'function {:id 'function}} (:code configured))
        (= {'macro {:id 'macro}} (:fragment configured))
        (= {:provider :fixture} (:native configured))
        (:schema configured)])
     => [true true true {:ledger {:version 2}}])

   (fact "module loading is idempotent and uses an injected loader"
     (let [calls (atom [])
           _ (reset! script/+modules+ {})
           _ (reset! script/+loaded-modules+ {})
           loaded
           (binding [script/*module-loader*
                     (fn [sentinel]
                       (do
                         (swap! calls conj sentinel)
                         sentinel))]
             [(script/load-module! (vector 'demo.module))
              (script/load-module! 'demo.module)])]
       [loaded
        (deref calls)
        (script/module-loaded? 'demo.module)])
     => [['demo.module 'demo.module]
         ['demo.module/__tahto_load__]
         true])

   (fact "registered modules with no entries are already loaded"
     (let [calls (atom [])
           module {:id 'demo.empty
                   :lang :postgres
                   :require []
                   :link {'- 'demo.empty}
                   :code {}
                   :fragment {}}
           _ (reset! script/+modules+ {'demo.empty module})
           _ (reset! script/+loaded-modules+ {})
           loaded
           (binding [script/*module-loader*
                     (fn [sentinel]
                       (do
                         (swap! calls conj sentinel)
                         sentinel))]
             (script/load-module! 'demo.empty))]
       [loaded
        (script/module-loaded? 'demo.empty)
        (deref calls)])
     => ['demo.empty true []])

   (fact "setup retains the requested target language and loads dependencies once"
     (let [module (current-module)
           calls (atom [])
           config {:require (vector 'demo.dependency)
                   :static {:mode :compile}
                   :schema {:ledger {:version 1}}}
           _ (reset! script/+modules+ {})
           _ (reset! script/+loaded-modules+ {})
           _ (binding [script/*module-loader*
                       (fn [sentinel]
                         (do
                           (swap! calls conj sentinel)
                           sentinel))]
               (do
                 (script/setup! :postgres config false)
                 (script/setup! :postgres config false)))
           configured (get (deref script/+modules+) module)]
       [(:lang configured)
        (:static configured)
        (:schema configured)
        (deref calls)])
     => [:postgres
         {:mode :compile}
         {:ledger {:version 1}}
         ['demo.dependency/__tahto_load__]])])

(pr-str (run '[lang.core.script-metadata-test]))
