(ns lang.runtime.standard-test
  (:use code.test)
  (:require [lang.runtime.standard :as standard]))

^{:refer lang.runtime.standard/arr-new :added "4.1"}
(fact "constructs XTalk collections as the existing Hara native types"
  (let [array (standard/arr-new 1 2)
        object (standard/obj-new "value" 1)]
    [(standard/arr? array)
     (standard/obj? object)])
  => [true true])

^{:refer lang.runtime.standard/arr-push! :added "4.1"}
(fact "delegates array mutation without replacing native identity"
  (let [array (standard/arr-new 1 2)
        alias array
        pushed (standard/arr-push! array 3)
        inserted (standard/arr-insert! array 1 9)]
    [(= array alias)
     (= array pushed)
     (= array inserted)
     (standard/arr-get alias 0)
     (standard/arr-get alias 1)
     (standard/arr-get alias 3)])
  => [true true true 1 9 3])

^{:refer lang.runtime.standard/obj-set! :added "4.1"}
(fact "delegates object mutation without replacing native identity"
  (let [object (standard/obj-new "a" 1)
        alias object
        assigned (standard/obj-set! object "b" 2)
        merged (standard/obj-assign!
                object
                (standard/obj-new "c" 3))]
    [(= object alias)
     (= object assigned)
     (= object merged)
     (standard/obj-get alias "a")
     (standard/obj-get alias "b")
     (standard/obj-get alias "c")])
  => [true true true 1 2 3])

^{:refer lang.runtime.standard/set-path! :added "4.1"}
(fact "mutates nested native values rather than rebuilding a persistent path"
  (let [values (standard/arr-new 1 2)
        inner (standard/obj-new "values" values)
        outer (standard/obj-new "inner" inner)]
    (standard/set-path! outer ["inner" "values" 1] 9)
    [(= inner (standard/obj-get outer "inner"))
     (= values (standard/obj-get inner "values"))
     (standard/arr-get values 1)])
  => [true true 9])

^{:refer lang.runtime.standard/arr-clone :added "4.1"}
(fact "uses native clone operations when XTalk requests a clone"
  (let [array (standard/arr-new 1 2)
        object (standard/obj-new "value" 1)
        array-copy (standard/arr-clone array)
        object-copy (standard/obj-clone object)]
    (standard/arr-set! array-copy 0 9)
    (standard/obj-set! object-copy "value" 9)
    [(standard/arr? array-copy)
     (standard/obj? object-copy)
     (not= array array-copy)
     (not= object object-copy)
     (standard/arr-get array 0)
     (standard/arr-get array-copy 0)
     (standard/obj-get object "value")
     (standard/obj-get object-copy "value")])
  => [true true true true 1 9 1 9])

^{:refer lang.runtime.standard/obj-pairs :added "4.1"}
(fact "returns native arrays from object and array transformations"
  (let [array (standard/arr-new 1 2 3)
        object (standard/obj-new "a" 1 "b" 2)]
    [(standard/arr? (standard/arr-map array inc))
     (standard/arr? (standard/arr-filter array odd?))
     (standard/arr? (standard/obj-keys object))
     (standard/arr? (standard/obj-vals object))
     (standard/arr? (standard/obj-pairs object))])
  => [true true true true true])
