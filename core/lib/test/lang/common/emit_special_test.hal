(ns lang.common.emit-special-test
  (:use code.test)
  (:require [lang.common.emit-helper :as helper]
            [lang.common.emit-special :as special]))

(def snapshot
  {:js {:book {:modules {'app.core
                         {:code {'visible {:id 'visible :op :def}
                                 'hidden {:id 'hidden :op :test}}}}}}})

(fact "selects allowed module ids"
  (special/emit-with-module-all-ids snapshot :js 'app.core #{:def})
  => ['visible])

(fact "orders module ids by Foundation source priority"
  (special/emit-with-module-all-ids
   {:js {:book
         {:modules
          {'app.core
           {:code
            {'late {:id 'late :op :def :priority 2 :time 1 :line 1}
             'last {:id 'last :op :def :priority 2 :time 2 :line 1}
             'first {:id 'first :op :def :priority 1 :time 9 :line 4}}}}}}}
   :js 'app.core #{:def})
  => ['first 'late 'last])

(fact "portable emission rejects implicit host evaluation"
  (special/emit-with-eval nil nil '(!:eval (+ 1 2)) {} {})
  => (throws)

  (special/emit-with-deref nil nil '(!:deref (var x)) {} {})
  => (throws))

(fact "the Foundation special test emitter installs recursive dispatch"
  (special/test-special-emit
   ''(1 2 3)
   (assoc helper/+default+
          :reserved {'quote {:op :quote :emit :quote}})
   {})
  => "(1,2,3)")

(run {:namespace "lang.common.emit-special-test"})
