(ns lang.common.emit-top-level-test
  (:use code.test)
  (:require [lang.common.emit-common :as common]
            [lang.common.emit-helper :as helper]
            [lang.common.emit-top-level :as top]))

(fact "transforms class members to inner forms"
  (top/transform-defclass-inner '[(fn a []) (var b 1) other])
  => '[(fn.inner a []) (var.inner b 1) other])

(fact "emits definitions and declarations"
  (binding [common/*emit-fn* common/emit-common]
    [(top/emit-def :def '(def hello (table 1 2 3)) helper/+default+ {})
     (top/emit-declare :def '(declare a b c) helper/+default+ {})])
  => ["def hello = table(1,2,3);" "def a,b,c"])

(fact "dispatches custom emitters"
  (top/emit-form :custom '(custom 1 2 3)
                 {:reserved {'custom {:emit (fn [form grammar mopts] 'CUSTOM)}}}
                 {})
  => 'CUSTOM)

(fact "qualifies top-level definitions for full layouts"
  (binding [common/*emit-fn*
            (fn [form grammar mopts]
              (if (symbol? form)
                (common/emit-symbol form grammar mopts)
                (common/emit-common form grammar mopts)))]
    (top/emit-top-level
     :def '(def value 1) helper/+default+
     {:layout :full :module {:id 'demo.core}}))
  => "def demo_core____value = 1;"

  (top/emit-top-level :def '(def value 1) helper/+default+ {:layout :full})
  => (throws))

(run {:namespace "lang.common.emit-top-level-test"})
