(ns lang.common.grammar-api-test
  (:use code.test)
  (:require [lang.common.grammar-api :as grammar]
            [lang.common.registry :as registry]))

(def plus-entry
  {:op :add
   :symbol #{'+}
   :type :operator
   :raw "+"})

(def cast-entry
  {:op :cast
   :symbol #{'cast}
   :type :operator
   :raw "cast"})

(def template
  (grammar/emit-template
   {:template/id :default
    :template/version 1
    :template/value {:token {:nil "nil"}}}))

(def profile
  (grammar/profile
   {:profile/id :core
    :profile/version 1
    :profile/operators {:add plus-entry}}))

(def parent
  (grammar/definition
   {:grammar/id :base-js
    :grammar/version 1
    :grammar/release "base"
    :grammar/emit-template
    {:template/id :default
     :template/version 1}
    :grammar/profiles
    [{:profile/id :core
      :profile/version 1}]}))

(def child
  (grammar/definition
   {:grammar/id :js
    :grammar/version 2
    :grammar/release "child"
    :grammar/parent
    {:grammar/id :base-js
     :grammar/version 1}
    :operators
    {:override {:add {:raw "plus"}}}
    :grammar/rewrite
    {:staging
     {:append ['lang.common.grammar-api/fingerprint]}}
    :grammar/facets
    {:typed
     {:operators
      {:define {:cast cast-entry}}
      :grammar/sections
      [[:lint [:no-eval]]]}
     :jsx
     {:requires #{:typed}
      :operators
      {:override {:add {:raw "jsx-plus"}}}}}
    :grammar/facet-order [:typed :jsx]}))

(def catalog
  (registry/install
   (registry/install
    (registry/install
     (registry/install
      (registry/registry)
      template)
     profile)
    parent)
   child))

(def resolved
  (registry/resolve
   catalog
   {:grammar/id :js
    :grammar/version 2
    :grammar/facets [:jsx]}))

(fact "declared sections dispatch through methods"
  (let [out (grammar/apply-section {} :lint [:no-eval] {:facet :typed})]
    (get-in out [:extensions :lint]))
  => [:no-eval])

(fact "materialization preserves order and shared facet customizations"
  [(get-in resolved [:grammar :token :nil])
   (:raw (get-in resolved [:grammar :reserved '+]))
   (:raw (get-in resolved [:grammar :reserved 'cast]))
   (get-in resolved [:coordinate :grammar/facets])
   (get-in resolved [:extensions :lint])
   (count (get-in resolved [:rewrite :staging]))]
  => ["nil" "jsx-plus" "cast" [:typed :jsx] [:no-eval] 1])

(fact "materialization records versioned provenance"
  (:provenance resolved)
  => [[:emit-template :default 1]
      [:profile :core 1]
      [:grammar :base-js 1]
      [:grammar :js 2]
      {:facet :typed}
      {:facet :jsx}])

(run {:namespace "lang.common.grammar-api-test"})
