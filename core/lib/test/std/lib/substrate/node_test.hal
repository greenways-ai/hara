(ns std.lib.substrate.node-test
  (:require [std.lib.test :as test]
            [std.lib.substrate :as substrate]
            [std.lib.substrate.protocol :as protocol]))

(def results
  [(test/check "spaces and services are isolated in a node atom"
               (let [node (substrate/node-create "node-a")]
                 (protocol/create-space node "main" {:state {:count 1} :meta {:owner "test"}})
                 (protocol/update-space-state node "main"
                                (fn [state] (assoc state :count (+ (get state :count) 1))))
                 (protocol/set-service node "cache" 42)
                 [(protocol/get-space-state node "main")
                  (protocol/get-service node "cache")])
               [{:count 2} 42])
   (test/check "nil space ids use the node-wide XTalk space"
               (let [node (substrate/node-create "node-root")]
                 (protocol/set-space-state node nil 42)
                 [(protocol/get-space-state node nil)
                  (protocol/frame-space (protocol/publish node nil "changed" 1 nil))])
               [42 "__NODE__"])
   (test/check "local requests invoke handlers with XTalk argument order"
               (let [node (substrate/node-create "node-b")]
                 (protocol/register-handler node "sum"
                                (fn [space args frame current-node]
                                  {:space (get space :id)
                                   :sum (+ (nth args 0) (nth args 1))})
                                {})
                 (protocol/request node "main" "sum" [19 23] {:id "req-local"}))
               {:space "main" :sum 42})
   (test/check "transports settle remote request promises"
               (let [node (substrate/node-create "node-c")]
                 (protocol/attach-transport node "peer-a"
                                (fn [request]
                                  (protocol/receive-frame node
                                                 (substrate/node-frame :response "res-1" "main" {} nil []
                                                                       (protocol/frame-id request)
                                                                       :ok 84 nil nil nil)
                                                 {:transport-id "peer-a"})))
                 (promise/value
                  (protocol/request node "main" "sum" []
                                 {:id "req-remote" :transport-id "peer-a"})))
               84)
   (test/check "default request and stream ids do not overwrite pending work"
               (let [node (substrate/node-create "node-ids")]
                 (protocol/attach-transport node "peer-a" (fn [frame] nil))
                 (protocol/request node "main" "wait" [] {:transport-id "peer-a"})
                 (protocol/request node "main" "wait" [] {:transport-id "peer-a"})
                 (let [first-stream (protocol/publish node "main" "changed" 1 nil)]
                   (let [second-stream (protocol/publish node "main" "changed" 2 nil)]
                     [(count (get (substrate/node-state node) :pending))
                      (not= (protocol/frame-id first-stream)
                            (protocol/frame-id second-stream))])))
               [2 true])
   (test/check "streams trigger locally and route to subscribers"
               (let [node (substrate/node-create "node-d")]
                 (protocol/register-trigger node "changed"
                                (fn [space frame current-node]
                                  (protocol/set-service current-node "local" (protocol/frame-data frame)))
                                {})
                 (protocol/attach-transport node "peer-a"
                                (fn [frame]
                                  (protocol/set-service node "remote" (protocol/frame-data frame))))
                 (let [subscription (protocol/subscribe node "main" "changed" "sub-1" {})]
                   (protocol/receive-frame node subscription {:transport-id "peer-a"}))
                 (protocol/publish node "main" "changed" 42 {:id "evt-1"})
                 (let [unsubscription (protocol/unsubscribe node "main" "changed" "sub-1" {})]
                   (protocol/receive-frame node unsubscription {:transport-id "peer-a"})
                   [(protocol/get-service node "local")
                    (protocol/get-service node "remote")
                    (protocol/frame-kind unsubscription)
                    (protocol/list-subscriptions node "main" "changed")]))
               [42 42 :unsubscribe []])])

(test/print-results results)
