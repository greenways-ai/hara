(ns std.foundation.edn-test
  (:use code.test)
  (:require [std.foundation.edn :as edn]))

(def results
  [(fact "read"
     (edn/read "{:a [1 2] :b #{:x}}")
     => {:a [1 2] :b #{:x}})
   (fact "write"
     (edn/write {:a [1 2]})
     => "{:a [1 2]}")
   (fact "pretty"
     (edn/pretty [:a 1] {})
     => "[:a 1]")
   (fact "pretty requires an options map"
     (edn/pretty [:a 1] nil)
     => (throws))
   (fact "pretty error carries the rejected options"
     (try
                 (edn/pretty [:a 1] nil)
                 (catch Throwable error
                   (ex-data error)))
     => {:options nil})
   (fact "read does not evaluate"
     (edn/read "(+ 1 2)")
     => '(+ 1 2))])

(pr-str (run '[std.foundation.edn-test]))
