(ns std.foundation.set-test
  (:use code.test)
  (:require [std.foundation.set :as set]))

(def results
  [(fact "union"
     (set/union #{1 2} #{2 3})
     => #{1 2 3})
   (fact "intersection"
     (set/intersection #{1 2 3} #{2 3 4} #{3 5})
     => #{3})
   (fact "difference"
     (set/difference #{1 2 3} #{2} #{3})
     => #{1})
   (fact "subset and superset"
     [(set/subset? #{1 2} #{1 2 3})
                (set/subset? #{1 4} #{1 2 3})
                (set/superset? #{1 2 3} #{1 2})]
     => [true false true])
   (fact "select"
     (set/select odd? #{1 2 3 4})
     => #{1 3})])

(pr-str (run '[std.foundation.set-test]))
