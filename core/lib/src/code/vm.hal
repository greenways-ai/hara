(ns code.vm
  (:require [code.vm.model :as model]
            [code.vm.interpreter :as interpreter]))

(def kinds model/+vm-kinds+)
(def statuses model/+vm-statuses+)
(def terminal-statuses model/+terminal-statuses+)
(def default-limits model/+default-limits+)

(def normalize-limits model/normalize-limits)
(def machine? model/machine?)
(def machine model/machine)
(def transition? model/transition?)
(def transition model/transition)
(def advance model/advance)
(def snapshot model/snapshot)
(def trace model/trace)
(def terminal? model/terminal?)

(def interpreter-journal-schema interpreter/+journal-schema+)
(def interpreter-journal? interpreter/journal?)
(def interpreter-machine? interpreter/interpreter-machine?)
(def interpreter-create interpreter/create)
(def interpreter-step interpreter/step)
(def interpreter-run interpreter/run)
(def interpreter-from-journal interpreter/from-journal)
