(ns code.test.base.match
  (:require [code.test.selector :as selector]))

(defn match-base [selection value] (selector/matches? selection value))
(defn match-include [selection value] (match-base selection value))
(defn match-exclude [selection value] (not (match-base selection value)))
(defn match-options
  [value options]
  (and (match-include (or (:include options) (fn [x] true)) value)
       (if (:exclude options)
         (match-exclude (:exclude options) value)
         true)))
