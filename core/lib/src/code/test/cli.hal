;; Host-facing argument normalisation for code.test. Execution belongs to
;; std.work; command-line token handling remains in the test domain.
(ns code.test.cli
  (:require [std.foundation.edn :as edn]))

(defn read-arg
  "Reads one command-line token as EDN, falling back to the original string."
  [value]
  (try
    (edn/read value)
    (catch Throwable error value)))

(defn keyword-arg?
  [value]
  (keyword? (read-arg value)))

(defn vector-tail
  [values start]
  (loop [index start
         output []]
    (if (= index (count values))
      output
      (recur (inc index) (conj output (nth values index))))))

(defn selector-values
  [arguments]
  (loop [remaining (vec arguments)
         selected []]
    (if (or (empty? remaining)
            (keyword-arg? (first remaining)))
      selected
      (recur (vector-tail remaining 1)
             (conj selected (read-arg (first remaining)))))))

(defn collapse-only
  "Collapses consecutive selectors following :only into one vector value."
  [arguments]
  (loop [remaining (vec arguments)
         output []]
    (if (empty? remaining)
      output
      (let [key (first remaining)
            tail (vector-tail remaining 1)]
        (if (= :only (read-arg key))
          (let [values (selector-values tail)]
            (if (empty? values)
              (recur tail (conj output key))
              (recur (vector-tail tail (count values))
                     (conj (conj output key) (pr-str values)))))
          (recur tail (conj output key)))))))

(defn process-args
  "Processes code.test CLI options, including archived :only and :with forms."
  [arguments]
  (loop [remaining (vec arguments)
         output {}]
    (if (empty? remaining)
      output
      (let [raw-key (first remaining)
            key (read-arg raw-key)
            tail (vector-tail remaining 1)
            has-value (not (empty? tail))
            value (if has-value (read-arg (first tail)) nil)]
        (if (not (keyword? key))
          (recur tail output)
          (if (or (not has-value) (keyword? value))
            (recur tail (assoc output key true))
            (recur (vector-tail tail 1)
                   (if (= key :only)
                     (assoc output :namespace value)
                     (if (= key :with)
                       (assoc output :namespace [value])
                       (assoc output key value))))))))))
