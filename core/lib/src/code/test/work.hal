;; Native std.work adapters for code.test. The test library retains ownership of
;; fact registration, matching, fixtures, reporting, and result semantics;
;; std.work owns execution, lifecycle, replay, and checkpoints.
(ns code.test.work
  (:require [code.test :as test]
            [code.test.protocol :as protocol]
            [std.work :as work]))

(defstruct WorkReporter [context reporter])

(defn work-event-kind
  [event]
  (cond
    (= event :run/start) :test/run-started
    (= event :run/end) :test/run-completed
    (= event :fact/start) :test/fact-started
    (= event :fact/end) :test/fact-completed
    :else :test/event))

(extend-type WorkReporter protocol/ITestReporter
  (report-event [reporter event]
    (let [context (field reporter :context)
          delegate (field reporter :reporter)
          event-kind (work-event-kind (:event event))
          data (assoc (dissoc event :event)
                      :test/event (:event event))]
      (work/emit! context event-kind data)
      (if delegate
        (try
          (test/report! delegate event)
          (catch Throwable error event))
        event))))

(defn work-reporter
  [context reporter]
  (code.test.work/WorkReporter context reporter))

(defn reporter-for
  [options context]
  (work-reporter context (:reporter options)))

(def +default-revision+ test/+default-work-revision+)
(def +runner-work+ test/+runner-work+)
(def revision test/work-revision)
(def context-options test/work-context-options)
(def execution-options test/work-execution-options)
(def suite-work test/suite-work)

(def +unsupported-batch-options+ [:fail-fast])

(defn fact-identity
  [value]
  (str value))

(defn fact-coordinate
  [namespace name fact-revision]
  [:test/fact
   (fact-identity namespace)
   (fact-identity name)
   fact-revision])

(defn fact-revision
  [fact default-revision]
  (or (:test/revision (:meta fact))
      default-revision))

(defn fact-definition-token
  "Returns the stable definition token used to invalidate a fact checkpoint.

   A producer may supply a canonical source digest as `:test/digest`, or another
   stable definition identity as `:test/definition`. The explicit fact/suite
   revision remains the compatibility fallback until portable source hashing is
   available in every runtime."
  [fact default-revision]
  (let [metadata (:meta fact)]
    (or (:test/digest metadata)
        (:test/definition metadata)
        (fact-revision fact default-revision))))

(defn fact-item-coordinate
  [fact default-revision]
  (let [fact-revision (fact-revision fact default-revision)]
    (conj
     (fact-coordinate (:namespace fact)
                      (:name fact)
                      fact-revision)
     (fact-definition-token fact default-revision))))

(defn resolve-fact
  [namespace name]
  (let [namespace (fact-identity namespace)
        name (fact-identity name)
        fact (test/get-fact namespace name)]
    (if fact
      fact
      (throw
       (ex-info "Registered test fact does not exist"
                {:namespace namespace
                 :name name})))))

(defn fact-work
  "Returns one checkpointed fact boundary. Assertion failures, skips, timeouts,
   and test errors are completed domain results returned by code.test/run-fact."
  ([namespace name]
   (fact-work namespace name +default-revision+))
  ([namespace name fact-revision]
   (work/step
    {:id (fact-coordinate namespace name fact-revision)
     :version fact-revision
     :test/revision fact-revision}
    (fn [input context]
      (let [options (execution-options input context)
            reporter (reporter-for options context)]
        (test/run-fact
         (resolve-fact namespace name)
         reporter
         options))))))

(defn unsupported-batch-options
  [options]
  (reduce
   (fn [output key]
     (if (and (has? options key)
              (not (nil? (get options key)))
              (not (= false (get options key))))
       (conj output key)
       output))
   []
   +unsupported-batch-options+))

(defn assert-batch-options!
  [options]
  (let [unsupported (unsupported-batch-options options)]
    (if (seq unsupported)
      (throw
       (ex-info
        "Fact batch execution does not support fail-fast scheduling"
        {:unsupported unsupported
         :options options})))
    options))

(defn selected-facts
  [options]
  (test/order-facts
   (vec
    (filter
     (fn [fact]
       (test/matches-selection? fact options))
     (test/tests)))))

(defn data-options
  [input context]
  (merge (test/normalize-run-options input)
         (or (:test/options context) {})))

(defn effective-suite-options
  [facts options]
  (let [namespace (if (seq facts)
                    (:namespace (first facts))
                    nil)
        suite-options
        (or (get (deref test/+global-settings+) namespace)
            {})]
    (merge suite-options options)))

(defn fact-item
  [fact options default-revision]
  (let [fact-revision (fact-revision fact default-revision)
        definition-token (fact-definition-token fact default-revision)]
    {:item/id (fact-item-coordinate fact default-revision)
     :item/value
     {:namespace (fact-identity (:namespace fact))
      :name (fact-identity (:name fact))
      :test/revision fact-revision
      :test/definition definition-token
      :test/options options}}))

(defn prepare-fact-batch
  [input context default-revision]
  (let [input-options (data-options input context)
        facts (selected-facts input-options)
        options (assert-batch-options!
                 (effective-suite-options facts input-options))
        items
        (vec
         (map
          (fn [fact]
            (fact-item fact options default-revision))
          facts))]
    {:test/options options
     :test/items items}))

(defn fact-manifest
  [input context default-revision]
  (:test/items
   (prepare-fact-batch input context default-revision)))

(defn summary-from-results
  [results]
  (let [counts (test/result-counts results)
        checks (test/attach-check-total
                (test/check-counts results))
        status (if (and (= 0 (:failed counts))
                        (= 0 (:error counts))
                        (= 0 (:timeout counts)))
                 :passed
                 :failed)
        namespaces
        (reduce
         (fn [output result]
           (conj output (:namespace result)))
         #{}
         results)]
    {:status status
     :counts counts
     :check-counts checks
     :files (count namespaces)
     :facts (count results)
     :checks (:total checks)
     :passed (:passed checks)
     :failed (:failed checks)
     :throw (:error counts)
     :timeout (:timeout counts)
     :results results}))

(defn fact-options
  [subject context]
  (execution-options (:test/options subject) context))

(defn fact-result-identity
  [fact]
  {:namespace (:namespace fact)
   :name (:name fact)
   :meta (:meta fact)})

(defn error-result
  [fact error]
  (merge (fact-result-identity fact)
         {:status :error
          :checks []
          :error (str error)}))

(defn fact-mode
  [subject context]
  (let [fact (resolve-fact (:namespace subject)
                           (:name subject))
        options (fact-options subject context)]
    (if (:skip (:meta fact))
      :terminal
      (if (test/fact-cancelled? fact options)
        :terminal
        :run))))

(defn terminal-fact-result
  [subject context]
  (let [fact (resolve-fact (:namespace subject)
                           (:name subject))
        options (fact-options subject context)
        reporter (reporter-for options context)]
    (test/run-fact fact reporter options)))

(defn before-fact
  [subject context]
  (let [fact (resolve-fact (:namespace subject)
                           (:name subject))
        options (fact-options subject context)
        reporter (reporter-for options context)
        identity (fact-result-identity fact)
        start (test/clock-now options)
        start-event (test/report! reporter
                                  (merge {:event :fact/start}
                                         identity))]
    (try
      (do
        (test/run-hooks [(:before-each options)
                         (:before (:meta fact))]
                        options)
        {:subject subject
         :test/start start
         :test/before-error nil})
      (catch Throwable error
        {:subject subject
         :test/start start
         :test/before-error (str error)}))))

(defn execute-fact-body
  [fact options]
  (try
    (let [checks
          (test/normalize-checks
           (test/settle ((:function fact) options) options))
          status (if (test/checks-timeout? checks)
                   :timeout
                   (if (test/checks-error? checks)
                     :error
                     (if (test/checks-pass? checks)
                       :passed
                       :failed)))]
      (merge (fact-result-identity fact)
             {:status status
              :checks checks}))
    (catch Throwable error
      (error-result fact error))))

(defn run-fact-body
  [state context]
  (let [subject (:subject state)
        fact (resolve-fact (:namespace subject)
                           (:name subject))
        options (fact-options subject context)
        result
        (if (:test/before-error state)
          (error-result fact (:test/before-error state))
          (execute-fact-body fact options))]
    (assoc state :test/result result)))

(defn after-fact
  [outcome context]
  (let [state (:work/body-result outcome)
        subject (or (:subject state)
                    (:work/input outcome))
        fact (resolve-fact (:namespace subject)
                           (:name subject))
        options (fact-options subject context)]
    (try
      (do
        (test/run-hooks [(:after (:meta fact))
                         (:after-each options)]
                        options)
        {:status :completed})
      (catch Throwable error
        {:status :error
         :error (str error)}))))

(defn timed-result
  [result start options]
  (let [end (test/clock-now options)]
    (if (and start end)
      (assoc result :elapsed (- end start))
      result)))

(defn finalize-fact
  [outcome context]
  (let [state (get-in outcome [:work/body :result])
        subject (:subject state)
        fact (resolve-fact (:namespace subject)
                           (:name subject))
        options (fact-options subject context)
        cleanup (get-in outcome [:work/cleanup :result])
        result (if (= :error (:status cleanup))
                 (error-result fact (:error cleanup))
                 (:test/result state))
        result (timed-result result (:test/start state) options)
        reporter (reporter-for options context)
        end-event (test/report! reporter
                                (merge {:event :fact/end}
                                       result))]
    result))

(defn running-fact-work
  [batch-revision]
  (work/chain
   {:id 'code.test/fact-scope-chain
    :version batch-revision}
   [(work/ensure
     {:id 'code.test/fact-scope
      :version batch-revision
      :return :outcome}
     (work/chain
      {:id 'code.test/fact-body-chain
       :version batch-revision}
      [(work/step
        {:id 'code.test/fact-before
         :version batch-revision}
        before-fact)
       (work/step
        {:id 'code.test/fact-body
         :version batch-revision}
        run-fact-body)])
     (work/step
      {:id 'code.test/fact-after
       :version batch-revision}
      after-fact))
    (work/step
     {:id 'code.test/fact-finalize
      :version batch-revision}
     finalize-fact)]))

(defn fact-process-work
  [batch-revision]
  (work/choose
   {:id 'code.test/fact-dispatch
    :version batch-revision}
   (work/step
    {:id 'code.test/fact-mode
     :version batch-revision}
    fact-mode)
   {:terminal
    (work/step
     {:id 'code.test/fact-terminal
      :version batch-revision}
     terminal-fact-result)
    :run
    (running-fact-work batch-revision)}))

(defn summarise-fact-batch
  [batch context]
  (summary-from-results
   (work/manifest-values (:results batch))))

(defn suite-before
  [prepared context]
  (let [options (execution-options (:test/options prepared) context)
        reporter (reporter-for options context)
        start-event
        (test/report! reporter
                      {:event :run/start
                       :count (count (:test/items prepared))})]
    (test/run-hook (:before-all options) options)
    nil))

(defn suite-after
  [outcome context]
  (let [prepared (:work/input outcome)
        options (execution-options (:test/options prepared) context)
        reporter (reporter-for options context)
        body-result (:work/body-result outcome)]
    (test/run-hook (:after-all options) options)
    (if (= :completed (:work/body-status outcome))
      (test/report! reporter
                    (merge {:event :run/end}
                           (:summary body-result)))
      nil)
    {:status :completed}))

(defn fact-batch-body
  [batch-revision]
  (work/chain
   {:id 'code.test/fact-batch-body
    :version batch-revision}
   [(work/all
     {:id 'code.test/suite-start
      :version batch-revision}
     [(work/pure
       {:id 'code.test/suite-state
        :version batch-revision}
       (fn [prepared context] prepared))
      (work/step
       {:id 'code.test/suite-before
        :version batch-revision}
       suite-before)])
    (work/pure
     {:id 'code.test/suite-state-after-start
      :version batch-revision}
     (fn [outputs context]
       (nth outputs 0)))
    (work/batch
     {:id 'code.test/fact-batch-items
      :version batch-revision}
     {:list
      (work/pure
       {:id 'code.test/fact-list
        :version batch-revision}
       (fn [prepared context]
         (:test/items prepared)))

      :process
      (fact-process-work batch-revision)

      :summarise
      (work/pure
       {:id 'code.test/fact-summary
        :version batch-revision}
       summarise-fact-batch)})]))

(defn fact-batch-work
  "Returns an opt-in fact graph with independently checkpointed fact bodies.

   Suite and fact cleanup hooks execute through cleanup-safe work scopes.
   Reporters are bridged into durable work history. Fail-fast scheduling remains
   on the cleanup-safe suite runner until the runtime owns queued item claims."
  ([]
   (fact-batch-work +default-revision+))
  ([batch-revision]
   (work/chain
    {:id 'code.test/fact-batch
     :version batch-revision
     :test/revision batch-revision}
    [(work/pure
      {:id 'code.test/fact-batch-prepare
       :version batch-revision}
      (fn [input context]
        (prepare-fact-batch input context batch-revision)))
     (work/ensure
      {:id 'code.test/suite-scope
       :version batch-revision}
      (fact-batch-body batch-revision)
      (work/step
       {:id 'code.test/suite-after
        :version batch-revision}
       suite-after))])))

(defn batch-summary
  [result]
  (:summary result))

(defn run-batch
  "Runs selected facts as independently checkpointed items and returns the
   ordinary code.test summary."
  ([runtime]
   (run-batch runtime {} {}))
  ([runtime options]
   (run-batch runtime options {}))
  ([runtime options work-options]
   (let [options (test/normalize-run-options options)]
     (batch-summary
      (work/run runtime
                (fact-batch-work (revision options))
                options
                work-options)))))

(defn start-batch
  "Starts independently checkpointed fact execution through an explicit runtime."
  ([runtime options]
   (start-batch runtime options {}))
  ([runtime options work-options]
   (let [options (test/normalize-run-options options)]
     (work/start runtime
                 (fact-batch-work (revision options))
                 options
                 work-options))))

(defn batch-result
  [runtime reference]
  (batch-summary (work/result runtime reference)))

(defn run
  "Runs a selected test suite through an explicit IWorkRuntime."
  ([runtime]
   (run runtime {} {}))
  ([runtime options]
   (run runtime options {}))
  ([runtime options work-options]
   (test/run runtime options work-options)))

(defn start
  "Starts a selected test suite through an explicit IWorkRuntime."
  ([runtime options]
   (start runtime options {}))
  ([runtime options work-options]
   (work/start runtime
               (suite-work (revision options))
               options
               work-options)))
