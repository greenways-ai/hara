;; Native std.work adapters for code.test. The test library retains ownership of
;; fact registration, matching, fixtures, reporting, and result semantics;
;; std.work owns execution, lifecycle, replay, and checkpoints.
(ns code.test.work
  (:require [code.test :as test]
            [std.work :as work]))

(def +default-revision+ test/+default-work-revision+)
(def +runner-work+ test/+runner-work+)
(def revision test/work-revision)
(def context-options test/work-context-options)
(def execution-options test/work-execution-options)
(def suite-work test/suite-work)

(defn fact-identity
  [value]
  (str value))

(defn fact-coordinate
  [namespace name fact-revision]
  [:test/fact
   (fact-identity namespace)
   (fact-identity name)
   fact-revision])

(defn resolve-fact
  [namespace name]
  (let [namespace (fact-identity namespace)
        name (fact-identity name)
        fact (test/get-fact namespace name)]
    (if fact
      fact
      (throw
       (ex-info "Registered test fact does not exist"
                {:namespace namespace
                 :name name})))))

(defn fact-work
  "Returns one checkpointed fact boundary. Assertion failures, skips, timeouts,
   and test errors are completed domain results returned by code.test/run-fact."
  ([namespace name]
   (fact-work namespace name +default-revision+))
  ([namespace name fact-revision]
   (work/step
    {:id (fact-coordinate namespace name fact-revision)
     :version fact-revision
     :test/revision fact-revision}
    (fn [input context]
      (let [options (execution-options input context)
            reporter (or (:reporter options)
                         test/+null-reporter+)]
        (test/run-fact
         (resolve-fact namespace name)
         reporter
         options))))))

(defn run
  "Runs a selected test suite through an explicit IWorkRuntime."
  ([runtime]
   (run runtime {} {}))
  ([runtime options]
   (run runtime options {}))
  ([runtime options work-options]
   (test/run runtime options work-options)))

(defn start
  "Starts a selected test suite through an explicit IWorkRuntime."
  ([runtime options]
   (start runtime options {}))
  ([runtime options work-options]
   (work/start runtime
               (suite-work (revision options))
               options
               work-options)))
