;; Deprecated task-shaped entry names retained for callers while code.test
;; execution migrates to native std.work values.
(ns code.test.task
  (:require [code.test :as test]
            [code.test.cli :as cli]))

(def run test/run)
(def run:current test/run)
(def run:test test/run)
(def run:load test/run)
(def run:unload test/run)
(def run-errored test/run)

(defn resolve-files
  ([files] (resolve-files files nil))
  ([files project]
   (if (or (vector? files) (list? files) (set? files))
     (vec files)
     [files])))

(defn run:interrupt [] true)
(defn run:report
  ([path] (test/run {:report path}))
  ([path options] (test/run (assoc options :report path)))
  ([path options project] (test/run (assoc options :report path))))
(defn print-options
  ([] (print-options :help))
  ([options]
   (if (= options :help)
     #{:help :current :default :disable :all}
     options)))

(defn legacy-test-options
  "Preserves the archived task CLI result shape while code.test.cli owns the
   canonical :namespace execution option."
  [options]
  (if (has? options :namespace)
    (assoc (dissoc options :namespace)
           :ns
           (:namespace options))
    options))

(defn process-test-args
  [arguments]
  (legacy-test-options
   (cli/process-args (cli/collapse-only arguments))))
(defn -main
  [& arguments]
  (test/run (process-test-args arguments)))
