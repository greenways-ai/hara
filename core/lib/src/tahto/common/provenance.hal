(ns tahto.common.provenance)

(def +field-keys+
  [:tahto/phase
   :tahto/subsystem
   :tahto/lang
   :tahto/module
   :tahto/namespace
   :tahto/entry
   :tahto/symbol
   :tahto/line
   :tahto/form
   :tahto/hook
   :tahto/grammar-coordinate
   :tahto/grammar-fingerprint
   :tahto/actor
   :tahto/source
   :tahto/work])

(defn module-id
  [module]
  (cond (map? module)
        (:id module)

        :else
        module))

(defn namespace-id
  [namespace]
  (cond (and (symbol? namespace)
             (the-ns namespace))
        (ns-name namespace)

        :else
        namespace))

(defn line-of
  [value]
  (cond (nil? value)
        nil

        (map? value)
        (or (:line value)
            (line-of (:entry value))
            (line-of (:form value))
            (:line (meta value)))

        :else
        (:line (meta value))))

(defn compact
  [m]
  (reduce-kv (fn [acc k v]
               (if (nil? v)
                 acc
                 (assoc acc k v)))
             {}
             m))

(defn frame
  [data]
  (let [inner (or (:tahto/provenance data) {})]
    (let [base (merge (select-keys inner +field-keys+)
                      (select-keys data +field-keys+))]
      (if (empty? base)
        {}
        (let [line (or (:tahto/line base)
                       (line-of (:tahto/entry base))
                       (line-of (:tahto/form base))
                       (line-of data))]
          (compact
           (assoc base
                  :tahto/module (module-id (:tahto/module base))
                  :tahto/namespace (namespace-id (:tahto/namespace base))
                  :tahto/line line)))))))

(defn provenance
  [& inputs]
  (apply merge
         {}
         (filter (fn [value] (not (empty? value)))
                 (map (fn [input]
                        (if (map? input) (frame input) {}))
                      inputs))))

(defn provenance-stack
  [data]
  (let [stack (:tahto/provenance-stack data)]
    (cond (seq stack)
          (vec (filter (fn [value] (not (empty? value)))
                       (map frame stack)))

          (map? data)
          (let [single (frame data)]
            (if (empty? single)
              []
              [single]))

          :else
          [])))

(defn same-site?
  [left right]
  (= (select-keys left [:tahto/phase
                        :tahto/subsystem
                        :tahto/module
                        :tahto/namespace
                        :tahto/line])
     (select-keys right [:tahto/phase
                         :tahto/subsystem
                         :tahto/module
                         :tahto/namespace
                         :tahto/line])))

(defn append-frame
  [stack current]
  (cond (empty? current)
        stack

        (and (seq stack)
             (same-site? (peek stack) current))
        stack

        :else
        (conj stack current)))

(defn with-provenance
  [mopts & inputs]
  (let [merged (apply provenance
                      (concat [(:tahto/provenance mopts)] inputs))]
    (if (empty? merged)
      mopts
      (assoc mopts :tahto/provenance merged))))

(defn error-with-provenance
  [message data t]
  (let [cause-data (ex-data t)]
    (let [current (frame data)]
      (let [inner-stack (provenance-stack cause-data)]
        (let [stack (append-frame (vec inner-stack) current)]
          (let [merged (if (seq stack)
                         (reduce merge {} (reverse stack))
                         {})]
            (let [wrapped? (:tahto/wrapped cause-data)
                  plain-data (dissoc data
                                     :tahto/provenance
                                     :tahto/provenance-stack)]
              (let [payload-0 (merge cause-data plain-data merged)]
                (let [payload-1 (if (seq merged)
                                  (assoc payload-0 :tahto/provenance merged)
                                  payload-0)]
                  (let [payload-2 (if (seq stack)
                                    (assoc payload-1 :tahto/provenance-stack stack)
                                    payload-1)]
                    (let [payload-3 (assoc payload-2
                                           :tahto/wrapped true
                                           :tahto/cause-class (ex-class t)
                                           :tahto/cause-message (ex-message t))]
                      (let [payload (if (and cause-data (not wrapped?))
                                      (assoc payload-3 :tahto/cause-data cause-data)
                                      payload-3)]
                        (ex-info (if (ex-message t)
                                   (str message ": " (ex-message t))
                                   message)
                                 payload
                                 t)))))))))))))

(defn throw-with-provenance
  [message data t]
  (throw (error-with-provenance message data t)))
