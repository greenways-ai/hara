(ns std.work.runtime.execution
  (:require [std.work.runtime.base :as base]
            [std.work.runtime.frame :as frame]
            [std.work.runtime.store :as store]))

(defn provider-operations
  [provider]
  (or (:provider/operations provider) provider))

(defn assert-role!
  [provider]
  (if (not= :work/executor (:provider/role provider))
    (throw
     (ex-info "Work provider does not have the executor role"
              {:provider/role (:provider/role provider)
               :provider/id (:provider/id provider)})))
  provider)

(defn validate-provider
  [provider]
  (let [provider (assert-role! provider)
        execute (get (provider-operations provider) :execute)]
    (if (nil? execute)
      (throw
       (ex-info "Work executor provider is missing :execute"
                {:provider/id (:provider/id provider)})))
    (if (:provider/handlers provider)
      provider
      (assoc provider :provider/handlers {}))))

(defn legacy-provider
  [provider]
  {:provider/role :work/executor
   :provider/id (or (:provider/id provider) :legacy-executor)
   :provider/capabilities (or (:provider/capabilities provider) #{})
   :provider/operations provider
   :provider/handlers (or (:handlers provider) {})
   :provider/legacy provider})

(defn normalise-provider
  [provider]
  (cond
    (nil? provider)
    (throw (ex-info "Work runtime requires an executor provider" {}))

    (and (map? provider)
         (= :work/executor (:provider/role provider)))
    (validate-provider provider)

    (and (map? provider)
         (:provider/role provider))
    (assert-role! provider)

    (map? provider)
    (validate-provider (legacy-provider provider))

    :else
    (throw
     (ex-info "Work executor provider must be a descriptor or operation map"
              {:provider provider}))))

(defn call
  [provider operation & arguments]
  (let [function (get (provider-operations provider) operation)]
    (if function
      (apply function arguments)
      (throw
       (ex-info "Work executor operation is not installed"
                {:provider/id (:provider/id provider)
                 :operation operation})))))

(defn execute-work
  [runtime frame work input]
  (call (base/runtime-executor runtime)
        :execute
        runtime
        frame
        work
        input))

(defn with-handler
  [provider operation handler]
  (assoc provider
         :provider/handlers
         (assoc (or (:provider/handlers provider) {})
                operation
                handler)))

(defn with-handlers
  [provider handlers]
  (assoc provider
         :provider/handlers
         (merge (or (:provider/handlers provider) {})
                (or handlers {}))))

(defn run-pure
  [execute runtime frame spec input]
  (let [frame (frame/leaf-frame frame spec)]
    ((:fn spec) input (frame/leaf-context runtime frame))))

(defn retry-allowed?
  [retry error]
  (let [predicate (:retry? retry)]
    (if predicate
      (if (predicate error) true false)
      true)))

(defn step-attempt
  [runtime frame spec input attempt maximum]
  (try
    (let [context (assoc (frame/leaf-context runtime frame) :attempt attempt)]
      [((:fn spec) input context) attempt])
    (catch Throwable error
      (if (and (< attempt maximum)
               (retry-allowed? (or (:retry spec) {}) error))
        (do
          (frame/emit! runtime frame :work/step-retry
                 {:step/id (:id spec)
                  :attempt attempt
                  :next-attempt (inc attempt)})
          (step-attempt runtime frame spec input (inc attempt) maximum))
        (do
          (frame/emit! runtime frame :work/step-failed
                 {:step/id (:id spec)
                  :attempt attempt
                  :error (str error)})
          (throw error))))))

(defn assert-step-identity!
  [runtime spec]
  (if (and (base/durable? runtime)
           (nil? (:id spec)))
    (throw
     (ex-info "Durable step work requires a stable :id"
              {:operation (:op spec)})))
  spec)

(defn checkpoint-record
  [frame spec input result attempts key]
  {:checkpoint/run (:run/id frame)
   :checkpoint/key key
   :checkpoint/work-root (:work/root frame)
   :checkpoint/work-version (:work/version frame)
   :checkpoint/node-path (:node/path frame)
   :checkpoint/item-id (:item/id frame)
   :checkpoint/item-path (or (:item/path frame) [])
   :checkpoint/status :completed
   :checkpoint/input input
   :checkpoint/result result
   :checkpoint/attempts attempts
   :checkpoint/definition-digest
   (or (:definition-digest spec) (:digest spec))
   :checkpoint/input-digest
   (or (:input-digest spec)
       (:input-digest (:options frame)))})

(defn run-step
  [execute runtime frame spec input]
  (let [_ (assert-step-identity! runtime spec)
        frame (frame/leaf-frame frame spec)
        key (frame/checkpoint-key frame)
        checkpoint
        (if (base/durable? runtime)
          (store/call (base/runtime-store runtime) :load-checkpoint key)
          nil)]
    (if (= :completed (:checkpoint/status checkpoint))
      (do
        (frame/emit! runtime frame :work/step-replayed
               {:step/id (:id spec)
                :checkpoint/key key})
        (:checkpoint/result checkpoint))
      (let [retry (or (:retry spec) {})
            maximum (or (:maximum retry) 1)
            _ (frame/emit! runtime frame :work/step-started
                     {:step/id (:id spec)
                      :checkpoint/key key})
            [result attempts]
            (step-attempt runtime frame spec input 1 maximum)
            completed
            (frame/event-record
             frame
             :work/step-completed
             {:step/id (:id spec)
              :checkpoint/key key
              :attempts attempts})]
        (if (base/durable? runtime)
          (frame/transact!
           runtime
           frame
           {:transition/checkpoints
            [(checkpoint-record frame spec input result attempts key)]
            :transition/events [completed]})
          (frame/emit! runtime frame :work/step-completed
                 {:step/id (:id spec)
                  :checkpoint/key key
                  :attempts attempts}))
        result))))

(defn run-chain
  [execute runtime frame spec input]
  (let [children (vec (:children spec))]
    (loop [index 0
           value input]
      (if (= index (count children))
        value
        (let [child (nth children index)
              child-spec (base/work-spec-map child)
              child-frame (frame/child-frame frame :chain index child-spec)]
          (recur (inc index)
                 (execute runtime child-frame child value)))))))

(defn run-each
  [execute runtime frame spec input]
  (let [manifest (frame/normalise-manifest runtime spec input)
        child (:work spec)
        child-spec (base/work-spec-map child)
        base-frame (frame/child-frame frame :each child-spec)]
    (loop [index 0
           output []]
      (if (= index (count manifest))
        output
        (let [item (nth manifest index)
              item-id (:item/id item)
              value (execute runtime
                             (frame/item-frame base-frame item-id)
                             child
                             (:item/value item))]
          (recur (inc index)
                 (conj output
                       {:item/id item-id
                        :item/value value})))))))

(defn run-filter
  [execute runtime frame spec input]
  (let [manifest (frame/normalise-manifest runtime spec input)
        predicate (:work spec)
        predicate-spec (base/work-spec-map predicate)
        base-frame (frame/child-frame frame :filter predicate-spec)]
    (loop [index 0
           output []]
      (if (= index (count manifest))
        output
        (let [item (nth manifest index)
              selected
              (execute runtime
                       (frame/item-frame base-frame (:item/id item))
                       predicate
                       (:item/value item))]
          (recur (inc index)
                 (if selected
                   (conj output item)
                   output)))))))

(defn run-fold
  [execute runtime frame spec input]
  (let [manifest (frame/normalise-manifest runtime spec input)
        reducer (:work spec)
        reducer-spec (base/work-spec-map reducer)
        base-frame (frame/child-frame frame :fold reducer-spec)]
    (loop [index 0
           accumulator (:initial spec)]
      (if (= index (count manifest))
        accumulator
        (let [item (nth manifest index)
              next-value
              (execute runtime
                       (frame/item-frame base-frame (:item/id item))
                       reducer
                       {:acc accumulator
                        :item/id (:item/id item)
                        :item/value (:item/value item)})]
          (recur (inc index) next-value))))))

(defn run-all
  [execute runtime frame spec input]
  (let [children (vec (:children spec))]
    (loop [index 0
           output []]
      (if (= index (count children))
        output
        (let [child (nth children index)
              child-spec (base/work-spec-map child)
              child-frame (frame/child-frame frame :all index child-spec)]
          (recur (inc index)
                 (conj output
                       (execute runtime child-frame child input))))))))

(defn run-choose
  [execute runtime frame spec input]
  (let [selector (:selector spec)
        selector-spec (base/work-spec-map selector)
        selected
        (execute runtime
                 (frame/child-frame frame :choose :selector selector-spec)
                 selector
                 input)
        choice (get (:choices spec) selected)]
    (if choice
      (let [choice-spec (base/work-spec-map choice)]
        (execute runtime
                 (frame/child-frame frame :choose selected choice-spec)
                 choice
                 input))
      (throw
       (ex-info "Work choice does not exist"
                {:selected selected
                 :choices (keys (:choices spec))})))))

(defn required-work
  [spec key]
  (let [work (get spec key)]
    (if work
      work
      (throw
       (ex-info "Work scope requires a child"
                {:operation (:op spec)
                 :child key
                 :work/id (:id spec)})))))

(defn cleanup-input
  [input status result error]
  {:work/input input
   :work/body-status status
   :work/body-result result
   :work/body-error (if error (str error) nil)})

(defn run-cleanup
  [execute runtime cleanup-frame cleanup input]
  (frame/emit! runtime cleanup-frame :work/cleanup-started
         {:cleanup/id (frame/node-id (base/work-spec-map cleanup))})
  (try
    (let [result (execute runtime cleanup-frame cleanup input)]
      (frame/emit! runtime cleanup-frame :work/cleanup-completed
             {:cleanup/id (frame/node-id (base/work-spec-map cleanup))})
      {:status :completed
       :result result})
    (catch Throwable error
      (frame/emit! runtime cleanup-frame :work/cleanup-failed
             {:cleanup/id (frame/node-id (base/work-spec-map cleanup))
              :error (str error)})
      {:status :failed
       :error error})))

(defn successful-ensure-result
  [spec input body-result cleanup-outcome]
  (if (= :outcome (:return spec))
    {:work/input input
     :work/body {:status :completed
                 :result body-result}
     :work/cleanup {:status :completed
                    :result (:result cleanup-outcome)}}
    body-result))

(defn run-body
  [execute runtime body-frame body input]
  (try
    {:status :completed
     :result (execute runtime body-frame body input)}
    (catch Throwable error
      {:status :failed
       :error error})))

(defn run-ensure
  [execute runtime frame spec input]
  (let [body (required-work spec :work)
        cleanup (required-work spec :cleanup)
        body-spec (base/work-spec-map body)
        cleanup-spec (base/work-spec-map cleanup)
        body-frame (frame/child-frame frame :ensure :body body-spec)
        cleanup-frame
        (assoc (frame/child-frame frame :ensure :cleanup cleanup-spec)
               :work/cleanup? true)
        body-outcome (run-body execute runtime body-frame body input)
        body-completed (= :completed (:status body-outcome))
        cleanup-outcome
        (run-cleanup execute
                     runtime
                     cleanup-frame
                     cleanup
                     (cleanup-input input
                                    (:status body-outcome)
                                    (if body-completed
                                      (:result body-outcome)
                                      nil)
                                    (if body-completed
                                      nil
                                      (:error body-outcome))))]
    (cond
      (and (not body-completed)
           (= :failed (:status cleanup-outcome)))
      (throw
       (ex-info "Work body and cleanup both failed"
                {:body/error (str (:error body-outcome))
                 :cleanup/error (str (:error cleanup-outcome))}))

      (not body-completed)
      (throw (:error body-outcome))

      (= :failed (:status cleanup-outcome))
      (throw (:error cleanup-outcome))

      :else
      (do
        (frame/assert-running! runtime frame)
        (successful-ensure-result spec
                                  input
                                  (:result body-outcome)
                                  cleanup-outcome)))))

(defn run-batch-filter
  [execute runtime frame filter-work manifest]
  (if (nil? filter-work)
    manifest
    (let [filter-spec (base/work-spec-map filter-work)
          base-frame (frame/child-frame frame :batch :filter filter-spec)]
      (loop [index 0
             output []]
        (if (= index (count manifest))
          output
          (let [item (nth manifest index)
                selected
                (execute runtime
                         (frame/item-frame base-frame (:item/id item))
                         filter-work
                         (:item/value item))]
            (recur (inc index)
                   (if selected
                     (conj output item)
                     output))))))))

(defn run-batch-process
  [execute runtime frame process-work manifest]
  (let [process-spec (base/work-spec-map process-work)
        base-frame (frame/child-frame frame :batch :process process-spec)]
    (loop [index 0
           output []]
      (if (= index (count manifest))
        output
        (let [item (nth manifest index)
              result
              (execute runtime
                       (frame/item-frame base-frame (:item/id item))
                       process-work
                       (:item/value item))]
          (recur (inc index)
                 (conj output
                       {:item/id (:item/id item)
                        :item/value result})))))))

(defn required-stage
  [spec stage]
  (let [work (get spec stage)]
    (if (nil? work)
      (throw
       (ex-info "Batch work requires a stage"
                {:stage stage
                 :work/id (:id spec)}))
      work)))

(defn run-batch
  [execute runtime frame spec input]
  (let [list-work (required-stage spec :list)
        list-spec (base/work-spec-map list-work)
        list-frame
        (frame/child-frame frame :batch :list list-spec)
        listed (execute runtime list-frame list-work input)
        manifest (frame/normalise-manifest runtime spec listed)
        selected
        (run-batch-filter execute runtime frame (:filter spec) manifest)
        process-work (required-stage spec :process)
        processed
        (run-batch-process execute runtime frame process-work selected)
        summary-input
        {:items selected
         :results processed}
        summarise-work (:summarise spec)
        summary
        (if summarise-work
          (let [summary-spec (base/work-spec-map summarise-work)
                summary-frame
                (frame/child-frame frame :batch :summarise summary-spec)]
            (execute runtime
                     summary-frame
                     summarise-work
                     summary-input))
          summary-input)]
    {:items selected
     :results processed
     :summary summary}))

(def default-handlers
  {:pure run-pure
   :step run-step
   :chain run-chain
   :each run-each
   :filter run-filter
   :fold run-fold
   :all run-all
   :choose run-choose
   :ensure run-ensure
   :batch run-batch})

(defn execute-node
  [runtime frame work input]
  (frame/assert-running! runtime frame)
  (let [spec (base/work-spec-map work)
        operation (:op spec)
        handler (get (base/runtime-handlers runtime) operation)]
    (if (nil? handler)
      (throw
       (ex-info "Work operation is not installed"
                {:operation operation
                 :node/path (:node/path frame)}))
      (do
        (frame/emit! runtime frame :work/node-started
               {:operation operation
                :node/id (:id spec)})
        (try
          (let [result (handler execute-node runtime frame spec input)]
            (frame/emit! runtime frame :work/node-completed
                   {:operation operation
                    :node/id (:id spec)})
            result)
          (catch Throwable error
            (frame/emit! runtime frame :work/node-failed
                   {:operation operation
                    :node/id (:id spec)
                    :error (str error)})
            (throw error)))))))
