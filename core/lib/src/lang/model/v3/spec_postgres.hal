(ns lang.model.v3.spec-postgres
  (:require [lang.common.grammar-api :as grammar]
            [lang.common.registry :as registry]
            [lang.core.registry :as core-registry]
            [lang.model.v2.spec-postgres :as postgres-v2]
            [lang.model.v1.spec-postgres.trigger :as trigger]))

(def +language+ :postgres)
(def +tag+ :postgres)
(def +version+ 3)

(def +grammar+
  (grammar/definition
   {:grammar/id +tag+
    :grammar/version +version+
    :grammar/release "foundation-v3-deftrigger"
    :grammar/language +language+
    :grammar/tag +tag+
    :grammar/engine {:minimum 1 :maximum 1}
    :grammar/parent
    {:grammar/id postgres-v2/+tag+
     :grammar/version postgres-v2/+version+}
    :operators
    {:define
     {:deftrigger
      {:op :deftrigger
       :symbol #{'deftrigger}
       :type :def
       :section :code
       :format trigger/pg-trigger-format
       :hydrate trigger/pg-trigger-hydrate
       :emit trigger/pg-trigger
       :static/dbtype :trigger}}}}))

(defn- install-source
  [catalog source]
  (if (registry/find catalog (grammar/source-coordinate source))
    catalog
    (registry/install catalog source)))

(defn install
  [catalog]
  (install-source (postgres-v2/install catalog) +grammar+))

(defn catalog
  []
  (install (registry/registry)))

(defn select
  ([]
   (select (catalog)))
  ([catalog]
   (registry/resolve catalog
                     {:grammar/id +tag+
                      :grammar/version +version+})))

(def +selection+ (select))

(def +book+
  {:lang +language+
   :parent :postgres
   :version +version+
   :coordinate (:coordinate +selection+)
   :grammar (:grammar +selection+)
   :selection +selection+})

(defn- version-installed?
  [version]
  (reduce (fn [found candidate]
            (or found (= version candidate)))
          false
          (core-registry/registry-book-versions :postgres :default)))

(def +registration+
  (do
    (if (not (version-installed? +version+))
      (core-registry/registry-book-add!
       :postgres
       :default
       +version+
       {:ns 'lang.model.v3.spec-postgres
        :book '+book+
        :parent :postgres}))
    (core-registry/registry-book-set-default!
     :postgres :default +version+)
    +version+))

(def +init+ +book+)
