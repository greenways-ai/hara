(ns lang.runtime.hara)

(defn set-path!
  "Associates value into a mutable XTalk reference and returns value."
  [reference path value]
  (swap! reference assoc-in path value)
  value)

(defn del-path
  "Returns collection without the value at path."
  [collection path]
  (let [path (vec path)]
    (cond
      (= 0 (count path)) nil
      (= 1 (count path)) (dissoc collection (first path))
      :else
      (let [head (first path)
            tail (vec (drop 1 path))
            child (get collection head)]
        (if (nil? child)
          collection
          (assoc collection head (del-path child tail)))))))

(defn del-path!
  "Deletes a path from a mutable XTalk reference and returns the previous value."
  [reference path]
  (let [previous (get-in (deref reference) path)]
    (swap! reference del-path path)
    previous))

(defn obj-assign!
  "Merges source maps into a mutable XTalk object and returns the new object."
  [reference & sources]
  (let [next (reduce merge (deref reference) sources)]
    (reset! reference next)
    next))

(defn arr-push!
  "Appends values to a mutable XTalk array and returns its new length."
  [reference & values]
  (let [next (reduce conj (vec (deref reference)) values)]
    (reset! reference next)
    (count next)))

(defn arr-pop!
  "Removes and returns the last value of a mutable XTalk array."
  [reference]
  (let [current (vec (deref reference))
        amount (count current)]
    (if (= 0 amount)
      nil
      (let [value (last current)
            next (vec (take (- amount 1) current))]
        (reset! reference next)
        value))))

(defn arr-push-first!
  "Prepends values to a mutable XTalk array and returns its new length."
  [reference & values]
  (let [next (vec (concat values (deref reference)))]
    (reset! reference next)
    (count next)))

(defn arr-pop-first!
  "Removes and returns the first value of a mutable XTalk array."
  [reference]
  (let [current (vec (deref reference))]
    (if (= 0 (count current))
      nil
      (let [value (first current)
            next (vec (drop 1 current))]
        (reset! reference next)
        value))))

(defn arr-remove!
  "Removes one value at index and returns a vector containing the removed value."
  [reference index]
  (let [current (vec (deref reference))
        amount (count current)]
    (if (or (< index 0) (>= index amount))
      []
      (let [value (nth current index)
            next (vec (concat (take index current)
                              (drop (+ index 1) current)))]
        (reset! reference next)
        [value]))))

(defn arr-insert!
  "Inserts value at index and returns an empty splice-result vector."
  [reference index value]
  (let [current (vec (deref reference))
        bounded (max 0 (min index (count current)))
        next (vec (concat (take bounded current)
                          [value]
                          (drop bounded current)))]
    (reset! reference next)
    []))

(defn arr-reverse!
  "Reverses a mutable XTalk array and returns the new array."
  [reference]
  (let [next (vec (reverse (deref reference)))]
    (reset! reference next)
    next))
