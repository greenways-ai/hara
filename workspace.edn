{:hara/type :workspace
 :hara/version "1.0.0"
 :workspace/id :hara-lang
 :workspace/layout
 {:layout/type :split
  :layout/direction :horizontal
  :layout/ratio 0.58
  :layout/first {:layout/type :area :layout/area "area/editor"}
  :layout/second {:layout/type :area :layout/area "area/output"}}
 :workspace/documents
 [{:document/id "document/welcome"
   :document/path "lib/examples/hello.hal"
   :document/language :hal}]
 :workspace/areas
 [{:area/id "area/editor"
   :area/type :code-editor
   :area/documents ["document/welcome"]}
  {:area/id "area/output"
   :area/type :output
   :area/canvas "canvas/output"}]
 :workspace/nodes []
 :workspace/connections []
 :workspace/links
 [{:link/id "link/welcome-output"
   :link/document "document/welcome"
   :link/area "area/output"}]
 :workspace/customizations
 {:theme :hara/dark
  :recovery/journal true}}
