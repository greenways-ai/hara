(ns hoplite.app)

(defn hello
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite" "true"}
   :body "Hello from Hoplite\n"})

(defn ^:async delayed
  [request]
  (std.foundation.coroutine/await
    (std.native.Host/call "nginx" "sleep" [25]))
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"
             "x-hoplite" "promise-resumed"}
   :body "Hara coroutine resumed from the Nginx event loop\n"})

(defn inspect
  [request]
  {:status 200
   :headers {"content-type" "text/plain; charset=utf-8"}
   :body "inspect"})
