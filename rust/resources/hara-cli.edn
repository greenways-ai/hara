{:document/id :hara/cli
 :document/type :hara/cli-application
 :document/version "0.1.0"
 :document/status :draft
 :document/title "Hara command-line application"
 :document/summary
 "Normative public route, option, handler and outcome contract shared by the Rust and Truffle Hara runtimes."

 :spec/conforms-to {:spec/id :hara/cli-app-metaspec
                    :spec/version "0.1.0"}

 :cli/apps
 [{:app/id :hara.cli/language
   :app/summary "Evaluate HAL and operate an interactive runtime."
   :app/routes [:hara.cli.route/eval :hara.cli.route/run-file
                :hara.cli.route/stdin :hara.cli.route/repl]}
  {:app/id :hara.cli/session
   :app/summary "Start or connect to Hara runtime sessions."
   :app/routes [:hara.cli.route/server :hara.cli.route/remote]}
  {:app/id :hara.cli/project
   :app/summary "Create, validate, execute, test and resolve Hara projects."
   :app/routes [:hara.cli.route/project-new :hara.cli.route/project-check
                :hara.cli.route/project-run :hara.cli.route/project-test
                :hara.cli.route/project-add :hara.cli.route/project-remove
                :hara.cli.route/project-sync :hara.cli.route/project-update]}
  {:app/id :hara.cli/package
   :app/summary "Build, inspect, install and publish deterministic Hara packages."
   :app/routes [:hara.cli.route/package :hara.cli.route/package-check
                :hara.cli.route/package-build :hara.cli.route/package-inspect
                :hara.cli.route/package-install :hara.cli.route/package-publish
                :hara.cli.route/package-tap :hara.cli.route/package-registry]}
  {:app/id :hara.cli/spec
   :app/summary "Lint, verify, convert and check machine-readable specifications."
   :app/routes [:hara.cli.route/spec :hara.cli.route/spec-lint
                :hara.cli.route/spec-verify :hara.cli.route/spec-validate
                :hara.cli.route/spec-template :hara.cli.route/spec-check-contribution
                :hara.cli.route/spec-check :hara.cli.route/spec-to-edn
                :hara.cli.route/spec-from-edn :hara.cli.route/spec-normalize
                :hara.cli.route/spec-graph :hara.cli.route/spec-obligations
                :hara.cli.route/spec-explain]}
  {:app/id :hara.cli/extension
   :app/summary "Validate, build, install and test Hara extension packages."
   :app/routes [:hara.cli.route/extension :hara.cli.route/extension-check
                :hara.cli.route/extension-build :hara.cli.route/extension-install
                :hara.cli.route/extension-test]}]

