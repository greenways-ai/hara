   :route/summary "Evaluate one HAL expression."
   :route/arguments [{:argument/id :hara.cli.argument/expression
                      :argument/cardinality :one
                      :argument/type :string}]
   :route/options [:hara.cli.option/project :hara.cli.option/offline
                   :hara.cli.option/allow-file :hara.cli.option/allow-net
                   :hara.cli.option/allow-process]
   :route/formats [:text]}
  {:route/id :hara.cli.route/run-file
   :route/path ["run"]
   :route/aliases []
