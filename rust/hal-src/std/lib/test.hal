(ns std.lib.test)

(defn config
  "Declares static test-runner configuration. The runner reads this form before evaluation."
  [options]
  nil)

(defn check
  "Returns a test result map."
  [name actual expected]
  {:name name
   :pass (= actual expected)
   :actual actual
   :expected expected})

(defmacro check-error
  "Returns a passing result if `form` throws, failing otherwise."
  [name form]
  `(std.lib.test/check ~name (try (do ~form false) (catch Throwable e# true)) true))

(defn passed?
  "True if a result map passed."
  [result]
  (:pass result))

(defn print-results
  "Prints the result vector so the runner can parse it."
  [results]
  (pr-str results))
