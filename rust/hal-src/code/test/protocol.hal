;; ============================================================================
;; code.test.protocol — compatibility aliases for the standard test contracts.
;;
;; Canonical protocol identities live under std.protocol.*. This namespace is
;; retained so the existing code.test implementation and downstream users can
;; migrate without creating a second, incompatible protocol set.
;; ============================================================================
(ns code.test.protocol
  (:require [std.protocol.itestregistry :as registry]
            [std.protocol.itestreporter :as reporter]
            [std.protocol.itestclock :as clock]
            [std.protocol.itesttimer :as timer]
            [std.protocol.itestcontrol :as control]
            [std.protocol.itestsession :as session]
            [std.protocol.imatch :as match]))

(def ITestRegistry registry/ITestRegistry)
(def registry-register registry/registry-register)
(def registry-remove registry/registry-remove)
(def registry-clear registry/registry-clear)
(def registry-facts registry/registry-facts)
(def registry-find registry/registry-find)

(def ITestReporter reporter/ITestReporter)
(def report-event reporter/report-event)

(def ITestClock clock/ITestClock)
(def now-ms clock/now-ms)

(def ITestTimer timer/ITestTimer)
(def timeout-promise timer/timeout-promise)
(def cancel-timeout timer/cancel-timeout)

(def ITestControl control/ITestControl)
(def cancelled? control/cancelled?)

(def ITestSession session/ITestSession)
(def session-run session/session-run)
(def session-cancel session/session-cancel)
(def session-status session/session-status)
(def session-results session/session-results)
(def session-close session/session-close)

;; Archived name retained for code.test matchers. New code should use IMatch.
(def IMatcher match/IMatch)
(def IMatch match/IMatch)
(def match-value match/match-value)
