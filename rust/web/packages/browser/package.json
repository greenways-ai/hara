{
  "name": "@hara-lang/browser",
  "version": "0.1.0",
  "description": "Embeddable Hara browser runtime and CDN loader",
  "license": "EPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/hara-wasm-vm/hara.d.ts",
      "import": "./dist/hara-wasm-vm/hara.mjs",
      "default": "./dist/hara-wasm-vm/hara.mjs"
    },
    "./vm": {
      "types": "./dist/hara-wasm-vm/hara.d.ts",
      "import": "./dist/hara-wasm-vm/hara.mjs",
      "default": "./dist/hara-wasm-vm/hara.mjs"
    },
    "./full": {
      "types": "./dist/hara-wasm-full/hara.d.ts",
      "import": "./dist/hara-wasm-full/hara.mjs",
      "default": "./dist/hara-wasm-full/hara.mjs"
    }
  },
  "unpkg": "./dist/hara-wasm-vm/hara.js",
  "jsdelivr": "./dist/hara-wasm-vm/hara.js",
  "files": [
    "dist/hara-wasm-vm",
    "dist/hara-wasm-full"
  ],
  "publishConfig": {
    "access": "public"
  }
}
