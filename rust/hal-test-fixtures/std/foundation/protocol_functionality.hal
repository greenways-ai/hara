;; Shared behavioral protocol contract for Rust and Truffle.
;; The surface-only contract remains in protocol_conformance.hal.
;; Host suites replace `unsupported` in each quoted failure form with receiver
;; candidates until the protocol rejects one with the normative category.
(ns user)

(defstruct ProtocolUseCase [state])
(defstruct UnsupportedUseCase [])

(defn use-case []
  (ProtocolUseCase
    (atom {:collection {:a 1 :b 2}
           :sequence [1 2 3]
           :cell (atom 10)
           :closed false
           :component-status :stopped
           :contexts {}
           :runtimes {}
           :hash-cache 0
           :meta {:source :fixture}
           :realized false
           :value 42
           :watches (atom [])})))

(defn state [fixture]
  (deref (field fixture :state)))

(defn state-get [fixture key]
  (get (state fixture) key))

(defn state-put [fixture key value]
  (do (std.protocol.ireset/reset
        (field fixture :state)
        (assoc (state fixture) key value))
      value))

(defn thrown? [f]
  (try
    (do (f) false)
    (catch Throwable error true)))

(defn result [protocol method success limit failure-form]
  {:protocol protocol
   :method method
   :success success
   :limit limit
   :limit-category :protocol/arity
   :failure :host-checked
   :failure-form failure-form
   :failure-category :protocol/unsupported-receiver
   :pass (if success limit false)})

(defn protocol-case [protocol method method-var success unsupported-form]
  (result protocol
          method
          success
          (thrown? (fn [] (method-var)))
          unsupported-form))

(extend-type ProtocolUseCase std.protocol.iapplicable/IApplicable
  (apply-default [fixture] (state-get fixture :value))
  (apply-in [fixture runtime args]
    (runtime (nth args 0) (nth args 1) (nth args 2)))
  (transform-in [fixture runtime args]
    (runtime (nth args 0) (nth args 1)))
  (transform-out [fixture runtime args value]
    (runtime (nth args 0) (nth args 1) value)))

(extend-type ProtocolUseCase std.protocol.iassoc/IAssoc
  (assoc [fixture key value] (assoc (state-get fixture :collection) key value)))

(extend-type ProtocolUseCase std.protocol.icas/ICas
  (cas [fixture old-value new-value]
    (std.protocol.icas/cas (state-get fixture :cell) old-value new-value)))

(extend-type ProtocolUseCase std.protocol.iclose/IClose
  (close [fixture] (do (state-put fixture :closed true) nil)))

(extend-type ProtocolUseCase std.protocol.icomponent/IComponent
  (props [fixture] {:name :component})
  (status [fixture] (state-get fixture :component-status))
  (started? [fixture] (= :started (state-get fixture :component-status)))
  (stopped? [fixture] (= :stopped (state-get fixture :component-status)))
  (start [fixture] (do (state-put fixture :component-status :started) fixture))
  (stop [fixture] (do (state-put fixture :component-status :stopped) fixture))
  (kill [fixture] (do (state-put fixture :component-status :killed) fixture))
  (remote? [fixture] false))

(extend-type ProtocolUseCase std.protocol.iconj/IConj
  (conj [fixture value] (conj (state-get fixture :sequence) value)))

(extend-type ProtocolUseCase std.protocol.icons/ICons
  (cons [fixture value] [value 1 2 3]))

(extend-type ProtocolUseCase std.protocol.icontext/IContext
  (call [fixture arg] [arg]))

(extend-type ProtocolUseCase std.protocol.icoroutine/ICoroutine
  (status [fixture] (state-get fixture :component-status))
  (resume [fixture arg] [arg]))

(extend-type ProtocolUseCase std.protocol.icontextlifecycle/IContextLifeCycle
  (has-module? [fixture module] (not (nil? (get (state-get fixture :contexts) module))))
  (setup-module [fixture module]
    (do (state-put fixture :contexts (assoc (state-get fixture :contexts) module :module))
        fixture))
  (teardown-module [fixture module]
    (do (state-put fixture :contexts (dissoc (state-get fixture :contexts) module))
        fixture))
  (has-pointer? [fixture pointer] (not (nil? (get (state-get fixture :contexts) pointer))))
  (setup-pointer [fixture pointer]
    (do (state-put fixture :contexts (assoc (state-get fixture :contexts) pointer :pointer))
        fixture))
  (teardown-pointer [fixture pointer]
    (do (state-put fixture :contexts (dissoc (state-get fixture :contexts) pointer))
        fixture)))

(extend-type ProtocolUseCase std.protocol.icount/ICount
  (count [fixture] (count (state-get fixture :sequence))))

(extend-type ProtocolUseCase std.protocol.ideref/IDeref
  (deref [fixture] (deref (state-get fixture :cell))))

(extend-type ProtocolUseCase std.protocol.idereftimeout/IDerefTimeout
  (deref-timeout [fixture milliseconds timeout-value]
    (if (neg? milliseconds) timeout-value (state-get fixture :value))))

(extend-type ProtocolUseCase std.protocol.idisplay/IDisplay
  (display [fixture] "<protocol-use-case>"))

(extend-type ProtocolUseCase std.protocol.idissoc/IDissoc
  (dissoc [fixture key] (dissoc (state-get fixture :collection) key)))

(extend-type ProtocolUseCase std.protocol.iempty/IEmpty
  (empty [fixture] []))

(extend-type ProtocolUseCase std.protocol.iequality/IEquality
  (equality [fixture other] (= (state-get fixture :value) other)))

(extend-type ProtocolUseCase std.protocol.iexinfo/IExInfo
  (data [fixture] {:kind :fixture-error}))

(extend-type ProtocolUseCase std.protocol.ifind/IFind
  (find [fixture key]
    (std.protocol.ifind/find (state-get fixture :collection) key)))

(extend-type ProtocolUseCase std.protocol.ifn/IFn
  (invoke [fixture arg] [arg]))

(extend-type ProtocolUseCase std.protocol.ihash/IHash
  (hash [fixture] (state-get fixture :value)))

(extend-type ProtocolUseCase std.protocol.ihashcached/IHashCached
  (hash-current [fixture] (state-get fixture :hash-cache))
  (hash-put [fixture value] (do (state-put fixture :hash-cache value) fixture)))

(extend-type ProtocolUseCase std.protocol.iindexed/IIndexed
  (index-of [fixture value]
    (if (= value 1) 0 (if (= value 2) 1 (if (= value 3) 2 nil)))))

(extend-type ProtocolUseCase std.protocol.iindexedkv/IIndexedKV
  (index-of-key [fixture key] (if (= key :a) 0 (if (= key :b) 1 -1)))
  (index-of-val [fixture value] (if (= value 1) 0 (if (= value 2) 1 -1))))

(extend-type ProtocolUseCase std.protocol.iinvokein/IInvokeIn
  (invoke-in [fixture context arg]
    (std.protocol.icontext/call context arg)))

(extend-type ProtocolUseCase std.protocol.iiter/IIter
  (iter [fixture] (std.protocol.iiter/iter (state-get fixture :sequence))))

(extend-type ProtocolUseCase std.protocol.iiterator/IIterator
  (iter-next? [fixture]
    (std.protocol.iiterator/iter-next? (state-get fixture :iterator)))
  (iter-next [fixture]
    (std.protocol.iiterator/iter-next (state-get fixture :iterator))))

(extend-type ProtocolUseCase std.protocol.ilookup/ILookup
  (lookup [fixture key]
    (get (state-get fixture :collection) key)))

(extend-type ProtocolUseCase std.protocol.inamespaced/INamespaced
  (name [fixture] "demo")
  (namespace [fixture] "std.protocol"))

(extend-type ProtocolUseCase std.protocol.inth/INth
  (nth [fixture index] (nth (state-get fixture :sequence) index)))

(extend-type ProtocolUseCase std.protocol.iobjtype/IObjType
  (meta [fixture] (state-get fixture :meta))
  (with-meta [fixture metadata] (do (state-put fixture :meta metadata) fixture)))

(extend-type ProtocolUseCase std.protocol.ipair/IPair
  (key [fixture] :a)
  (value [fixture] 1))

(extend-type ProtocolUseCase std.protocol.ipeekfirst/IPeekFirst
  (peek-first [fixture] (first (state-get fixture :sequence))))

(extend-type ProtocolUseCase std.protocol.ipeeklast/IPeekLast
  (peek-last [fixture] (nth (state-get fixture :sequence) 2)))

(extend-type ProtocolUseCase std.protocol.ipromise/IPromise
  (state [fixture] :fulfilled)
  (value [fixture] (state-get fixture :value))
  (then [fixture function] (function (state-get fixture :value)))
  (catch [fixture function] fixture)
  (finally [fixture function] (do (function) fixture))
  (cancel [fixture] (do (state-put fixture :component-status :cancelled) fixture)))

(extend-type ProtocolUseCase std.protocol.ipointer/IPointer
  (ptr-context [fixture] :runtime/demo)
  (ptr-keys [fixture] [:module :name])
  (ptr-val [fixture key] (get {:module :demo :name :value} key)))

(extend-type ProtocolUseCase std.protocol.ipopfirst/IPopFirst
  (pop-first [fixture] [2 3]))

(extend-type ProtocolUseCase std.protocol.ipoplast/IPopLast
  (pop-last [fixture] [1 2]))

(extend-type ProtocolUseCase std.protocol.ipushfirst/IPushFirst
  (push-first [fixture value] [value 1 2 3]))

(extend-type ProtocolUseCase std.protocol.ipushlast/IPushLast
  (push-last [fixture value] (conj (state-get fixture :sequence) value)))

(extend-type ProtocolUseCase std.protocol.irealize/IRealize
  (realized? [fixture] (state-get fixture :realized))
  (realize [fixture] (do (state-put fixture :realized true) (state-get fixture :value))))

;; IReduce is exercised against a native vector below because Rust currently
;; requires guest variadic implementations to use a fixed compatibility form.

(extend-type ProtocolUseCase std.protocol.ireset/IReset
  (reset [fixture value]
    (std.protocol.ireset/reset (state-get fixture :cell) value)))

(extend-type ProtocolUseCase std.protocol.ispace/ISpace
  (context-set [fixture context key options]
    (do (state-put fixture :contexts
                   (assoc (state-get fixture :contexts)
                          context
                          {:key key :options options}))
        fixture))
  (context-unset [fixture context]
    (do (state-put fixture :contexts (dissoc (state-get fixture :contexts) context))
        fixture))
  (context-list [fixture] (keys (state-get fixture :contexts)))
  (context-get [fixture context] (get (state-get fixture :contexts) context))
  (rt-active [fixture] (keys (state-get fixture :runtimes)))
  (rt-get [fixture context] (get (state-get fixture :runtimes) context))
  (rt-start [fixture context]
    (do (state-put fixture :runtimes
                   (assoc (state-get fixture :runtimes) context :started))
        :started))
  (rt-started? [fixture context]
    (= :started (get (state-get fixture :runtimes) context)))
  (rt-stopped? [fixture context]
    (not (= :started (get (state-get fixture :runtimes) context))))
  (rt-stop [fixture context]
    (do (state-put fixture :runtimes
                   (assoc (state-get fixture :runtimes) context :stopped))
        fixture)))

(extend-type ProtocolUseCase std.protocol.itomutable/IToMutable
  (to-mutable [fixture] (array 1 2 3)))

(extend-type ProtocolUseCase std.protocol.itopersistent/IToPersistent
  (to-persistent [fixture] [1 2 3]))

(extend-type ProtocolUseCase std.protocol.iwatch/IWatch
  (watch-add [fixture key function]
    (std.protocol.iwatch/watch-add (state-get fixture :cell) key function))
  (watch-remove [fixture key]
    (std.protocol.iwatch/watch-remove (state-get fixture :cell) key))
  (watch-list [fixture]
    (std.protocol.iwatch/watch-list (state-get fixture :cell))))

(let [unsupported (UnsupportedUseCase)]
  [(protocol-case :IApplicable :apply-default std.protocol.iapplicable/apply-default
     (= 42 (std.protocol.iapplicable/apply-default (use-case)))
     '(std.protocol.iapplicable/apply-default unsupported))
   (protocol-case :IApplicable :apply-in std.protocol.iapplicable/apply-in
     (= [1 2 3] (std.protocol.iapplicable/apply-in
                  (use-case) (fn [a b c] [a b c]) [1 2 3]))
     '(std.protocol.iapplicable/apply-in unsupported (fn [& xs] xs) [1]))
   (protocol-case :IApplicable :transform-in std.protocol.iapplicable/transform-in
     (= [2 3] (std.protocol.iapplicable/transform-in
                (use-case) (fn [a b] [a b]) [2 3]))
     '(std.protocol.iapplicable/transform-in unsupported (fn [& xs] xs) [2]))
   (protocol-case :IApplicable :transform-out std.protocol.iapplicable/transform-out
     (= [1 2 3] (std.protocol.iapplicable/transform-out
                  (use-case) (fn [a b c] [a b c]) [1 2] 3))
     '(std.protocol.iapplicable/transform-out unsupported (fn [& xs] xs) [1] 2))

   (protocol-case :IAssoc :assoc std.protocol.iassoc/assoc
     (= {:a 1 :b 2 :c 3}
        (std.protocol.iassoc/assoc (use-case) :c 3))
     '(std.protocol.iassoc/assoc unsupported :c 3))

   (protocol-case :ICas :cas std.protocol.icas/cas
     (= [true 11]
        (let [fixture (use-case)]
          [(std.protocol.icas/cas fixture 10 11)
           (deref (state-get fixture :cell))]))
     '(std.protocol.icas/cas unsupported 10 11))

   (protocol-case :IClose :close std.protocol.iclose/close
     (= true
        (let [fixture (use-case)]
          (std.protocol.iclose/close fixture)
          (state-get fixture :closed)))
     '(std.protocol.iclose/close unsupported))

   (protocol-case :IComponent :props std.protocol.icomponent/props
     (= {:name :component} (std.protocol.icomponent/props (use-case)))
     '(std.protocol.icomponent/props unsupported))
   (protocol-case :IComponent :status std.protocol.icomponent/status
     (= :stopped (std.protocol.icomponent/status (use-case)))
     '(std.protocol.icomponent/status unsupported))
   (protocol-case :IComponent :started? std.protocol.icomponent/started?
     (= true
        (let [fixture (use-case)]
          (std.protocol.icomponent/start fixture)
          (std.protocol.icomponent/started? fixture)))
     '(std.protocol.icomponent/started? unsupported))
   (protocol-case :IComponent :stopped? std.protocol.icomponent/stopped?
     (= true (std.protocol.icomponent/stopped? (use-case)))
     '(std.protocol.icomponent/stopped? unsupported))
   (protocol-case :IComponent :start std.protocol.icomponent/start
     (= :started
        (let [fixture (use-case)]
          (std.protocol.icomponent/start fixture)
          (state-get fixture :component-status)))
     '(std.protocol.icomponent/start unsupported))
   (protocol-case :IComponent :stop std.protocol.icomponent/stop
     (= :stopped
        (let [fixture (use-case)]
          (std.protocol.icomponent/start fixture)
          (std.protocol.icomponent/stop fixture)
          (state-get fixture :component-status)))
     '(std.protocol.icomponent/stop unsupported))
   (protocol-case :IComponent :kill std.protocol.icomponent/kill
     (= :killed
        (let [fixture (use-case)]
          (std.protocol.icomponent/kill fixture)
          (state-get fixture :component-status)))
     '(std.protocol.icomponent/kill unsupported))
   (protocol-case :IComponent :remote? std.protocol.icomponent/remote?
     (= false (std.protocol.icomponent/remote? (use-case)))
     '(std.protocol.icomponent/remote? unsupported))

   (protocol-case :IConj :conj std.protocol.iconj/conj
     (= [1 2 3 4] (std.protocol.iconj/conj (use-case) 4))
     '(std.protocol.iconj/conj unsupported 4))

   (protocol-case :ICons :cons std.protocol.icons/cons
     (= [0 1 2 3] (std.protocol.icons/cons (use-case) 0))
     '(std.protocol.icons/cons unsupported 0))

   (protocol-case :IContext :call std.protocol.icontext/call
     (= [1] (std.protocol.icontext/call (use-case) 1))
     '(std.protocol.icontext/call unsupported 1))

   (protocol-case :ICoroutine :status std.protocol.icoroutine/status
     (= :stopped (std.protocol.icoroutine/status (use-case)))
     '(std.protocol.icoroutine/status unsupported))
   (protocol-case :ICoroutine :resume std.protocol.icoroutine/resume
     (= [:input] (std.protocol.icoroutine/resume (use-case) :input))
     '(std.protocol.icoroutine/resume unsupported :input))

   (protocol-case :IContextLifeCycle :has-module? std.protocol.icontextlifecycle/has-module?
     (= false (std.protocol.icontextlifecycle/has-module? (use-case) :demo))
     '(std.protocol.icontextlifecycle/has-module? unsupported :demo))
   (protocol-case :IContextLifeCycle :setup-module std.protocol.icontextlifecycle/setup-module
     (= true
        (let [fixture (use-case)]
          (std.protocol.icontextlifecycle/setup-module fixture :demo)
          (std.protocol.icontextlifecycle/has-module? fixture :demo)))
     '(std.protocol.icontextlifecycle/setup-module unsupported :demo))
   (protocol-case :IContextLifeCycle :teardown-module std.protocol.icontextlifecycle/teardown-module
     (= false
        (let [fixture (use-case)]
          (std.protocol.icontextlifecycle/setup-module fixture :demo)
          (std.protocol.icontextlifecycle/teardown-module fixture :demo)
          (std.protocol.icontextlifecycle/has-module? fixture :demo)))
     '(std.protocol.icontextlifecycle/teardown-module unsupported :demo))
   (protocol-case :IContextLifeCycle :has-pointer? std.protocol.icontextlifecycle/has-pointer?
     (= false (std.protocol.icontextlifecycle/has-pointer? (use-case) :pointer))
     '(std.protocol.icontextlifecycle/has-pointer? unsupported :pointer))
   (protocol-case :IContextLifeCycle :setup-pointer std.protocol.icontextlifecycle/setup-pointer
     (= true
        (let [fixture (use-case)]
          (std.protocol.icontextlifecycle/setup-pointer fixture :pointer)
          (std.protocol.icontextlifecycle/has-pointer? fixture :pointer)))
     '(std.protocol.icontextlifecycle/setup-pointer unsupported :pointer))
   (protocol-case :IContextLifeCycle :teardown-pointer std.protocol.icontextlifecycle/teardown-pointer
     (= false
        (let [fixture (use-case)]
          (std.protocol.icontextlifecycle/setup-pointer fixture :pointer)
          (std.protocol.icontextlifecycle/teardown-pointer fixture :pointer)
          (std.protocol.icontextlifecycle/has-pointer? fixture :pointer)))
     '(std.protocol.icontextlifecycle/teardown-pointer unsupported :pointer))

   (protocol-case :ICount :count std.protocol.icount/count
     (= 3 (std.protocol.icount/count (use-case)))
     '(std.protocol.icount/count unsupported))

   (protocol-case :IDeref :deref std.protocol.ideref/deref
     (= 10 (std.protocol.ideref/deref (atom 10)))
     '(std.protocol.ideref/deref unsupported))

   (protocol-case :IDerefTimeout :deref-timeout std.protocol.idereftimeout/deref-timeout
     (= :timeout (std.protocol.idereftimeout/deref-timeout (use-case) -1 :timeout))
     '(std.protocol.idereftimeout/deref-timeout unsupported 0 :timeout))

   (protocol-case :IDisplay :display std.protocol.idisplay/display
     (= "<protocol-use-case>" (std.protocol.idisplay/display (use-case)))
     '(std.protocol.idisplay/display unsupported))

   (protocol-case :IDissoc :dissoc std.protocol.idissoc/dissoc
     (= {:b 2} (std.protocol.idissoc/dissoc (use-case) :a))
     '(std.protocol.idissoc/dissoc unsupported :a))

   (protocol-case :IEmpty :empty std.protocol.iempty/empty
     (= [] (std.protocol.iempty/empty (use-case)))
     '(std.protocol.iempty/empty unsupported))

   (protocol-case :IEquality :equality std.protocol.iequality/equality
     (= true (std.protocol.iequality/equality (use-case) 42))
     '(std.protocol.iequality/equality unsupported 42))

   (protocol-case :IExInfo :data std.protocol.iexinfo/data
     (= {:kind :fixture-error} (std.protocol.iexinfo/data (use-case)))
     '(std.protocol.iexinfo/data unsupported))

   (protocol-case :IFind :find std.protocol.ifind/find
     (= 1
        (std.protocol.ipair/value
          (std.protocol.ifind/find (use-case) :a)))
     '(std.protocol.ifind/find unsupported :a))

   (protocol-case :IFn :invoke std.protocol.ifn/invoke
     (= [1] (std.protocol.ifn/invoke (use-case) 1))
     '(std.protocol.ifn/invoke unsupported 1))

   (protocol-case :IHash :hash std.protocol.ihash/hash
     (= 42 (std.protocol.ihash/hash (use-case)))
     '(std.protocol.ihash/hash unsupported))

   (protocol-case :IHashCached :hash-current std.protocol.ihashcached/hash-current
     (= 0 (std.protocol.ihashcached/hash-current (use-case)))
     '(std.protocol.ihashcached/hash-current unsupported))
   (protocol-case :IHashCached :hash-put std.protocol.ihashcached/hash-put
     (= 99
        (let [fixture (use-case)]
          (std.protocol.ihashcached/hash-put fixture 99)
          (std.protocol.ihashcached/hash-current fixture)))
     '(std.protocol.ihashcached/hash-put unsupported 99))

   (protocol-case :IIndexed :index-of std.protocol.iindexed/index-of
     (= 1 (std.protocol.iindexed/index-of (use-case) 2))
     '(std.protocol.iindexed/index-of unsupported 2))

   (protocol-case :IIndexedKV :index-of-key std.protocol.iindexedkv/index-of-key
     (= 1 (std.protocol.iindexedkv/index-of-key (use-case) :b))
     '(std.protocol.iindexedkv/index-of-key unsupported :b))
   (protocol-case :IIndexedKV :index-of-val std.protocol.iindexedkv/index-of-val
     (= 0 (std.protocol.iindexedkv/index-of-val (use-case) 1))
     '(std.protocol.iindexedkv/index-of-val unsupported 1))

   (protocol-case :IInvokeIn :invoke-in std.protocol.iinvokein/invoke-in
     (= [1] (std.protocol.iinvokein/invoke-in (use-case) (use-case) 1))
     '(std.protocol.iinvokein/invoke-in unsupported (use-case) 1))

   (protocol-case :IIter :iter std.protocol.iiter/iter
     (= 1
        (std.protocol.iiterator/iter-next
          (std.protocol.iiter/iter (use-case))))
     '(std.protocol.iiter/iter unsupported))

   (protocol-case :IIterator :iter-next? std.protocol.iiterator/iter-next?
     (= true
        (let [fixture (use-case)]
          (state-put fixture :iterator (std.protocol.iiter/iter [1]))
          (std.protocol.iiterator/iter-next? fixture)))
     '(std.protocol.iiterator/iter-next? unsupported))
   (protocol-case :IIterator :iter-next std.protocol.iiterator/iter-next
     (= 1
        (let [fixture (use-case)]
          (state-put fixture :iterator (std.protocol.iiter/iter [1]))
          (std.protocol.iiterator/iter-next fixture)))
     '(std.protocol.iiterator/iter-next unsupported))

   (protocol-case :ILookup :lookup std.protocol.ilookup/lookup
     (= 1 (std.protocol.ilookup/lookup (use-case) :a))
     '(std.protocol.ilookup/lookup unsupported :a))

   (protocol-case :INamespaced :name std.protocol.inamespaced/name
     (= "demo" (std.protocol.inamespaced/name (use-case)))
     '(std.protocol.inamespaced/name unsupported))
   (protocol-case :INamespaced :namespace std.protocol.inamespaced/namespace
     (= "std.protocol" (std.protocol.inamespaced/namespace (use-case)))
     '(std.protocol.inamespaced/namespace unsupported))

   (protocol-case :INth :nth std.protocol.inth/nth
     (= 2 (std.protocol.inth/nth (use-case) 1))
     '(std.protocol.inth/nth unsupported 1))

   (protocol-case :IObjType :meta std.protocol.iobjtype/meta
     (= {:source :fixture} (std.protocol.iobjtype/meta (use-case)))
     '(std.protocol.iobjtype/meta unsupported))
   (protocol-case :IObjType :with-meta std.protocol.iobjtype/with-meta
     (= {:source :updated}
        (let [fixture (use-case)]
          (std.protocol.iobjtype/with-meta fixture {:source :updated})
          (std.protocol.iobjtype/meta fixture)))
     '(std.protocol.iobjtype/with-meta unsupported {:source :updated}))

   (protocol-case :IPair :key std.protocol.ipair/key
     (= :a (std.protocol.ipair/key (use-case)))
     '(std.protocol.ipair/key unsupported))
   (protocol-case :IPair :value std.protocol.ipair/value
     (= 1 (std.protocol.ipair/value (use-case)))
     '(std.protocol.ipair/value unsupported))

   (protocol-case :IPeekFirst :peek-first std.protocol.ipeekfirst/peek-first
     (= 1 (std.protocol.ipeekfirst/peek-first (use-case)))
     '(std.protocol.ipeekfirst/peek-first unsupported))
   (protocol-case :IPeekLast :peek-last std.protocol.ipeeklast/peek-last
     (= 3 (std.protocol.ipeeklast/peek-last (use-case)))
     '(std.protocol.ipeeklast/peek-last unsupported))

   (protocol-case :IPromise :state std.protocol.ipromise/state
     (= :fulfilled (std.protocol.ipromise/state (use-case)))
     '(std.protocol.ipromise/state unsupported))
   (protocol-case :IPromise :value std.protocol.ipromise/value
     (= 42 (std.protocol.ipromise/value (use-case)))
     '(std.protocol.ipromise/value unsupported))
