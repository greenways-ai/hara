(ns code.test.base.listener)

(defn result-function [result] (:function result))
(defn result-name [result] (:name result))
(defn summarise-verify [result] (if (:pass result) :success :failed))
(defn summarise-evaluate [result] (:status result))
(defn form-printer [result] result)
(defn check-printer [result] result)
(defn form-error-accumulator [result] result)
(defn check-error-accumulator [result] result)
(defn fact-printer [result] result)
(defn fact-accumulator [result] result)
(defn bulk-printer [result] result)
(defn install-listeners [] {})
