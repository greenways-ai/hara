(ns tahto.protocol.book)

(defprotocol IBook
  (book-module [book module-id])
  (book-modules [book]))

(defprotocol IModule
  (module-id [module])
  (module-link [module])
  (module-entry [module section entry-id])
  (module-includes [module])
  (module-native-import [module local-symbol]))

(defprotocol IEntry
  (entry-id [entry])
  (entry-module [entry])
  (entry-section [entry])
  (entry-op-key [entry])
  (entry-form [entry])
  (entry-template [entry])
  (entry-standalone [entry]))
