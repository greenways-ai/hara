(ns tahto.core.runtime
  (:require [tahto.core.registry :as registry]))

(def +language-registry+ (atom {}))
(def +type-registry+ (atom {}))

(defn install-lang!
  "Installs a language into the portable Tahto runtime registry."
  ([language]
   (install-lang! language {}))
  ([language options]
   (let [entry (merge {:lang language
                       :book-key :default}
                      options)]
     (swap! +language-registry+ assoc language entry)
     entry)))

(defn install-type!
  "Installs one runtime type for a language.

   This keeps the Foundation [language runtime] coordinate and constructor
   shape while replacing JVM resource specs with portable immutable data."
  [language runtime spec]
  (let [entry (merge {:lang language
                      :runtime runtime}
                     spec)]
    (swap! +type-registry+ assoc [language runtime] entry)
    entry))

(defn language-info
  [language]
  (get @+language-registry+ language))

(defn runtime-installed?
  [language runtime]
  (boolean (get @+type-registry+ [language runtime])))

(defn available-runtimes
  [language]
  (reduce (fn [out coordinate]
            (if (= language (first coordinate))
              (conj out (second coordinate))
              out))
          []
          (keys @+type-registry+)))

(defn require-runtime!
  "Loads the implementation registered for [language runtime]."
  [language runtime]
  (or (registry/registry-runtime language runtime)
      (throw
       (ex-info "Runtime is not registered"
                {:lang language
                 :runtime runtime
                 :available (registry/registry-list)}))))

(defn runtime-spec
  "Returns an installed runtime type, loading its implementation lazily."
  [language runtime]
  (require-runtime! language runtime)
  (or (get @+type-registry+ [language runtime])
      (throw
       (ex-info "Runtime implementation did not install its type"
                {:lang language
                 :runtime runtime
                 :namespace (registry/registry-runtime-ns language runtime)}))))

(defn rt-create
  "Creates a runtime from its Foundation [language runtime] coordinate."
  ([language runtime]
   (rt-create language runtime {}))
  ([language runtime options]
   (let [spec (runtime-spec language runtime)
         create-fn (get-in spec [:instance :create])
         config (merge (:config spec)
                       options
                       {:lang language
                        :runtime runtime})]
     (if create-fn
       (create-fn config)
       (throw
        (ex-info "Runtime type has no constructor"
                 {:lang language
                  :runtime runtime
                  :spec spec}))))))

(defn- instance-fn
  [runtime key]
  (let [spec (runtime-spec (:lang runtime) (:runtime runtime))]
    (get-in spec [:instance key])))

(defn rt-start
  [runtime]
  (if-let [start-fn (instance-fn runtime :start)]
    (start-fn runtime)
    runtime))

(defn rt-stop
  [runtime]
  (if-let [stop-fn (instance-fn runtime :stop)]
    (stop-fn runtime)
    runtime))

(defn rt-raw-eval
  "Evaluates already-emitted target source through a Tahto runtime."
  [runtime source]
  (if-let [raw-eval (instance-fn runtime :raw-eval)]
    (raw-eval runtime source)
    (throw
     (ex-info "Runtime type has no raw evaluator"
              {:lang (:lang runtime)
               :runtime (:runtime runtime)}))))

(defn bootstrap!
  "Bootstraps the first Foundation-compatible Tahto runtime slice.

   Books and runtime implementations are loaded separately, matching
   Foundation. The initial supported languages are :js and :python and the
   installed runtime types are :oneshot and :basic."
  ([]
   (bootstrap! {:languages [:js :python]
                :runtimes [:oneshot :basic]
                :version 1}))
  ([{:keys [languages runtimes version]
     :or {languages [:js :python]
          runtimes [:oneshot :basic]
          version 1}}]
   (let [books
         (reduce (fn [out language]
                   (let [book (registry/registry-book language :default version)]
                     (install-lang! language {:version version
                                              :book book})
                     (assoc out language book)))
                 {}
                 languages)]
     (doseq [language languages
             runtime runtimes]
       (require-runtime! language runtime))
     {:version version
      :books books
      :languages @+language-registry+
      :runtimes @+type-registry+})))
