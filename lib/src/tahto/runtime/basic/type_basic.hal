(ns tahto.runtime.basic.type-basic
  (:require [tahto.runtime.basic.type-oneshot :as oneshot]))

(defstruct RuntimeBasic [id lang runtime program exec process state])

(defn- default-id
  [language]
  (keyword (str (name language) ".basic")))

(defn rt-basic:create
  "Creates the Foundation-shaped basic runtime.

   The registry and lifecycle are now in Tahto. Until Hara exposes incremental
   child-process streams, evaluation uses the installed oneshot transport and
   records that compatibility boundary explicitly in :process."
  [options]
  (let [id (get options :id)
        lang (get options :lang)
        runtime (or (get options :runtime) :basic)
        exec (get options :exec)
        program (get options :program)
        process (get options :process)
        [program process exec]
        (oneshot/rt-oneshot-setup lang program process exec runtime)
        process (merge process
                       {:transport :oneshot-bootstrap
                        :persistent false})]
    (tahto.runtime.basic.type-basic/RuntimeBasic
     (or id (default-id lang))
     lang
     runtime
     program
     exec
     process
     (atom {:status :created
            :transport (get process :transport)}))))

(defn start-basic
  [runtime]
  (reset! (get runtime :state)
          {:status :started
           :transport (get-in runtime [:process :transport])})
  runtime)

(defn stop-basic
  [runtime]
  (reset! (get runtime :state)
          {:status :stopped
           :transport (get-in runtime [:process :transport])})
  runtime)

(defn basic-state
  [runtime]
  (deref (get runtime :state)))

(defn raw-eval-basic
  [runtime source]
  (if (= :started (get (basic-state runtime) :status))
    (oneshot/raw-eval-oneshot runtime source)
    (throw
     (ex-info "Basic runtime is not started"
              {:id (get runtime :id)
               :lang (get runtime :lang)
               :state (basic-state runtime)}))))

(defn rt-basic
  "Creates and starts a basic runtime, matching Foundation's public function."
  [options]
  (start-basic (rt-basic:create options)))
