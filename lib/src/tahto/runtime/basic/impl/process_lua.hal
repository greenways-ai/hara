(ns tahto.runtime.basic.impl.process-lua
  (:require [tahto.core.runtime :as runtime]
            [tahto.runtime.basic.type-basic :as basic]
            [tahto.runtime.basic.type-common :as common]
            [tahto.runtime.basic.type-oneshot :as oneshot]))

(def +lua-init+
  (common/put-program-options
   :lua
   {:default {:oneshot :lua :basic :lua}
    :env {:lua {:exec "lua"
                :extension "lua"
                :flags {:oneshot ["-e"] :basic ["-e"]}}}}))

(def +lua-oneshot-config+
  (common/set-context-options
   [:lua :oneshot :default]
   {:main {} :emit {} :json :full}))

(def +lua-basic-config+
  (common/set-context-options
   [:lua :basic :default]
   {:main {} :emit {} :json :full :timeout 2000
    :transport :process-socket}))

(def +lua-oneshot+
  (runtime/install-type!
   :lua :oneshot
   {:type :tahto/rt.oneshot
    :instance {:create oneshot/rt-oneshot:create
               :raw-eval oneshot/raw-eval-oneshot}}))

(def +lua-basic+
  (runtime/install-type!
   :lua :basic
   {:type :tahto/rt.basic
    :config {:layout :full}
    :instance {:create basic/rt-basic:create
               :start basic/start-basic
               :stop basic/stop-basic
               :raw-eval basic/raw-eval-basic}}))

(def +init+
  {:lang :lua :program +lua-init+
   :oneshot +lua-oneshot+ :basic +lua-basic+})
