(ns tahto.core
  (:require [tahto.common.book-entry :as entry]
            [tahto.common.book-meta :as meta]
            [tahto.common.grammar :as grammar]
            [tahto.common.preprocess-input :as input]
            [tahto.common.preprocess-resolve :as resolve]
            [tahto.common.preprocess-staging :as staging]
            [tahto.common.preprocess-value :as value]))

(def book-entry entry/book-entry)
(def book-entry? entry/book-entry?)
(def book-meta meta/book-meta)
(def book-meta? meta/book-meta?)
(def grammar grammar/grammar)
(def grammar-build grammar/build)
(def grammar-to-reserved grammar/to-reserved)
(def to-input input/to-input)
(def to-input-form input/to-input-form)
(def to-resolve staging/to-resolve)
(def to-staging staging/to-staging)
(def get-fragment resolve/get-fragment)
(def value-standalone value/value-standalone)
