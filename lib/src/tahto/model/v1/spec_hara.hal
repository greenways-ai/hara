(ns tahto.model.v1.spec-hara
  (:require [tahto.common.grammar-api :as grammar]
            [tahto.common.registry :as registry]
            [tahto.core.registry :as core-registry]
            [tahto.model.v1.spec-xtalk :as xtalk]
            [tahto.model.v1.spec-hara.emit]))

(def +language+ :hara)
(def +tag+ :hara)
(def +version+ 1)

(def +grammar+
  (grammar/definition
   {:grammar/id +tag+
    :grammar/version +version+
    :grammar/release "self-host-v1"
    :grammar/language +language+
    :grammar/tag +tag+
    :grammar/engine {:minimum 1 :maximum 1}
    :grammar/parent
    {:grammar/id xtalk/+tag+
     :grammar/version xtalk/+version+}
    :grammar/rewrite
    {:target
     {:append
      ['tahto.model.v1.spec-hara.emit/rewrite-hara-source]}}}))

(defn- install-source
  [catalog source]
  (if (registry/find catalog (grammar/source-coordinate source))
    catalog
    (registry/install catalog source)))

(defn install
  "Installs the concrete self-hosted Hara target over abstract XTalk."
  [catalog]
  (install-source (xtalk/install catalog) +grammar+))

(defn catalog
  []
  (install (registry/registry)))

(defn select
  "Resolves the Hara target grammar using language and tag :hara."
  ([]
   (select (catalog)))
  ([catalog]
   (registry/resolve catalog
                     {:grammar/id +tag+
                      :grammar/version +version+})))

(def +selection+ (select))

(def +book+
  {:lang +language+
   :parent :xtalk
   :version +version+
   :coordinate (:coordinate +selection+)
   :grammar (:grammar +selection+)
   :selection +selection+})

(def +book-registration+
  (if (core-registry/registry-book-info :hara)
    (core-registry/registry-book-info :hara)
    (core-registry/registry-book-add!
     :hara
     +version+
     {:ns 'tahto.model.v1.spec-hara
      :book '+book+
      :parent :xtalk})))

(def +runtime-registration+
  [(core-registry/registry-add!
    :hara :basic
    'tahto.runtime.basic.impl.runtime-hara)
   (core-registry/registry-add!
    :xtalk :basic
    'tahto.runtime.basic.impl.runtime-hara)])

(defmacro !.hara
  "Compiles XTalk through the :hara target and evaluates it in-process."
  [& body]
  (list 'tahto.core.script/eval-form!
        :hara
        (list 'quote
              (if (= 1 (count body))
                (first body)
                (apply list 'do body)))))

(def +init+ +book+)
