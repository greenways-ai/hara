(ns tahto.model.v1.spec-postgres.deftype.common
  (:require [std.foundation.string :as string]))

(def +type-alias+
  {:map :jsonb
   :array :jsonb
   :long :bigint
   :enum :text
   :image :jsonb
   :time :bigint})

(defn pg-type-alias
  [value]
  (or (get +type-alias+ value) value))

(defn- letter-upper?
  [value]
  (and (= value (string/upper value))
       (not (= value (string/lower value)))))

(defn- letter-lower?
  [value]
  (and (= value (string/lower value))
       (not (= value (string/upper value)))))

(defn snake-name
  "Converts Foundation identifiers to deterministic PostgreSQL snake case."
  [value]
  (let [raw (string/replace (name value) "-" "_")
        size (string/length raw)]
    (loop [index 0
           output ""]
      (if (= index size)
        (string/lower output)
        (let [character (string/char-at raw index)
              previous (if (> index 0)
                         (string/char-at raw (- index 1))
                         "")
              following (if (< (+ index 1) size)
                          (string/char-at raw (+ index 1))
                          "")
              boundary
              (and (> index 0)
                   (letter-upper? character)
                   (not (= previous "_"))
                   (or (not (letter-upper? previous))
                       (letter-lower? following)))]
          (recur (+ index 1)
                 (str output
                      (if boundary "_" "")
                      character)))))))

(defn identifier-value
  [value]
  (cond (keyword? value) (name value)
        (symbol? value) (name value)
        :else (str value)))

(defn quote-identifier
  [value]
  (str "\""
       (string/replace (identifier-value value) "\"" "\"\"")
       "\""))

(defn qualified-token
  "Emits the historical quoted PostgreSQL identifier coordinate without
   renaming the declared table or type."
  [schema value]
  (if schema
    (str (quote-identifier schema) "." (quote-identifier value))
    (quote-identifier value)))

(defn pg-type-part
  [value]
  (cond (keyword? value) (string/upper (string/replace (name value) "-" " "))
        (symbol? value) (string/upper (string/replace (name value) "-" " "))
        (string? value) (string/upper value)
        :else (str value)))

(defn pg-type-output
  [value]
  (cond
    (vector? value)
    (if (= 0 (count value))
      "[]"
      (let [base (pg-type-part (first value))
            arguments (vec (rest value))]
        (if (= 0 (count arguments))
          base
          (str base "(" (string/join "," (map str arguments)) ")"))))

    :else
    (pg-type-part (pg-type-alias value))))

(defn normalize-params
  [value]
  (cond (map? value) value
        (and (sequential? value)
             (= 1 (count value))
             (map? (first value)))
        (first value)
        (nil? value) {}
        :else
        (throw (ex-info "PostgreSQL deftype parameters must be a map"
                        {:parameters value}))))

(defn column-pairs
  [spec]
  (if (not (= 0 (mod (count spec) 2)))
    (throw (ex-info "PostgreSQL deftype column specification must contain pairs"
                    {:spec spec}))
    (vec
     (map (fn [pair]
            (let [column (first pair)
                  attributes (second pair)]
              (if (not (map? attributes))
                (throw (ex-info "PostgreSQL deftype column attributes must be a map"
                                {:column column
                                 :attributes attributes}))
                [column attributes])))
          (partition 2 spec)))))

(defn- generated-expression
  [attributes]
  (let [generated (:generated attributes)]
    (if (and (= :enum (:type attributes))
             (get-in attributes [:enum :ns]))
      (list '++ generated (get-in attributes [:enum :ns]))
      generated)))

(defn normalize-column
  [column attributes index]
  (let [attributes
        (if (contains? attributes :generated)
          (-> attributes
              (dissoc :generated)
              (assoc :ignore true)
              (assoc-in [:sql :generated]
                        (generated-expression attributes)))
          attributes)
        type (:type attributes)]
    (if (nil? type)
      (throw (ex-info "PostgreSQL deftype column type is required"
                      {:column column
                       :attributes attributes}))
      {:column column
       :attributes attributes
       :priority (or (:priority attributes) 50)
       :index index})))

(defn normalize-columns
  [spec]
  (loop [index 0
         remaining (column-pairs spec)
         output []]
    (if (= 0 (count remaining))
      (vec
       (map (fn [entry]
              [(:column entry) (:attributes entry)])
            (sort-by (fn [entry]
                       [(:priority entry) (:index entry)])
                     output)))
      (let [pair (first remaining)]
        (recur (+ index 1)
               (vec (rest remaining))
               (conj output
                     (normalize-column (first pair)
                                       (second pair)
                                       index)))))))

(defn normalize-columns-preserve
  [spec]
  (loop [index 0
         remaining (column-pairs spec)
         output []]
    (if (= 0 (count remaining))
      (vec (map (fn [entry]
                  [(:column entry) (:attributes entry)])
                output))
      (let [pair (first remaining)]
        (recur (+ index 1)
               (vec (rest remaining))
               (conj output
                     (normalize-column (first pair)
                                       (second pair)
                                       index)))))))

(defn- deep-merge
  [left right]
  (reduce-kv
   (fn [output key value]
     (let [existing (get output key)]
       (assoc output key
              (if (and (map? existing) (map? value))
                (deep-merge existing value)
                value))))
   (or left {})
   (or right {})))

(declare target-link linked-entry linked-entry-form)

(defn resolve-optional
  [qualified]
  (or (resolve qualified)
      (try
        (requiring-resolve qualified)
        (catch Throwable error nil))))

(defn- fragment-entry-value
  [target context]
  (let [link (target-link target context)
        entry (if link (linked-entry context link) nil)
        form (if entry (linked-entry-form entry) nil)]
    (cond
      (and form (= 'def (first form)))
      (nth form 2)

      entry
      (throw
       (ex-info "Portable PostgreSQL fragment entry must be a def"
                {:target target
                 :entry entry
                 :form form}))

      :else nil)))

(defn fragment-spec
  "Resolves one historical prepend/append/raw descriptor into flat column data.
   Module aliases are resolved through the portable Tahto module registry."
  [descriptor context]
  (let [descriptor-value (if (vector? descriptor) descriptor [descriptor])
        target (first descriptor-value)
        overrides (if (> (count descriptor-value) 1)
                    (apply hash-map (rest descriptor-value))
                    {})
        link (if (symbol? target) (target-link target context) nil)
        module-value (if (symbol? target)
                       (fragment-entry-value target context)
                       nil)
        host-target (if link
                      (symbol (str (:module link)) (name (:id link)))
                      target)
        resolved (if (and (symbol? host-target) (nil? module-value))
                   (resolve-optional host-target)
                   nil)
        value (cond module-value module-value
                    resolved (deref resolved)
                    (and (vector? descriptor)
                         (not (symbol? target))) descriptor
                    :else
                    (throw
                     (ex-info "Portable PostgreSQL column fragment is unresolved"
                              {:descriptor descriptor})))
        pairs (column-pairs value)]
    (vec
     (mapcat
      (fn [pair]
        (let [column (first pair)
              attributes (second pair)
              override (get overrides column)]
          [column
           (if override
             (deep-merge attributes override)
             attributes)]))
      pairs))))

(defn expand-fragments
  [descriptors context]
  (vec
   (mapcat (fn [descriptor]
             (fragment-spec descriptor context))
           (cond (nil? descriptors) []
                 (vector? descriptors) descriptors
                 :else [descriptors]))))

(defn module-static
  [module]
  (let [static (or (:static module) {})
        schemas (or (get-in static [:all :schema]) [])
        schema (or (if (> (count schemas) 0) (first schemas) nil)
                   (let [direct (:schema module)]
                     (if (or (string? direct)
                             (symbol? direct)
                             (keyword? direct))
                       direct
                       nil)))
        application (or (:application module)
                        (:application static))
        output {}
        output (if schema
                 (assoc output :static/schema schema)
                 output)
        output (if application
                 (assoc output :static/application application)
                 output)]
    output))

(defn target-symbol
  [value]
  (cond (symbol? value) value
        (keyword? value) (symbol (name value))
        (string? value) (symbol value)
        :else nil))

(defn target-link
  [value context]
  (let [target (target-symbol value)
        module (:module context)
        module-id (:id module)
        namespace-value (if target (namespace target) nil)
        alias (if namespace-value (symbol namespace-value) nil)
        target-module
        (cond (nil? target) nil
              (nil? namespace-value) module-id
              (= namespace-value "-") module-id
              :else (or (get (:link module) alias) alias))]
    (if (and target target-module)
      {:section :code
       :lang :postgres
       :module target-module
       :id (symbol (name target))}
      nil)))

(defn normalized-link-coordinate
  [value]
  (cond (keyword? value) (symbol (name value))
        (string? value) (symbol value)
        :else value))

(defn linked-entry
  [context link]
  (let [module-id (normalized-link-coordinate (:module link))
        entry-id (normalized-link-coordinate (:id link))]
    (get-in (:modules context) [module-id :code entry-id])))

(defn linked-entry-form
  [entry]
  (or (:form-input entry)
      (:form entry)))

(defn linked-entry-schema
  [context link entry]
  (let [module-id (normalized-link-coordinate (:module link))
        module (get (:modules context) module-id)
        static (module-static module)]
    (or (:static/schema entry)
        (:static/schema static))))

(defn primary-descriptors
  [columns]
  (vec
   (keep (fn [pair]
           (let [column (first pair)
                 attributes (second pair)]
             (if (:primary attributes)
               {:id column
                :type (:type attributes)
                :ref (:ref/resolved attributes)
                :enum (:enum/resolved attributes)}
               nil)))
         columns)))
