(ns tahto.model.v1.spec-python
  (:require [tahto.base.v1.grammar-spec :as spec]
            [tahto.common.grammar-api :as grammar]
            [tahto.common.registry :as registry]
            [tahto.model.v1.spec-xtalk :as xtalk]))

(def +language+ :python)
(def +tag+ :py)
(def +version+ spec/+version+)

(def +grammar+
  (grammar/definition
   {:grammar/id +tag+
    :grammar/version +version+
    :grammar/release "foundation-v1"
    :grammar/language +language+
    :grammar/tag +tag+
    :grammar/engine {:minimum 1 :maximum 1}
    :grammar/parent
    {:grammar/id xtalk/+tag+
     :grammar/version xtalk/+version+}
    :operators
    {:override
     {:pow {:raw "**"}
      :and {:raw "and"}
      :or {:raw "or"}
      :not {:raw "not" :emit :prefix}
      :throw {:raw "raise" :emit :prefix}}}
    :emit
    {:defaults
     {:default
      {:comment {:prefix "#"}
       :common {:start "("
                :end ")"
                :space " "
                :assign "="
                :sep ","
                :statement ""
                :namespace "."
                :newline "\n"
                :indent "    "}
       :invoke {:start "(" :end ")" :sep "," :space " "}
       :block {:parameter {:start "" :end ""}
               :body {:start ":" :end ""}
               :space-before-body ""}
       :function {:raw "def"
                  :args {:start "(" :end ")" :sep "," :space " "}
                  :body {:start ":" :end ""}
                  :space-before-body ""}}
      :token
      {:nil "None"
       :true "True"
       :false "False"
       :string {:quote :double}
       :symbol {:namespace "."
                :replace {"-" "_"
                          "?" "_p"
                          "!" "_bang"}}}
      :data
      {:vector {:start "[" :end "]" :sep "," :space " "}
       :set {:start "{" :end "}" :sep "," :space " "}
       :map {:start "{" :end "}" :sep "," :space " "}
       :map-entry {:assign ":" :space " "}}
      :define
      {:defglobal {:raw ""}
       :def {:raw ""}}}}}))

(def +book+
  {:lang +language+
   :parent :xtalk
   :version +version+
   :grammar +grammar+})

(def +init+ +book+)

(defn- install-source
  [catalog source]
  (if (registry/find catalog (grammar/source-coordinate source))
    catalog
    (registry/install catalog source)))

(defn install
  "Installs the Foundation-named Python V1 model."
  [catalog]
  (install-source (xtalk/install catalog) +grammar+))

(defn catalog
  []
  (install (registry/registry)))

(defn select
  "Resolves Python language :python using grammar tag :py."
  ([]
   (select (catalog)))
  ([catalog]
   (registry/resolve catalog
                     {:grammar/id +tag+
                      :grammar/version +version+})))
