(ns tahto.common.registry
  (:require [tahto.common.grammar-api :as grammar]
            [tahto.protocol.registry :as protocol]))

(defstruct GrammarRegistry [sources])

(defn registry
  "Creates an empty immutable grammar registry."
  []
  (tahto.common.registry/GrammarRegistry {}))

(defn- query-match?
  [source query]
  (reduce-kv (fn [matches key value]
               (and matches (= value (get source key))))
             true
             (or query {})))

(extend-type GrammarRegistry protocol/IGrammarCatalog
  (find-source [registry coordinate]
    (get (:sources registry) coordinate))

  (list-sources [registry query]
    (vec
     (filter (fn [source]
               (query-match? source query))
             (vals (:sources registry)))))

  (available-versions [registry grammar-id]
    (vec
     (sort
      (map :source/version
           (filter (fn [source]
                     (and (= :grammar (:source/kind source))
                          (= grammar-id (:source/id source))))
                   (vals (:sources registry))))))))

(extend-type GrammarRegistry protocol/IGrammarRegistry
  (install-source [registry source]
    (let [coordinate (grammar/source-coordinate source)]
      (if (get (:sources registry) coordinate)
        (throw
         (ex-info "Grammar source coordinate already installed"
                  {:coordinate coordinate}))
        (tahto.common.registry/GrammarRegistry
         (assoc (:sources registry) coordinate source)))))

  (replace-source [registry source]
    (let [coordinate (grammar/source-coordinate source)]
      (if (get (:sources registry) coordinate)
        (tahto.common.registry/GrammarRegistry
         (assoc (:sources registry) coordinate source))
        (throw
         (ex-info "Cannot replace missing grammar source"
                  {:coordinate coordinate})))))

  (remove-source [registry coordinate]
    (if (get (:sources registry) coordinate)
      (tahto.common.registry/GrammarRegistry
       (dissoc (:sources registry) coordinate))
      (throw
       (ex-info "Cannot remove missing grammar source"
                {:coordinate coordinate})))))

(extend-type GrammarRegistry protocol/IGrammarResolver
  (resolve-grammar [registry request]
    (let [grammar-id (:grammar/id request)
          version (:grammar/version request)]
      (if (or (nil? grammar-id)
              (nil? version))
        (throw
         (ex-info
          "Grammar resolution requires an explicit id and version"
          {:request request}))
        (let [source
              (protocol-call protocol/IGrammarCatalog
                             find-source
                             registry
                             [:grammar grammar-id version])]
          (if source
            (grammar/materialize registry source request)
            (throw
             (ex-info "Grammar definition not found"
                      {:request request}))))))))

(defn install
  [registry source]
  (protocol-call protocol/IGrammarRegistry
                 install-source registry source))

(defn replace
  [registry source]
  (protocol-call protocol/IGrammarRegistry
                 replace-source registry source))

(defn remove
  [registry coordinate]
  (protocol-call protocol/IGrammarRegistry
                 remove-source registry coordinate))

(defn find
  [registry coordinate]
  (protocol-call protocol/IGrammarCatalog
                 find-source registry coordinate))

(defn list
  ([registry]
   (list registry {}))
  ([registry query]
   (protocol-call protocol/IGrammarCatalog
                  list-sources registry query)))

(defn versions
  [registry grammar-id]
  (protocol-call protocol/IGrammarCatalog
                 available-versions registry grammar-id))

(defn resolve
  [registry request]
  (protocol-call protocol/IGrammarResolver
                 resolve-grammar registry request))
