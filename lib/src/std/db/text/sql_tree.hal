;; ============================================================================
;; std.db.text.sql-tree — render reusable graph plans as SQL.
;; ============================================================================
(ns std.db.text.sql-tree
  (:require [std.db.text.base-tree :as tree]
            [std.db.text.sql-graph :as graph]))

(defn sql-query-select
  [schema entry args options]
  (graph/select-return schema
                       (tree/plan-select schema entry args options)
                       0
                       options))

(defn sql-query-count
  [schema entry args options]
  (graph/select-return schema
                       (tree/plan-count schema entry args options)
                       0
                       options))

(defn sql-query-return
  [schema entry id args options]
  (graph/select-return schema
                       (tree/plan-return schema entry id args options)
                       0
                       options))

(defn sql-query-return-bulk
  [schema entry ids args options]
  (graph/select-return schema
                       (tree/plan-return-bulk schema entry ids args options)
                       0
                       options))

(defn sql-query-combined
  [schema select-entry select-args return-entry return-args return-omit options]
  (graph/select-return
   schema
   (tree/plan-combined schema
                       select-entry
                       select-args
                       return-entry
                       return-args
                       return-omit
                       options
                       false)
   0
   options))
