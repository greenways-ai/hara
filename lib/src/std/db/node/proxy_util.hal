;; ============================================================================
;; std.db.node.proxy-util — transport selection for database client requests.
;; ============================================================================
(ns std.db.node.proxy-util
  (:require [std.lib.substrate.protocol :as substrate]))

(def DEFAULT-TRANSPORT-SERVICE "std.db.runtime/default-transport")

(defn- compatible-get
  [value lookup-key]
  (cond
    (not (map? value)) nil
    (has? value lookup-key) (get value lookup-key)
    (string? lookup-key) (get value (keyword lookup-key))
    (keyword? lookup-key) (get value (name lookup-key))
    :else nil))

(defn set-default-transport
  "Sets the default server transport ID for database proxy requests."
  [node transport-id]
  (substrate/set-service node DEFAULT-TRANSPORT-SERVICE transport-id)
  transport-id)

(defn get-default-transport
  "Returns the default server transport ID."
  [node]
  (substrate/get-service node DEFAULT-TRANSPORT-SERVICE))

(defn get-transport-id
  "Resolves a transport from options, node default or first attached transport."
  [node options]
  (or (compatible-get options :transport-id)
      (compatible-get options :transport_id)
      (get-default-transport node)
      (first (substrate/list-transports node))))

(defn request-meta
  "Builds request metadata with an explicit transport ID."
  [node options]
  (let [transport-id (get-transport-id node options)]
    (if transport-id
      {:transport-id transport-id}
      {})))

(defn request-proxy
  "Forwards the current request action across the configured transport."
  [space args request node]
  (substrate/request node
                     nil
                     (field request :action)
                     args
                     (request-meta node (field request :meta))))

(defn request-client
  "Invokes a local handler when present, otherwise forwards over transport."
  [node action args options]
  (if (substrate/get-handler node action)
    (substrate/request node nil action args {:local true})
    (let [meta (request-meta node options)]
      (if (get meta :transport-id)
        (substrate/request node nil action args meta)
        (throw (ex-info "No database runtime transport is attached"
                        {:action action
                         :transports (substrate/list-transports node)}))))))
