;; Temporary compatibility facade. New code should use std.lib.block.type.
(ns std.block.type
  (:require [std.lib.block.type :as type]))

(def Block type/Block)
(def block? type/block?)
(def void-block? type/void-block?)
(def token-block? type/token-block?)
(def container-block? type/container-block?)
(def modifier-block? type/modifier-block?)
(def code-block? type/code-block?)
(def space-block? type/space-block?)
(def linebreak-block? type/linebreak-block?)
(def linespace-block? type/linespace-block?)
(def eof-block? type/eof-block?)
(def comment-block? type/comment-block?)
