(ns std.block.construct
  (:require [std.block.type :as type]))

(defn raw-block
  [kind tag string value children props]
  (std.block.type/Block kind tag string value children props))

(defn void
  [tag string]
  (raw-block :void tag string nil [] {}))

(defn repeat-string
  [text amount]
  (loop [output ""
         remaining amount]
    (if (= 0 remaining)
      output
      (recur (str output text) (dec remaining)))))

(defn join-strings
  [strings]
  (reduce (fn [output string] (str output string)) "" strings))

(defn space [] (void :space " "))
(defn spaces [amount] (void :space (repeat-string " " amount)))
(defn tab [] (void :tab "\t"))
(defn tabs [amount] (void :tab (repeat-string "\t" amount)))
(defn newline [] (void :linebreak "\n"))
(defn newlines [amount] (void :linespace (repeat-string "\n" amount)))
(defn comment [string] (raw-block :void :comment string nil [] {}))

(defn container-tag
  [value]
  (cond
    (vector? value) :vector
    (list? value) :list
    (map? value) :map
    (set? value) :set
    :else nil))

(defn block
  [value]
  (if (type/block? value)
    value
    (let [tag (container-tag value)]
      (if tag
        (raw-block :container tag (pr-str value) value
                   (if (or (map? value) (set? value))
                     []
                     (vec (map std.block.construct/block value)))
                   {})
        (raw-block :token :token (pr-str value) value [] {})))))

(defn container
  [tag children]
  (raw-block :container tag
             (join-strings (map (fn [child]
                                  (field child :string))
                                children))
             nil
             (vec children)
             {}))

(defn root
  ([children]
   (root children
         (join-strings (map (fn [child] (field child :string)) children))))
  ([children source]
   (raw-block :container :root source
              (if (= 1 (count children))
                (field (first children) :value)
                (vec (map (fn [child] (field child :value)) children)))
              (vec children)
              {:source source})))

(defn contents [block] (field block :children))
(defn max-width [block] (count (field block :string)))
