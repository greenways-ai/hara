;; Temporary compatibility facade. New code should use std.lib.block.construct.
(ns std.block.construct
  (:require [std.lib.block.construct :as construct]))

(def raw-block construct/raw-block)
(def void construct/void)
(def repeat-string construct/repeat-string)
(def join-strings construct/join-strings)
(def space construct/space)
(def spaces construct/spaces)
(def tab construct/tab)
(def tabs construct/tabs)
(def newline construct/newline)
(def newlines construct/newlines)
(def comment construct/comment)
(def token-from-string construct/token-from-string)
(def token construct/token-from-string)
(def modifier construct/modifier)
(def uneval construct/uneval)
(def cursor construct/cursor)
(def container-tag construct/container-tag)
(def block construct/block)
(def container construct/container)
(def root construct/root)
(def contents construct/contents)
(def max-width construct/max-width)
(def add-child construct/add-child)
(def empty construct/empty)
(def line-width construct/line-width)
(def get-lines construct/get-lines)
(def rep construct/rep)
(def indent-body construct/indent-body)
