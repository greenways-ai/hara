;; Temporary compatibility facade. New code should use std.lib.block.base.
(ns std.block.base
  (:require [std.lib.block.base :as base]))

(def block? base/block?)
(def expression? base/expression?)
(def block-type base/block-type)
(def block-tag base/block-tag)
(def block-string base/block-string)
(def block-length base/block-length)
(def block-width base/block-width)
(def block-height base/block-height)
(def block-prefixed base/block-prefixed)
(def block-suffixed base/block-suffixed)
(def block-verify base/block-verify)
(def block-value base/block-value)
(def block-value-string base/block-value-string)
(def block-children base/block-children)
(def replace-children base/replace-children)
(def block-info base/block-info)
