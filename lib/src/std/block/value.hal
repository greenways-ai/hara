;; Temporary compatibility facade. New code should use std.lib.block.value.
(ns std.block.value
  (:require [std.lib.block.value :as value]))

(def child-values value/child-values)
(def root-value value/root-value)
(def list-value value/list-value)
(def vector-value value/vector-value)
(def set-value value/set-value)
(def map-value value/map-value)
(def from-value-string value/from-value-string)
(def deref-value value/deref-value)
(def quote-value value/quote-value)
(def var-value value/var-value)
(def unquote-value value/unquote-value)
(def unquote-splice-value value/unquote-splice-value)
