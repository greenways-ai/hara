;; Temporary compatibility facade. New code should use std.lib.block.check.
(ns std.block.check
  (:require [std.lib.block.check :as check]))

(def boundary? check/boundary?)
(def whitespace? check/whitespace?)
(def comma? check/comma?)
(def linebreak? check/linebreak?)
(def delimiter? check/delimiter?)
(def voidspace? check/voidspace?)
(def linetab? check/linetab?)
(def linespace? check/linespace?)
(def voidspace-or-boundary? check/voidspace-or-boundary?)
(def void-tag check/void-tag)
(def void? check/void?)
(def token-tag check/token-tag)
(def token? check/token?)
(def collection-tag check/collection-tag)
(def collection? check/collection?)
(def comment? check/comment?)
