;; Temporary compatibility facade. New code should use std.lib.block.reader.
(ns std.block.reader
  (:require [std.lib.block.reader :as reader]))

(def Reader reader/Reader)
(def create reader/create)
(def reader-position reader/reader-position)
(def throw-reader reader/throw-reader)
(def step-char reader/step-char)
(def read-char reader/read-char)
(def ignore-char reader/ignore-char)
(def unread-char reader/unread-char)
(def peek-char reader/peek-char)
(def read-while reader/read-while)
(def read-until reader/read-until)
(def read-times reader/read-times)
(def read-repeatedly reader/read-repeatedly)
(def read-include reader/read-include)
(def slurp reader/slurp)
(def read-to-boundary reader/read-to-boundary)
