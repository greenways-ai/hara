;; Temporary compatibility facade. New code should use std.lib.block.editor.
(ns std.block.editor
  (:require [std.lib.block.editor :as editor]))

(def create editor/create)
(def current editor/current)
(def result editor/result)
(def move-next editor/move-next)
(def move-prev editor/move-prev)
(def move-left editor/move-left)
(def move-right editor/move-right)
(def move-in editor/move-in)
(def move-out editor/move-out)
(def insert-left editor/insert-left)
(def insert-right editor/insert-right)
(def replace editor/replace)
(def delete editor/delete)
