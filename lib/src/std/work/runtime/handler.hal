(ns std.work.runtime.handler
  (:require [std.work.runtime.base :as base]
            [std.work.runtime.frame :as frame]))

(defn run-pure
  [execute runtime frame spec input]
  ((:fn spec) input (frame/leaf-context (frame/leaf-frame frame spec))))

(defn retry-allowed?
  [retry error]
  (let [predicate (:retry? retry)]
    (if predicate
      (if (predicate error) true false)
      true)))

(defn step-attempt
  [runtime frame spec input attempt maximum]
  (try
    (let [context (assoc (frame/leaf-context frame) :attempt attempt)]
      [((:fn spec) input context) attempt])
    (catch Throwable error
      (if (and (< attempt maximum)
               (retry-allowed? (or (:retry spec) {}) error))
        (do
          (frame/emit! runtime frame :work/step-retry
                 {:step/id (:id spec)
                  :attempt attempt
                  :next-attempt (inc attempt)})
          (step-attempt runtime frame spec input (inc attempt) maximum))
        (do
          (frame/emit! runtime frame :work/step-failed
                 {:step/id (:id spec)
                  :attempt attempt
                  :error (str error)})
          (throw error))))))

(defn assert-step-identity!
  [runtime spec]
  (if (and (base/durable? runtime)
           (nil? (:id spec)))
    (throw
     (ex-info "Durable step work requires a stable :id"
              {:operation (:op spec)})))
  spec)

(defn run-step
  [execute runtime frame spec input]
  (let [_ (assert-step-identity! runtime spec)
        frame (frame/leaf-frame frame spec)
        key (frame/checkpoint-key frame)
        checkpoint
        (if (base/durable? runtime)
          (base/backend-call (base/runtime-backend runtime) :load-checkpoint key)
          nil)]
    (if (= :completed (:checkpoint/status checkpoint))
      (do
        (frame/emit! runtime frame :work/step-replayed
               {:step/id (:id spec)
                :checkpoint/key key})
        (:checkpoint/result checkpoint))
      (let [retry (or (:retry spec) {})
            maximum (or (:maximum retry) 1)
            _ (frame/emit! runtime frame :work/step-started
                     {:step/id (:id spec)
                      :checkpoint/key key})
            [result attempts]
            (step-attempt runtime frame spec input 1 maximum)]
        (if (base/durable? runtime)
          (base/backend-call
           (base/runtime-backend runtime)
           :commit-checkpoint
           {:checkpoint/run (:run/id frame)
            :checkpoint/key key
            :checkpoint/work-root (:work/root frame)
            :checkpoint/node-path (:node/path frame)
            :checkpoint/item-id (:item/id frame)
            :checkpoint/status :completed
            :checkpoint/input input
            :checkpoint/result result
            :checkpoint/attempts attempts}))
        (frame/emit! runtime frame :work/step-completed
               {:step/id (:id spec)
                :checkpoint/key key
                :attempts attempts})
        result))))

(defn run-chain
  [execute runtime frame spec input]
  (let [children (vec (:children spec))]
    (loop [index 0
           value input]
      (if (= index (count children))
        value
        (let [child (nth children index)
              child-spec (base/work-spec-map child)
              child-frame (frame/child-frame frame :chain index child-spec)]
          (recur (inc index)
                 (execute runtime child-frame child value)))))))

(defn run-each
  [execute runtime frame spec input]
  (let [manifest (frame/normalise-manifest runtime spec input)
        child (:work spec)
        child-spec (base/work-spec-map child)
        base-frame (frame/child-frame frame :each child-spec)]
    (loop [index 0
           output []]
      (if (= index (count manifest))
        output
        (let [item (nth manifest index)
              item-id (:item/id item)
              value (execute runtime
                             (frame/item-frame base-frame item-id)
                             child
                             (:item/value item))]
          (recur (ilÈ[™^
