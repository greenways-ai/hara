;; ============================================================================
;; std.substrate — Foundation-compatible application node facade.
;;
;; This first cut keeps the existing protocol-first std.lib.substrate runtime
;; as the storage engine while establishing the canonical public namespace and
;; the observable node, transport, request, response and stream lifecycle used
;; by xt.substrate.
;; ============================================================================
(ns std.substrate
  (:require [std.foundation.promise :as promise]
            [std.lib.substrate :as core]
            [std.lib.substrate.protocol :as protocol]))

(def KIND_REQUEST :request)
(def KIND_RESPONSE :response)
(def KIND_STREAM :stream)
(def KIND_SUBSCRIBE :subscribe)
(def KIND_UNSUBSCRIBE :unsubscribe)
(def STATUS_OK :ok)
(def STATUS_ERROR :error)
(def SPACE_NODE "__NODE__")

(declare receive-frame)

(defn option-value
  [options keyword-key string-key]
  (or (get (or options {}) keyword-key)
      (get (or options {}) string-key)))

(defn transport-id-value
  [options]
  (or (option-value options :transport-id "transport-id")
      (option-value options :transport_id "transport_id")))

(defn local-value
  [options]
  (or (option-value options :local "local") false))

(defn map-each
  [entries function]
  (let [entries (or entries {})
        entry-keys (vec (keys entries))]
    (loop [index 0]
      (if (= index (count entry-keys))
        nil
        (let [key (nth entry-keys index)]
          (do (function key (get entries key))
              (recur (inc index))))))))

(defn node?
  [value]
  (try
    (do (field value :state) true)
    (catch error false)))

(defn node-state
  [node]
  (core/node-state node))

(defn node-section
  [node section]
  (core/node-section node section))

(defn node-id
  [node]
  (field node :id))

(defn configure-space
  [node space-id config]
  (protocol/create-space node space-id
                         (if (map? config)
                           config
                           {:state config})))

(defn configure-handler
  [node action config]
  (if (fn? config)
    (protocol/register-handler node action config {})
    (let [handler (or (get config :fn) (get config "fn"))
          metadata (or (get config :meta) (get config "meta") {})]
      (if (fn? handler)
        (protocol/register-handler node action handler metadata)
        (throw (ex-info "Invalid substrate handler configuration"
                        {:action action :config config}))))))

(defn configure-trigger
  [node signal config]
  (if (fn? config)
    (protocol/register-trigger node signal config {})
    (let [trigger (or (get config :fn) (get config "fn"))
          metadata (or (get config :meta) (get config "meta") {})]
      (if (fn? trigger)
        (protocol/register-trigger node signal trigger metadata)
        (throw (ex-info "Invalid substrate trigger configuration"
                        {:signal signal :config config}))))))

(defn node-configure
  [node options]
  (let [options (or options {})]
    (map-each (or (get options :spaces) (get options "spaces"))
              (fn [space-id config]
                (configure-space node space-id config)))
    (map-each (or (get options :services) (get options "services"))
              (fn [service-id service]
                (protocol/set-service node service-id service)))
    (map-each (or (get options :handlers) (get options "handlers"))
              (fn [action config]
                (configure-handler node action config)))
    (map-each (or (get options :triggers) (get options "triggers"))
              (fn [signal config]
                (configure-trigger node signal config)))
    (map-each (or (get options :meta) (get options "meta"))
              (fn [key value]
                (core/section-put node :meta key value)))
    node))

(defn node-create
  [options]
  (let [options (if (map? options) options {:id options})
        id (or (option-value options :id "id")
               (str (gensym "node-")))
        node (core/node-create id)]
    (node-configure node options)))

(defn node-frame
  [kind id space metadata action args reply-to status data error signal cause]
  (core/node-frame kind id space (or metadata {}) action (or args [])
                   reply-to status data error signal cause))

(defn request-frame
  [space action args metadata]
  (let [metadata (or metadata {})]
    (node-frame KIND_REQUEST
                (or (option-value metadata :id "id")
                    (str (gensym "req-")))
                space metadata action args nil nil nil nil nil nil)))

(defn response-frame
  [reply-to space status data error metadata]
  (let [metadata (or metadata {})]
    (node-frame KIND_RESPONSE
                (or (option-value metadata :id "id")
                    (str (gensym "res-")))
                space metadata nil [] reply-to status data error nil nil)))

(defn response-ok-frame
  [reply-to space data metadata]
  (response-frame reply-to space STATUS_OK data nil metadata))

(defn response-error-frame
  [reply-to space error metadata]
  (response-frame reply-to space STATUS_ERROR nil error metadata))

(defn stream-frame
  [space signal data metadata cause]
  (let [metadata (or metadata {})]
    (node-frame KIND_STREAM
                (or (option-value metadata :id "id")
                    (str (gensym "evt-")))
                space metadata nil [] nil nil data nil signal cause)))

(defn frame-id [frame] (protocol/frame-id frame))
(defn frame-kind [frame] (protocol/frame-kind frame))
(defn frame-space [frame] (protocol/frame-space frame))
(defn frame-meta [frame] (protocol/frame-meta frame))
(defn frame-cause [frame] (protocol/frame-cause frame))
(defn frame-data [frame] (protocol/frame-data frame))

(defn create-space [node space-id config]
  (protocol/create-space node space-id config))
(defn get-space [node space-id] (protocol/get-space node space-id))
(defn ensure-space [node space-id config]
  (protocol/ensure-space node space-id config))
(defn remove-space [node space-id] (protocol/remove-space node space-id))
(defn list-spaces [node] (protocol/list-spaces node))
(defn get-space-state [node space-id]
  (protocol/get-space-state node space-id))
(defn set-space-state [node space-id state]
  (protocol/set-space-state node space-id state))
(defn update-space-state [node space-id updater]
  (protocol/update-space-state
   node space-id
   (fn [state]
     (updater state (protocol/ensure-space node space-id {}) node))))

(defn get-services [node] (node-section node :services))
(defn get-service [node service-id] (protocol/get-service node service-id))
(defn set-service [node service-id service]
  (protocol/set-service node service-id service))
(defn remove-service [node service-id]
  (protocol/remove-service node service-id))

(defn register-handler [node action handler metadata]
  (protocol/register-handler node action handler (or metadata {})))
(defn unregister-handler [node action]
  (protocol/unregister-handler node action))
(defn get-handler [node action] (protocol/get-handler node action))
(defn list-handlers [node] (protocol/list-handlers node))
(defn register-trigger [node signal trigger metadata]
  (protocol/register-trigger node signal trigger (or metadata {})))
(defn unregister-trigger [node signal]
  (protocol/unregister-trigger node signal))
(defn get-trigger [node signal] (protocol/get-trigger node signal))
(defn list-triggers [node] (protocol/list-triggers node))

(defn transport?
  [transport]
  (and (map? transport)
       (= "substrate.transport"
          (or (get transport :tag)
              (get transport "::")))))

(defn transport-create
  [transport-id implementation]
  (let [implementation (if (fn? implementation)
                         {:send-fn implementation}
                         (or implementation {}))]
    {:tag "substrate.transport"
     :id transport-id
     :listener nil
     :meta (or (get implementation :meta)
               (get implementation "meta") {})
     :send-fn (or (get implementation :send-fn)
                  (get implementation :send_fn)
                  (get implementation "send_fn"))
     :start-fn (or (get implementation :start-fn)
                   (get implementation :start_fn)
                   (get implementation "start_fn"))
     :stop-fn (or (get implementation :stop-fn)
                  (get implementation :stop_fn)
                  (get implementation "stop_fn"))}))

(defn transport-get
  [node transport-id]
  (get (node-section node :transport-entries) transport-id))

(defn transport-list
  [node]
  (protocol/list-transports node))

(defn ensure-context-transport
  [context transport-id]
  (let [context (or context {})]
    (if (transport-id-value context)
      context
      (assoc context :transport-id transport-id))))

(defn attach-transport
  [node transport-id transport]
  (let [entry (if (transport? transport)
                transport
                (transport-create transport-id transport))
        send-fn (get entry :send-fn)
        start-fn (get entry :start-fn)
        inbound (fn [frame context]
                  (receive-frame node frame
                                 (ensure-context-transport context transport-id)))
        sender (fn [frame]
                 (if (fn? send-fn)
                   (send-fn frame)
                   (throw (ex-info "Transport missing send function"
                                   {:transport-id transport-id}))))]
    (protocol/attach-transport node transport-id sender)
    (core/section-put node :transport-entries transport-id entry)
    (if (fn? start-fn)
      (promise/then
       (promise/from (start-fn inbound))
       (fn [listener]
         (let [started (assoc entry :listener listener)]
           (core/section-put node :transport-entries transport-id started)
           started)))
      (promise/from entry))))

(defn detach-transport
  [node transport-id]
  (let [entry (transport-get node transport-id)
        stop-fn (get (or entry {}) :stop-fn)
        listener (get (or entry {}) :listener)]
    (protocol/detach-transport node transport-id)
    (core/section-remove node :transport-entries transport-id)
    (if (fn? stop-fn)
      (promise/then (promise/from (stop-fn listener))
                    (fn [_] entry))
      (promise/from entry))))

(defn transport-send
  [node transport-id frame]
  (promise/from (protocol/send-transport node transport-id frame)))

(defn request-meta
  [metadata transport-id]
  (let [metadata (or metadata {})]
    (if transport-id
      (assoc metadata :transport-id transport-id)
      metadata)))

(defn request-target
  [node metadata]
  (if (local-value metadata)
    nil
    (or (transport-id-value metadata)
        (first (transport-list node)))))

(defn request
  [node space action args metadata]
  (let [metadata (or metadata {})
        target (request-target node metadata)]
    (protocol/request node space action args
                      (request-meta metadata target))))

(defn send-response
  [node transport-id response]
  (if transport-id
    (promise/then (transport-send node transport-id response)
                  (fn [_] response))
    (promise/from response)))

(defn receive-request
  [node request-frame context]
  (let [transport-id (transport-id-value context)]
    (try
      (promise/catch
       (promise/then
        (promise/from (protocol/receive-request node request-frame context))
        (fn [data]
          (send-response node transport-id
                         (response-ok-frame
                          (frame-id request-frame)
                          (frame-space request-frame)
                          data nil))))
       (fn [error]
         (send-response node transport-id
                        (response-error-frame
                         (frame-id request-frame)
                         (frame-space request-frame)
                         error nil))))
      (catch error
        (send-response node transport-id
                       (response-error-frame
                        (frame-id request-frame)
                        (frame-space request-frame)
                        error nil))))))

(defn receive-response
  [node response]
  (protocol/receive-response node response)
  (promise/from response))

(defn subscribe
  [node space signal subscription-id metadata]
  (let [metadata (or metadata {})
        target (request-target node metadata)
        frame (protocol/subscribe node space signal subscription-id metadata)]
    (if target
      (promise/then (transport-send node target frame)
                    (fn [_] frame))
      (promise/from frame))))

(defn unsubscribe
  [node space signal subscription-id metadata]
  (let [metadata (or metadata {})
        target (request-target node metadata)
        frame (protocol/unsubscribe node space signal subscription-id metadata)]
    (if target
      (promise/then (transport-send node target frame)
                    (fn [_] frame))
      (promise/from frame))))

(defn route-stream-loop
  [node transport-ids frame exclude-id index]
  (if (= index (count transport-ids))
    (promise/from frame)
    (let [transport-id (nth transport-ids index)]
      (if (= transport-id exclude-id)
        (route-stream-loop node transport-ids frame exclude-id (inc index))
        (promise/then
         (transport-send node transport-id frame)
         (fn [_]
           (route-stream-loop node transport-ids frame exclude-id (inc index))))))))

(defn route-stream
  [node frame exclude-id]
  (route-stream-loop node
                     (protocol/list-subscriptions
                      node (frame-space frame) (field frame :signal))
                     frame exclude-id 0))

(defn receive-publish
  [node frame context]
  (promise/then
   (promise/from (protocol/receive-publish node frame context))
   (fn [_]
     (route-stream node frame (transport-id-value context)))))

(defn publish
  [node space signal data metadata]
  (protocol/publish node space signal data metadata))

(defn broadcast-loop
  [node transport-ids frame exclude-id index]
  (if (= index (count transport-ids))
    (promise/from frame)
    (let [transport-id (nth transport-ids index)]
      (if (= transport-id exclude-id)
        (broadcast-loop node transport-ids frame exclude-id (inc index))
        (promise/then
         (transport-send node transport-id frame)
         (fn [_]
           (broadcast-loop node transport-ids frame exclude-id (inc index))))))))

(defn broadcast-transport
  [node frame exclude-id]
  (broadcast-loop node (transport-list node) frame exclude-id 0))

(defn receive-frame
  [node frame context]
  (let [kind (frame-kind frame)]
    (cond
      (= kind KIND_REQUEST) (receive-request node frame context)
      (= kind KIND_RESPONSE) (receive-response node frame)
      (= kind KIND_STREAM) (receive-publish node frame context)
      (= kind KIND_SUBSCRIBE)
      (promise/from (protocol/receive-frame node frame context))
      (= kind KIND_UNSUBSCRIBE)
      (promise/from (protocol/receive-frame node frame context))
      :else (promise/from frame))))

(defn cancel-request
  [node request-id reason]
  (protocol/cancel-request node request-id reason))

(defn reject-pending
  [node reason]
  (protocol/reject-pending node reason))

(defn list-subscriptions
  ([node]
   (node-section node :router))
  ([node space]
   (let [router (node-section node :router)
         prefix (core/node-space-id space)]
     (reduce (fn [out entry]
               (let [key (first entry)]
                 (if (= prefix (first key))
                   (assoc out (second key) (second entry))
                   out)))
             {}
             router)))
  ([node space signal]
   (protocol/list-subscriptions node space signal)))
