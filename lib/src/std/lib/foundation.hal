;; ============================================================================
;; std.lib.foundation — the first language-level bootstrap substrate for Hara L0.
;;
;; Contract:
;;   * Keep this layer free of host interop and Java-specific values.
;;   * Every public definition carries a docstring and a ^{:schema ...}
;;     annotation in the std.typed surface grammar (spec/hara/data/typed.edn).
;;     Annotations are data: checked by the std.typed linter, never required
;;     at runtime. This file is the linter's dogfood target.
;;   * Variadic signatures use & in the schema input vector, e.g.
;;     [:fn [:any & :any] :any]. Lazy iterator results annotate as :any
;;     until the grammar grows an :iterator primitive.
;;   * Macros carry docstrings only; macro signatures are form-level and
;;     outside the value-type schema grammar.
;;
;; Authoritative references:
;;   * spec/hara/data/foundation.edn — the namespace boundary (what exists).
;;   * spec/hara/data/typed.edn      — the schema grammar (how types are written).
;; ============================================================================
(ns std.lib.foundation)

;; ---------------------------------------------------------------------------
;; Functions and composition
;; ---------------------------------------------------------------------------

(defn ^{:schema [:fn [:any] :any]}
  identity
  "Returns its argument unchanged."
  [value] value)

(defn ^{:schema [:fn [:num] :num]}
  inc
  "Returns value + 1."
  [value] (+ value 1))

(defn ^{:schema [:fn [:num] :num]}
  dec
  "Returns value - 1."
  [value] (- value 1))

(defn ^{:schema [:fn [:any] :fn]}
  constantly
  "Returns a function that ignores its arguments and always returns value."
  [value] (fn [ignored & rest] value))

(defn ^{:schema [:fn [:fn :fn] :fn]}
  comp2
  "Composes two functions right-to-left: (comp2 f g)(x) = f(g(x))."
  [f g] (fn [value] (f (g value))))

(defn ^{:schema [:fn [:fn :fn :fn] :fn]}
  comp3
  "Composes three functions right-to-left: (comp3 f g h)(x) = f(g(h(x)))."
  [f g h] (fn [value] (f (g (h value)))))

(defn ^{:schema [:function [:fn [:fn :fn] :fn]
                            [:fn [:fn :fn :fn] :fn]]}
  comp
  "Composes two or three functions right-to-left."
  ([f g] (comp2 f g))
  ([f g h] (comp3 f g h)))

(defn ^{:schema [:fn [:fn] :fn]}
  complement
  "Returns a function returning the logical negation of predicate's result."
  [predicate] (fn [value] (not (predicate value))))

(defn ^{:schema [:fn [:fn & :any] :fn]}
  partial
  "Returns a function that calls function with arguments prepended to its own."
  [function & arguments]
  (fn [& more]
    (apply function (concat arguments more))))

(defn ^{:schema [:fn [& :fn] :fn]}
  juxt
  "Returns a function whose result is the vector of each function applied to
   its arguments."
  [& functions]
  (fn [& arguments]
    (map (fn [function]
            (apply function arguments))
          functions)))

;; ---------------------------------------------------------------------------
;; Predicates
;; ---------------------------------------------------------------------------

(defn ^{:schema [:fn [:num] :bool]}
  zero?
  "Returns true if value equals 0."
  [value] (= value 0))

(defn ^{:schema [:fn [:num] :bool]}
  pos?
  "Returns true if value is greater than 0."
  [value] (> value 0))

(defn ^{:schema [:fn [:num] :bool]}
  neg?
  "Returns true if value is less than 0."
  [value] (< value 0))

(defn ^{:schema [:fn [:num] :bool]}
  even?
  "Returns true if value is evenly divisible by 2."
  [value] (= (mod value 2) 0))

(defn ^{:schema [:fn [:num] :bool]}
  odd?
  "Returns true if value is not evenly divisible by 2."
  [value] (not (even? value)))

(defn ^{:schema [:fn [:any] :bool]}
  nil?
  "Returns true if value is nil."
  [value] (= value nil))

(defn ^{:schema [:fn [:any] :bool]}
  false?
  "Returns true if value is exactly false."
  [value] (= value false))

(defn ^{:schema [:fn [:any] :bool]}
  true?
  "Returns true if value is exactly true."
  [value] (= value true))

;; ---------------------------------------------------------------------------
;; Sequence access
;; ---------------------------------------------------------------------------

(defn ^{:schema [:fn [:any] :bool]}
  empty?
  "Returns true if value yields no items."
  [value] (not (iter-has? (iter value))))

(defn ^{:schema [:fn [:any] :any]}
  first
  "Returns the first item of value, or nil if value is empty."
  [value]
  (let [it (iter value)]
    (if (iter-has? it) (iter-next it) nil)))

(defn ^{:schema [:fn [:any] :any]}
  second
  "Returns the second item of value, or nil if value has fewer than two items."
  [value] (first (rest value)))

(defn ^{:schema [:fn [:any] :any]}
  rest
  "Returns all but the first item of value as a seq, or nil if empty."
  [value]
  (let [it (seq (iter-drop 1 value))]
    (if (iter-has? it) it nil)))

(defn ^{:schema [:fn [:any] :any]}
  not-empty
  "Returns value if it has any items, nil otherwise."
  [value] (if (empty? value) nil value))

(defn ^{:schema [:fn [:any] :any]}
  last
  "Returns the last item of value, or nil if value is empty."
  [value]
  (let [it (iter value)]
    (if (iter-has? it)
      (loop [result (iter-next it)]
        (if (iter-has? it) (recur (iter-next it)) result))
      nil)))

(defn ^{:schema [:fn [:any] :any]}
  reverse
  "Returns the items of value in reverse order as a list."
  [value]
  (let [it (iter value)]
    (loop [result '()]
      (if (iter-has? it)
        (recur (cons (iter-next it) result))
        result))))

;; ---------------------------------------------------------------------------
;; Nested associative access
;; ---------------------------------------------------------------------------

(defn ^{:schema [:fn [:any [:vector :any]] :any]}
  get-in
  "Returns the value at the end of the key path keys, or nil if absent."
  [value keys]
  (loop [current value
         remaining (vec keys)]
    (if (= 0 (count remaining))
      current
      (recur (get current (first remaining))
             (vec (drop 1 remaining))))))

(defn ^{:schema [:fn [:any [:vector :any] :any] :any]}
  assoc-in
  "Returns value with new-value associated at the end of the key path keys,
   creating intermediate maps as needed."
  [value keys new-value]
  (let [path (vec keys)]
    (if (= 0 (count path))
      new-value
      (assoc (if (nil? value) {} value)
             (first path)
             (assoc-in (get value (first path))
                       (vec (drop 1 path))
                       new-value)))))

(defn ^{:schema [:fn [:any :any :fn & :any] :any]}
  update
  "Associates key in value with the result of applying function to the old
   value and args."
  [value key function & args]
  (assoc value key (apply function (concat [(get value key)] args))))

(defn ^{:schema [:fn [:any [:vector :any] :fn & :any] :any]}
  update-in
  "Like update, but at the end of the key path keys."
  [value keys function & args]
  (assoc-in value keys (apply function (concat [(get-in value keys)] args))))

;; ---------------------------------------------------------------------------
;; Map entries
;; ---------------------------------------------------------------------------

(defn ^{:schema [:fn [:any] :any]}
  key
  "Returns the key of a map entry."
  [entry] (first entry))

(defn ^{:schema [:fn [:any] :any]}
  val
  "Returns the value of a map entry."
  [entry] (second entry))

(defn ^{:schema [:fn [:any] :any]}
  keys
  "Returns a lazy sequence of the map's keys."
  [value] (map key value))

(defn ^{:schema [:fn [:any] :any]}
  vals
  "Returns a lazy sequence of the map's values."
  [value] (map val value))

;; ---------------------------------------------------------------------------
;; Lazy producers and transformers
;; ---------------------------------------------------------------------------

(defn ^{:schema [:function [:fn [] :any]
                            [:fn [:num] :any]
                            [:fn [:num :num] :any]]}
  range
  "Returns a lazy seq of numbers: from 0 upward, below end, or from start
   below end."
  ([] (seq (iter-range 0)))
  ([end] (seq (iter-range end)))
  ([start end] (seq (iter-range start end))))

(defn ^{:schema [:function [:fn [:any] :any]
                            [:fn [:num :any] :any]]}
  repeat
  "Returns a lazy seq of value repeated forever, or amount times."
  ([value] (seq (iter-constantly value)))
  ([amount value] (take amount (seq (iter-constantly value)))))

(defn ^{:schema [:function [:fn [:fn] :any]
                            [:fn [:num :fn] :any]]}
  repeatedly
  "Returns a lazy seq of calls to function, forever or amount times."
  ([function] (seq (iter-repeatedly function)))
  ([amount function] (take amount (seq (iter-repeatedly function)))))

(defn ^{:schema [:fn [:fn :any] :any]}
  iterate
  "Returns a lazy seq of seed, (function seed), (function (function seed)), …"
  [function seed] (seq (iter-iterate function seed)))

(defn ^{:schema [:fn [:fn :any] :any]}
  take-while
  "Returns a lazy seq of items while predicate holds."
  [predicate value] (seq (iter-take-while predicate value)))

(defn ^{:schema [:fn [:fn :any] :any]}
  drop-while
  "Returns a lazy seq dropping items while predicate holds."
  [predicate value] (seq (iter-drop-while predicate value)))

(defn ^{:schema [:fn [:num] :fn]}
  partition-all-transform
  "Returns a transform partitioning its input into groups of amount items,
   preserving array origins."
  [amount]
  (fn [value]
    (if (array? value)
      (apply array (iter-partition-all amount value))
      (vec (iter-partition-all amount value)))))

(defn ^{:schema [:function [:fn [:num] :fn]
                            [:fn [:num :any] :any]]}
  partition-all
  "Partitions value into groups of at most amount items; unary form returns a
   transform."
  ([amount] (partition-all-transform amount))
  ([amount value] (seq (iter-partition-all amount value))))

(defn ^{:schema [:fn [:num] :fn]}
  partition-transform
  "Returns a transform partitioning its input into groups of exactly amount
   items, preserving array origins."
  [amount]
  (fn [value]
    (if (array? value)
      (apply array (iter-partition amount value))
      (vec (iter-partition amount value)))))

(defn ^{:schema [:function [:fn [:num] :fn]
                            [:fn [:num :any] :any]]}
  partition
  "Partitions value into groups of exactly amount items; unary form returns a
   transform."
  ([amount] (partition-transform amount))
  ([amount value] (seq (iter-partition amount value))))

(defn ^{:schema [:fn [:any :any] :any]}
  interpose
  "Returns a lazy seq of the items of value with separator between them."
  [separator value] (seq (iter-interpose separator value)))

(defn ^{:schema [:fn [:any & :any] :any]}
  interleave
  "Returns a lazy seq of the first items of each source, then the second
   items, and so on, stopping at the shortest source."
  [value & rest] (seq (apply iter-interleave value rest)))

(defn- ^{:schema [:fn [:any :any] :any]}
  materialize-like
  "Materializes values into a collection of the same origin kind: arrays stay
   arrays, lists stay lists, everything else becomes a vector."
  [origin values]
  (if (array? origin)
    (apply array values)
    (if (list? origin)
      (apply list values)
      (vec values))))

(defn ^{:schema [:fn [:fn] :fn]}
  map-transform
  "Returns a lazy iterator transform mapping function over its input."
  [function]
  (fn [value & rest]
    (seq (apply iter-map function (concat [value] rest)))))

(defn ^{:schema [:function [:fn [:fn] :fn]
                            [:fn [:fn :any & :any] :any]]}
  map
  "Unary form returns a lazy transform. Otherwise eagerly maps function over
   one or more sources, stopping at the shortest, preserving the first
   source's origin."
  ([function] (map-transform function))
  ([function value & rest]
   (materialize-like value
                     (apply iter-map function (concat [value] rest)))))

(defn ^{:schema [:fn [:fn :any] :any]}
  filter
  "Returns a lazy seq of the items of value for which predicate returns true."
  [predicate value] (seq (iter-filter predicate value)))

(defn ^{:schema [:fn [:num :any] :any]}
  take
  "Returns a lazy seq of the first amount items of value."
  [amount value] (seq (iter-take amount value)))

(defn ^{:schema [:fn [:num :any] :any]}
  drop
  "Returns a lazy seq of all but the first amount items of value."
  [amount value] (seq (iter-drop amount value)))

(defn ^{:schema [:fn [:fn :any] :any]}
  mapcat
  "Returns a lazy seq of function applied to each item, concatenated."
  [function value] (seq (iter-mapcat function value)))

(defn ^{:schema [:fn [:fn :any] :any]}
  keep
  "Returns a lazy seq of the non-nil results of function over value."
  [function value] (seq (iter-keep function value)))

(defn ^{:schema [:fn [:any] :any]}
  cycle
  "Returns a lazy seq repeating the items of value forever."
  [value] (seq (iter-cycle value)))

(defn ^{:schema [:fn [:any & :any] :any]}
  zip
  "Returns a lazy seq of tuples of the items of each source in parallel,
   stopping at the shortest."
  [first & rest] (seq (apply iter-zip first rest)))

(defn ^{:schema [:fn [:any] :any]}
  partition-pair
  "Returns a lazy seq of value partitioned into pairs."
  [value] (seq (iter-partition-pair value)))

(defn ^{:schema [:fn [:fn :any] :bool]}
  every?
  "Returns true if predicate holds for every item of value."
  [predicate value] (iter-every? predicate value))

(defn ^{:schema [:fn [:fn :any] :bool]}
  any?
  "Returns true if predicate holds for at least one item of value."
  [predicate value] (iter-any? predicate value))

;; ---------------------------------------------------------------------------
;; Truth and fixed-point combinators retained from Foundation
;; ---------------------------------------------------------------------------

(defn ^{:schema [:fn [& :any] :bool]}
  T
  "Ignores its arguments and returns true."
  [& values] true)

(defn ^{:schema [:fn [& :any] :bool]}
  F
  "Ignores its arguments and returns false."
  [& values] false)

(defn ^{:schema [:fn [& :any] :nil]}
  NIL
  "Ignores its arguments and returns nil."
  [& values] nil)

(defn ^{:schema [:fn [:fn] :fn]}
  U
  "Self-application combinator."
  [function] (fn [value] ((function function) value)))

(defn ^{:schema [:fn [:fn] :any]}
  Z
  "Eager fixed-point combinator."
  [function]
  (let [A (fn [value] (function (U value)))]
    (A A)))

(defn ^{:schema [:fn [:fn] :any]}
  Y
  "Classical fixed-point combinator; diverges under ordinary eager use."
  [function]
  (let [A (fn [value] (function (value value)))]
    (A A)))

;; ---------------------------------------------------------------------------
;; Sorting and selection
;; ---------------------------------------------------------------------------

(defn ^{:schema [:fn [:any & :any] :any]}
  min
  "Returns the least of value and values under compare."
  [value & values]
  (reduce (fn [result item]
            (if (< (compare item result) 0) item result))
          value
          values))

(defn ^{:schema [:fn [:any & :any] :any]}
  max
  "Returns the greatest of value and values under compare."
  [value & values]
  (reduce (fn [result item]
            (if (> (compare item result) 0) item result))
          value
          values))

(defn- ^{:schema [:fn [:fn :any :any] :vector]}
  insert-sorted
  "Inserts value into the sorted vector values according to comparison."
  [comparison value values]
  (let [it (iter values)]
    (loop [result []]
      (if (iter-has? it)
        (let [item (iter-next it)]
          (if (<= (comparison value item) 0)
            (vec (concat result [value item] (seq it)))
            (recur (conj result item))))
        (conj result value)))))

(defn ^{:schema [:function [:fn [:any] :any]
                            [:fn [:fn :any] :any]]}
  sort
  "Returns values sorted by comparison (default compare), preserving the
   input's origin. Stable."
  ([values] (sort compare values))
  ([comparison values]
   (materialize-like
     values
     (reduce (fn [result value]
               (insert-sorted comparison value result))
             []
             values))))

(defn ^{:schema [:function [:fn [:fn :any] :any]
                            [:fn [:fn :fn :any] :any]]}
  sort-by
  "Returns values sorted by the results of key-function under comparison
   (default compare)."
  ([key-function values] (sort-by key-function compare values))
  ([key-function comparison values]
   (sort (fn [left right]
           (comparison (key-function left) (key-function right)))
         values)))

;; ---------------------------------------------------------------------------
;; Slicing and splitting
;; ---------------------------------------------------------------------------

(defn ^{:schema [:function [:fn [:any] :any]
                            [:fn [:num :any] :any]]}
  drop-last
  "Returns values without its last amount items (default 1), preserving
   origin."
  ([values] (drop-last 1 values))
  ([amount values]
   (materialize-like values
                     (take (max 0 (- (count values) amount)) values))))

(defn ^{:schema [:fn [:any] :any]}
  butlast
  "Returns values without its last item."
  [values] (drop-last 1 values))

(defn ^{:schema [:fn [:num :any] :any]}
  take-last
  "Returns the last amount items of values, preserving origin."
  [amount values]
  (materialize-like values
                    (drop (max 0 (- (count values) amount)) values)))

(defn ^{:schema [:fn [:num :any] :vector]}
  split-at
  "Returns a pair of (take amount values) and (drop amount values), each
   preserving origin."
  [amount values]
  [(materialize-like values (take amount values))
   (materialize-like values (drop amount values))])

(defn ^{:schema [:fn [:fn :any] :vector]}
  split-with
  "Returns a pair of the longest prefix satisfying predicate and the rest,
   each preserving origin."
  [predicate values]
  (let [it (iter values)]
    (loop [prefix []]
      (if (iter-has? it)
        (let [value (iter-next it)]
          (if (predicate value)
            (recur (conj prefix value))
            [(materialize-like values prefix)
             (materialize-like values (concat [value] (seq it)))]))
        [(materialize-like values prefix)
         (materialize-like values [])]))))

(defn ^{:schema [:fn [:fn :any] :vector]}
  partition-by
  "Returns a vector of the runs of items of values for which function returns
   equal consecutive markers."
  [function values]
  (let [it (iter values)]
    (loop [groups []
           group []
           previous nil
           started false]
      (if (iter-has? it)
        (let [value (iter-next it)
              marker (function value)]
          (if (if started (not= marker previous) false)
            (recur (conj groups group) [value] marker true)
            (recur groups (conj group value) marker true)))
        (if started (conj groups group) groups)))))

(defn ^{:schema [:fn [:num :any] :any]}
  take-nth
  "Returns every amount-th item of values, preserving origin. Throws on
   non-positive amount."
  [amount values]
  (if (<= amount 0)
    (throw (ex-info "take-nth expects a positive amount" {:amount amount}))
    (let [it (iter values)]
      (loop [index 0
             result []]
        (if (iter-has? it)
          (let [value (iter-next it)]
            (recur (+ index 1)
                   (if (= (mod index amount) 0)
                     (conj result value)
                     result)))
          (materialize-like values result))))))

;; ---------------------------------------------------------------------------
;; Maps and reductions
;; ---------------------------------------------------------------------------

(defn ^{:schema [:fn [:any :any] :any]}
  into
  "Returns destination with every item of source conjoined."
  [destination source]
  (reduce conj destination source))

(defn ^{:schema [:fn [:any] :any]}
  distinct
  "Returns the items of values with duplicates removed, preserving order and
   origin."
  [values]
  (let [it (iter values)]
    (loop [seen {}
           result []]
      (if (iter-has? it)
        (let [value (iter-next it)]
          (if (has? seen value)
            (recur seen result)
            (recur (assoc seen value true) (conj result value))))
        (materialize-like values result)))))

(defn ^{:schema [:fn [& :any] :bool]}
  distinct?
  "Returns true if no two of values are equal."
  [& values]
  (let [it (iter values)]
    (loop [seen {}]
      (if (iter-has? it)
        (let [value (iter-next it)]
          (if (has? seen value)
            false
            (recur (assoc seen value true))))
        true))))

(defn ^{:schema [:fn [:any :any] :map]}
  zipmap
  "Returns a map of map-keys to map-values, stopping at the shorter input."
  [map-keys map-values]
  (let [key-it (iter map-keys)
        value-it (iter map-values)]
    (loop [result {}]
      (if (if (iter-has? key-it) (iter-has? value-it) false)
        (recur (assoc result (iter-next key-it) (iter-next value-it)))
        result))))

(defn ^{:schema [:fn [:fn & :any] :map]}
  merge-with
  "Merges maps left-to-right, combining duplicate values with
   (function old new). Nil maps are skipped."
  [function & maps]
  (reduce
    (fn [result value-map]
      (if (nil? value-map)
        result
        (reduce
          (fn [current entry]
            (let [entry-key (key entry)
                  entry-value (val entry)]
              (assoc current
                     entry-key
                     (if (has? current entry-key)
                       (function (get current entry-key) entry-value)
                       entry-value))))
          result
          value-map)))
    {}
    maps))

(defn ^{:schema [:fn [:fn :any] :map]}
  group-by
  "Returns a map of (function value) to vectors of the values producing it."
  [function values]
  (reduce (fn [result value]
            (let [group-key (function value)]
              (assoc result
                     group-key
                     (conj (get result group-key []) value))))
          {}
          values))

(defn ^{:schema [:fn [:any] :map]}
  frequencies
  "Returns a map of each distinct item of values to its occurrence count."
  [values]
  (reduce (fn [result value]
            (assoc result value (+ 1 (get result value 0))))
          {}
          values))

;; ---------------------------------------------------------------------------
;; Macro tooling
;; ---------------------------------------------------------------------------

(defn ^{:schema [:fn [:any] :any]}
  macroexpand
  "Repeatedly applies macroexpand-1 until the form is stable. Throws after
   1000 expansion steps."
  [form]
  (loop [current form
         expansions 0]
    (let [expanded (macroexpand-1 current)]
      (if (= expanded current)
        current
        (if (>= expansions 1000)
          (throw "macro expansion exceeded 1000 steps")
          (recur expanded (+ expansions 1)))))))

(declare macroexpand-all)

(defn- ^{:schema [:fn [:fn :any] :any]}
  walk-code
  "Applies function to the immediate children of a code form, preserving
   collection kinds and list metadata."
  [function form]
  (cond (list? form)
        (with-meta (apply list (map function form)) (meta form))

        (vector? form)
        (reduce (fn [output value] (conj output (function value)))
                (empty form)
                form)

        (map? form)
        (reduce (fn [output entry]
                  (assoc output
                         (function (key entry))
                         (function (val entry))))
                (empty form)
                form)

        (set? form)
        (reduce (fn [output value] (conj output (function value)))
                (empty form)
                form)

        :else form))

(defn- ^{:schema [:fn [:any] :any]}
  macroexpand-syntax-template
  "Expands unquote and unquote-splicing forms inside a syntax-quote template."
  [form]
  (if (list? form)
    (let [operator (first form)]
      (if (or (= operator 'unquote)
              (= operator 'unquote-splicing))
        (with-meta (list operator (macroexpand-all (second form))) (meta form))
        (walk-code macroexpand-syntax-template form)))
    (walk-code macroexpand-syntax-template form)))

(defn ^{:schema [:fn [:any] :any]}
  macroexpand-all
  "Fully expands form, descending into subforms. Quote bodies are preserved;
   syntax-quote templates expand only their unquoted parts."
  [form]
  (let [expanded (macroexpand form)]
    (if (list? expanded)
      (let [operator (first expanded)]
        (cond (= operator 'quote)
              expanded

              (= operator 'syntax-quote)
              (with-meta
                (list operator (macroexpand-syntax-template (second expanded)))
                (meta expanded))

              :else
              (walk-code macroexpand-all expanded)))
      (walk-code macroexpand-all expanded))))

;; ---------------------------------------------------------------------------
;; Threading-form helpers
;; ---------------------------------------------------------------------------

(defn- ^{:schema [:fn [:any :any] :any]}
  thread-first-form
  "Builds the form of step with value inserted as the first argument."
  [value step]
  (if (list? step)
    (apply list (concat [(first step) value] (rest step)))
    (list step value)))

(defn- ^{:schema [:fn [:any :any] :any]}
  thread-last-form
  "Builds the form of step with value inserted as the last argument."
  [value step]
  (if (list? step)
    (apply list (concat step [value]))
    (list step value)))

(defn- ^{:schema [:fn [:any :any] :any]}
  conditional-thread-form
  "Builds the nested let/if expansion of cond-> (or cond->> when last? is
   true) for value and its condition/step clause pairs."
  [value clauses last?]
  (if (= 0 (count clauses))
      value
    (let [condition (first clauses)
          step (second clauses)
          remaining (vec (drop 2 clauses))
          result-symbol (gensym "result")
          threaded (if last?
                       (thread-last-form result-symbol step)
                     (thread-first-form result-symbol step))]
      (list 'let [result-symbol value]
             (list 'if
                    condition
                    (conditional-thread-form threaded remaining last?)
                    (conditional-thread-form result-symbol remaining last?))))))

;; ---------------------------------------------------------------------------
;; Macros
;; ---------------------------------------------------------------------------

(defmacro if-not
  "Evaluates then when test is false, otherwise the optional alternative."
  [test then & alternative]
  `(if ~test ~(if (= 0 (count alternative)) nil (first alternative)) ~then))

(defmacro if-let
  "Binds name to expression; evaluates then when the value is truthy,
   otherwise the optional alternative."
  [binding then & alternative]
  (let [name (nth binding 0)
        expression (nth binding 1)]
    `(let [~name ~expression]
       (if ~name ~then ~(if (= 0 (count alternative)) nil (first alternative))))))

(defmacro when-let
  "Binds name to expression; when the value is truthy, evaluates body."
  [binding & body]
  (let [name (nth binding 0)
        expression (nth binding 1)]
    `(let [~name ~expression]
       (if ~name (do ~@body) nil))))

(defmacro cond->
  "Threads value through each step whose condition holds, inserting it as the
   first argument."
  [value & clauses]
  (conditional-thread-form value clauses false))

(defmacro cond->>
  "Threads value through each step whose condition holds, inserting it as the
   last argument."
  [value & clauses]
  (conditional-thread-form value clauses true))

(defmacro code-line
  "Expands to the line number of the invocation form."
  [] (get (meta &form) :line))

(defmacro code-column
  "Expands to the column number of the invocation form."
  [] (get (meta &form) :column))

