;; Portable task descriptions and invocation. Presentation is deliberately
;; absent: std.lib.task.bulk reports data through std.lib.task.protocol.
(ns std.lib.task
  (:require [std.lib.task.process :as process]))

(defn task-defaults
  [kind]
  {:main {:arglists '([] [entry])
          :argcount 1}})

(defstruct Task
  [type name main construct arglists item result summary params])

(defn task-from-map
  [config]
  (std.lib.task/Task (:type config)
                 (:name config)
                 (:main config)
                 (:construct config)
                 (:arglists config)
                 (:item config)
                 (:result config)
                 (:summary config)
                 (:params config)))

(defn task-status
  [task]
  (field task :type))

(defn task-info
  [task]
  {:fn (field task :name)})

(defn single-function-print
  "Retains the Foundation option normalisation without performing output."
  [params]
  (if (and (not (:bulk params))
           (nil? (get-in params [:print :function])))
    (assoc-in params [:print :function] true)
    params))

(defn task
  ([config]
   (task-from-map config))
  ([type name argument]
   (let [defaults (task-defaults type)
         options (if (map? argument) argument {})
         main-config (if (map? argument)
                       (:main argument)
                       {:fn argument})
         function (:fn main-config)
         argcount (or (:argcount main-config)
                      (get-in defaults [:main :argcount])
                      1)
         adapted (first (process/main-function function argcount))
         config (merge defaults
                       options
                       {:type type
                        :name name
                        :main (merge (:main defaults)
                                     main-config
                                     {:fn adapted
                                      :argcount argcount})})]
     (task-from-map config))))

(defn task?
  [value]
  (instance? std.lib.task/Task value))

(defn invoke-intern-task
  ([name config]
   (invoke-intern-task :task name config nil))
  ([type name config body]
   `(def ~name
      (std.lib.task/task
       ~(or (:template config) :default)
       ~(str name)
       ~config))))

(defmacro deftask
  [name config & body]
  (invoke-intern-task :task name config body))

(defn invoke
  [task & arguments]
  (apply process/invoke task arguments))

(def select-filter process/select-filter)
(def select-inputs process/select-inputs)
