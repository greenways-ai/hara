;; Portable bulk task execution. This namespace emits structured reports and
;; never prints; hosts own terminal rendering and wall-clock implementations.
(ns std.lib.task.bulk
  (:require [std.lib.task.protocol :as protocol]))

(defstruct NullReporter [])
(defstruct EventReporter [reports])
(defstruct FixedClock [value])

(extend-type NullReporter protocol/ITaskReporter
  (report-task [reporter report]
    report))

(extend-type EventReporter protocol/ITaskReporter
  (report-task [reporter report]
    (do
      (swap! (field reporter :reports)
             (fn [reports] (conj reports report)))
      report)))

(extend-type FixedClock protocol/ITaskClock
  (task-now-ms [clock]
    (field clock :value)))

(def +null-reporter+ (std.lib.task.bulk/NullReporter))
(def +zero-clock+ (std.lib.task.bulk/FixedClock 0))

(defn event-reporter
  ([] (std.lib.task.bulk/EventReporter (atom [])))
  ([reports] (std.lib.task.bulk/EventReporter reports)))

(defn reporter-events
  [reporter]
  (deref (field reporter :reports)))

(defn report!
  [reporter report]
  (protocol-call protocol/ITaskReporter report-task reporter report))

(defn now-ms
  [clock]
  (protocol-call protocol/ITaskClock task-now-ms clock))

(defn normalize-result
  [input value]
  (if (and (map? value)
           (not (nil? (get value :status))))
    (merge {:key input} value)
    {:key input :status :return :data value}))

(defn bulk-process-item
  [task function input params lookup env args]
  (let [reporter (or (:reporter params) +null-reporter+)
        clock (or (:clock params) +zero-clock+)
        start (now-ms clock)]
    (report! reporter {:event :task/item-start :input input})
    (let [result
          (try
            (merge (normalize-result
                    input
                    (apply function input params lookup env args))
                   {:elapsed (- (now-ms clock) start)})
            (catch Throwable error
              {:key input
               :status :error
               :error (str error)
               :elapsed (- (now-ms clock) start)}))]
      (report! reporter (merge {:event :task/item-end} result))
      result)))

(defn bulk-items
  [task function inputs params lookup env args]
  (vec (map (fn [input]
              (bulk-process-item task function input params lookup env args))
            inputs)))

(defn bulk-warnings
  [items]
  (vec (filter (fn [item] (= :warn (get item :status))) items)))

(defn bulk-errors
  [items]
  (vec (filter (fn [item]
                 (or (= :error (get item :status))
                     (= :critical (get item :status))))
               items)))

(defn result-ignored?
  [task item]
  (let [status (get item :status)
        result-config (or (if task (field task :result) nil) {})
        ignore (get result-config :ignore)]
    (or (not (= :return status))
        (if ignore (ignore (get item :data)) false))))

(defn bulk-results
  ([items]
   (bulk-results nil items))
  ([task items]
   (vec (filter (fn [item] (not (result-ignored? task item))) items))))

(defn bulk-summary
  ([items]
   (bulk-summary nil items 0))
  ([task items elapsed]
   (let [results (bulk-results task items)
         base {:items (count items)
               :results (count results)
               :warnings (count (bulk-warnings items))
               :errors (count (bulk-errors items))
               :cumulative
               (reduce (fn [total item]
                         (+ total (or (get item :elapsed) 0)))
                       0
                       items)
               :elapsed elapsed}
         summary-config (or (if task (field task :summary) nil) {})
         aggregates (or (get summary-config :aggregate) {})
         aggregated
         (reduce
          (fn [summary entry]
            (let [key (nth entry 0)
                  aggregate (nth entry 1)
                  select (nth aggregate 0)
                  accumulate (nth aggregate 1)
                  initial (nth aggregate 2)
                  value
                  (reduce (fn [output result]
                            (let [selected (select (get result :data))]
                              (if (nil? selected)
                                output
                                (accumulate output selected))))
                          initial
                          results)]
              (assoc summary key value)))
          base
          aggregates)
         finalise (get summary-config :finalise)]
     (if finalise
       (finalise aggregated items results)
       aggregated))))

(defn output-value
  [function value]
  (if function (function value) value))

(defn package-records
  [records output package]
  (if (= package :records)
    records
    (let [pairs
          (vec
           (map (fn [record]
                  [(get record :key)
                   (output-value output (get record :data))])
                records))]
      (if (= package :vector)
        pairs
        (reduce (fn [output pair]
                  (assoc output (nth pair 0) (nth pair 1)))
                {}
                pairs)))))

(defn package-selection
  [task bundle selection package]
  (let [item-output (get (or (field task :item) {}) :output)
        result-output (get (or (field task :result) {}) :output)]
    (reduce
     (fn [output key]
       (if (= key :items)
         (assoc output key
                (package-records (get bundle key) item-output package))
         (if (= key :results)
           (assoc output key
                  (package-records (get bundle key) result-output package))
           (if (or (= key :warnings)
                   (= key :errors)
                   (= key :summary))
             (assoc output key (get bundle key))
             output))))
     {}
     selection)))

(defn bulk-package
  ([items return]
   (let [results (bulk-results items)
         bundle {:items items
                 :results results
                 :warnings (bulk-warnings items)
                 :errors (bulk-errors items)
                 :summary (bulk-summary items)}]
     (if (= return :all)
       bundle
       (get bundle return))))
  ([task bundle return package]
   (let [selection (if (= return :all)
                     [:items :warnings :errors :results :summary]
                     (if (keyword? return) [return] return))
         packaged (package-selection task bundle selection package)]
     (if (= return :all)
       packaged
       (if (keyword? return)
         (get packaged return)
         packaged)))))

(defn bulk
  [task function inputs params lookup env & args]
  (let [reporter (or (:reporter params) +null-reporter+)
        clock (or (:clock params) +zero-clock+)
        args (vec args)
        start (now-ms clock)]
    (report! reporter {:event :task/bulk-start :count (count inputs)})
    (let [items (bulk-items task function inputs
                            (assoc params :bulk true)
                            lookup env args)
          elapsed (- (now-ms clock) start)
          results (bulk-results task items)
          warnings (bulk-warnings items)
          errors (bulk-errors items)
          summary (bulk-summary task items elapsed)
          bundle {:items items
                  :results results
                  :warnings warnings
                  :errors errors
                  :summary summary}
          output (bulk-package task bundle
                               (or (:return params) :results)
                               (or (:package params) :map))]
      (report! reporter {:event :task/bulk-end
                         :summary summary})
      output)))
