;; Temporary compatibility facade. New code should use std.lib.task.
(ns std.task
  (:require [std.lib.task :as task]))

(def Task task/Task)
(def task-defaults task/task-defaults)
(def task-from-map task/task-from-map)
(def task-status task/task-status)
(def task-info task/task-info)
(def single-function-print task/single-function-print)
(def task task/task)
(def task? task/task?)
(def invoke-intern-task task/invoke-intern-task)

(defmacro deftask
  [name config & body]
  (task/invoke-intern-task :task name config body))

(def invoke task/invoke)
(def select-filter task/select-filter)
(def select-inputs task/select-inputs)
