;; ============================================================================
;; std.foundation.promise — portable promise library (foundation boundary).
;;
;; Pure activation declaration: every public Var is a host builtin; kind,
;; docstring, and arglists come from the host export catalog (@HaraExport).
;; Schema annotations for these symbols belong in std.typed.core-sigs
;; (specs/hara/data/typed.edn).
;;
;; Contract:
;;   * Promises are the single async boundary; new/from/then/catch/finally
;;     compose without exposing host executors.
;;   * cancel is best-effort.
;;   * delay defers evaluation into the promise scheduler.
;;
;; Authority: specs/hara/data/foundation.edn (:runtime-libraries std.foundation.promise)
;; ============================================================================
(ns std.foundation.promise)

(defn run [function] (std.native.Promise/run function))
(defn new [executor] (std.native.Promise/new executor))
(defn from [value] (std.native.Promise/from value))
(defn all [values] (std.native.Promise/all values))
(defn delay [milliseconds function]
  (std.native.Promise/delay milliseconds function))
(defn state [promise] (IPromise/state promise))
(defn value [promise] (IPromise/value promise))
(defn then [promise function] (IPromise/then promise function))
(defn catch [promise function] (IPromise/catch promise function))
(defn finally [promise function] (IPromise/finally promise function))
(defn cancel [promise] (IPromise/cancel promise))
