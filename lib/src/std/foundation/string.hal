;; ==========================================================================
;; std.foundation.string — portable Unicode string operations.
;;
;;                            string
;;                               |
;;       +-----------------------+-----------------------+
;;       |                       |                       |
;;       v                       v                       v
;;   inspection              transformation           search
;;   length/blank?           trim/case/pad           index-of
;;   char-at                 replace/reverse         includes?
;;       |                       |                       |
;;       +-----------------------+-----------------------+
;;                               |
;;                               v
;;                      std.native.String
;;                               |
;;                  +------------+------------+
;;                  |                         |
;;                  v                         v
;;              UTF-8 bytes            compatibility names
;;             encode/decode          len/char/substring
;;
;; Indexes and lengths follow the portable native String contract. Canonical
;; names appear first; compatibility spellings are thin HAL calls into them.
;; ==========================================================================
(ns std.foundation.string)

(defn ^{:schema [:fn [:str] :int]}
  length
  "Returns the portable character count of value."
  [value]
  (String/length value))

(defn ^{:schema [:fn [:str] :bool]}
  blank?
  "Returns true when value is empty or contains only whitespace."
  [value]
  (String/blank? value))

(defn ^{:schema [:fn [:str :str] :bool]}
  includes?
  "Returns true when value contains part."
  [value part]
  (String/includes? value part))

(defn ^{:schema [:fn [:str :str] :bool]}
  starts-with?
  "Returns true when value begins with part."
  [value part]
  (String/starts-with? value part))

(defn ^{:schema [:fn [:str :str] :bool]}
  ends-with?
  "Returns true when value ends with part."
  [value part]
  (String/ends-with? value part))

(defn ^{:schema [:fn [:str :int] :str]}
  char-at
  "Returns the character at index as a one-character string."
  [value index]
  (String/char-at value index))

(defn ^{:schema [:function [:fn [:str :int] :str]
                            [:fn [:str :int :int] :str]]}
  slice
  "Returns the portion of value from start up to optional end."
  ([value start]
   (String/slice value start))
  ([value start end]
   (String/slice value start end)))

(defn ^{:schema [:function [:fn [:str :str] :int]
                            [:fn [:str :str :int] :int]]}
  index-of
  "Returns the first index of part at or after optional offset."
  ([value part]
   (String/index-of value part))
  ([value part offset]
   (String/index-of value part offset)))

(defn ^{:schema [:function [:fn [:str :str] :int]
                            [:fn [:str :str :int] :int]]}
  last-index-of
  "Returns the last index of part, optionally bounded by offset."
  ([value part]
   (String/last-index-of value part))
  ([value part offset]
   (String/last-index-of value part offset)))

(defn ^{:schema [:fn [:str :any] :str]}
  join
  "Joins values into one string, placing separator between adjacent items."
  [separator values]
  (String/join separator values))

(defn ^{:schema [:fn [:str :str] :vector]}
  split
  "Splits value around separator and returns the resulting strings."
  [value separator]
  (String/split value separator))

(defn ^{:schema [:fn [:str] :vector]}
  split-lines
  "Splits value at portable line boundaries."
  [value]
  (String/split-lines value))

(defn ^{:schema [:fn [:str :int] :str]}
  repeat
  "Returns value repeated count times."
  [value count]
  (String/repeat value count))

(defn ^{:schema [:fn [:str :str :str] :str]}
  replace
  "Replaces every occurrence of match in value with replacement."
  [value match replacement]
  (String/replace value match replacement))

(defn ^{:schema [:fn [:str :str :str] :str]}
  replace-first
  "Replaces the first occurrence of match in value with replacement."
  [value match replacement]
  (String/replace-first value match replacement))

(defn ^{:schema [:fn [:str] :str]}
  trim
  "Removes leading and trailing whitespace from value."
  [value]
  (String/trim value))

(defn ^{:schema [:fn [:str] :str]}
  trim-left
  "Removes leading whitespace from value."
  [value]
  (String/trim-left value))

(defn ^{:schema [:fn [:str] :str]}
  trim-right
  "Removes trailing whitespace from value."
  [value]
  (String/trim-right value))

(defn ^{:schema [:fn [:str] :str]}
  upper
  "Returns value converted to uppercase."
  [value]
  (String/upper value))

(defn ^{:schema [:fn [:str] :str]}
  lower
  "Returns value converted to lowercase."
  [value]
  (String/lower value))

(defn ^{:schema [:fn [:str] :str]}
  capitalize
  "Uppercases value's first character according to the native contract."
  [value]
  (String/capitalize value))

(defn ^{:schema [:fn [:str] :str]}
  decapitalize
  "Lowercases value's first character according to the native contract."
  [value]
  (String/decapitalize value))

(defn ^{:schema [:fn [:str :int :str] :str]}
  pad-left
  "Prepends padding until value reaches length."
  [value length padding]
  (String/pad-left value length padding))

(defn ^{:schema [:fn [:str :int :str] :str]}
  pad-right
  "Appends padding until value reaches length."
  [value length padding]
  (String/pad-right value length padding))

(defn ^{:schema [:fn [:str] :str]}
  reverse
  "Returns value with its portable character order reversed."
  [value]
  (String/reverse value))

(defn ^{:schema [:fn [:str] :bytes]}
  encode-utf8
  "Encodes value as UTF-8 bytes."
  [value]
  (String/encode-utf8 value))

(defn ^{:schema [:fn [:bytes] :str]}
  decode-utf8
  "Decodes UTF-8 bytes into a string."
  [value]
  (String/decode-utf8 value))

;; Compatibility names remain ordinary HAL wrappers so their metadata is
;; independently discoverable while their behavior stays canonical.

(defn ^{:schema [:fn [:str] :int]}
  len
  "Compatibility name for length."
  [value]
  (length value))

(defn ^{:schema [:fn [:str] :int]}
  count
  "Compatibility name for length."
  [value]
  (length value))

(defn ^{:schema [:fn [:str :int] :str]}
  char
  "Compatibility name for char-at."
  [value index]
  (char-at value index))

(defn ^{:schema [:function [:fn [:str :int] :str]
                            [:fn [:str :int :int] :str]]}
  substring
  "Compatibility name for slice."
  ([value start]
   (slice value start))
  ([value start end]
   (slice value start end)))

(defn ^{:schema [:fn [:str] :str]}
  to-upper
  "Compatibility name for upper."
  [value]
  (upper value))

(defn ^{:schema [:fn [:str] :str]}
  to-lower
  "Compatibility name for lower."
  [value]
  (lower value))

(defn ^{:schema [:fn [:str] :bytes]}
  encode
  "Compatibility name for encode-utf8."
  [value]
  (encode-utf8 value))

(defn ^{:schema [:fn [:bytes] :str]}
  decode
  "Compatibility name for decode-utf8."
  [value]
  (decode-utf8 value))

(defn ^{:schema [:fn [:str :str] :int]}
  comp
  "Compares left with right and returns a negative, zero, or positive integer."
  [left right]
  (String/comp left right))

(defn ^{:schema [:fn [:str :str] :bool]}
  lt?
  "Returns true when left sorts before right."
  [left right]
  (String/lt? left right))

(defn ^{:schema [:fn [:str :str] :bool]}
  gt?
  "Returns true when left sorts after right."
  [left right]
  (String/gt? left right))

(defn ^{:schema [:fn [:num :int] :str]}
  to-fixed
  "Formats numeric value with exactly precision fractional digits."
  [value precision]
  (String/to-fixed value precision))
