(ns std.foundation.context
  (:require [std.foundation.component :as component]))

(defstruct runtime-null-type [])
(defstruct space-type [state])
(defstruct pointer-type [context fields runtime resolver])

(defn runtime-null [] (std.foundation.context/runtime-null-type))

(extend-type runtime-null-type IContext
  (call [runtime & args] (vec args)))

(extend-type runtime-null-type IComponent
  (props [runtime] {})
  (status [runtime] :started)
  (started? [runtime] true)
  (stopped? [runtime] false)
  (start [runtime] runtime)
  (stop [runtime] runtime)
  (kill [runtime] runtime)
  (remote? [runtime] false))

(extend-type runtime-null-type IContextLifeCycle
  (has-module? [runtime module] false)
  (setup-module [runtime module] runtime)
  (teardown-module [runtime module] runtime)
  (has-pointer? [runtime pointer] false)
  (setup-pointer [runtime pointer] runtime)
  (teardown-pointer [runtime pointer] runtime))

(def ^:dynamic *registry* (atom {:null {:runtimes {:default {:create (fn [config] (runtime-null))
                                                        :config {}}}
                                        :scratch (runtime-null)}}))

(defn registry-list [] (keys (deref *registry*)))
(defn registry-get [context] (get (deref *registry*) context))
(defn registry-install [context options]
  (swap! *registry* (fn [registry] (assoc registry context (merge {:runtimes {}} options))))
  (registry-get context))
(defn registry-uninstall [context]
  (swap! *registry* dissoc context))
(defn registry-runtime [context variant]
  (get-in (registry-get context) [:runtimes (or variant :default)]))
(defn registry-runtime-add [context variant spec]
  (swap! *registry* assoc-in [context :runtimes variant] spec))
(defn registry-runtime-remove [context variant]
  (swap! *registry* update-in [context :runtimes] dissoc variant))
(defn registry-scratch [context] (get-in (registry-get context) [:scratch]))
(defn registry-scratch-set! [context runtime]
  (swap! *registry* assoc-in [context :scratch] runtime))

(defn space [] (std.foundation.context/space-type (atom {})))
(defn space? [value] (instance? space-type value))

(defn- space-entry [space context]
  (get (deref (:state space)) context))

(defn- space-context-set [space context variant options]
  (let [spec (registry-runtime context variant)]
    (if (not spec)
      (throw (ex-info "Context runtime is not registered" {:context context :variant variant}))
      (let [entry {:context context
                   :variant (or variant :default)
                   :config (merge (:config spec) options)
                   :spec spec}]
        (swap! (:state space) assoc context entry)
        entry))))

(defn- space-context-unset [space context]
  (let [entry (space-entry space context)]
    (if (:runtime entry) (ISpace/rt-stop space context))
    (swap! (:state space) dissoc context)
    entry))

(defn- space-rt-start [space context]
  (let [entry (space-entry space context)
        current (:runtime entry)]
    (if current current
        (let [create (get-in entry [:spec :create])
              runtime (component/start (create (:config entry)))]
          (swap! (:state space) assoc context (assoc entry :runtime runtime))
          runtime))))

(defn- space-rt-stop [space context]
  (let [entry (space-entry space context)
        runtime (:runtime entry)]
    (if runtime
      (do (component/stop runtime)
          (swap! (:state space) assoc context (dissoc entry :runtime))
          nil))))

(extend-type space-type ISpace
  (context-set [space context variant options] (space-context-set space context variant options))
  (context-unset [space context] (space-context-unset space context))
  (context-list [space] (vec (keys (deref (:state space)))))
  (context-get [space context] (space-entry space context))
  (rt-active [space]
    (vec (map (fn [pair] (first pair))
              (filter (fn [pair] (:runtime (second pair))) (deref (:state space))))))
  (rt-get [space context] (:runtime (space-entry space context)))
  (rt-start [space context] (space-rt-start space context))
  (rt-started? [space context] (not (nil? (:runtime (space-entry space context)))))
  (rt-stopped? [space context] (nil? (:runtime (space-entry space context))))
  (rt-stop [space context] (space-rt-stop space context)))

(defn pointer
  ([context] (pointer context {}))
  ([context fields] (std.foundation.context/pointer-type context fields nil nil)))

(defn pointer? [value] (instance? pointer-type value))

(defn pointer-default [pointer]
  (or (:runtime pointer)
      (if (:resolver pointer) ((:resolver pointer) pointer))
      (registry-scratch (:context pointer))
      (runtime-null)))

(extend-type pointer-type IPointer
  (ptr-context [pointer] (:context pointer))
  (ptr-keys [pointer] (keys (:fields pointer)))
  (ptr-val [pointer key] (get (:fields pointer) key)))

(extend-type pointer-type IApplicable
  (apply-default [pointer] (pointer-default pointer))
  (apply-in [pointer runtime args] (apply IContext/call runtime args))
  (transform-in [pointer runtime args] args)
  (transform-out [pointer runtime args value] value))

(extend-type pointer-type IInvokeIn
  (invoke-in [pointer runtime & args]
    (IApplicable/apply-in pointer runtime args)))

(defn call [runtime & args] (apply IContext/call runtime args))
(defn has-module? [runtime module] (IContextLifeCycle/has-module? runtime module))
(defn setup-module [runtime module] (IContextLifeCycle/setup-module runtime module))
(defn teardown-module [runtime module] (IContextLifeCycle/teardown-module runtime module))
(defn has-pointer? [runtime pointer] (IContextLifeCycle/has-pointer? runtime pointer))
(defn setup-pointer [runtime pointer] (IContextLifeCycle/setup-pointer runtime pointer))
(defn teardown-pointer [runtime pointer] (IContextLifeCycle/teardown-pointer runtime pointer))
(defn invoke-in [value runtime & args] (apply IInvokeIn/invoke-in value runtime args))
(defn ptr-context [pointer] (IPointer/ptr-context pointer))
(defn ptr-keys [pointer] (IPointer/ptr-keys pointer))
(defn ptr-val [pointer key] (IPointer/ptr-val pointer key))
(defn context-set [space context variant options] (ISpace/context-set space context variant options))
(defn context-unset [space context] (ISpace/context-unset space context))
(defn context-list [space] (ISpace/context-list space))
(defn context-get [space context] (ISpace/context-get space context))
(defn rt-active [space] (ISpace/rt-active space))
(defn rt-get [space context] (ISpace/rt-get space context))
(defn rt-start [space context] (ISpace/rt-start space context))
(defn rt-started? [space context] (ISpace/rt-started? space context))
(defn rt-stopped? [space context] (ISpace/rt-stopped? space context))
(defn rt-stop [space context] (ISpace/rt-stop space context))
