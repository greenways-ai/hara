(ns std.foundation.pretty
  (:require [std.foundation.pretty.engine :as engine]))

(defn render
  ([document]
   (engine/render document {}))
  ([document options]
   (engine/render document options)))

(defn write
  ([document]
   (write document {}))
  ([document options]
   (std.native.Printer/p (engine/render document options))))
