;; ============================================================================
;; std.foundation.bytes — portable byte-vector library (foundation boundary).
;;
;; Pure activation declaration: every public Var is a host builtin; kind,
;; docstring, and arglists come from the host export catalog (@HaraExport).
;; Schema annotations for these symbols belong in std.typed.core-sigs
;; (spec/hara/data/typed.edn).
;;
;; Contract:
;;   * Byte vectors are mutable runtime values; set mutates in place.
;;   * u8 / s8 reinterpret a byte as unsigned (0..255) or signed (-128..127).
;;
;; Authority: spec/hara/data/foundation.edn (:runtime-libraries std.foundation.bytes)
;; ============================================================================
(ns std.foundation.bytes
  (:config
   {:builtins [count
               get
               set
               copy
               slice
               u8
               s8]}))
