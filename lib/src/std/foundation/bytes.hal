(ns std.foundation.bytes)

(defn count [value] (std.native.Bytes/count value))
(defn get
  ([value index] (std.native.Bytes/get value index))
  ([value index fallback] (std.native.Bytes/get value index fallback)))
(defn set [value index item] (std.native.Bytes/set value index item))
(defn copy [value] (std.native.Bytes/copy value))
(defn slice
  ([value start] (std.native.Bytes/slice value start))
  ([value start end] (std.native.Bytes/slice value start end)))
(defn u8 [value] (std.native.Bytes/u8 value))
(defn s8 [value] (std.native.Bytes/s8 value))
