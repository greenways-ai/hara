;; Temporary compatibility facade. New code should use std.lib.task.bulk.
(ns std.task.bulk
  (:require [std.lib.task.bulk :as bulk]))

(def NullReporter bulk/NullReporter)
(def EventReporter bulk/EventReporter)
(def FixedClock bulk/FixedClock)
(def +null-reporter+ bulk/+null-reporter+)
(def +zero-clock+ bulk/+zero-clock+)
(def event-reporter bulk/event-reporter)
(def reporter-events bulk/reporter-events)
(def report! bulk/report!)
(def now-ms bulk/now-ms)
(def normalize-result bulk/normalize-result)
(def bulk-process-item bulk/bulk-process-item)
(def bulk-items bulk/bulk-items)
(def bulk-warnings bulk/bulk-warnings)
(def bulk-errors bulk/bulk-errors)
(def bulk-results bulk/bulk-results)
(def bulk-summary bulk/bulk-summary)
(def bulk-package bulk/bulk-package)
(def bulk bulk/bulk)
