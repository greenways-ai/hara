;; Temporary compatibility facade. New code should use std.lib.block.
(ns std.block
  (:require [std.lib.block :as block]))

(def block? block/block?)
(def expression? block/expression?)
(def type block/type)
(def tag block/tag)
(def string block/string)
(def length block/length)
(def width block/width)
(def height block/height)
(def prefixed block/prefixed)
(def suffixed block/suffixed)
(def verify block/verify)
(def value block/value)
(def value-string block/value-string)
(def children block/children)
(def replace-children block/replace-children)
(def info block/info)
(def block block/block)
(def void block/void)
(def space block/space)
(def spaces block/spaces)
(def newline block/newline)
(def newlines block/newlines)
(def tab block/tab)
(def tabs block/tabs)
(def comment block/comment)
(def token block/token)
(def uneval block/uneval)
(def cursor block/cursor)
(def contents block/contents)
(def container block/container)
(def root block/root)
(def max-width block/max-width)
(def add-child block/add-child)
(def empty block/empty)
(def line-width block/line-width)
(def get-lines block/get-lines)
(def rep block/rep)
(def indent-body block/indent-body)
(def block-context block/block-context)
(def block-zip block/block-zip)
(def child-values block/child-values)
(def root-value block/root-value)
(def editor block/editor)
(def layout block/layout)
(def parse-string block/parse-string)
(def parse-root block/parse-root)
(def parse-first block/parse-first)
(def void? block/void?)
(def code? block/code?)
(def space? block/space?)
(def linebreak? block/linebreak?)
(def linespace? block/linespace?)
