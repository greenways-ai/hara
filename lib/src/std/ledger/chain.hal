;; ============================================================================
;; std.ledger.chain — a consensus-free executable AST blockchain in Hara.
;;
;; Each block stores an auditable source form. Deterministic replay of those
;; forms against the genesis state produces a single global state X.
;; ============================================================================
(ns std.ledger.chain
  (:require [std.foundation.string :as str]
            [std.ledger.common :as common]
            [std.ledger.protocol :as protocol]))

(defn- unsigned-byte
  "Converts a signed byte to an unsigned 0..255 value."
  [value]
  (if (< value 0) (+ value 256) value))

(defn- djb2-32
  "Deterministic 32-bit djb2 hash of a string."
  [text]
  (let [bytes (str/encode text)]
    (loop [index 0
           hash 5381]
      (if (= index (count bytes))
        hash
        (let [byte (unsigned-byte (nth bytes index))]
          (recur (inc index)
                 (mod (+ (* 33 hash) byte) 4294967296)))))))

(defn- block-context
  "Builds the context map passed to a block's source function."
  [block]
  {:actor     (common/block-get block :actor)
   :timestamp (common/block-get block :timestamp)
   :index     (common/block-get block :index)
   :prev-hash (common/block-get block :prev-hash)})

(defn- apply-source
  "Evaluates a block's source form and applies the resulting function to the
   previous state and block context."
  [source prev-state ctx]
  (let [f (eval source)]
    (f prev-state ctx)))

(extend-type common/Block protocol/IHashable
  (header [b]
    {:index     (common/block-get b :index)
     :prev-hash (common/block-get b :prev-hash)
     :actor     (common/block-get b :actor)
     :timestamp (common/block-get b :timestamp)
     :source    (common/block-get b :source)})
  (content-hash [b]
    (djb2-32 (pr-str (protocol/header b)))))

(extend-type common/Block protocol/IReplayable
  (replay [b prev-state]
    (let [source (common/block-get b :source)]
      (if (nil? source)
        prev-state
        (apply-source source prev-state (block-context b))))))

(extend-type common/Block protocol/IValid
  (valid? [b]
    (= (common/block-get b :hash) (protocol/content-hash b))))

(extend-type common/Chain protocol/IValid
  (valid? [chain]
    (let [blocks (common/chain-get chain :blocks)]
      (and (> (count blocks) 0)
           (= (common/chain-get chain :state)
              (common/block-get (last blocks) :state))
           (loop [index 0
                  prev nil]
             (if (= index (count blocks))
               true
               (let [block (nth blocks index)
                     expected-state (if (= index 0)
                                      (common/block-get block :state)
                                      (protocol/replay block
                                                (common/block-get prev :state)))
                     ok (and (protocol/valid? block)
                             (= (common/block-get block :state) expected-state)
                             (or (= index 0)
                                 (and (= (common/block-get block :index)
                                         (inc (common/block-get prev :index)))
                                      (= (common/block-get block :prev-hash)
                                         (common/block-get prev :hash)))))]
                 (if ok
                   (recur (inc index) block)
                   false))))))))

(extend-type common/Chain protocol/IChainOps
  (head [chain]
    (last (common/chain-get chain :blocks)))
  (blocks [chain]
    (common/chain-get chain :blocks))
  (state [chain]
    (common/chain-get chain :state))
  (append [chain actor timestamp source]
    (let [prev    (protocol/head chain)
          index   (inc (common/block-get prev :index))
          p-hash  (common/block-get prev :hash)
          p-state (common/chain-get chain :state)
          ctx     {:actor actor :timestamp timestamp :index index :prev-hash p-hash}
          state   (if (nil? source) p-state (apply-source source p-state ctx))
          block   (common/Block index p-hash actor timestamp source state nil)
          block   (common/block-assoc block :hash (protocol/content-hash block))]
      (common/Chain (conj (common/chain-get chain :blocks) block)
                    (common/block-get block :state)))))

(defn create
  "Creates a new chain with the given genesis state."
  [genesis-state]
  (let [genesis (common/Block 0 0 :std.ledger/genesis 0 nil genesis-state nil)
        genesis (common/block-assoc genesis :hash (protocol/content-hash genesis))]
    (common/Chain [genesis] genesis-state)))

(defn head
  "Returns the last block of the chain."
  [chain]
  (protocol/head chain))

(defn blocks
  "Returns all blocks in the chain."
  [chain]
  (protocol/blocks chain))

(defn state
  "Returns the current state of the chain."
  [chain]
  (protocol/state chain))

(defn append
  "Appends a block to the chain. The source form must evaluate to a function
   of two arguments: the previous state and a context map."
  [chain actor timestamp source]
  (protocol/append chain actor timestamp source))

(defn valid?
  "Replays the chain from the genesis block, verifying every hash link and
   every state transition. Returns true only if the stored chain is internally
   consistent."
  [chain]
  (protocol/valid? chain))

(defmacro tx
  "Wraps a transaction body in a quoted function of `state` and `ctx`.
   The resulting source form is stored in the block and can be read and
   replayed by anyone."
  [& body]
  `(quote (fn [state ctx] ~@body)))
