(ns std.db.node.batch-test
  (:use code.test)
  (:require [std.db.node.client-base :as client]
            [std.db.node.runtime :as runtime]
            [std.db.protocol :as protocol]
            [std.foundation.promise :as promise]
            [std.lib.substrate :as substrate]))

(def EVENTS (atom []))

(defstruct BatchConnection
  [id])

(defn- record-event
  [connection mode sql parameters]
  (swap! EVENTS conj {:connection (field connection :id)
                      :mode mode
                      :sql sql
                      :parameters parameters}))

(extend-type BatchConnection protocol/IDatabase
  (db-engine [connection]
    :batch-sql)
  (db-provider [connection]
    :batch)
  (db-info [connection]
    {:id (field connection :id)
     :engine :batch-sql
     :provider :batch})
  (db-exec [connection sql parameters]
    (record-event connection :exec sql parameters)
    (if (= sql "fail")
      (promise/new
       (fn [resolve reject]
         (reject (ex-info "statement failed" {:sql sql}))))
      (promise/from {:affected 1
                     :sql sql
                     :parameters parameters})))
  (db-query [connection sql parameters]
    (record-event connection :query sql parameters)
    (promise/from {:columns ["value"]
                   :rows [[(first parameters)]]
                   :affected 0}))
  (db-close [connection]
    (promise/from true)))

(defn batch-driver
  []
  {:id :batch
   :engine :batch-sql
   :open (fn [options]
           (promise/from
            (std.db.node.batch-test/BatchConnection
             (get options :id "batch-1"))))})

(def config
  {:primary {:type :batch
             :options {:id "primary-batch"}}})

(defn connected-runtime
  [suffix]
  (let [server (substrate/node-create (str "batch-server-" suffix))
        client-node (substrate/node-create (str "batch-client-" suffix))
        connected (deref
                   (runtime/local-connect
                    client-node
                    server
                    config
                    {}
                    {}
                    {:drivers {:batch (batch-driver)}}))]
    {:server server
     :client client-node
     :runtime (get connected :runtime)}))

(def results
  [(fact "plain batches run mixed exec and query statements sequentially"
     (reset! EVENTS [])
     (let [connected (connected-runtime "plain")
           client-node (get connected :client)
           output (deref
                   (client/batch
                    client-node
                    "db/primary"
                    [{:sql "insert-one" :parameters [1]}
                     {:sql "select-one" :parameters [42] :mode :query}
                     {:sql "insert-two" :parameters [2]}]
                    {}))]
       [(get output :status)
        (map (fn [result]
               (or (get result :sql)
                   (get result :rows)))
             (get output :results))
        (map (fn [event]
               [(get event :mode) (get event :sql)])
             @EVENTS)])
     => [:complete
         ["insert-one" [[42]] "insert-two"]
         [[:exec "insert-one"]
          [:query "select-one"]
          [:exec "insert-two"]]])

   (fact "transaction batches begin run and commit without interleaving"
     (reset! EVENTS [])
     (let [connected (connected-runtime "commit")
           client-node (get connected :client)
           output (deref
                   (client/transaction
                    client-node
                    "db/primary"
                    [{:sql "insert" :parameters [1]}
                     {:sql "select" :parameters [7] :mode "query"}]
                    {}))]
       [(get output :status)
        (get-in output [:results 1 :rows])
        (map (fn [event] (get event :sql)) @EVENTS)])
     => [:committed
         [[7]]
         ["begin" "insert" "select" "commit"]])

   (fact "failed transaction batches roll back and propagate the error"
     (reset! EVENTS [])
     (let [connected (connected-runtime "rollback")
           client-node (get connected :client)
           status (deref
                   (promise/catch
                    (client/transaction
                     client-node
                     "db/primary"
                     [{:sql "before-failure"}
                      {:sql "fail"}
                      {:sql "after-failure"}]
                     {})
                    (fn [error] :failed)))]
       [status
        (map (fn [event] (get event :sql)) @EVENTS)])
     => [:failed
         ["begin" "before-failure" "fail" "rollback"]])])

(pr-str (run '[std.db.node.batch-test]))
