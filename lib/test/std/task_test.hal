(ns std.task-test
  (:require [std.lib.test :as test]
            [std.task :as task]
            [std.task.bulk :as bulk]))

(task/deftask double-task
  {:template :default
   :main {:fn (fn [value] (* 2 value))}})

(def results
  [(test/check "deftask creates a portable task"
               [(task/task? double-task)
                (task/task-status double-task)
                (task/task-info double-task)
                (task/invoke double-task 3)]
               [true :default {:fn "double-task"} 6])
   (test/check "bulk execution reports data without printing"
               (let [reporter (bulk/event-reporter)
                     output (task/invoke
                             double-task
                             [1 2 3]
                             {:reporter reporter
                              :return :all})]
                 [(get output :summary)
                  (vec (map (fn [result] (get result :data))
                            (get output :results)))
                  (vec (map (fn [report] (get report :event))
                            (bulk/reporter-events reporter)))])
               [{:items 3 :results 3 :warnings 0 :errors 0}
                [2 4 6]
                [:task/bulk-start
                 :task/item-start :task/item-end
                 :task/item-start :task/item-end
                 :task/item-start :task/item-end
                 :task/bulk-end]])])

(test/print-results results)
