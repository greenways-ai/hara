(ns std.foundation.string-test
  (:use code.test))

(def results
  [(fact "len"
     (str/len "hara")
     => 4)
   (fact "len-unicode"
     (str/len "hé")
     => 2)
   (fact "comp"
     (str/comp "a" "b")
     => -1)
   (fact "lt?"
     (str/lt? "a" "b")
     => true)
   (fact "gt?"
     (str/gt? "b" "a")
     => true)
   (fact "pad-left"
     (str/pad-left "x" 3 "0")
     => "00x")
   (fact "pad-right"
     (str/pad-right "x" 3 "0")
     => "x00")
   (fact "starts-with?"
     (str/starts-with? "hara" "ha")
     => true)
   (fact "ends-with?"
     (str/ends-with? "hara" "ra")
     => true)
   (fact "char"
     (str/char "hara" 1)
     => "a")
   (fact "split"
     (nth (str/split "a,b" ",") 1)
     => "b")
   (fact "split-three"
     (nth (str/split "a,b,c" ",") 1)
     => "b")
   (fact "join"
     (str/join "," ["a" "b"])
     => "a,b")
   (fact "index-of"
     (str/index-of "ababa" "ba" 2)
     => 3)
   (fact "substring"
     (str/substring "hara" 1 3)
     => "ar")
   (fact "to-upper"
     (str/to-upper "hara")
     => "HARA")
   (fact "to-lower"
     (str/to-lower "HARA")
     => "hara")
   (fact "to-fixed"
     (str/to-fixed 1.25 2)
     => "1.25")
   (fact "to-fixed-integer"
     (str/to-fixed 1 2)
     => "1.00")
   (fact "replace"
     (str/replace "hara" "a" "x")
     => "hxrx")
   (fact "replace-all-occurrences"
     (str/replace "a-b-a" "a" "x")
     => "x-b-x")
   (fact "trim"
     (str/trim " x ")
     => "x")
   (fact "trim-left"
     (str/trim-left " x ")
     => "x ")
   (fact "trim-left-multi"
     (str/trim-left "  a  ")
     => "a  ")
   (fact "trim-right"
     (str/trim-right " x ")
     => " x")
   (fact "trim-right-multi"
     (str/trim-right "  a  ")
     => "  a")
   (fact "encode/decode round-trip"
     (str/decode (str/encode "hé"))
     => "hé")])

(pr-str (run '[std.foundation.string-test]))
