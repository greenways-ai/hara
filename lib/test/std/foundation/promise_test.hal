(ns std.foundation.promise-test
  (:use code.test))

(def results
  [(fact "promise body constructor resolves to value"
     (deref (promise (fn [] 42)))
     => 42)
   (fact "promise/from wraps a value"
     (deref (promise/from 42))
     => 42)
   (fact "promise? recognizes promises"
     (promise? (promise/from 1))
     => true)
   (fact "promise? rejects non-promises"
     (promise? 1)
     => false)
   (fact "promise/then chains"
     (deref (promise/then (promise (fn [] 40))
                                    (fn [x] (promise (fn [] (+ x 2))))))
     => 42)
   (fact "promise/catch recovers from rejection"
     (deref (promise/catch (promise (fn [] (throw "bad")))
                                     (fn [error] 7)))
     => 7)
   (fact "promise/all returns vector of results"
     (nth (deref (promise/all [(promise (fn [] 1))
                                         (promise (fn [] 3))]))
                    1)
     => 3)
   (fact "promise body can return nested promise"
     (deref (promise (fn [] (promise (fn [] 9)))))
     => 9)
   (fact "promise/finally runs and returns original value"
     (deref (promise/finally (promise (fn [] 4))
                                       (fn [] (promise (fn [] 99)))))
     => 4)
   (fact "promise/catch on explicit reject"
     (deref (promise/catch (promise/new (fn [resolve reject] (reject "bad")))
                                     (fn [error] 8)))
     => 8)
   (fact "promise/catch after finally recovers original error"
     (deref (promise/catch (promise/finally (promise (fn [] (throw "original")))
                                                      (fn [] nil))
                                     (fn [error] 11)))
     => 11)
   (fact "promise/cancel returns the promise"
     (let [p (promise/delay 10000 (fn [] 1))]
                 (promise? (promise/cancel p)))
     => true)])

(pr-str (run '[std.foundation.promise-test]))
