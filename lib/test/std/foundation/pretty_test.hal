(ns std.foundation.pretty-test
  (:use code.test)
  (:require [std.foundation.pretty :as pretty]))

(def document
  [:group
   "("
   [:nest 2 [:line] "alpha" [:line] "beta"]
   ")"])

(def results
  [(fact "plain text"
     (pretty/render "abc")
     => "abc")
   (fact "group stays flat within width"
     (pretty/render document {:width 80})
     => "( alpha beta)")
   (fact "group breaks and nests beyond width"
     (pretty/render document {:width 8})
     => "(\n  alpha\n  beta)")
   (fact "pass text has zero visible width"
     (pretty/render [:group [:pass "<color>"] "123" [:line] "4"]
                              {:width 5})
     => "<color>123 4")
   (fact "options must be a map"
     (pretty/render "abc" nil)
     => (throws))])

(pr-str (run '[std.foundation.pretty-test]))
