(ns std.foundation.alias-test
  (:use code.test))

(def results
  [(fact "str/trim default alias works without require"
     (str/trim "  hara  ")
     => "hara")
   (fact "bytes/get default alias works without require"
     (bytes/get (bytes -1) 0)
     => 255)
   (fact "promise? default alias works without require"
     (promise? (promise/new (fn [resolve reject] (resolve 1))))
     => true)
   (fact ":config {:intrinsics :all} keeps every default alias"
     (do (ns app (:config {:intrinsics :all}))
                   (let [result (bytes/count (str/encode "x"))]
                     (ns std.foundation.alias-test
                       (:use code.test))
                     result))
     => 1)])

(pr-str (run '[std.foundation.alias-test]))
