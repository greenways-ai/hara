(ns std.foundation.set-test
  (:require [std.lib.test :as test]
            [std.foundation.set :as set]))

(def results
  [(test/check "union"
               (set/union #{1 2} #{2 3})
               #{1 2 3})
   (test/check "intersection"
               (set/intersection #{1 2 3} #{2 3 4} #{3 5})
               #{3})
   (test/check "difference"
               (set/difference #{1 2 3} #{2} #{3})
               #{1})
   (test/check "subset and superset"
               [(set/subset? #{1 2} #{1 2 3})
                (set/subset? #{1 4} #{1 2 3})
                (set/superset? #{1 2 3} #{1 2})]
               [true false true])
   (test/check "select"
               (set/select odd? #{1 2 3 4})
               #{1 3})])

(test/print-results results)
