(ns std.foundation.json-test
  (:use code.test)
  (:require [std.foundation.json :as json]))

(def results
  [(fact "read"
     (json/read "{\"a\":[1,2]}")
     => {"a" [1 2]})
   (fact "write"
     (json/write {"a" [1 2]})
     => "{\"a\":[1,2]}")
   (fact "pretty"
     (json/pretty {"a" 1} {})
     => "{\n  \"a\": 1\n}")
   (fact "pretty requires an options map"
     (json/pretty {"a" 1} nil)
     => (throws))
   (fact "native implementation"
     (Json/write {"a" 1})
     => "{\"a\":1}")])

(pr-str (run '[std.foundation.json-test]))
