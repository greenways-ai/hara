(ns std.foundation-test
  (:use code.test)
  (:require [std.lib.test :as test]))

(defmacro env-line [] (:line &env))

(defmacro hygienic [value]
  `(let [x# ~value] [x# x#]))

(def results
  [(fact "test config is inert at evaluation time"
     (test/config {:session-scope :shared})
     => nil)
   (fact "comp composes right-to-left"
     ((comp inc inc) 40)
     => 42)
   (fact "map is eager on vectors"
     (map inc [1 2 3])
     => [2 3 4])
   (fact "reload bumps module revision and keeps behaviour"
     (let [revision (module-revision "std/foundation.hal")]
                 (require 'std.foundation {:reload true})
                 [(= (inc revision) (module-revision "std/foundation.hal"))
                  (map inc [1 2 3])])
     => [true [2 3 4]])
   (fact "T/F/NIL constants and ordering helpers"
     [(T 1) (F 1) (NIL 1) (compare 2 3) (min 3 1 2) (max 3 1 2)]
     => [true false nil -1 1 3])
   (fact "basic math functions and constants are portable"
     [(= E 2.718281828459045)
                (= PI 3.141592653589793)
                (= (sin 0) 0.0)
                (= (cos 0) 1.0)
                (= (tan 0) 0.0)
                (= (asin 0) 0.0)
                (= (acos 1) 0.0)
                (= (atan 0) 0.0)
                (= (atan2 0 1) 0.0)
                (= (sinh 0) 0.0)
                (= (cosh 0) 1.0)
                (= (tanh 0) 0.0)
                (= (asinh 0) 0.0)
                (= (acosh 1) 0.0)
                (= (atanh 0) 0.0)
                (= (floor 1.75) 1.0)
                (= (ceil 1.25) 2.0)
                (= (pow 2 3) 8.0)
                (= (abs -3) 3)
                (= (exp 0) 1.0)
                (= (sqrt 9) 3.0)]
     => [true true true true true true true true true true true
                true true true true true true true true true true])

   (fact "map arity/return-type variants"
     [(vector? (map inc [1 2 3]))
                (iter? ((map inc) [1 2 3]))
                (vector? (map inc (array 1 2 3)))
                (iter? ((comp (map inc) (map inc)) [1 2 3]))]
     => [true true true true])
   (fact "curried map returns iterator"
     [(vec ((map inc) [1 2 3])) (vec ((comp (map inc) (map inc)) [1 2 3]))]
     => [[2 3 4] [3 4 5]])
   (fact "map on array"
     (map inc (array 1 2 3))
     => [2 3 4])
   (fact "sequence transforms return iterator partials and eager vectors"
     [(iter? ((filter odd?) [1 2 3]))
      (filter odd? [1 2 3])
      (take 2 '(1 2 3))
      (drop 1 (array 1 2 3))
      (take-while odd? [1 3 2 5])
      (drop-while odd? [1 3 2 5])
      (mapcat (fn [x] [x x]) [1 2])
      (keep (fn [x] (if (odd? x) x nil)) [1 2 3])
      (partition 2 [1 2 3])
      (partition-all 2 [1 2 3])
      (interpose :x [1 2 3])]
     => [true [1 3] [1 2] [2 3] [1 3] [2 5]
         [1 1 2 2] [1 3] [[1 2]] [[1 2] [3]] [1 :x 2 :x 3]])
   (fact "source combiners are eager vectors"
     [(zip [1 2] [3 4])
      (interleave [1 2] [3 4])
      (partition-pair [1 2 3 4])]
     => [[[1 3] [2 4]] [1 3 2 4] [[1 2] [3 4]]])
   (fact "terminal predicates have reusable unary forms"
     [((every? odd?) [1 3 5])
      ((any? odd?) [2 4 5])
      (every? odd? [1 2])
      (any? odd? [2 4])]
     => [true true false false])
   (fact "Iter owns the native iterator operations"
     [(= Iter std.native.Iter)
      (iter? (Iter/iter-map inc [1 2]))
      (Iter/iter-finite? [1 2])
      (Iter/iter-materialize [1 2])]
     => [true true true [1 2]])

   (fact "collection/ordering additions"
     [(butlast [1 2 3])
                (take-last 2 [1 2 3])
                (split-at 2 [1 2 3])
                (partition-by odd? [1 3 2 4 5])
                (take-nth 2 [0 1 2 3 4])]
     => [[1 2] [2 3] [[1 2] [3]] [[1 3] [2 4] [5]] [0 2 4]])
   (fact "map and collection helpers"
     [(sort [3 1 2])
                (sort-by count [[:a :b] [:a] [:a :b :c]])
                (distinct [1 2 1 3])
                (distinct? 1 2 3)
                (distinct? 1 2 1)
                (zipmap [:a :b] [1 2])
                (map-keys inc {1 :a 2 :b})
                (map-vals inc {:a 1 :b 2})
                (merge-with + {:a 1} {:a 2 :b 3})
                (group-by odd? [1 2 3 4])
                (frequencies [:a :b :a])]
     => [[1 2 3]
                [[:a] [:a :b] [:a :b :c]]
                [1 2 3]
                true
                false
                {:a 1 :b 2}
                {2 :a 3 :b}
                {:a 2 :b 3}
                {:a 3 :b 3}
                {true [1 3] false [2 4]}
                {:a 2 :b 1}])

   (fact "atom watches receive four arguments"
     (let [a (atom 1)
                     seen (atom [])]
                 (watch-add
                   a :log
                   (fn [key ref old new]
                     (swap! seen
                            (fn [values item] (conj values item))
                            [key old new])))
                 (swap! a (fn [value amount] (+ value amount)) 2)
                 (reset! a 9)
                 [(deref a)
                  (deref seen)
                  (std.protocol.iiterator/iter-next?
                    (std.protocol.iiter/iter (watch-list a)))
                  (cas! a 9 10)
                  (deref a)])
     => [9 [[:log 1 3] [:log 3 9]] true true 10])

   (fact "foundation macros expand portably"
     [(if-not false :yes :no)
                (if-let [x 4] (+ x 1) 0)
                (when-let [x 4] (+ x 2))
                (cond-> 1 true inc false (+ 10) true (* 3))
                (cond->> [1 2] true (map inc))]
     => [:yes 5 6 6 [2 3]])
   (fact "doto evaluates its target once and returns it"
     (let [calls (atom 0)
                     value (doto
                             (do (swap! calls inc) (atom []))
                             (swap! (fn [values item] (conj values item)) 1)
                             (swap! (fn [values item] (conj values item)) 2))]
                 [(deref calls) (deref value)])
     => [1 [1 2]])
   (fact "code-line/code-column and &env line are numbers"
     [(number? (code-line)) (number? (code-column)) (number? (env-line))]
     => [true true true])
   (fact "hygienic macro gensyms do not leak"
     [(hygienic 4) (hygienic 5)]
     => [[4 4] [5 5]])])

(pr-str (run '[std.foundation-test]))
