(ns std.foundation-test
  (:require [std.lib.test :as test]))

(def results
  [(test/check "comp composes right-to-left"
               ((comp inc inc) 40)
               42)
   (test/check "map is eager on vectors"
               (map inc [1 2 3])
               [2 3 4])
   (test/check "reload bumps module revision and keeps behaviour"
               (let [revision (module-revision "std/foundation.hal")]
                 (require 'std.foundation {:reload true})
                 [(= (inc revision) (module-revision "std/foundation.hal"))
                  (map inc [1 2 3])])
               [true [2 3 4]])
   (test/check "T/F/NIL constants and ordering helpers"
               [(T 1) (F 1) (NIL 1) (compare 2 3) (min 3 1 2) (max 3 1 2)]
               [true false nil -1 1 3])

   (test/check "map arity/return-type variants"
               [(vector? (map inc [1 2 3]))
                (iter? ((map inc) [1 2 3]))
                (array? (map inc (array 1 2 3)))
                (iter? ((comp (map inc) (map inc)) [1 2 3]))]
               [true true true true])
   (test/check "curried map returns iterator"
               [(vec ((map inc) [1 2 3])) (vec ((comp (map inc) (map inc)) [1 2 3]))]
               [[2 3 4] [3 4 5]])
   (test/check "map on array"
               (map inc (array 1 2 3))
               [2 3 4])

   (test/check "collection/ordering additions"
               [(butlast [1 2 3])
                (take-last 2 [1 2 3])
                (split-at 2 [1 2 3])
                (partition-by odd? [1 3 2 4 5])
                (take-nth 2 [0 1 2 3 4])]
               [[1 2] [2 3] [[1 2] [3]] [[1 3] [2 4] [5]] [0 2 4]])
   (test/check "map and collection helpers"
               [(sort [3 1 2])
                (sort-by count [[:a :b] [:a] [:a :b :c]])
                (distinct [1 2 1 3])
                (distinct? 1 2 3)
                (distinct? 1 2 1)
                (zipmap [:a :b] [1 2])
                (map-keys inc {1 :a 2 :b})
                (map-vals inc {:a 1 :b 2})
                (merge-with + {:a 1} {:a 2 :b 3})
                (group-by odd? [1 2 3 4])
                (frequencies [:a :b :a])]
               [[1 2 3]
                [[:a] [:a :b] [:a :b :c]]
                [1 2 3]
                true
                false
                {:a 1 :b 2}
                {2 :a 3 :b}
                {:a 2 :b 3}
                {:a 3 :b 3}
                {true [1 3] false [2 4]}
                {:a 2 :b 1}])

   (test/check "atom watches receive four arguments"
               (let [a (atom 1)
                     seen (atom [])]
                 (add-watch a :log (fn [key ref old new] (swap! seen conj [key old new])))
                 (swap! a + 2)
                 (reset! a 9)
                 [(deref a) (deref seen) (count (get-watches a)) (compare-and-set! a 9 10) (deref a)])
               [9 [[:log 1 3] [:log 3 9]] 1 true 10])

   (test/check "foundation macros expand portably"
               [(if-not false :yes :no)
                (if-let [x 4] (+ x 1) 0)
                (when-let [x 4] (+ x 2))
                (cond-> 1 true inc false (+ 10) true (* 3))
                (cond->> [1 2] true (map inc))]
               [:yes 5 6 6 [2 3]])
   (test/check "doto evaluates its target once and returns it"
               (let [calls (atom 0)
                     value (doto
                             (do (swap! calls inc) (atom []))
                             (swap! (fn [values item] (conj values item)) 1)
                             (swap! (fn [values item] (conj values item)) 2))]
                 [(deref calls) (deref value)])
               [1 [1 2]])
   (test/check "code-line/code-column and &env line are numbers"
               (do (defmacro env-line [] (:line &env))
                   [(number? (code-line)) (number? (code-column)) (number? (env-line))])
               [true true true])
   (test/check "hygienic macro gensyms do not leak"
               (do (defmacro hygienic [value]
                     `(let [x# ~value] [x# x#]))
                   [(hygienic 4) (hygienic 5)])
               [[4 4] [5 5]])])

(test/print-results results)
