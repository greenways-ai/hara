(ns std.db-test
  (:use code.test)
  (:require [std.db :as db]
            [std.db.protocol :as protocol]))

(defstruct MockConnection
  [id])

(extend-type MockConnection protocol/IDatabase
  (db-engine [connection]
    :mock-sql)
  (db-provider [connection]
    :mock)
  (db-info [connection]
    {:id (field connection :id)
     :engine :mock-sql
     :provider :mock})
  (db-exec [connection sql parameters]
    {:operation :exec
     :id (field connection :id)
     :sql sql
     :parameters parameters})
  (db-query [connection sql parameters]
    {:operation :query
     :id (field connection :id)
     :sql sql
     :parameters parameters})
  (db-close [connection]
    {:operation :close
     :id (field connection :id)}))

(def connection (std.db-test/MockConnection 7))

(def results
  [(fact "generic metadata dispatches through IDatabase"
     [(db/engine connection)
      (db/provider connection)
      (db/info connection)]
     => [:mock-sql
         :mock
         {:id 7 :engine :mock-sql :provider :mock}])

   (fact "generic exec and query preserve optional parameters"
     [(db/exec connection "create table item (id integer)")
      (db/query connection "select * from item where id = ?" [7])]
     => [{:operation :exec
          :id 7
          :sql "create table item (id integer)"
          :parameters []}
         {:operation :query
          :id 7
          :sql "select * from item where id = ?"
          :parameters [7]}])

   (fact "transaction helpers and close use the same protocol"
     [(db/begin connection)
      (db/commit connection)
      (db/rollback connection)
      (db/close connection)]
     => [{:operation :exec :id 7 :sql "begin" :parameters []}
         {:operation :exec :id 7 :sql "commit" :parameters []}
         {:operation :exec :id 7 :sql "rollback" :parameters []}
         {:operation :close :id 7}])])

(pr-str (run '[std.db-test]))
