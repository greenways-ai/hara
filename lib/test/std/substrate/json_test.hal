(ns std.substrate.json-test
  (:require [std.lib.test :as test]
            [std.substrate.frame :as frame]
            [std.substrate.json :as substrate-json]
            [std.substrate.router :as router]))

(def results
  [(test/check
    "recognises supported JSON wire kinds"
    [(substrate-json/frame-kind? frame/KIND_REQUEST)
     (substrate-json/frame-kind? frame/KIND_RESPONSE)
     (substrate-json/frame-kind? frame/KIND_STREAM)
     (substrate-json/frame-kind? router/KIND_SUBSCRIBE)
     (substrate-json/frame-kind? "unknown")]
    [true true true true false])

   (test/check
    "validates request response and stream frames"
    [(substrate-json/valid-frame?
      {"kind" "request"
       "id" "req-1"
       "space" "room/a"
       "action" "demo/echo"
       "args" ["ping"]})
     (substrate-json/valid-frame?
      {"kind" "response"
       "id" "res-1"
       "space" "room/a"
       "reply_to" "req-1"
       "status" "ok"})
     (substrate-json/valid-frame?
      {"kind" "stream"
       "id" "evt-1"
       "space" "room/a"
       "signal" "demo/update"})
     (substrate-json/valid-frame?
      {"kind" "request"
       "id" "req-2"
       "space" "room/a"
       "action" "demo/echo"
       "args" {"bad" true}})
     (substrate-json/valid-frame?
      {"kind" "invalid"
       "id" "req-3"
       "space" "room/a"})]
    [true true true false false])

   (test/check
    "normalises arbitrary errors into JSON-safe maps"
    [(substrate-json/normalize-error nil)
     (substrate-json/normalize-error "broken")
     (substrate-json/normalize-error {"error" "denied"})
     (substrate-json/normalize-error {"status" "error"})
     (substrate-json/normalize-error 42)]
    [nil
     {"message" "broken"}
     {"error" "denied" "message" "denied"}
     {"status" "error" "message" "error"}
     {"message" "42"}])

   (test/check
    "normalises response error payloads before emission"
    [(substrate-json/normalize-frame
      {"kind" "response"
       "id" "res-1"
       "space" "room/a"
       "reply_to" "req-1"
       "status" "error"
       "error" {"error" "denied"}})
     (substrate-json/normalize-frame
      {"kind" "request"
       "id" "req-1"
       "space" "room/a"
       "action" "demo/echo"
       "args" []})]
    [{"kind" "response"
      "id" "res-1"
      "space" "room/a"
      "reply_to" "req-1"
      "status" "error"
      "error" {"error" "denied" "message" "denied"}}
     {"kind" "request"
      "id" "req-1"
      "space" "room/a"
      "action" "demo/echo"
      "args" []}])

   (test/check
    "encodes and decodes validated frames"
    (let [encoded
          (substrate-json/encode-frame
           {"kind" "response"
            "id" "res-1"
            "space" "room/a"
            "reply_to" "req-1"
            "status" "error"
            "error" {"error" "denied"}})
          decoded
          (substrate-json/decode-frame
           "{\"kind\":\"stream\",\"id\":\"evt-1\",\"space\":\"room/a\",\"signal\":\"demo/update\",\"data\":{\"ok\":true}}")]
      [(substrate-json/decode-frame encoded)
       decoded])
    [{"kind" "response"
      "id" "res-1"
      "space" "room/a"
      "reply_to" "req-1"
      "status" "error"
      "error" {"error" "denied" "message" "denied"}}
     {"kind" "stream"
      "id" "evt-1"
      "space" "room/a"
      "signal" "demo/update"
      "data" {"ok" true}}])

   (test/check-error
    "rejects invalid frames"
    (substrate-json/encode-frame
     {"kind" "request" "id" "bad" "space" "room/a"}))])

(test/print-results results)
