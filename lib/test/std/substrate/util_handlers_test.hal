(ns std.substrate.util-handlers-test
  (:use code.test)
  (:require [std.lib.substrate :as core]
            [std.substrate.space :as space]
            [std.substrate.util :as util]
            [std.substrate.util-handlers :as handlers]))

(fact "installs the complete utility handler set"
  (let [node (core/node-create "install-node")]
    (handlers/install-util-handlers node)
    (util/list-handlers node))
  => ["@/echo"
      "@/get-service"
      "@/list-handlers"
      "@/list-spaces"
      "@/list-transports"
      "@/list-triggers"
      "@/node-info"
      "@/ping"])

(fact "ping and echo preserve the Foundation contract"
  (let [node (core/node-create "ping-node")]
    [(handlers/ping nil nil nil node)
     (handlers/echo nil [1 2 3] nil node)])
  => [{"pong" true "node" "ping-node"}
      [1 2 3]])

(fact "registry utility handlers report current node state"
  (let [node (core/node-create "registry-node")]
    (handlers/install-util-handlers node)
    (util/register-handler node "echo" identity nil)
    (util/register-trigger node "event/ping" identity nil)
    (space/create-space node "room/a" nil)
    (core/section-put node :transports "peer-a"
                      {"id" "peer-a" "send_fn" identity})
    [(handlers/list-handlers nil nil nil node)
     (handlers/list-triggers nil nil nil node)
     (handlers/list-spaces nil nil nil node)
     (handlers/list-transports nil nil nil node)])
  => [["@/echo"
       "@/get-service"
       "@/list-handlers"
       "@/list-spaces"
       "@/list-transports"
       "@/list-triggers"
       "@/node-info"
       "@/ping"
       "echo"]
      ["event/ping"]
      ["room/a"]
      ["peer-a"]])

(fact "node-info reports id and metadata"
  (let [node (core/node-create "info-node")]
    (core/section-put node :meta "role" "test")
    (handlers/node-info nil nil nil node))
  => {"id" "info-node" "meta" {"role" "test"}})

(fact "get-service returns requested entries"
  (let [node (core/node-create "service-node")]
    (core/section-put node :services "cache" {"scope" "local"})
    [(handlers/handle-get-service nil "cache" nil node)
     (handlers/handle-get-service nil "missing" nil node)])
  => [{"scope" "local"} nil])

(pr-str (run '[std.substrate.util-handlers-test]))
