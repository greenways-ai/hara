(ns std.lib.block-test
  (:require [std.lib.block :as block]
            [std.lib.block.check :as check]
            [std.lib.block.grid :as grid]
            [std.lib.block.reader :as reader]
            [std.block :as compat]
            [std.lib.test :as test]))

(def results
  [(test/check "parse preserves source and value"
               (let [parsed (block/parse-string "[1 2 3]")
                     first-block (block/parse-first "[1 2 3]")]
                 [(block/string parsed)
                  (block/value parsed)
                  (block/type first-block)
                  (block/tag first-block)
                  (vec (map block/value
                            (filter block/code?
                                    (block/children first-block))))])
               ["[1 2 3]" [1 2 3] :container :vector [1 2 3]])
   (test/check "constructs portable whitespace blocks"
               (let [spaces (block/spaces 3)
                     newline (block/newline)]
                 [(block/string spaces)
                  (block/space? spaces)
                  (block/string newline)
                  (block/linebreak? newline)
                  (block/verify newline)])
               ["   " true "\n" true true])
   (test/check "persistent block zipper rebuilds edited containers"
               (let [original (block/block [1 2])
                     zipper (block/block-zip original)
                     edited (std.lib.zip/result
                             (std.lib.zip/replace-right
                              (std.lib.zip/step-right
                               (std.lib.zip/step-right
                               (std.lib.zip/step-inside zipper))
                               )
                              (block/block 3)))]
                 [(block/string original)
                  (block/string edited)
                  (block/string (block/replace-children
                                 original
                                 [(block/block 4)]))])
               ["[1 2]" "[1 3]" "[4]"])
   (test/check "parser preserves nested whitespace, comments, and delimiters"
               (let [parsed (block/parse-string
                             "(alpha  ; note\n [1 {:k \"v\"}])")
                     form (block/parse-first
                           "(alpha  ; note\n [1 {:k \"v\"}])")]
                 [(block/string parsed)
                  (block/string form)
                  (vec (map block/tag (block/children form)))
                  (block/height form)])
               ["(alpha  ; note\n [1 {:k \"v\"}])"
                "(alpha  ; note\n [1 {:k \"v\"}])"
                [:token :space :space :comment :linebreak :space :vector]
                1])
   (test/check "container values apply hash-uneval modifiers"
               (let [form (block/parse-first "[1 #_2 3]")]
                 [(block/value form)
                  (block/child-values form)
                  (block/string form)])
               [[1 3] [1 3] "[1 #_2 3]"])
   (test/check "reader conditionals and cursor dispatch preserve structure"
               (let [selected (block/parse-first "#?(:clj alpha :cljs beta)")
                     spliced (block/parse-first "#?@(:clj [alpha])")
                     cursor (block/parse-first "#|")]
                 [(block/string selected)
                  (block/value selected)
                  (block/string spliced)
                  (block/value spliced)
                  (block/tag cursor)
                  (block/string cursor)])
               ["#?(:clj alpha :cljs beta)"
                '(? {:clj alpha :cljs beta})
                "#?@(:clj [alpha])"
                '(?-splicing {:clj [alpha]})
                :hash-cursor
                "|"])
   (test/check "portable check and reader APIs retain source position"
               (let [input (reader/create "ab\ncd")
                     first-two (reader/read-times input reader/read-char 2)
                     newline (reader/read-char input)]
                 [first-two
                  (check/linebreak? newline)
                  (reader/reader-position input)
                  (reader/read-to-boundary input)])
               [["a" "b"] true [2 1] "cd"])
   (test/check "layout and line metrics retain the archived public surface"
               (let [laid-out (block/layout '(if ready [1 2] [3 4]))
                     wrapped (block/layout '(if ready [1 2] [3 4])
                                           {:width 10})
                     multiline (block/parse-string "alpha\nlonger")]
                 [(block/string laid-out)
                  (block/string wrapped)
                  (block/max-width multiline)
                  (block/line-width multiline)
                  (block/string (block/empty))])
               ["(if ready [1 2] [3 4])"
                "(if\n  ready\n  [1 2]\n  [3 4]\n)"
                6 6 "()"])
   (test/check "grid applies portable indentation rules"
               (let [form (block/parse-first "(if\nready\ndone)")
                     formatted (grid/grid form 0
                                          {:rules {'if {:indent 1}}})]
                 [(block/string form)
                  (block/string formatted)])
               ["(if\nready\ndone)"
                "(if\n  ready\n  done)"])
   (test/check "retains the temporary std.block compatibility facade"
               [(compat/string (compat/parse-string "[1 2]"))
                (compat/value (compat/parse-string "[1 2]"))]
               ["[1 2]" [1 2]])])

(test/print-results results)
