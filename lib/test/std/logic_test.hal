(ns std.logic-test
  (:require [std.logic :as logic]
            [std.lib.test :as test]))

(def results
  [(test/check
    "unifies scalar and nested terms"
    [(logic/run* (fn [query] (logic/== query 42)))
     (logic/run*
      (fn [query]
        (logic/fresh
         (fn [item]
           (logic/all (logic/== item 7)
                      (logic/== query {:items [item item]}))))))]
    [[42] [{:items [7 7]}]])

   (test/check
    "runs disjunction clauses fairly"
    (logic/run* (fn [query]
                  (logic/conde [(logic/== query :tea)]
                               [(logic/== query :coffee)])))
    [:tea :coffee])

   (test/check
    "reifies shared unbound variables"
    (logic/run*
     (fn [query]
       (logic/fresh (fn [item] (logic/== query [item item])))))
    [['_.0 '_.0]])

   (test/check
    "rejects cyclic substitutions with an occurs check"
    (logic/run*
     (fn [query]
       (logic/fresh
        (fn [item]
          (logic/all (logic/== item [item])
                     (logic/== query :unreachable))))))
    [])

   (test/check
    "limits result collection"
    (logic/run 2
               (fn [query]
                 (logic/conde [(logic/== query 1)]
                              [(logic/== query 2)]
                              [(logic/== query 3)])))
    [1 2])])

(test/print-results results)
