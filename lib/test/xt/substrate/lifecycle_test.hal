(ns xt.substrate.lifecycle-test
  (:use code.test)
  (:require [tahto.core :as l]))

^{:seedgen/root {:all true, :langs [:js :lua :python]}}
(l/script- :js
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.spec-promise :as promise]
             [xt.substrate :as node]
             [xt.substrate.base-frame :as frame]
             [xt.substrate.base-request :as request]
             [xt.substrate.base-pubsub :as pubsub]
             [xt.substrate.base-router :as router]]})

(l/script- :lua
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.spec-promise :as promise]
             [xt.substrate :as node]
             [xt.substrate.base-frame :as frame]
             [xt.substrate.base-request :as request]
             [xt.substrate.base-pubsub :as pubsub]
             [xt.substrate.base-router :as router]]})

(l/script- :python
  {:runtime :basic
   :require [[xt.lang.spec-base :as xt]
             [xt.lang.spec-promise :as promise]
             [xt.substrate :as node]
             [xt.substrate.base-frame :as frame]
             [xt.substrate.base-request :as request]
             [xt.substrate.base-pubsub :as pubsub]
             [xt.substrate.base-router :as router]]})

(fact:global
 {:setup [(l/rt:restart)]
  :teardown [(l/rt:stop)]})

^{:refer xt.substrate/request :added "4.1"}
(fact "configures nodes and handles local and pending request lifecycles"

  (!.js
    (var calls [])
    (var resolved [])
    (var n
      (node/node-create
       {:id "node-a"
        :meta {:cluster "test"}
        :services {:cache {:kind "memory"}}
        :spaces {"room/a" {:state {:count 1}
                                   :meta {:owner "alpha"}}}}))
    (node/register-handler
     n "echo"
     (fn [space args incoming current-node]
       (xt/x:arr-push calls [(. space ["id"])
                             (. incoming ["action"])
                             (. current-node ["id"])
                             args])
       (return args))
     nil)
    (var local-output (node/request n "room/a" "echo" [2 3] {:local true}))
    (var incoming (frame/request-frame "room/a" "echo" [] {:id "req-1"}))
    (request/add-pending n incoming
                         (fn [value] (xt/x:arr-push resolved value))
                         (fn [value] (return value))
                         {:transport_id "peer-a"})
    (request/settle-pending
     n
     (frame/response-ok-frame "req-1" "room/a" {:ok true} {:id "res-1"}))
    [(node/node? n)
     (. n ["id"])
     (. (node/get-space-state n "room/a") ["count"])
     (. (node/get-service n "cache") ["kind"])
     (promise/x:promise-native? local-output)
     calls
     resolved
     (xt/x:obj-keys (. n ["pending"]))])
  => [true "node-a" 1 "memory" true
      [["room/a" "echo" "node-a" [2 3]]]
      [{"ok" true}]
      []]

  (!.lua
    (var calls [])
    (var resolved [])
    (var n
      (node/node-create
       {:id "node-a"
        :meta {:cluster "test"}
        :services {:cache {:kind "memory"}}
        :spaces {"room/a" {:state {:count 1}
                                   :meta {:owner "alpha"}}}}))
    (node/register-handler
     n "echo"
     (fn [space args incoming current-node]
       (xt/x:arr-push calls [(. space ["id"])
                             (. incoming ["action"])
                             (. current-node ["id"])
                             args])
       (return args))
     nil)
    (var local-output (node/request n "room/a" "echo" [2 3] {:local true}))
    (var incoming (frame/request-frame "room/a" "echo" [] {:id "req-1"}))
    (request/add-pending n incoming
                         (fn [value] (xt/x:arr-push resolved value))
                         (fn [value] (return value))
                         {:transport_id "peer-a"})
    (request/settle-pending
     n
     (frame/response-ok-frame "req-1" "room/a" {:ok true} {:id "res-1"}))
    [(node/node? n)
     (. n ["id"])
     (. (node/get-space-state n "room/a") ["count"])
     (. (node/get-service n "cache") ["kind"])
     (promise/x:promise-native? local-output)
     calls
     resolved
     (xt/x:obj-keys (. n ["pending"]))])
  => [true "node-a" 1 "memory" true
      [["room/a" "echo" "node-a" [2 3]]]
      [{"ok" true}]
      []]

  (!.py
    (var calls [])
    (var resolved [])
    (var n
      (node/node-create
       {:id "node-a"
        :meta {:cluster "test"}
        :services {:cache {:kind "memory"}}
        :spaces {"room/a" {:state {:count 1}
                                   :meta {:owner "alpha"}}}}))
    (node/register-handler
     n "echo"
     (fn [space args incoming current-node]
       (xt/x:arr-push calls [(. space ["id"])
                             (. incoming ["action"])
                             (. current-node ["id"])
                             args])
       (return args))
     nil)
    (var local-output (node/request n "room/a" "echo" [2 3] {:local true}))
    (var incoming (frame/request-frame "room/a" "echo" [] {:id "req-1"}))
    (request/add-pending n incoming
                         (fn [value] (xt/x:arr-push resolved value))
                         (fn [value] (return value))
                         {:transport_id "peer-a"})
    (request/settle-pending
     n
     (frame/response-ok-frame "req-1" "room/a" {:ok true} {:id "res-1"}))
    [(node/node? n)
     (. n ["id"])
     (. (node/get-space-state n "room/a") ["count"])
     (. (node/get-service n "cache") ["kind"])
     (promise/x:promise-native? local-output)
     calls
     resolved
     (xt/x:obj-keys (. n ["pending"]))])
  => [true "node-a" 1 "memory" true
      [["room/a" "echo" "node-a" [2 3]]]
      [{"ok" true}]
      []])

^{:refer xt.substrate/publish :added "4.1"}
(fact "dispatches triggers and manages routed transport lifecycle"

  (!.js
    (var started [])
    (var stopped [])
    (var sent [])
    (var n (node/node-create {:id "node-a"}))
    (node/register-trigger
     n "event/updated"
     (fn [space stream current-node]
       (node/set-space-state current-node (. space ["id"]) (. stream ["data"]))
       (return true))
     nil)
    (var trigger-output
      (pubsub/receive-publish
       n
       (frame/stream-frame "room/a" "event/updated" {:value 9} {:id "evt-1"} nil)))
    (var transport
      (node/transport-create
       "peer-a"
       {:start_fn (fn [listener]
                    (xt/x:arr-push started (xt/x:is-function? listener))
                    (return {:token "listener-a"}))
        :stop_fn (fn [listener]
                   (xt/x:arr-push stopped (. listener ["token"]))
                   (return true))
        :send_fn (fn [outgoing]
                   (xt/x:arr-push sent [(. outgoing ["kind"])
                                        (. outgoing ["signal"])
                                        (. outgoing ["data"] ["value"])])
                   (return outgoing))}))
    (var attached (node/attach-transport n "peer-a" transport))
    (router/add-subscription n "peer-a" "room/a" "event/updated" "sub-1" nil)
    (var published (node/publish n "room/a" "event/updated" {:value 12} nil))
    (var detached (node/detach-transport n "peer-a"))
    [(promise/x:promise-native? trigger-output)
     (node/get-space-state n "room/a")
     (promise/x:promise-native? attached)
     started
     (promise/x:promise-native? published)
     sent
     (promise/x:promise-native? detached)
     (node/transport-list n)
     stopped])
  => [true {"value" 12} true [true] true
      [["stream" "event/updated" 12]]
      true [] ["listener-a"]]

  (!.lua
    (var started [])
    (var stopped [])
    (var sent [])
    (var n (node/node-create {:id "node-a"}))
    (node/register-trigger
     n "event/updated"
     (fn [space stream current-node]
       (node/set-space-state current-node (. space ["id"]) (. stream ["data"]))
       (return true))
     nil)
    (var trigger-output
      (pubsub/receive-publish
       n
       (frame/stream-frame "room/a" "event/updated" {:value 9} {:id "evt-1"} nil)))
    (var transport
      (node/transport-create
       "peer-a"
       {:start_fn (fn [listener]
                    (xt/x:arr-push started (xt/x:is-function? listener))
                    (return {:token "listener-a"}))
        :stop_fn (fn [listener]
                   (xt/x:arr-push stopped (. listener ["token"]))
                   (return true))
        :send_fn (fn [outgoing]
                   (xt/x:arr-push sent [(. outgoing ["kind"])
                                        (. outgoing ["signal"])
                                        (. outgoing ["data"] ["value"])])
                   (return outgoing))}))
    (var attached (node/attach-transport n "peer-a" transport))
    (router/add-subscription n "peer-a" "room/a" "event/updated" "sub-1" nil)
    (var published (node/publish n "room/a" "event/updated" {:value 12} nil))
    (var detached (node/detach-transport n "peer-a"))
    [(promise/x:promise-native? trigger-output)
     (node/get-space-state n "room/a")
     (promise/x:promise-native? attached)
     started
     (promise/x:promise-native? published)
     sent
     (promise/x:promise-native? detached)
     (node/transport-list n)
     stopped])
  => [true {"value" 12} true [true] true
      [["stream" "event/updated" 12]]
      true [] ["listener-a"]]

  (!.py
    (var started [])
    (var stopped [])
    (var sent [])
    (var n (node/node-create {:id "node-a"}))
    (node/register-trigger
     n "event/updated"
     (fn [space stream current-node]
       (node/set-space-state current-node (. space ["id"]) (. stream ["data"]))
       (return true))
     nil)
    (var trigger-output
      (pubsub/receive-publish
       n
       (frame/stream-frame "room/a" "event/updated" {:value 9} {:id "evt-1"} nil)))
    (var transport
      (node/transport-create
       "peer-a"
       {:start_fn (fn [listener]
                    (xt/x:arr-push started (xt/x:is-function? listener))
                    (return {:token "listener-a"}))
        :stop_fn (fn [listener]
                   (xt/x:arr-push stopped (. listener ["token"]))
                   (return true))
        :send_fn (fn [outgoing]
                   (xt/x:arr-push sent [(. outgoing ["kind"])
                                        (. outgoing ["signal"])
                                        (. outgoing ["data"] ["value"])])
                   (return outgoing))}))
    (var attached (node/attach-transport n "peer-a" transport))
    (router/add-subscription n "peer-a" "room/a" "event/updated" "sub-1" nil)
    (var published (node/publish n "room/a" "event/updated" {:value 12} nil))
    (var detached (node/detach-transport n "peer-a"))
    [(promise/x:promise-native? trigger-output)
     (node/get-space-state n "room/a")
     (promise/x:promise-native? attached)
     started
     (promise/x:promise-native? published)
     sent
     (promise/x:promise-native? detached)
     (node/transport-list n)
     stopped])
  => [true {"value" 12} true [true] true
      [["stream" "event/updated" 12]]
      true [] ["listener-a"]])
