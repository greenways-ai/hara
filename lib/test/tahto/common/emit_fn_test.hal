(ns tahto.common.emit-fn-test
  (:use code.test)
  (:require [tahto.common.emit-fn :as function]
            [tahto.common.emit-helper :as helper]))

(fact "emits typed function inputs"
  (function/emit-input-default
   {:modifiers [:const :int] :symbol 'value :force true :value 42}
   "=" helper/+default+ {})
  => "const int value = 42"

  (function/emit-input-default
   {:modifiers [[]] :symbol 'values}
   "=" helper/+default+ {})
  => "values[]")

(fact "emits function preambles"
  (function/emit-fn-preamble
   [:function 'add '(:int x :int y)] helper/+default+ {})
  => "add(int x,int y)")

(fact "merges function block options"
  (:raw (function/emit-fn-block
         :function
         (assoc-in helper/+default+ [:function :function :raw] "fn")))
  => "fn")

(fact "emits return hints and multiline preambles"
  (function/emit-hint-type
   {:uppercase true} (with-meta 'value {:- [:int []]}) nil
   helper/+default+ {})
  => "INT []"

  (function/emit-fn-preamble
   [:function 'add '(:int x :int y)]
   (assoc-in helper/+default+
             [:function :function :args :multiline] true)
   {})
  => "add(\n  int x,\n  int y\n)")

(fact "emits function bodies and header-only declarations"
  (function/emit-fn
   :function '(function add [:int x] (return x))
   helper/+default+ {})
  => "function add(int x){\n  (return x);\n}"

  (function/emit-fn
   :function
   (list 'function (with-meta 'add {:header true}) [:int 'x])
   helper/+default+ {})
  => "function add(int x);")

(run {:namespace "tahto.common.emit-fn-test"})
