(ns tahto.common.emit-test
  (:require [std.lib.test :as test]
            [tahto.common.emit :as emit]
            [tahto.common.grammar-api :as grammar]
            [tahto.common.registry :as registry]
            [tahto.protocol.compiler :as compiler]))

(def template
  (grammar/emit-template
   {:template/id :js-default
    :template/version 1
    :template/value
    {:token {:nil "null"}}}))

(def grammar-v1
  (grammar/definition
   {:grammar/id :js
    :grammar/version 1
    :grammar/release "v1"
    :grammar/emit-template
    {:template/id :js-default
     :template/version 1}
    :operators
    {:define
     {:add {:op :add
          :symbol #{'+}
          :type :operator
          :emit :infix
          :raw "+"}}}}))

(def grammar-v2
  (grammar/definition
   {:grammar/id :js
    :grammar/version 2
    :grammar/release "v2"
    :grammar/emit-template
    {:template/id :js-default
     :template/version 1}
    :operators
    {:define
     {:add {:op :add
          :symbol #{'+}
          :type :operator
          :emit :infix
          :raw "plus"}}}}))

(def catalog
  (registry/install
   (registry/install
    (registry/install
     (registry/registry)
     template)
    grammar-v1)
   grammar-v2))

(def selected-v1
  (registry/resolve
   catalog
   {:grammar/id :js
    :grammar/version 1}))

(def selected-v2
  (registry/resolve
   catalog
   {:grammar/id :js
    :grammar/version 2}))

(def emitter-instance
  (emit/emitter))

(def results
  [(test/check "emit recursively uses a resolved grammar"
               (compiler/emit-form
                emitter-instance
                '(+ 1 (+ 2 3))
                selected-v1
                {})
               "(1 + (2 + 3))")
   (test/check "grammar versions select different emit behavior"
               [(emit/emit '(+ 1 2) selected-v1)
                (emit/emit '(+ 1 2) selected-v2)]
               ["(1 + 2)"
                "(1 plus 2)"])
   (test/check "tokens use the selected emit template"
               (emit/emit nil selected-v1)
               "null")])

(test/print-results results)
