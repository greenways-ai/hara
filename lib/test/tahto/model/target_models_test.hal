(ns tahto.model.target-models-test
  (:use code.test)
  (:require [tahto.common.emit :as emit]
            [tahto.model.v1.spec-js :as spec-js]
            [tahto.model.v1.spec-python :as spec-python]))

(def js (spec-js/select))
(def py (spec-python/select))

(fact "JavaScript keeps the Foundation language and grammar tag"
  [spec-js/+language+ spec-js/+tag+
   (get-in js [:coordinate :grammar/id])
   (get-in js [:grammar :tag])]
  => [:js :js :js :js])

(fact "Python keeps the Foundation language and grammar tag"
  [spec-python/+language+ spec-python/+tag+
   (get-in py [:coordinate :grammar/id])
   (get-in py [:grammar :tag])]
  => [:python :py :py :py])

(fact "target models inherit the versioned XTalk/common model"
  [(:provenance js) (:provenance py)]
  => [[[:emit-template :xtalk 1]
       [:profile :xtalk 1]
       [:grammar :xtalk 1]
       [:grammar :js 1]]
      [[:emit-template :xtalk 1]
       [:profile :xtalk 1]
       [:grammar :xtalk 1]
       [:grammar :py 1]]])

(fact "target grammars emit executable forms"
  [(emit/emit '(console.log (+ 19 23)) js)
   (emit/emit '(print (+ 19 23)) py)
   (emit/emit '(defn add [x y] (return (+ x y))) js)
   (emit/emit '(defn add [x y] (return (+ x y))) py)]
  => ["console.log((19 + 23))"
      "print((19 + 23))"
      "function add(x, y) {\n  return (x + y);\n}"
      "def add(x, y):\n    return (x + y)"])

(fact "target literals differ by language"
  [(emit/emit nil js) (emit/emit true js)
   (emit/emit nil py) (emit/emit true py)]
  => ["null" "true" "None" "True"])

(run {:namespace "tahto.model.target-models-test"})
