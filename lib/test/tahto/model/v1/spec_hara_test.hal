(ns tahto.model.v1.spec-hara-test
  (:use code.test)
  (:require [std.foundation.string :as string]
            [tahto.common.compiler :as compiler]
            [tahto.model.v1.spec-hara :as hara]
            [tahto.model.v1.spec-hara.emit :as hara-emit]
            [tahto.runtime.hara-support]))

(def selected (hara/select))
(def instance (compiler/compiler))

(def mutable-source
  '(do
     (var out 1)
     (:= out (+ out 2))
     out))

(def mutable-compiled
  (compiler/compile instance mutable-source selected))

^{:refer tahto.model.v1.spec-hara/select :added "4.1"}
(fact "installs a concrete Hara grammar beneath abstract XTalk"
  [hara/+language+
   hara/+tag+
   (get-in selected [:coordinate :grammar/id])
   (get-in selected [:coordinate :grammar/version])
   (:provenance selected)]
  => [:hara
      :hara
      :hara
      1
      [[:emit-template :xtalk 1]
       [:profile :xtalk 1]
       [:grammar :xtalk 1]
       [:grammar :hara 1]]])

^{:refer tahto.model.v1.spec-hara.emit/rewrite-hara-source :added "4.1"}
(fact "emits parseable Hara source through the normal Tahto compiler"
  (read-string (:output mutable-compiled))
  => '(let [out (atom 1)]
        (do
          (reset! out (+ (deref out) 2))
          (deref out))))

^{:refer tahto.model.v1.spec-hara.emit/lower-top :added "4.1"}
(fact "lowers XTalk mutable locals without introducing mutable Hara bindings"
  (eval (hara-emit/lower-top mutable-source {}))
  => 3)

^{:refer tahto.model.v1.spec-hara.emit/lower-top :added "4.1"}
(fact "preserves return from nested branches using private control signals"
  (let [function
        (eval
         (hara-emit/lower-top
          '(fn [x]
             (br*
              (if (< x 0) (return -1))
              (else (return 1))))
          {}))]
    [(function -4) (function 4)])
  => [-1 1])

^{:refer tahto.model.v1.spec-hara.emit/lower-top :added "4.1"}
(fact "lowers canonical three-part loops onto Hara loop/recur"
  (eval
   (hara-emit/lower-top
    '(do
       (var out 0)
       (for [(var i 0)
             (< i 4)
             (:= i (+ i 1))]
         (:= out (+ out i)))
       out)
    {}))
  => 6)

^{:refer tahto.model.v1.spec-hara.emit/lower-top :added "4.1"}
(fact "supports structural mutation while retaining persistent values"
  (eval
   (hara-emit/lower-top
    '(do
       (var state {"count" 1})
       (x:set-key state "count" 2)
       state)
    {}))
  => {"count" 2})

^{:refer tahto.model.v1.spec-hara.emit/lower-top :added "4.1"}
(fact "keeps unsupported host-sensitive operations explicit"
  (try
    (hara-emit/lower-top '(x:shell "pwd") {})
    nil
    (catch Throwable error
      [(ex-message error)
       (get (ex-data error) :tahto/error-code)
       (get (ex-data error) :form)]))
  => ["XTalk operation is not yet implemented by the Hara target"
      :tahto.hara/unsupported-form
      '(x:shell "pwd")])

^{:refer tahto.model.v1.spec-hara.emit/rewrite-hara-source :added "4.1"}
(fact "uses the existing raw internal-string emitter rather than a second emitter stack"
  (let [target (get-in mutable-compiled [:stages :target])]
    [(first target)
     (string/includes? (second target) "atom")
     (= (second target) (:output mutable-compiled))])
  => ['-%%- true true])

^{:refer tahto.model.v1.spec-hara/select :added "4.1"}
(fact "resolves exactly one callable target rewrite hook"
  [(count (get-in selected [:rewrite :target]))
   (into [] (map fn? (get-in selected [:rewrite :target])))]
  => [1 [true]])

^{:refer tahto.model.v1.spec-hara.emit/lower-top :added "4.1"}
(fact "rebuilds portable function calls as Hara call data"
  (hara-emit/lower-top '(gcd 54 24) {})
  => '(gcd 54 24))

^{:refer tahto.model.v1.spec-hara.emit/rewrite-hara-source :added "4.1"}
(fact "wraps portable function calls in the raw Hara source operation"
  (hara-emit/rewrite-hara-source '(gcd 54 24) {})
  => '(-%%- "(gcd 54 24)"))

^{:refer tahto.common.compiler/compile :added "4.1"}
(fact "compiles an ordinary portable function call through the Hara target hook"
  (:output (compiler/compile instance '(gcd 54 24) selected))
  => "(gcd 54 24)")

^{:refer tahto.model.v1.spec-hara.emit/canonical-op :added "4.1"}
(fact "normalizes linked XTalk operation symbols before target mapping"
  [(hara-emit/canonical-op 'x:m-mod)
   (hara-emit/canonical-op 'xt.lang.spec-base/x:m-mod)
   (hara-emit/lower-top '(xt.lang.spec-base/x:m-mod 5 2) {})]
  => ['x:m-mod 'x:m-mod '(mod 5 2)])

