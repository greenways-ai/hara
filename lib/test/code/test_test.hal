(ns code.test-test
  (:use code.test)
  (:require [std.lib.test :as legacy]))

(fact "evaluates ordinary equality"
  (+ 20 22) => 42
  (+ 1 2 3) => 6)

(fact "awaits promise-returning assertions"
  (promise/from 42) => 42)

(fact "matches thrown values"
  (throw "expected") => (throws))

(fact "supports predicate matchers"
  {:tags [:unit :matcher]}
  42 => (satisfies (fn [value] (= 42 value))))

(fact "records skipped facts"
  {:skip true :tags [:slow]}
  (throw "must not run") => :never)

(def lifecycle (atom []))

(fact "runs promise-aware fixtures"
  {:before (fn []
             (swap! lifecycle (fn [events] (conj events :before))))
   :after (fn []
            (swap! lifecycle (fn [events] (conj events :after))))}
  (promise/from :ready) => :ready)

(def reporter (event-reporter))
(def summary (run {:namespace "code.test-test"
                   :reporter reporter}))

(def timeout-timer
  (function-timer
   (fn [promise milliseconds]
     {:promise (promise/from {:test/status :timeout})
      :timeout milliseconds})
   (fn [timeout] timeout)))

(def timeout-result
  (check (fn [] (promise/from 42))
         42
         {:timer timeout-timer
          :timeout 25}))

(def cancelled-summary
  (run {:namespace "code.test-test"
        :control (function-control (fn [fact] true))}))

(def fixture-events (atom []))
(def fixture-summary
  (run {:namespace "code.test-test"
        :name "evaluates ordinary equality"
        :before-all (fn []
                      (swap! fixture-events
                             (fn [events] (conj events :before-all))))
        :before-each (fn []
                       (swap! fixture-events
                              (fn [events] (conj events :before-each))))
        :after-each (fn []
                      (swap! fixture-events
                             (fn [events] (conj events :after-each))))
        :after-all (fn []
                     (swap! fixture-events
                            (fn [events] (conj events :after-all))))}))

(def tagged-summary
  (run {:namespace "code.test-test"
        :include-tags :matcher}))

(def fail-fast-runs (atom 0))
(register! "fail-fast/1"
           (fn [options]
             [{:pass false :actual :no :expected :yes}]))
(register! "fail-fast/2"
           (fn [options]
             (do
               (swap! fail-fast-runs inc)
               [{:pass true :actual :yes :expected :yes}])))
(def fail-fast-summary
  (run {:namespace "code.test-test"
        :name "fail-fast/"
        :fail-fast true}))
(remove-fact "fail-fast/1")
(remove-fact "fail-fast/2")

(def clock-values (atom [10 18]))
(def timed-result
  (run-fact
   (get-fact "code.test-test" "evaluates ordinary equality")
   +null-reporter+
   {:clock
    (function-clock
     (fn []
       (let [value (first (deref clock-values))]
         (swap! clock-values rest)
         value)))}))

(def results
  [(legacy/check "portable facts pass"
                 [(get summary :status)
                  (get (get summary :counts) :passed)
                  (count (get summary :results))
                  (count (get (first (get summary :results)) :checks))
                  (deref lifecycle)]
                 [:passed 5 6 1 [:before :after]])
   (legacy/check "runner emits structured events without printing"
                 (vec (map (fn [report] (get report :event))
                           (reporter-events reporter)))
                 [:run/start
                  :fact/start :fact/end
                  :fact/start :fact/end
                  :fact/start :fact/end
                  :fact/start :fact/end
                  :fact/start :fact/end
                  :fact/start :fact/end
                  :run/end])
   (legacy/check "host timers classify timeout diagnostics"
                 [(get timeout-result :status)
                  (get timeout-result :pass)
                  (get timeout-result :timeout)]
                 [:timeout false 25])
   (legacy/check "host control cancels facts without invoking them"
                 [(get cancelled-summary :status)
                  (get (get cancelled-summary :counts) :cancelled)
                  (deref lifecycle)]
                 [:passed 5 [:before :after]])
   (legacy/check "host clocks attach deterministic elapsed time"
                 [(get timed-result :status) (get timed-result :elapsed)]
                 [:passed 8])
   (legacy/check "runner supports suite fixtures, selectors, tags, and skips"
                 [(deref fixture-events)
                  (get fixture-summary :facts)
                  (get tagged-summary :facts)
                  (get (get summary :counts) :skipped)
                  (get (get summary :checks) :total)
                  (get (get fail-fast-summary :counts) :failed)
                  (get (get fail-fast-summary :counts) :cancelled)
                  (deref fail-fast-runs)]
                 [[:before-all :before-each :after-each :after-all]
                  1 1 1 6 1 1 0])])

(legacy/print-results results)
