---
import {
  catalog,
  comparisonResult,
  evidence,
  formatTime,
  runtimeBaseline,
  runtimeIndex,
  steadyRatioFor,
  workloadMeta,
  workloads
} from "../lib/benchmark-data";
---
<section class="tab-panel" role="tabpanel" id="hara-artifacts" aria-labelledby="tab-hara" hidden>
  <header><p class="hara-kicker">Nine measured artifacts · one language</p><h2>Hara runtimes</h2><p>Preparation, first invocation, steady state, and throughput remain separate so deployment and execution costs are not blurred together.</p></header>
  {evidence ? <section class="comparison-results" aria-labelledby="runtime-matrix-title">
    <header class="section-heading">
      <div><p class="hara-kicker">Benchmark results</p><h3 id="runtime-matrix-title">Hara runtime matrix</h3><p>Each cell compares steady-state timing against <code>{runtimeBaseline}</code>. Select a cell to inspect all four boundaries.</p></div>
      <div class="matrix-legend" aria-label="Matrix legend"><span class="legend-ahead">Baseline ahead</span><span class="legend-behind">Baseline behind</span></div>
    </header>
    <div class="matrix-stage">
      <div class="matrix-scroll" tabindex="0" aria-label="Scrollable Hara runtime comparison matrix">
        <table class="comparison-matrix">
          <thead><tr><th scope="col">Artifact</th>{workloads.map((workload) => <th scope="col">{workloadMeta[workload]?.label ?? workload}</th>)}</tr></thead>
          <tbody>
            <tr class="hara-baseline"><th scope="row"><strong>{runtimeBaseline}</strong><code>baseline</code></th>{workloads.map(() => <td><span class="baseline-cell"><strong>1.00×</strong><span>baseline</span></span></td>)}</tr>
            {catalog.artifacts.filter((artifact) => artifact.id !== runtimeBaseline).map((artifact) => <tr>
              <th scope="row"><strong>{artifact.id}</strong><code>{artifact.host} · {artifact.representation}</code></th>
              {workloads.map((workload) => {
                const row = runtimeIndex.get(`${artifact.id}/${workload}`);
                const baseline = runtimeIndex.get(`${runtimeBaseline}/${workload}`);
                if (!row || !baseline) {
                  return <td><span class="baseline-cell"><strong>—</strong><span>pending</span></span></td>;
                }
                const ratio = steadyRatioFor(artifact.id, workload);
                const result = comparisonResult(ratio);
                return <td><button class:list={["matrix-cell", result.status]} type="button" data-comparison-cell data-kind="runtime" data-runtime-label={artifact.id} data-workload-label={workloadMeta[workload]?.label ?? workload} data-workload-summary={workloadMeta[workload]?.summary} data-ratio={ratio} data-result={result.text} data-steady={formatTime(row.steady_ns)} data-baseline-steady={formatTime(baseline.steady_ns)} data-prepare={formatTime(row.prepare_ns)} data-first={formatTime(row.first_ns)} data-throughput={row.throughput_per_sec.toFixed(1)} aria-pressed="false"><strong>{result.value}</strong><span>{result.label}</span></button></td>;
              })}
            </tr>)}
          </tbody>
        </table>
      </div>
      <aside class="matrix-detail" data-matrix-detail aria-live="polite">
        <p class="hara-kicker">Selected runtime</p><h4 data-detail-title>Select a result</h4><p data-detail-summary>Choose a cell to inspect the four boundaries.</p>
        <dl><div><dt data-detail-label-a>Artifact</dt><dd data-detail-hara>—</dd></div><div><dt data-detail-runtime-label>Baseline</dt><dd data-detail-runtime>—</dd></div><div><dt>Result</dt><dd data-detail-result>—</dd></div></dl>
      </aside>
    </div>
  </section> : <p class="summary-note">The nine-runtime reference run remains gated until every native-image and browser cell can be produced on one pinned host.</p>}
  <section class="result-explanation compact" aria-labelledby="runtime-explanation-title"><header><p class="hara-kicker">What just happened</p><h3 id="runtime-explanation-title">Four boundaries, not one vague speed number.</h3></header><div class="method-grid"><article><h4>Prepare</h4><p>Load or compile the representation once.</p></article><article><h4>First</h4><p>Execute the first prepared invocation.</p></article><article><h4>Steady</h4><p>Use the converged prepared-call window.</p></article><article><h4>Calls/s</h4><p>Invert steady timing into throughput.</p></article></div></section>
  <div class="artifact-specs">{catalog.artifacts.map((artifact) => <article><code>{artifact.id}</code><b>{artifact.host} · {artifact.representation}</b><p>{artifact.summary}</p><small>{artifact.invocation}</small></article>)}</div>
</section>
