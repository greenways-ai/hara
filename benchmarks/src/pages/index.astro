---
import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/motifs.css";
import "../styles/site.css";
import "@hara-lang/visual-language/theme.js";
import SiteHeader from "../components/SiteHeader.astro";
import LanguagePanel from "../components/LanguagePanel.astro";
import RuntimePanel from "../components/RuntimePanel.astro";
import HttpPanel from "../components/HttpPanel.astro";
import RuntimeReference from "../components/RuntimeReference.astro";
import { comparisonRows, evidenceDate, workloads } from "../lib/benchmark-data";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const pageUrl = new URL(basePath, Astro.site);
const socialImage = "https://www.hara-lang.org/og-hara-ribbon.jpg";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Reproducible Hara runtime, language, and HTTP benchmarks." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Hara Benchmarks" />
  <meta property="og:description" content="Reproducible Hara runtime, language, and HTTP benchmarks." />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:secure_url" content={socialImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Hara — A programmable kernel. Embedded everywhere." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Hara Benchmarks" />
  <meta name="twitter:description" content="Reproducible Hara runtime, language, and HTTP benchmarks." />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content="Hara — A programmable kernel. Embedded everywhere." />
  <link rel="canonical" href={pageUrl} />
  <link rel="icon" href={`${basePath}assets/hara-favicon.svg`} type="image/svg+xml" />
  <title>Hara Benchmarks</title>
</head>
<body>
  <SiteHeader />
  <main>
    <section class="summary hara-motif" data-motif="rack"><div class="summary-inner"><p class="hara-kicker">Reproducible performance evidence</p><h1>Hara benchmarks</h1><p class="lede">Start with the language shootout: where Hara leads, where it trails, and the exact workloads behind every comparison.</p><div class="evidence-line"><span class="evidence-dot ready"></span><span>Published {evidenceDate}</span><span aria-hidden="true">·</span><span>{workloads.length} workloads</span><span aria-hidden="true">·</span><span>{comparisonRows.length} comparison languages</span></div></div></section>
    <section class="results-shell">
      <div class="tabs" role="tablist" aria-label="Benchmark sections"><button role="tab" aria-selected="true" aria-controls="language-shootout" id="tab-languages">Language shootout</button><button role="tab" aria-selected="false" aria-controls="http-results" id="tab-http" tabindex="-1">HTTP</button><button role="tab" aria-selected="false" aria-controls="hara-artifacts" id="tab-hara" tabindex="-1">Hara runtimes</button></div>
      <LanguagePanel /><HttpPanel /><RuntimePanel />
    </section>
    <RuntimeReference />
  </main>
  <footer><span>Hara benchmark evidence</span><a href="https://github.com/hara-lang/hara/tree/main/lib/bench">Methods and raw data</a></footer>
  <script>
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const activate = (tab: HTMLButtonElement, focus = true) => {
      tabs.forEach((item) => {
        const active = item === tab;
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
        const panel = item.getAttribute("aria-controls");
        if (panel) document.getElementById(panel)?.toggleAttribute("hidden", !active);
      });
      if (focus) tab.focus();
      history.replaceState(null, "", `#${tab.getAttribute("aria-controls")}`);
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight"].includes(event.key)) return;
        event.preventDefault();
        activate(tabs[(index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length]);
      });
    });
    const initialTab = tabs.find((tab) => `#${tab.getAttribute("aria-controls")}` === location.hash);
    if (initialTab) activate(initialTab, false);

    const formatNs = (value: number) => {
      if (!Number.isFinite(value)) return "Pending";
      return value < 1_000 ? `${value.toFixed(1)} ns` : value < 1_000_000 ? `${(value / 1_000).toFixed(1)} µs` : `${(value / 1_000_000).toFixed(2)} ms`;
    };
    const cells = [...document.querySelectorAll<HTMLButtonElement>("[data-comparison-cell]")];
    const selectCell = (cell: HTMLButtonElement) => {
      const stage = cell.closest(".matrix-stage");
      const detail = stage?.querySelector<HTMLElement>("[data-matrix-detail]");
      stage?.querySelectorAll("[data-comparison-cell]").forEach((item) => item.setAttribute("aria-pressed", String(item === cell)));
      if (!detail) return;
      const competitor = cell.dataset.runtimeLabel ?? "Competitor";
      detail.querySelector<HTMLElement>("[data-detail-title]")!.textContent = `Hara vs ${competitor}`;
      detail.querySelector<HTMLElement>("[data-detail-runtime-label]")!.textContent = competitor;
      detail.querySelector<HTMLElement>("[data-detail-result]")!.textContent = cell.dataset.result ?? "Pending";
      if (cell.dataset.kind === "overall") {
        detail.querySelector<HTMLElement>("[data-detail-summary]")!.textContent = `All workloads. Hara wins ${cell.dataset.haraWins}; ${competitor} wins ${cell.dataset.competitorWins}.`;
        detail.querySelector<HTMLElement>("[data-detail-hara]")!.textContent = "1.00× baseline";
        detail.querySelector<HTMLElement>("[data-detail-runtime]")!.textContent = `${Number(cell.dataset.ratio).toFixed(2)}× Hara time`;
      } else if (cell.dataset.kind === "http") {
        detail.querySelector<HTMLElement>("[data-detail-title]")!.textContent = `hoplite-raw vs ${competitor}`;
        detail.querySelector<HTMLElement>("[data-detail-label-a]")!.textContent = competitor;
        detail.querySelector<HTMLElement>("[data-detail-runtime-label]")!.textContent = "hoplite-raw baseline";
        detail.querySelector<HTMLElement>("[data-detail-summary]")!.textContent = `${cell.dataset.workloadLabel} · mean ${cell.dataset.meanMs} ms · p95 ${cell.dataset.p95Ms} ms`;
        detail.querySelector<HTMLElement>("[data-detail-hara]")!.textContent = `${cell.dataset.rps} req/s`;
        detail.querySelector<HTMLElement>("[data-detail-runtime]")!.textContent = `${cell.dataset.baselineRps} req/s`;
      } else if (cell.dataset.kind === "runtime") {
        detail.querySelector<HTMLElement>("[data-detail-title]")!.textContent = `${competitor} vs hara-rust-full`;
        detail.querySelector<HTMLElement>("[data-detail-label-a]")!.textContent = competitor;
        detail.querySelector<HTMLElement>("[data-detail-runtime-label]")!.textContent = "hara-rust-full baseline";
        detail.querySelector<HTMLElement>("[data-detail-summary]")!.textContent = `${cell.dataset.workloadLabel}: prepare ${cell.dataset.prepare} · first ${cell.dataset.first} · ${cell.dataset.throughput} calls/s`;
        detail.querySelector<HTMLElement>("[data-detail-hara]")!.textContent = cell.dataset.steady ?? "—";
        detail.querySelector<HTMLElement>("[data-detail-runtime]")!.textContent = cell.dataset.baselineSteady ?? "—";
      } else {
        detail.querySelector<HTMLElement>("[data-detail-summary]")!.textContent = `${cell.dataset.workloadLabel}: ${cell.dataset.workloadSummary}`;
        detail.querySelector<HTMLElement>("[data-detail-hara]")!.textContent = formatNs(Number(cell.dataset.haraNs));
        detail.querySelector<HTMLElement>("[data-detail-runtime]")!.textContent = formatNs(Number(cell.dataset.runtimeNs));
      }
    };
    cells.forEach((cell) => cell.addEventListener("click", () => selectCell(cell)));
    document.querySelectorAll(".matrix-stage").forEach((stage) => {
      const stageCells = [...stage.querySelectorAll<HTMLButtonElement>("[data-comparison-cell]")];
      const initialCell = stageCells.find((cell) => cell.dataset.initial === "true") ?? stageCells[0];
      if (initialCell) selectCell(initialCell);
    });
  </script>
</body>
</html>
