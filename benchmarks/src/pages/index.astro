---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import ThemeToggle from "@hara-lang/visual-language/astro/ThemeToggle.astro";
import HaraMark from "@hara-lang/visual-language/astro/HaraMark.astro";
import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/motifs.css";
import "../styles/site.css";
import "@hara-lang/visual-language/theme.js";
import catalog from "../../../lib/bench/catalog.json";

const evidencePath = resolve("lib/bench/results/reference-v2.json");
type Measurement = { runtime:string; workload:string; prepare_ns:number; first_ns:number; steady_ns:number; throughput_per_sec:number };
type Evidence = { measurements:Measurement[]; environment:{timestamp:string}; startup:Record<string,{p50_ns:number}>; artifacts:Record<string,{transfer_bytes:number}> };
const evidence: Evidence | null = existsSync(evidencePath) ? JSON.parse(readFileSync(evidencePath, "utf8")) : null;
const index = new Map<string, Measurement>((evidence?.measurements ?? []).map((row) => [`${row.runtime}/${row.workload}`, row]));
const formatTime = (ns:number | null | undefined) => ns == null ? "Pending" : ns < 1e6 ? `${(ns / 1e3).toFixed(1)} µs` : `${(ns / 1e6).toFixed(2)} ms`;
const formatSize = (bytes:number | null | undefined) => bytes == null ? "Pending" : bytes < 1e6 ? `${(bytes / 1e3).toFixed(0)} KB` : `${(bytes / 1e6).toFixed(2)} MB`;
const geometricMean = (values:number[]) => values.length ? Math.exp(values.reduce((sum, value) => sum + Math.log(value), 0) / values.length) : null;
const baseline = Object.fromEntries(catalog.corpus.workloads.map((workload) => [workload, index.get(`hara-rust-full/${workload}`)?.steady_ns]));
const speedIndex = (runtime:string) => geometricMean(catalog.corpus.workloads.flatMap((workload) => {
  const value = index.get(`${runtime}/${workload}`)?.steady_ns;
  return value && baseline[workload] ? [baseline[workload] / value] : [];
}));
const artifactMetrics = catalog.artifacts.map((artifact) => ({ ...artifact,
  speed: speedIndex(artifact.id),
  startup: evidence?.startup?.[artifact.id]?.p50_ns,
  size: evidence?.artifacts?.[artifact.id]?.transfer_bytes
}));
const timestamp = evidence?.environment?.timestamp ?? "A complete standard reference run has not been committed yet";
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Reproducible Hara runtime, language, and HTTP benchmarks."/><link rel="canonical" href={new URL(basePath, Astro.site)}/><link rel="icon" href={`${basePath}assets/hara-favicon.svg`} type="image/svg+xml"/><title>Hara Benchmarks</title></head>
<body>
  <header class="site-header"><a class="brand" href="https://www.hara-lang.org/"><HaraMark size={26}/><span>Hara</span></a><nav><a href="https://www.hara-lang.org/docs/">Docs</a><a href="https://specs.hara-lang.org/">Specs</a><a href="https://github.com/hara-lang/hara">Source</a></nav><ThemeToggle/></header>
  <main>
    <section class="summary hara-motif" data-motif="rack">
      <div class="summary-inner">
        <p class="hara-kicker">Reproducible performance evidence</p>
        <h1>Hara benchmarks</h1>
        <p class="lede">Bytecode VM and full compilation across native Rust, browser WebAssembly, JVM, and Truffle Native Image.</p>
        <div class="evidence-line"><span class:list={["evidence-dot", { ready: evidence }]}></span><span>{timestamp}</span></div>
        <div class="summary-table-wrap">
          <table class="summary-table"><thead><tr><th>Artifact</th><th>Host</th><th>Representation</th><th>Speed index</th><th>Startup p50</th><th>Transfer size</th></tr></thead>
          <tbody>{artifactMetrics.map((item) => <tr><th><code>{item.id}</code></th><td>{item.host}</td><td>{item.representation}</td><td>{item.speed == null ? "Pending" : `${item.speed.toFixed(2)}×`}</td><td>{formatTime(item.startup)}</td><td>{formatSize(item.size)}</td></tr>)}</tbody></table>
        </div>
        <p class="summary-note">Speed index is the geometric mean of <code>hara-rust-full / artifact</code> steady time across all eight algorithms. Higher is faster; Rust full is 1.00×.</p>
      </div>
    </section>

    <section class="results-shell">
      <div class="tabs" role="tablist" aria-label="Benchmark sections">
        <button role="tab" aria-selected="true" aria-controls="hara-artifacts" id="tab-hara">Hara artifacts</button>
        <button role="tab" aria-selected="false" aria-controls="language-shootout" id="tab-languages" tabindex="-1">Language shootout</button>
        <button role="tab" aria-selected="false" aria-controls="http-results" id="tab-http" tabindex="-1">HTTP</button>
        <button role="tab" aria-selected="false" aria-controls="methodology" id="tab-method" tabindex="-1">Methodology</button>
      </div>

      <section class="tab-panel" role="tabpanel" id="hara-artifacts" aria-labelledby="tab-hara">
        <header><p class="hara-kicker">Eight artifacts · eight algorithms</p><h2>Prepared execution results</h2><p>Preparation, first invocation, steady state, and throughput are separate measurements. Every cell is checksum verified.</p></header>
        <div class="detail-table"><table><thead><tr><th>Artifact / workload</th><th>Prepare</th><th>First</th><th>Steady</th><th>Calls/s</th></tr></thead><tbody>
        {catalog.artifacts.flatMap((artifact) => catalog.corpus.workloads.map((workload) => { const row = index.get(`${artifact.id}/${workload}`); return <tr><th><code>{artifact.id}</code><small>{workload}</small></th><td>{formatTime(row?.prepare_ns)}</td><td>{formatTime(row?.first_ns)}</td><td>{formatTime(row?.steady_ns)}</td><td>{row?.throughput_per_sec == null ? "Pending" : row.throughput_per_sec.toFixed(1)}</td></tr>; }))}
        </tbody></table></div>
        <div class="artifact-specs">{catalog.artifacts.map((artifact) => <article><code>{artifact.id}</code><b>{artifact.host} · {artifact.representation}</b><p>{artifact.summary}</p><small>{artifact.invocation}</small></article>)}</div>
      </section>

      <section class="tab-panel" role="tabpanel" id="language-shootout" aria-labelledby="tab-languages" hidden>
        <header><p class="hara-kicker">One Hara tier</p><h2>Language shootout</h2><p>Every competitor is compared with <code>hara-rust-full</code>, Hara’s highest-performance native tier, over the same eight algorithms.</p></header>
        <div class="detail-table"><table><thead><tr><th>Runtime</th><th>Workloads</th><th>Execution boundary</th><th>Evidence</th></tr></thead><tbody>{catalog.language_competitors.map((runtime) => <tr><th>{runtime}</th><td>8 / 8 specified</td><td>Prepared execution</td><td>{evidence ? "See committed evidence" : "Pending standard run"}</td></tr>)}</tbody></table></div>
      </section>

      <section class="tab-panel" role="tabpanel" id="http-results" aria-labelledby="tab-http" hidden>
        <header><p class="hara-kicker">Loopback HTTP/1.1 · keep-alive</p><h2>HTTP frameworks</h2><p>Hoplite is measured only with genuine <code>hara-rust-full</code> handler compilation.</p></header>
        <div class="detail-table"><table><thead><tr><th>Server</th><th>Routes</th><th>Worker model</th><th>Evidence</th></tr></thead><tbody>{catalog.http_competitors.map((server) => <tr><th><code>{server}</code></th><td>/hello · /json · /delay</td><td>One worker / event loop</td><td>{evidence ? "See committed evidence" : "Pending standard run"}</td></tr>)}</tbody></table></div>
      </section>

      <section class="tab-panel methodology" role="tabpanel" id="methodology" aria-labelledby="tab-method" hidden>
        <header><p class="hara-kicker">Reproduce the numbers</p><h2>Methodology</h2></header>
        <div class="method-grid"><article><h3>Corpus</h3><p>Sieve, Towers, Queens, heap permutation, Ackermann, Tak, Collatz, and matrix multiplication use equivalent runtime-specific source and identical expected checksums.</p></article><article><h3>Timing boundaries</h3><p>Preparation loads or compiles once. First invocation is recorded separately. Steady state uses the final converged windows and adaptive inner batching in browsers.</p></article><article><h3>Environment</h3><p>Reference evidence comes from one pinned self-hosted machine. It records CPU, OS, revisions, toolchains, browser, artifact bytes, and every raw sample.</p></article><article><h3>Publication gate</h3><p><code>python3 lib/bench/validate_evidence.py reference-v2.json</code> rejects smoke profiles, missing cells, failed checksums, vocabulary drift, and comparison tiers other than <code>hara-rust-full</code>.</p></article></div>
      </section>
    </section>
  </main>
  <footer><span>Hara benchmark evidence</span><a href="https://github.com/hara-lang/hara/tree/main/lib/bench">Methods and raw data</a></footer>
  <script>
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const activate = (tab:HTMLButtonElement, focus = true) => {
      for (const item of tabs) { const active = item === tab; item.setAttribute("aria-selected", String(active)); item.tabIndex = active ? 0 : -1; const controls = item.getAttribute("aria-controls"); if (controls) document.getElementById(controls)?.toggleAttribute("hidden", !active); }
      if (focus) tab.focus(); history.replaceState(null, "", `#${tab.getAttribute("aria-controls")}`);
    };
    tabs.forEach((tab, index) => { tab.addEventListener("click", () => activate(tab)); tab.addEventListener("keydown", (event) => { if (!['ArrowLeft','ArrowRight'].includes(event.key)) return; event.preventDefault(); const offset = event.key === 'ArrowRight' ? 1 : -1; activate(tabs[(index + offset + tabs.length) % tabs.length]); }); });
    const initial = tabs.find((tab) => `#${tab.getAttribute("aria-controls")}` === location.hash); if (initial) activate(initial, false);
  </script>
</body></html>
