{:spec/version "0.1"
 :spec/status :draft
 :language "hara-l0"
 :namespace std.typed

 ;; This file is the editable design authority for the std.typed.* public surface:
 ;; gradual typing (schema language + inference) with lint as its first consumer.
 ;; A function is not part of the boundary merely because a std.typed.* namespace
 ;; defines it; only the symbols and behaviors declared here are contractual.
 ;; Facts in lib/test/std/typed/ and implementations should be reconciled with
 ;; this file. The prose rationale lives in
 ;; docs/superpowers/specs/2026-07-24-gradual-typing-linter-design.md.

 :namespaces
 {std.typed.schema
  {:role "Schema language: surface grammar, normal form, lattice, projection, registries."
   :purity :pure-functions-and-data
   :host-access false}

  std.typed.infer
  {:role "Inference engine: literals, propagation, narrowing propositions, signature application."
   :purity :pure-functions
   :host-access false}

  std.typed.core-sigs
  {:role "Core-builtin signature table written in the surface grammar."
   :purity :data
   :host-access false}

  std.typed.lint.forms
  {:role "Walks read-forms output; normalizes defn/let/fn/if shapes; span accessors."
   :purity :total-functions
   :host-access #{read-forms}}

  std.typed.lint.hooks
  {:role "Macro handling: built-in rewrites, macroexpand path, hook registry."
   :purity :total-functions
   :host-access #{macroexpand macroexpand-all}}

  std.typed.lint.analyze
  {:role "The pass: per-namespace tables, checks, findings. Custom-check registry."
   :purity :total-functions
   :host-access false}

  std.typed.lint.report
  {:role "Findings to text and EDN; summaries."
   :purity :pure-functions
   :host-access false}}

 :schema-grammar
 {:primitives
  #{:any :nil :bool :num :str :keyword :symbol
    :list :vector :map :set :fn :atom :bytes :promise}

  ;; Bottom. Never appears in schemas or annotations; suppresses findings.
  :internal #{:unknown}

  ;; Surface forms are vectors headed by these symbols; normalize rewrites them
  ;; to the :normal-forms maps below. Union members flatten, dedupe, and a
  ;; singleton union collapses to its member.
  :composites
  {:or {:surface [:or type & types]
        :normal :union
        :flatten true
        :dedupe true
        :collapse-singleton true}
   :maybe {:surface [:maybe type]
           :normal :maybe
           :equivalent [:or type :nil]}
   :vector {:surface [:vector item-type]
            :normal :vector
            :descriptive true}
   :map {:surface [:map [key type] & field-pairs]
         :normal :map
         :descriptive true
         :checked :disjoint-keys-only}
   :fn {:surface [:fn [input & inputs] output]
        :normal :fn
        :single-arity true
        :rest-args "An & in the input vector marks remaining arguments, e.g. [:fn [:any & :any] :any]."}}
   :function {:surface [:function fn-schema & fn-schemas]
              :normal :function
              :members :single-arity-fn-schemas}}

  :normal-forms
  {:primitive {:kind :primitive :name :primitive-keyword}
   :union {:kind :union :types :vector-of-normal-forms}
   :maybe {:kind :maybe :item :normal-form}
   :vector {:kind :vector :item :normal-form}
   :map {:kind :map :fields [{:name :keyword :type :normal-form}]}
   :fn {:kind :fn :inputs :vector-of-normal-forms :output :normal-form}
   :function {:kind :function :arities :vector-of-fn-normal-forms}}

  ;; Where user annotations live. Checked against inference, never required.
  :annotation
  {:site :defn-symbol-metadata
   :key :schema
   :precedence [:annotation :core-sigs :inferred-defn-body :unknown]}

  ;; Relationship to hara.typed.xtalk (foundation-base): only the :fn head and
  ;; the map normal form are adopted. No :xt/ primitive namespacing, no
  ;; [:and] [:tuple] [:array] [:dict] [:record] [:> Target] forms, no named
  ;; type references, no :xt/self. Multi-arity is :function, not a union of
  ;; :fn types.
  :xtalk-overlap #{:fn-head :map-normal-form}}

 :inference
 {:rules
  {:literals "Literal values infer their primitive type; quoted forms infer their data type."
   :core-signatures "Call sites of core-sigs entries get arg checks and the declared output type."
   :propagation "let bindings carry init types inward; defn records each arity plus a best-effort output type from the body."
   :narrowing "Predicate tests in if/when test position refine local bindings per branch via propositions."
   :annotations "^{:schema ...} on defn symbols is normalized, then checked against the inferred body output."}

  :narrowing
  {:propositions #{:is :not :and :or}
   :subject :local-bindings-only
   :semantics :core-typed-occurrence-typing-subset
   :registered-predicates :via-std.typed.schema/register-predicate}

  ;; unknown anywhere in the precedence chain falls through to the next layer;
  ;; unknown at the bottom produces no finding. False positives are worse than
  ;; silence at this stage.
  :unknown {:suppresses-findings true
            :appears-in-output false}

  :branch-join :union-of-branch-types}

 :checks
 {:arity {:level :error
          :trigger "Call-site argument count is incompatible with every arity of a known var."}
  :unresolved-symbol {:level :error
                      :trigger "Symbol is not bound in locals, namespace mappings, or requires."}
  :type-mismatch {:level :warning
                  :trigger "Both sides are concrete and disjoint, e.g. (+ 1 \"a\")."}
  :unused-binding {:level :warning
                   :trigger "A let binding is never referenced."}}

 :findings
 {:shape {:file :string
          :row :int
          :col :int
          :end-row :int
          :end-col :int
          :level #{:warning :error}
          :type :check-keyword
          :message :string}
  :span-source :form-metadata
  :missing-span {:row 1 :col 1 :message-includes-printed-form true}
  :compatibility :clj-kondo-top-level
  :totality "Analysis never throws on malformed-but-readable code; every check returns findings."}

 :macro-handling
 {:tiers
  [{:tier :builtin-rewrites
    :covers :l0-and-bootstrap-macro-set
    :action :rewrite-to-analyzable-let-if-fn-shapes}
   {:tier :macroexpand
    :covers :user-macros-with-loaded-defining-namespace
    :action :real-expansion-via-runtime-builtin
    :failure :degrades-to-next-tier}
   {:tier :hook-registry
    :covers :macros-that-cannot-or-should-not-expand
    :action {:lint-as :equivalence-declaration
             :rewrite-fn :form-to-form-transformation}}]
  :expansion-failure-is-error false}

 :registries
 {:schema-heads
  {:owner std.typed.schema
   :key :composite-head-symbol
   :value :projection-fn-schema-to-normal-form
   :register register-schema-head}

  :narrowing-predicates
  {:owner std.typed.schema
   :key :qualified-predicate-symbol
   :value :refined-type-or-proposition-fn
   :register register-predicate}

  :custom-checks
  {:owner std.typed.lint.analyze
   :key :check-id-keyword
   :value {:level #{:warning :error} :fn :analysis-to-findings}
   :register register-check
   :contract-same-as-built-ins true
   :execution-note "Custom check namespaces are ordinary hara code loaded before linting; linting a project executes its registered check namespaces."}}

 :semantics
 {;; Descriptive return keywords follow foundation.edn conventions; where a
  ;; value is a type, it is in normal form unless stated otherwise.

  :schema
  {normalize {:arglists [[schema]]
              :returns :normal-form
              :totality :unknown-surface-heads-pass-through-unrecognized}
   primitive? {:arglists [[value]] :returns :boolean}
   union {:arglists [[types]] :returns :normal-form
          :properties #{:flatten :dedupe :collapse-singleton}}
   compatible? {:arglists [[expected actual]] :returns :boolean
                :any-and-unknown-are-escape-hatches true}
   project-arities {:arglists [[fn-or-function-normal-form]]
                    :returns :per-arity-table}
   register-schema-head {:arglists [[head-symbol projection-fn]]
                         :returns :nil}
   register-predicate {:arglists [[qualified-symbol refinement]]
                       :returns :nil}}

  :infer
  {infer-form {:arglists [[form env sigs]]
               :returns {:type :normal-form :env :env}}
   infer-defn {:arglists [[defn-form env sigs]]
               :returns {:arities :per-arity-table :output :normal-form}}
   narrow {:arglists [[env test-form]]
           :returns {:then :env :else :env}}
   join {:arglists [[type-a type-b]] :returns :normal-form
         :branch-join true}}

  :core-sigs
  {+sigs+ {:value :map-qualified-symbol-to-surface-schema
           :scope :l0-and-core-surface-used-by-std.lib.foundation}
   sig {:arglists [[qualified-symbol]]
        :returns :per-arity-table-or-nil}}

  :lint-forms
  {read-source {:arglists [[path]]
                :returns :vector-of-forms-with-span-metadata
                :capability #{:hal-path :file-io}}
   form-kind {:arglists [[form]] :returns :shape-keyword}
   span {:arglists [[form]]
         :returns {:file :string :row :int :col :int :end-row :int :end-col :int}
         :missing :degrades-per-findings/missing-span}}

  :lint-hooks
  {register-hook {:arglists [[qualified-macro-symbol hook-spec]] :returns :nil}
   expand-form {:arglists [[form env]]
                :returns :form
                :tier-order [:builtin-rewrites :macroexpand :hook-registry]
                :failure :returns-input-form}}

  :lint-analyze
  {analyze-forms {:arglists [[forms opts]]
                  :returns {:defs :def-table :usages :usage-table :types :type-env}}
   analyze-namespace {:arglists [[path opts]]
                      :returns :vector-of-findings}
   register-check {:arglists [[{:keys [id level fn]}]] :returns :nil}
   +default-checks+ {:value [:arity :unresolved-symbol :type-mismatch :unused-binding]}}

  :lint-report
  {format-findings {:arglists [[findings opts]]
                    :returns :string
                    :kondo-compatible-lines true}
   summarize {:arglists [[findings]]
              :returns {:total :int :errors :int :warnings :int :by-type :map}}}}

 :host-dependencies
 {:read-forms {:runtime :truffle
               :location "java/src/main/java/hara/truffle/HaraContext.java"
               :capability #{:hal-path :file-io}}
  :macroexpand {:runtime :truffle}
  :namespace-introspection #{ns-publics ns-aliases ns-name requiring-resolve}
  :metadata #{meta with-meta-via-protocol-call}
  :new-jvm-surface false
  :other-runtimes "read-forms and macroexpand must be ported before std.typed runs on the kernel or Rust runtimes."}

 :implementation-status
 {:jvm {:implemented false
        :source-root lib/src/std/typed
        :test-root lib/test/std/typed
        :junit-wrapper StdTypedSourceTest}}

 :implementation-issues
 [{:id :runtimes/read-forms
   :current "read-forms and macroexpand exist only in the Truffle runtime."
   :required "Port both to the kernel and Rust runtimes with parity tests before std.typed is advertised as portable."}

  {:id :core-sigs/coverage
   :current "No signature table exists."
   :required "Seed std.typed.core-sigs for the L0/core surface used by std.lib.foundation; a sync fact diffs table keys against core namespace publics so an unsigned builtin fails the build."}

  {:id :dogfood/false-positives
   :current "The linter does not exist."
   :required "Analyze lib/src/std/lib/foundation.hal and lib/src/polis/common/ with zero findings before declaring the launch checks stable."}

  {:id :macros/bootstrap-set
   :current "The built-in rewrite tier covers nothing yet."
   :required "Implement rewrites for the L0/bootstrap macro set (-> ->> when cond if-let when-let) into analyzable let/if/fn shapes before user macros are attempted."}]

 :implementation-notes
 ["The schema grammar adopts exactly two things from hara.typed.xtalk: the [:fn [inputs] output] head and the {:kind ...} map normal form. Everything else deliberately diverges."
  "Inference is kondo-style and shallow by design: no type variables, no unification, no whole-program checking."
  "Narrowing propositions are a strict subset of core.typed occurrence typing; the representation leaves room for let-aliasing and path refinement later."
  "std.typed.validate (runtime validation against the same schemas) is a future consumer and changes nothing in this file's boundary."
  "The semantics section above is written to double as the std.typed.* self-annotation seed once the library can lint itself."
  "Custom checks, the hook registry, and the :lint project.hal key are launch-scope only where listed under :registries and :macro-handling; per-file config is intentionally absent."]}
