{:spec/version "0.1"
 :spec/status :draft
 :language "hara-l0"
 :namespace std.foundation

 ;; This file is the editable design authority for the JVM bootstrap boundary.
 ;; A symbol is not part of the boundary merely because HaraContext installs it.
 ;; Conformance cases and implementations should be reconciled with this file.
 :namespace-contract
 {:clauses #{:config :require :flavor :import}
  :config
  {:cardinality :zero-or-one
   :keys
   {:blank {:type :boolean
            :default false
            :semantics :suppress-automatic-foundation-referral}
    :builtins {:type :vector-of-unique-unqualified-symbols
               :default []
               :selection :exact
               :allow-all false
               :namespace :declaring-namespace
               :metadata #{:doc :arglists :kind}}
    :intrinsics {:type [:or
                        :all
                        {:exclude :vector-of-unique-library-symbols
                         :alias :library-to-unqualified-alias-map}]
                 :default :all}}
   :unknown-keys :error
   :validation :before-namespace-mutation
   :standalone-builtins-clause false
   :standalone-intrinsics-clause false}
  :blank {:foundation-referral false
          :special-forms true
          :intrinsic-aliases :configured-independently
          :erase-owned-definitions false}
  :builtins {:registration :runtime-provider
             :activation :source-declared
             :arbitrary-host-access false
             :missing-export :error
             :namespace-mismatch :error
             :binding-conflict :error
             :repeated-identical-activation :idempotent}
  :intrinsics
  {:libraries
   {string {:namespace std.foundation.string :default-alias str}
    bytes {:namespace std.foundation.bytes :default-alias bytes}
    promise {:namespace std.foundation.promise :default-alias promise}
    coroutine {:namespace std.foundation.coroutine :default-alias coroutine}
    file {:namespace std.foundation.file :default-alias file}
    os {:namespace std.foundation.os :default-alias os}}
   :exclude :removes-automatic-alias-only
   :explicit-require-after-exclusion true
   :alias-option :alias}}

 :boundary
 {:special-forms
  #{quote
    if
    do
    let
    loop
    recur
    fn
    def
    defn
    ns}

  :macros
  #{->
    ->>
    if-let
    when-let
    if-not
    cond->
    cond->>
    code-line
    code-column}

  :reader-literals
  {:regex
   {:syntax "#\"...\""
    :value :hara-regex}}

  :builtin-symbols
  {:numeric
   #{+ - * / mod = not= < <= > >= compare}

   :invocation
   #{apply
     gensym}

   :state
   #{atom
     atom?
     deref
     reset!
     swap!
     compare-and-set!
     add-watch
     remove-watch
     get-watches}

   :predicates
   #{nil? boolean? true? false?
     number? integer? decimal?
     string? char? keyword? symbol?
     collection? sequential? list? vector? tuple? queue? map? set? map-entry?
     array? object? bytes? promise? coroutine? atom?
     callable? iterable? iterator? counted? indexed? associative?
     derefable? watchable?}

   :evaluation
   #{eval
     read-string
     read-forms}

   :regex
   #{re-pattern
     regex?
     re-find
     re-matches
     re-seq
     re-groups}

   :collections
   #{count
     get
     find
     has?
     assoc
     dissoc
     conj
     cons
     nth
     empty
     vec
     list}

   :iteration
   #{iter
     map
     filter
     take
     drop
     mapcat
     keep
     cycle
     zip
     partition-pair
     partition
     partition-all
     interpose
     interleave
     take-while
     drop-while
     range
     repeat
     repeatedly
     iterate
     concat
     reduce
     every?
     any?}}

  ;; Runtime-backed values expose a deliberately restricted portable surface.
  ;; These methods do not imply general host interop or JVM member access.
  :runtime-values
  {:array
   {:constructor array
    :identity :mutable
    :methods
    #{get
      set
      push-first
      push-last
      pop-first
      pop-last
      insert
      remove
      clone
      slice
      map
      filter
      fold-left
      fold-right}}

   :object
   {:constructor object
    :identity :mutable
    :methods
    #{has?
      get
      set
      delete
      clone
      assign
      keys
      vals
      pairs}}}

  ;; Portable libraries backed by runtime facilities that Hara does not expose
  ;; through general host or implementation-language interop.
  :runtime-libraries
  {std.foundation.coroutine
   {:alias coroutine
    :symbols
    #{create
      resume
      yield
      status
      coroutine?
      close
      await}}

   std.foundation.string
   {:alias str
    :symbols
    #{length
      blank?
      includes?
      starts-with?
      ends-with?
      char-at
      slice
      index-of
      last-index-of
      join
      split
      split-lines
      repeat
      replace
      replace-first
      trim
      trim-left
      trim-right
      upper
      lower
      capitalize
      decapitalize
      pad-left
      pad-right
      reverse
      encode-utf8
      decode-utf8}}

   std.foundation.bytes
   {:alias bytes
    :symbols
    #{count
      get
      set
      copy
      slice
      u8
      s8}}

   std.foundation.promise
   {:alias promise
    :symbols
    #{run
      new
      all
      then
      catch
      finally
      state
      value
      cancel
      native?
      delay}}

   std.foundation.file
   {:alias file
    :capability :file
    :symbols #{resolve read write exists? list mkdir delete}}

   std.foundation.os
   {:alias os
    :symbols
    #{platform arch cwd env getenv spawn process? process-alive?
      process-write process-close-input process-stdout process-stderr
      process-wait process-kill}}}

  ;; These are ordinary Hara definitions built only from the boundary above.
  :foundation-symbols
  #{identity
    inc
    dec
    constantly
    comp
    complement
    zero?
    pos?
    neg?
    even?
    odd?
    nil?
    false?
    true?
    empty?
    first
    second
    rest
    not-empty
    get-in
    assoc-in
    update
    update-in
    last
    reverse
    key
    val
    keys
    vals
    juxt
    T F NIL U Z Y
    min max sort sort-by
    butlast drop-last take-last split-at split-with partition-by take-nth
    into distinct distinct? zipmap merge-with group-by frequencies
    partial}}

 :protocols
 {:IFind
  {:methods
   {find {:arglists [[collection key]]
          :returns :entry-or-nil}
    has? {:arglists [[collection key]]
          :returns :boolean}}
   :invariant
   "has? distinguishes a missing key from a key whose associated value is nil."}}

 :semantics
 {:combinators
  {T :constant-true
   F :constant-false
   NIL :constant-nil
   U :self-application
   Z :eager-fixed-point
   Y {:kind :classical-fixed-point
      :warning :diverges-under-ordinary-eager-use}}

  :comparison
  {:compare {:arglists [[left right]]
             :result #{-1 0 1}
             :orderable #{numbers strings characters keywords symbols booleans sequential-values}
             :sequential :lexicographic
             :unrelated-values :error}
   :sort {:stable true
          :input :ordered-collection
          :output :preserve-input-origin
          :unordered-input :error}
   :sort-by {:stable true :key-evaluations :implementation-defined}}

  :atoms
  {:operations #{atom atom? deref reset! swap! compare-and-set!
                 add-watch remove-watch get-watches}
   :watch-callback [key reference old-value new-value]
   :validation :before-commit
   :notification :exactly-once-after-successful-commit
   :failed-cas-notifies false
   :swap-function-may-repeat true
   :watch-error {:state :remains-committed :propagation :caller}}

  :macro-context
  {:gensym {:arglists [[] [prefix]] :returns :unique-unqualified-symbol}
   :syntax-quote-auto-gensym {:suffix "#" :scope :one-expansion}
   :&form :complete-invocation-with-source-metadata
   :&env {:representation :immutable-hara-map
          :keys #{:ns :locals :aliases :file :line :column}
          :host-objects false}
   :source-location-macros #{code-line code-column}}

  :collection-extensions
  {:origin-preserving #{butlast drop-last take-last take-nth distinct sort sort-by}
   :pair-results #{split-at split-with}
   :map-results #{zipmap merge-with group-by frequencies}
   :into :destination-governs-origin}

  :errors-current
  {:runtime-errors :hara-exception
   :explicit-throw :thrown-value-wrapper
   :ex-info :legacy-java-ex-info
   :ordinary-runtime-errors-catchable false
   :host-class-leak ex-class}

  :map
  {:direct
   {:arglists [[function source]
               [function source & sources]]
    :evaluation :eager
    :output :preserve-first-source-origin
    :multiple-sources :stop-at-shortest}

   :transform
   {:arglists [[function]]
    :evaluation :lazy
    :returns :iterator-transform
    :application
    {:input :iterable-or-iterator
     :output :iterator}}}

  :iterator-transform
  {:callable true
   :composition comp
   :acquisition :on-demand
   :one-shot true}

  :materialization
  {:vector vec
   :list list
   :array array}

  :membership
  {:find :protocol-dispatch
   :has? :protocol-dispatch
   :nil-value-distinct-from-missing true}

  :evaluation
  {:read-string
   {:arglists [[source]]
    :returns :form
    :multiple-forms :error}

   :read-forms
   {:arglists [[source]]
    :returns :forms
    :input :string
    :file-io false}

   :eval
   {:arglists [[form]]
    :namespace :current
    :returns :value}}

  :string
  {:index-unit :unicode-code-point
   :literal-operations
   #{split replace replace-first}
   :encoding
   {:encode-utf8 :string-to-bytes
    :decode-utf8 :bytes-to-string}}

  :regex
  {:value :hara-regex
   :reader-literal "#\"...\""
   :construction re-pattern
   :dialect :hara-portable-v1
   :host-value-exposure false
   :match-result
   {:without-captures :string
    :with-captures :vector
    :no-match nil}
   :re-matches :whole-input
   :re-find :first-match
   :re-groups :capture-result
   :re-seq
   {:evaluation :lazy
    :returns :iterator}
   :replacement
   {:functions true
    :template-syntax "$n"
    :host-template-syntax false}
   :portable-flags
   #{:case-insensitive
     :multiline
     :dotall}}

  :file
  {:resolve {:arglists [[root path]]
             :evaluation :synchronous
             :returns :normalized-path-string
             :touches-filesystem false}
   :operations
   {read {:arglists [[path]] :returns :promise-of-bytes}
    write {:arglists [[path bytes]]
           :returns :promise-of-nil
           :creates-missing-parents false
           :existing-target :overwrite}
    exists? {:arglists [[path]] :returns :promise-of-boolean}
    list {:arglists [[path]]
          :returns :promise-of-sorted-normalized-child-path-vector}
    mkdir {:arglists [[path]]
           :returns :promise-of-nil
           :parents true
           :existing-directory :success}
    delete {:arglists [[path]]
            :returns :promise-of-nil
            :recursive false}}
   :capability :file}

  :os
  {:identity
   {platform {:arglists [[]]
              :returns #{:linux :macos :windows :unknown}}
    arch {:arglists [[]] :returns :normalized-architecture-keyword}
    cwd {:arglists [[]] :returns :normalized-path-string}
    env {:arglists [[]] :returns :string-to-string-map}
    getenv {:arglists [[name]] :returns :string-or-nil}}
   :process
   {:capability :process
    :shell-command-strings false
    :argv :non-empty-vector-of-strings
    :spawn-options {:cwd :string :env :string-to-string-map}
    :handle :opaque
    :functions
    {spawn {:arglists [[argv] [argv options]] :returns :process}
     process? {:arglists [[value]] :returns :boolean}
     process-alive? {:arglists [[process]] :returns :boolean}
     process-write {:arglists [[process bytes]]
                    :returns :promise-of-nil
                    :destination :stdin}
     process-close-input {:arglists [[process]] :returns :promise-of-nil}
     process-stdout {:arglists [[process]]
                     :returns :promise-of-bytes
                     :settles :eof}
     process-stderr {:arglists [[process]]
                     :returns :promise-of-bytes
                     :settles :eof}
     process-wait {:arglists [[process]]
                   :returns :promise-of-integer-exit-code
                   :repeatable true}
     process-kill {:arglists [[process]]
                   :returns :nil
                   :mode :force
                   :dead-process :success}}
    :output-draining :concurrent-from-spawn
    :excluded #{shell inherited-io os-signals incremental-streams
                clipboard notifications url-helpers tmux}}}}

 :excluded-symbols
 #{mapv
   iter-has?
   iter-next
   iter-close
   iter-map
   iter-filter
   iter-take
   iter-drop
   iter-mapcat
   iter-keep
   iter-cycle
   iter-zip
   iter-partition-pair
   iter-partition
   iter-partition-all
   iter-interpose
   iter-interleave
   iter-take-while
   iter-drop-while
   iter-range
   iter-constantly
   iter-repeatedly
   iter-iterate
   iter-every?
   iter-any?}

 :implementation-status
 {:jvm
  {:core-namespace std.lib.foundation
   :automatic-referrals #{hara.lang.intrinsic std.lib.foundation}
   :automatic-aliases
   {str std.lib.string
    promise std.lib.promise
    bytes std.lib.bytes
    socket std.lib.socket
    file std.lib.file
    block std.lib.block
    zip std.lib.zip}
   :ns-clauses #{:intrinsics :require :flavor :import}
   :config-clause false
   :builtins-clause false
   :intrinsics-option :aliases
   :provider-activation :whole-provider
   :export-metadata #{:name :kind :doc :arglists :intrinsic}
   :coroutine-access :explicit-require
   :file-symbols #{resolve read write}}}

 :implementation-issues
 [{:id :evaluation/read-string
   :current "The JVM exposes eval and read-forms, but no single-form read-string builtin."
   :required "Expose read-string through the Hara reader, preserve form metadata, and reject trailing non-whitespace forms."}

  {:id :namespace/config
   :current "The JVM accepts standalone :intrinsics and has no :config or :builtins clause."
   :required "Parse and validate one :config map before applying core referrals, builtin activation, or intrinsic aliases."}

  {:id :namespace/builtin-activation
   :current "HaraStaticLibrary installs every @HaraExport method when its provider is installed."
   :required "Catalog host exports separately and activate only the exact symbols declared by the namespace's :config :builtins vector."}

  {:id :namespace/foundation-family
   :current "The JVM publishes foundational libraries under std.lib.* and automatically aliases socket, block, and zip."
   :required "Publish the six separate libraries under std.foundation.*, remove legacy foundational aliases, and keep non-foundation std.lib.* libraries explicit."}

  {:id :file/small-filesystem
   :current "std.lib.file exposes resolve, read, and write."
   :required "Move it to std.foundation.file and add promise-based exists?, list, mkdir, and non-recursive delete with the specified deterministic behavior."}

  {:id :os/process
   :current "There is no guest-visible portable OS/process foundation namespace."
   :required "Add std.foundation.os with normalized host identity and capability-gated argv-only buffered process operations using explicit process-* names."}

  {:id :regex/reader-value
   :current "hara.kernel.base.Parser compiles regex literals directly to java.util.regex.Pattern."
   :required "Read regex literals into an immutable Hara regex value containing source, flags, and a portable parsed representation."}

  {:id :regex/hir
   :current "HirArtifact encodes flagless JVM regex values portably as a pattern string (opcode 17, spec/hara/hir.md) and rejects flagged patterns. There is still no Hara regex value carrying source, flags, and dialect."
   :required "Add deterministic HIR encoding and decoding for the Hara regex source, flags, and dialect/version."}

  {:id :regex/jvm-adapter
   :current "regexp? and test matching inspect java.util.regex.Pattern directly."
   :required "Compile and cache a private JVM Pattern behind the Hara regex value; never expose Pattern or Matcher to guest code."}

  {:id :regex/talo-lowering
   :current "Talo recognizes a regex token, but its xtalk string operations do not share one regex contract across targets."
   :required "Lower the Hara regex representation and replacement templates per target, rejecting unsupported portable-v1 constructs explicitly."}

  {:id :regex/lua
   :current "Lua patterns are not equivalent to JavaScript, Python, R, or JVM regular expressions."
   :required "Choose a Lua regex runtime/helper or emit an explicit unsupported-feature error; do not silently reinterpret Hara regex as a Lua pattern."}

  {:id :regex/replacement
   :current "Replacement capture syntax differs across JVM, JavaScript, Python, Lua, and R."
   :required "Parse Hara $n templates and translate them for each target; function replacements receive the same string/vector match shape everywhere."}

  {:id :string/unicode-indexing
   :current "JVM length, char, substring, and regex offsets expose UTF-16 code-unit indexes."
   :required "Implement length, char-at, slice, search offsets, and regex offsets in Unicode code points across JVM and Talo targets."}

  {:id :conformance/regex-parity
   :current "No shared JVM/Talo regex conformance matrix exists."
   :required "Add cases for literals, escaping, captures, no-match, repeated matches, flags, replacement templates, Unicode, unsupported constructs, and target parity."}

  {:id :errors/unified-value
   :current "Runtime HaraException failures are not caught by Hara try; explicit throw and ex-info use separate wrappers, and ex-class exposes JVM class names."
   :required "Normalize reader, analyzer, runtime, promise, coroutine, file, native, and explicit failures into one host-neutral Hara error value and catch mechanism."}]

 :implementation-notes
 ["The current JVM implementation does not yet conform to this draft."
  "Foundation bootstrap uses (:config {:blank true ...}); blank suppresses core referral but not configured intrinsic aliases."
  "Standalone :builtins and :intrinsics clauses are intentionally invalid."
  "The intrinsic remapping option is singular :alias."
  "Host export catalogs do not grant arbitrary JVM interop or runtime capabilities."
  "Iterator mechanics may remain JVM-backed, but iter-* names are not public language symbols."
  "Direct map is eager and origin-preserving; the unary map transform is lazy."
  "mapv is intentionally absent rather than retained as a compatibility alias."
  "HIR plain maps and sets encode in the canonical unsigned lexicographic order of their encoded bytes; ordered maps and sets keep insertion order (spec/hara/hir.md)."
  "Filesystem loading, namespace reflection, and general host interop are outside this boundary."]}
