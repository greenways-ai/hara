{:reference
 {:repository "zcaudate-xyz/foundation-base"
  :commit "f909a44ad504cc6c9f44248d59ec3148261a48d7"
  :xtalk-grammar "src/tahto/model/spec_xtalk.clj"
  :xtalk-runtime "src/tahto/runtime/basic/impl/process_xtalk.clj"}

 :target
 {:grammar "lib/src/tahto/model/v1/spec_hara.hal"
  :emitter "lib/src/tahto/model/v1/spec_hara/emit.hal"
  :runtime "lib/src/tahto/runtime/basic/type_hara.hal"
  :registration "lib/src/tahto/runtime/basic/impl/process_xtalk.hal"
  :collection-facade "lib/src/tahto/runtime/hara.hal"
  :native-arr "std.native.Arr"
  :native-obj "std.native.Obj"}

 :architecture
 {:xtalk
  "The target-neutral parent grammar and public semantic runtime coordinate."
  :hara
  "The concrete child grammar and in-process execution target."
  :coordinates
  {[:xtalk :basic] :canonical
   [:hara :basic] :explicit-alias}
  :transport :in-process
  :child-process false
  :wire-protocol false
  :collection-ownership :hara-runtime}

 :grammar
 {:coordinate {:grammar/id :hara
               :grammar/variant :default
               :grammar/version 1}
  :parent {:grammar/id :xtalk
           :grammar/version 1}
  :emission :hara-source
  :module-symbols :flattened-vars
  :mutable-bindings :hara-atoms
  :mutable-collections [:std.native.Arr :std.native.Obj]
  :returns :tagged-local-unwind}

 :runtime
 {:state :persistent-hara-namespace
  :semantic-input "XTalk AST compiled through the :hara grammar"
  :raw-input "Already-emitted Hara source"
  :result "Native Hara value"
  :collection-values [:std.native.Arr :std.native.Obj]
  :collection-mutation :identity-preserving
  :lifecycle [:created :started :stopped]
  :state-fields
  [:status :target :namespace :evaluations :last-source :last-result
   :last-compiled? :last-error]}

 :collection-facade
 {:principle
  "tahto.runtime.hara adapts XTalk names and return conventions only; storage and mutation belong to std.native.Arr and std.native.Obj."
  :construction
  {:vector-literal :std.native.Arr/new
   :map-literal :std.native.Obj/new
   :boundary-conversion :recursive}
  :array
  {:direct [:new :instance? :get-index :set-index]
   :marker
   [:push-first :push-last :pop-first :pop-last :insert :remove
    :clone :map :filter :fold-left :fold-right]}
  :object
  {:direct [:new :instance? :get-key :set-key :has-key? :delete-key]
   :marker [:assign :clone :keys :vals :pairs]}
  :identity
  ["Mutation is visible through aliases."
   "Nested native objects retain identity during deep assignment."
   "Cloning is the explicit operation that creates a distinct native value."]}

 :ported-surface
 {:control
  [:do :if :when :cond :br* :while :for:index :for:array :for:object
   :for:iter :try :catch :finally :return]
  :definitions [:fn :defn :def :defglobal]
  :mutation
  [:var := :+= :-= :*= :++ :-- x:set-key x:set-idx x:del-key
   x:obj-assign x:arr-push x:arr-pop x:arr-push-first
   x:arr-pop-first x:arr-remove x:arr-insert x:arr-reverse]
  :data
  [:std.native.Arr :std.native.Obj :sets :module-symbols :member-index]
  :portable-operations
  [:type-predicates :arrays :objects :strings :json :math :bits :apply]}

 :intentional-differences
 [{:foundation "The historical :xtalk runtime executes emitted Scheme through Chez."
   :hara "The :xtalk :basic runtime compiles to Hara and evaluates inside the current Hara kernel."
   :reason "Self-hosting removes the external process, socket, and JSON result envelope."}
  {:foundation "Mutable target variables and collections use the target runtime's identity model."
   :hara "Scalar rebinding is represented by Hara atoms; array and object values are std.native.Arr and std.native.Obj and mutate in place."
   :reason "The atom models a mutable binding cell, not collection storage. Native collections preserve identity and alias visibility."
   :supersedes
   "The initial merged implementation rebuilt persistent vectors/maps inside atoms and is intentionally replaced by this native facade."}
  {:foundation "Target return statements are native control flow."
   :hara "Function-local return uses a tagged exception caught at the function boundary."
   :reason "Preserves early-return semantics without adding a new Hara special form."}]

 :deferred
 [:break-and-continue-unwind
  :generator-yield
  :filesystem-and-shell-capabilities
  :iterator-object-protocol-parity
  :complete-promise-operation-parity
  :full-xt-lang-corpus]

 :tests
 [{:path "lib/test/tahto/runtime/hara_test.hal"
   :facts 6
   :coverage
   [:native-construction :alias-identity :nested-identity :boundary-conversion
    :native-clones]}
  {:path "lib/test/tahto/model/v1/spec_hara_test.hal"
   :facts 8
   :coverage [:native-literals :native-reads :native-predicates :provenance]}
  {:path "lib/test/tahto/runtime/basic/impl/process_xtalk_test.hal"
   :facts 6
   :coverage [:native-runtime-results :lifecycle :namespace-isolation]}]

 :acceptance
 ["The :hara grammar resolves as a versioned child of :xtalk."
  "The :xtalk :basic coordinate launches no process and owns no transport."
  "XTalk vector and map literals are created as std.native.Arr and std.native.Obj."
  "Array and object mutation preserves native identity and is visible through aliases."
  "Nested native object identity survives deep assignment."
  "Persistent vectors/maps are accepted only as boundary inputs and recursively converted once."
  "Semantic XTalk input returns native Hara collection values."
  "Canonical HAL sources and Rust packaged snapshots are identical."]}
