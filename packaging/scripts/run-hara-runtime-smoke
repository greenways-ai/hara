#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT"

"$REPO_ROOT/core/hara" run \
  "$REPO_ROOT/core/lib/integration/hara/lang_bootstrap_probe.hal"

runtime_command=(
  "$REPO_ROOT/core/hara"
  --allow-net
  --allow-process
  run
  "$REPO_ROOT/core/lib/integration/hara/runtime_smoke.hal"
)

if command -v timeout >/dev/null 2>&1; then
  timeout 45s "${runtime_command[@]}"
else
  "${runtime_command[@]}"
fi
