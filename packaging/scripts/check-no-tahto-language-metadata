#!/usr/bin/env python3
"""Reject live legacy Hara language metadata keywords.

The one-release reader constructs legacy keys dynamically. Literal legacy keys
are permitted only in the published migration fixture and its documentation.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

REPOSITORY = Path(__file__).resolve().parents[2]
ROOTS = (
    Path("core/lib/src/lang"),
    Path("core/lib/test/lang"),
    Path("core/lib/integration"),
    Path("core/java/src"),
    Path("core/rust/hal-src/lang"),
    Path("core/spec"),
)
SKIP_PARTS = {"target", "node_modules", "vendor", ".git"}
BINARY = {".class", ".jar", ".wasm", ".png", ".jpg", ".gif", ".zip", ".gz"}
ALLOWED = {
    Path("core/spec/fixtures/lang-metadata-v1/legacy.edn"),
    Path("core/spec/fixtures/lang-metadata-v1/README.md"),
}
PATTERN = re.compile(r":tahto(?:[./])")

errors: list[str] = []
for relative_root in ROOTS:
    root = REPOSITORY / relative_root
    if not root.exists():
        continue
    for path in root.rglob("*"):
        if not path.is_file() or path.suffix.lower() in BINARY:
            continue
        relative = path.relative_to(REPOSITORY)
        if relative in ALLOWED or any(part in SKIP_PARTS for part in relative.parts):
            continue
        try:
            source = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        for match in PATTERN.finditer(source):
            line = source.count("\n", 0, match.start()) + 1
            errors.append(f"legacy language metadata keyword: {relative}:{line}")

legacy_fixture = REPOSITORY / "core/spec/fixtures/lang-metadata-v1/legacy.edn"
canonical_fixture = REPOSITORY / "core/spec/fixtures/lang-metadata-v1/canonical.edn"
if not legacy_fixture.is_file() or ":tahto/" not in legacy_fixture.read_text(encoding="utf-8"):
    errors.append("legacy language metadata fixture is missing or vacuous")
if not canonical_fixture.is_file():
    errors.append("canonical language metadata fixture is missing")
else:
    canonical = canonical_fixture.read_text(encoding="utf-8")
    if ":lang/" not in canonical:
        errors.append("canonical language metadata fixture is vacuous")
    if PATTERN.search(canonical):
        errors.append("canonical language metadata fixture contains a legacy key")

if errors:
    for error in errors:
        print(error, file=sys.stderr)
    raise SystemExit(1)

print("no live legacy Hara language metadata keywords remain")
