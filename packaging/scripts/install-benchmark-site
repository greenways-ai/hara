#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="${1:-prepare}"
SOURCE="${2:-$ROOT/.benchmark-site}"
OUT="${3:-$ROOT/core/target/www}"
CATALOG="$SOURCE/data/catalog.json"
RUNS="$SOURCE/data/runs.json"

for required in "$CATALOG" "$RUNS"; do
  if [[ ! -s "$required" ]]; then
    echo "benchmark data is missing $required" >&2
    exit 1
  fi
done

prepare() {
  python3 - "$CATALOG" "$RUNS" \
    "$ROOT/core/lib/bench/results/language-reference.json" \
    "$ROOT/core/lib/bench/results/class-reference.json" <<'PY'
from __future__ import annotations

import json
import statistics
import sys
from pathlib import Path
from typing import Any

catalog_path, runs_path, language_path, class_path = map(Path, sys.argv[1:])
catalog = json.loads(catalog_path.read_text(encoding="utf-8"))
runs = json.loads(runs_path.read_text(encoding="utf-8")).get("runs", [])
runtime_catalog = catalog.get("runtime_catalog", {})
runtime_specs = runtime_catalog.get("runtimes", {})
display_order = runtime_catalog.get("display_order", [])

HARA_RUNTIME = "hara-rust-whole-wasm-prepared"
LEGACY_HARA_RUNTIME = "hara-rust-full"
MIN_SHARED_WORKLOADS = 6


def timestamp(run: dict[str, Any]) -> str:
    return str(run.get("environment", {}).get("timestamp") or "")


def samples(row: dict[str, Any]) -> list[float]:
    values = row.get("steady_state", {}).get("samples_ns") or []
    return [float(value) for value in values if isinstance(value, (int, float)) and value > 0]


def usable_count(run: dict[str, Any], runtime: str) -> int:
    return len({
        row.get("workload")
        for row in run.get("measurements", [])
        if row.get("runtime") == runtime
        and row.get("status") == "ok"
        and samples(row)
        and row.get("workload")
    })


def resolve_runtime(run: dict[str, Any], base: str) -> str | None:
    available = {
        str(row.get("runtime"))
        for row in run.get("measurements", [])
        if row.get("runtime")
    }
    if base == "hara" and HARA_RUNTIME in available:
        return HARA_RUNTIME
    prefix = str(runtime_specs.get(base, {}).get("runtime_prefix") or f"{base}-")
    matches = sorted(
        runtime for runtime in available
        if runtime.startswith(prefix) and runtime.endswith("-prepared")
    )
    return matches[0] if matches else None


def resolve_measured_runtimes(run: dict[str, Any]) -> dict[str, str] | None:
    bases = ["hara", *display_order]
    resolved: dict[str, str] = {}
    for base in bases:
        spec = runtime_specs.get(base, {})
        if base != "hara" and spec.get("status") != "measured":
            continue
        runtime = resolve_runtime(run, base)
        if runtime is None or usable_count(run, runtime) < MIN_SHARED_WORKLOADS:
            return None
        resolved[base] = runtime
    return resolved


selected: tuple[dict[str, Any], dict[str, str]] | None = None
for run in sorted(runs, key=timestamp, reverse=True):
    resolved = resolve_measured_runtimes(run)
    if resolved is not None:
        selected = (run, resolved)
        break

if selected is None:
    raise SystemExit(
        "no canonical run contains at least six verified workloads for every measured prepared runtime"
    )

run, resolved = selected
selected_runtimes = set(resolved.values())
normalized: list[dict[str, Any]] = []
for row in run.get("measurements", []):
    runtime = row.get("runtime")
    workload = row.get("workload")
    if runtime not in selected_runtimes or not workload:
        continue
    item: dict[str, Any] = {
        "runtime": runtime,
        "workload": workload,
        "status": row.get("status", "failed"),
    }
    values = samples(row)
    if row.get("status") == "ok" and values:
        item["analysis"] = {"steady_ns": round(statistics.median(values))}
    normalized.append(item)

peer_order = [
    resolved[base]
    for base in display_order
    if base in resolved and base != "hara"
]
workload_ids = list(dict.fromkeys(
    row["workload"] for row in normalized if row.get("workload")
))
environment = dict(run.get("environment", {}))
environment["benchmark_data_source"] = "hara-lang/hara-benchmarks:benchmark-site"
common = {
    "schema_version": 2,
    "profile": run.get("run", {}).get("profile", "canonical"),
    "environment": environment,
    "versions": run.get("versions", {}),
    "workload_ids": workload_ids,
    "provenance": run.get("provenance", {}),
}

language_rows = []
for row in normalized:
    item = dict(row)
    if item["runtime"] == HARA_RUNTIME:
        item["runtime"] = LEGACY_HARA_RUNTIME
    language_rows.append(item)
language_payload = {
    **common,
    "runtime_order": [*peer_order, LEGACY_HARA_RUNTIME],
    "measurements": language_rows,
}
class_payload = {
    **common,
    "runtime_order": [HARA_RUNTIME, *peer_order],
    "measurements": normalized,
}

for path, payload in ((language_path, language_payload), (class_path, class_payload)):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")

print(
    f"Prepared Astro benchmark evidence from {run.get('run', {}).get('id', 'canonical run')}: "
    f"{len(resolved)} measured runtimes, {len(workload_ids)} workloads"
)
PY
}

publish() {
  DEST="$OUT/benchmarks"
  DATA_DEST="$DEST/data"
  INDEX="$DEST/index.html"
  if [[ ! -s "$INDEX" ]]; then
    echo "Astro benchmark output is missing $INDEX" >&2
    exit 1
  fi
  if ! grep -Fq '<title>Hara Benchmarks</title>' "$INDEX" \
    || ! grep -Fq 'id="class-comparison"' "$INDEX" \
    || ! grep -Fq 'id="language-shootout"' "$INDEX" \
    || ! grep -Fq 'rust-prepared' "$INDEX"; then
    echo "benchmark output is not the Rust-enabled Astro site" >&2
    exit 1
  fi
  mkdir -p "$DATA_DEST"
  cp "$CATALOG" "$DATA_DEST/catalog.json"
  cp "$RUNS" "$DATA_DEST/runs.json"
  echo "Published canonical benchmark data alongside the Astro site at $DEST"
}

case "$MODE" in
  prepare) prepare ;;
  publish) publish ;;
  all) prepare; publish ;;
  *)
    echo "usage: scripts/install-benchmark-site prepare|publish|all [SOURCE] [OUT]" >&2
    exit 2
    ;;
esac
