#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SOURCE="$ROOT/hara-specs-registry/01-lang/009-halc/draft/conformance/complete.hal"
GOLDEN="$ROOT/hara-specs-registry/01-lang/009-halc/draft/conformance/golden"
WORK=$(mktemp -d "${TMPDIR:-/tmp}/hara-halc.XXXXXX")
trap 'rm -rf "$WORK"' EXIT HUP INT TERM

mvn -q -f "$ROOT/core/java/pom.xml" -Ptruffle -DskipTests package
cargo run -q --manifest-path "$ROOT/core/rust/Cargo.toml" --features halc-encoder --bin hara -- \
  compile-halc "$SOURCE" --output "$WORK/rust.halc" --resource conformance/complete.hal
java -jar "$ROOT/core/java/target/hara-truffle.jar" compile-halc "$SOURCE" \
  --output "$WORK/java.halc" --resource conformance/complete.hal
cmp "$WORK/java.halc" "$WORK/rust.halc"

mkdir -p "$GOLDEN"
cp "$WORK/java.halc" "$GOLDEN/complete.halc"
cp "$WORK/java.halc" "$GOLDEN/legacy-v1.hir"
perl -pi -e 'if ($. == 1) { substr($_, 0, 4) = "HIR\0" }' "$GOLDEN/legacy-v1.hir"

echo "HALC goldens regenerated from byte-identical Java and Rust encoders."
