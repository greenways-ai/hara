#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
CRATE_VERSION=$(sed -n 's/^version = "\(.*\)"/\1/p' "$ROOT/core/rust/Cargo.toml" | head -n 1)
VERSION=${1:-$CRATE_VERSION}
OUT=${HARA_STUDIO_RUNTIME_OUT:-"$ROOT/core/target/studio-runtime"}
STAGE="$OUT/hara-studio-runtime-$VERSION"
ARCHIVE="$OUT/hara-studio-runtime-$VERSION.tar.gz"
OBSERVATION_WASM="$ROOT/core/rust/observation-raw/target/wasm32-unknown-unknown/browser-release/hara_bytecode_observation_raw.wasm"

if [ -z "$CRATE_VERSION" ]; then
  echo "unable to read the Hara runtime version from core/rust/Cargo.toml" >&2
  exit 1
fi

# Preserve the established Studio archive assembly as a stable base. The live
# observation payload is an optional second Wasm module layered into that stage,
# keeping normal evaluation on the lean raw runtime.
"$ROOT/packaging/scripts/build-studio-runtime-base" "$VERSION" >/dev/null
bash "$ROOT/packaging/scripts/build-bytecode-observation-wasm" >/dev/null

test -s "$OBSERVATION_WASM"
cp "$OBSERVATION_WASM" "$STAGE/rust/bytecode-observation.wasm"
cp "$OBSERVATION_WASM" "$STAGE/examples/music/runtime/bytecode-observation.wasm"

node "$ROOT/packaging/scripts/verify-bytecode-observation-runtime.mjs" "$STAGE"

rm -f "$ARCHIVE" "$ARCHIVE.sha256"
COPYFILE_DISABLE=1 tar -czf "$ARCHIVE" -C "$STAGE" .
if command -v sha256sum >/dev/null 2>&1; then
  sha256sum "$ARCHIVE" > "$ARCHIVE.sha256"
else
  shasum -a 256 "$ARCHIVE" > "$ARCHIVE.sha256"
fi

echo "$ARCHIVE"
