#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

exec "$ROOT/packaging/scripts/run-runtime-benchmarks" \
  --profile standard \
  --corpus lib/bench/runtime/vm-small.json \
  --output target/vm-bb-benchmark.json \
  --runtime bb \
  --runtime hara-rust-vm \
  --runtime hara-rust-trace-native \
  --check-regressions lib/bench/runtime/vm-small-baselines.json \
  "$@"
