(ns gw.build.core
  (:require [gw.build.checker :as checker]
            [gw.build.codec :as codec]
            [gw.build.graph :as graph]
            [gw.build.model :as model]
            [gw.build.normalize :as normalize]
            [gw.build.parse :as parse]
            [gw.build.report :as report]))

(def build model/build)
(def artifact model/artifact)
(def specification-reference model/specification-reference)
(def stage model/stage)
(def checker-reference model/checker-reference)
(def checker-variation model/checker-variation)
(def parse-build parse/parse-build)
(def normalize-build normalize/normalize-build)
(def canonical-build? normalize/canonical-build?)
(def to-edn codec/to-edn)
(def from-edn codec/from-edn)
(def read-build-string codec/read-build-string)
(def write-build-string codec/write-build-string)
(def stage-index graph/stage-index)
(def stage-dependencies graph/stage-dependencies)
(def missing-dependencies graph/missing-dependencies)
(def find-cycles graph/find-cycles)
(def topological-order graph/topological-order)
(def reachable-stages graph/reachable-stages)
(def blocked-stages graph/blocked-stages)
(def check-build checker/check-build)
(def build-report report/build-report)
