(ns+
  (:require [studio.draw :as draw]))

;; SCREEN 03 // GREENWAYS OS
;; A live HAL diagram of the Chrome extension, a kernel-enabled page, debugging,
;; and publication as one connected creative workflow.

(defn lerp [a b amount]
  (+ a (* (- b a) amount)))

(defn pulse [tick offset]
  (/ (mod (+ tick offset) 150) 150.0))

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            width (get frame "canvas/width")
            height (get frame "canvas/height")
            cx (* width 0.68)
            cy (* height 0.5)
            browser-left (- cx 290)
            browser-top (- cy 220)
            browser-width 580
            browser-height 440
            extension-x (- cx 205)
            page-x (+ cx 55)
            publish-x (+ cx 210)
            debug-y (+ cy 132)
            p1 (pulse tick 0)
            p2 (pulse tick 48)
            p3 (pulse tick 96)]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :canvas-2d
               :background "#020408"
               :commands
               [[:grid 44 "rgba(156,123,255,.045)" 1]

                ;; Chrome window.
                [:mist cx cy 250 "#9c7bff" 0.12]
                [:rect browser-left browser-top browser-width browser-height "#050912" 0.96]
                [:rect browser-left browser-top browser-width 42 "#0a1020" 1]
                [:circle (+ browser-left 20) (+ browser-top 21) 5 "#ff657f" 1]
                [:circle (+ browser-left 38) (+ browser-top 21) 5 "#f5d742" 1]
                [:circle (+ browser-left 56) (+ browser-top 21) 5 "#41f5e4" 1]
                [:rect (+ browser-left 86) (+ browser-top 11) (- browser-width 118) 20 "#111a2a" 1]
                [:text "KERNEL-ENABLED PAGE" (+ browser-left 104) (+ browser-top 25) "#8195a8" 9]

                ;; Greenways extension surface.
                [:rect (- extension-x 92) (- cy 114) 184 228 "#071a18" 0.98]
                [:text "GREENWAYS OS" (- extension-x 58) (- cy 80) "#41f5e4" 13]
                [:text "CHROME EXTENSION" (- extension-x 61) (- cy 57) "#8ca9aa" 9]
                [:rect (- extension-x 63) (- cy 26) 126 34 "#0d302e" 1]
                [:text "CREATE" (- extension-x 23) (- cy 5) "#bafff8" 10]
                [:rect (- extension-x 63) (+ cy 22) 126 34 "#14223a" 1]
                [:text "INSPECT" (- extension-x 26) (+ cy 43) "#9dc9ff" 10]
                [:rect (- extension-x 63) (+ cy 70) 126 34 "#25112c" 1]
                [:text "PUBLISH" (- extension-x 27) (+ cy 91) "#ff83b7" 10]

                ;; Page kernel.
                [:circle page-x (- cy 34) 74 "#0a1930" 1]
                [:circle page-x (- cy 34) 53 "#102a43" 1]
                [:circle page-x (- cy 34) 31 "#123343" 1]
                [:text "HARA" (- page-x 22) (- cy 40) "#bafff8" 14]
                [:text "KERNEL" (- page-x 25) (- cy 20) "#41f5e4" 9]
                [:text "PAGE STATE" (- page-x 35) (+ cy 52) "#8195a8" 9]
                [:text "DOM · MEDIA · EVENTS" (- page-x 57) (+ cy 72) "#8195a8" 9]

                ;; Debugger panel.
                [:rect (- page-x 104) debug-y 208 54 "#10101c" 0.98]
                [:text "LIVE KERNEL DEBUGGER" (- page-x 74) (+ debug-y 22) "#b69bff" 10]
                [:text "SESSIONS · CAPS · MESSAGES · FRAMES" (- page-x 91) (+ debug-y 42) "#8195a8" 8]

                ;; Publication target.
                [:mist publish-x (- cy 50) 92 "#ff2e88" 0.12]
                [:circle publish-x (- cy 50) 56 "#241020" 1]
                [:text "GREENWAYS" (- publish-x 38) (- cy 55) "#ff83b7" 11]
                [:text "PUBLISH" (- publish-x 24) (- cy 36) "#f4bed4" 9]
                [:text "WORKSPACE + IDENTITY" (- publish-x 61) (+ cy 38) "#8195a8" 9]
                [:text "PROVENANCE + VERSION" (- publish-x 64) (+ cy 57) "#8195a8" 9]

                ;; Workflow connections.
                [:line (+ extension-x 92) (- cy 34) (- page-x 74) (- cy 34) "#41f5e4" 2 0.72]
                [:line (+ page-x 74) (- cy 34) (- publish-x 56) (- cy 50) "#ff2e88" 2 0.72]
                [:line page-x (+ cy 40) page-x debug-y "#9c7bff" 2 0.72]

                [:circle (lerp (+ extension-x 92) (- page-x 74) p1) (- cy 34) 6 "#bafff8" 1]
                [:circle (lerp (+ page-x 74) (- publish-x 56) p2)
                         (lerp (- cy 34) (- cy 50) p2) 6 "#ff83b7" 1]
                [:circle page-x (lerp (+ cy 40) debug-y p3) 6 "#c7b8ff" 1]

                [:text "CREATE IN THE PAGE → DEBUG THE KERNEL → PUBLISH THE WORK" (- cx 226) (+ browser-top browser-height 34) "#bafff8" 10]
                [:text "GREENWAYS OS // THE BROWSER BECOMES A CREATIVE OPERATING SURFACE" (- cx 254) (+ browser-top browser-height 56) "#8195a8" 9]]}))
          (recur (+ tick 1)))))))
