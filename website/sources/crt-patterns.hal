(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: Five mathematical pattern studies viewed through a curved CRT.
;; BASED ON: 2016 David A. Roberts — https://davidar.io
;; REFERENCE: https://www.shadertoy.com/view/Xs3GWj
;; CRT treatment adapted from https://www.shadertoy.com/view/XtlSD7
;; MODES: Margarita, Plaid Meltdown, Sunlight Revealed, Threesome,
;; and Digital Bacteria. The scene changes every ten seconds.
;; TRY: change 0.1 * time in pattern-mode to cycle faster.
;; TRY: reduce the scanline and grille contrast for a softer display.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

#define PI 3.141592653589793

vec2 crtCurveUv(vec2 uv) {
  uv = uv * 2.0 - 1.0;
  vec2 offset = abs(uv.yx) / vec2(6.0, 4.0);
  uv += uv * offset * offset;
  return uv * 0.5 + 0.5;
}

vec3 addVignette(vec3 value, vec2 uv) {
  float vignette = uv.x * uv.y * (1.0 - uv.x) * (1.0 - uv.y);
  vignette = clamp(pow(16.0 * vignette, 0.3), 0.0, 1.0);
  return value * (0.30 + 0.70 * vignette);
}

vec3 addCrtMask(vec3 value, vec2 uv, float time) {
  float scanline = clamp(
    0.94 + 0.06 * cos(PI * (uv.y + 0.008 * time) * 300.0),
    0.0, 1.0);
  float grille = 0.86 + 0.14 * clamp(
    1.5 * cos(PI * uv.x * 720.0), 0.0, 1.0);
  return value * scanline * grille * 1.16;
}

float angleOf(vec2 p) { return atan(p.y, p.x); }
float cubeRoot(float x) { return sign(x) * pow(abs(x), 1.0 / 3.0); }
float square(float x) { return x * x; }

vec3 margarita(vec2 p) {
  float z = length(p) - 3.5 * angleOf(p) + sin(p.x) + cos(p.y);
  if (mod(z, 7.0 * PI) < PI / 2.0) return vec3(1.0, 0.03, 0.18);
  if (mod(z, PI) < PI / 2.0) return vec3(0.0);
  return vec3(0.72, 1.0, 0.97);
}

vec3 digitalBacteria(vec2 p) {
  p /= 4.0;
  float x = square(sin(p.x) + p.y) + square(cos(p.y) + p.x);
  float y = cos(10.0 * p.x) + cos(10.0 * p.y) - sin(p.x * p.y);
  float z = square(sin(floor(p.x)) + floor(p.y))
    + square(cos(floor(p.y)) + floor(p.x));
  if (17.0 < x && x < 21.0 && 17.0 < z && z < 21.0 && y < 0.0)
    return vec3(0.45, 1.0, 0.32);
  if (17.0 < z && z < 21.0) return vec3(0.62, 0.02, 0.22);
  if (17.0 < x && x < 21.0) return vec3(0.98, 0.72, 0.10);
  return vec3(0.04, 0.22, 0.20);
}

vec3 threesome(vec2 p) {
  p /= 3.0;
  float z = 1.0;
  z *= sin(length(p + vec2(5.0, 0.0)))
    * cos(8.0 * angleOf(p + vec2(5.0, 0.0)));
  z *= sin(length(p - vec2(5.0, 5.0)))
    * cos(8.0 * angleOf(p - vec2(5.0, 5.0)));
  z *= sin(length(p + vec2(0.0, 5.0)))
    * cos(8.0 * angleOf(p + vec2(0.0, 5.0)));
  if ((-0.1 < z && z < 0.0) || 0.2 < z)
    return vec3(0.02, 0.01, 0.07);
  return vec3(0.38, 0.95, 1.0);
}

vec3 plaidMeltdown(vec2 p) {
  p = p / 15.0 + 7.0;
  float a = 2.0 * sin(p.x * sin(p.y) + p.y * sin(p.x));
  float b = cubeRoot(sin(2.5 * sqrt(2.0) * (p.x - p.y)));
  float c = cubeRoot(sin(2.5 * sqrt(2.0) * (p.x + p.y)));
  float d = sin(80.0 * p.x) + sin(80.0 * p.y);
  if (0.25 * (a + b + c) > 0.5 * d)
    return vec3(0.01, 0.01, 0.04);
  return vec3(0.61, 0.20, 1.0);
}

vec3 sunlightRevealed(vec2 p) {
  p /= 6.0;
  p.x += 2.0;
  float a = length(vec2(3.0 - p.x, p.y)) + abs(p.y) + abs(1.0 - p.x);
  float f = atan(p.y, p.x - 1.0);
  float c = atan(p.y, p.x - 3.0);
  float radius = square(p.x - 1.0) + square(p.y);
  vec3 result = vec3(0.0);
  float layers = 0.0;
  if (5.0 < a && a < 7.0 && mod(f, PI / 7.0) < PI / 14.0) {
    result += vec3(0.0, 0.42, 1.0);
    layers += 1.0;
  }
  if (5.0 < a && a < 7.0 && mod(c, PI / 9.0) < PI / 18.0) {
    result += vec3(1.0, 0.03, 0.18);
    layers += 1.0;
  }
  if (5.0 < a && a < 7.0 && mod(f, PI / 8.0) < PI / 16.0) {
    result += vec3(1.0, 0.88, 0.05);
    layers += 1.0;
  }
  float safeF = max(abs(f), 0.04);
  if ((45.0 - 3.0 * p.x) * PI / 180.0 < f
      && f < (47.0 - p.x) * PI / 180.0
      && p.y > 0.1 * p.x
      && mod(log(max(radius, 0.001)) / log(safeF), 2.0) < 1.0) {
    result += vec3(0.72, 1.0, 0.97);
    layers += 1.0;
  }
  return layers > 0.0 ? result / layers : result;
}

vec3 pattern(vec2 p, float time) {
  float patternMode = mod(0.1 * time, 5.0);
  if (patternMode < 1.0) return margarita(p);
  if (patternMode < 2.0) return plaidMeltdown(p);
  if (patternMode < 3.0) return sunlightRevealed(p);
  if (patternMode < 4.0) return threesome(p);
  return digitalBacteria(p);
}

void main() {
  float time = u_time * 0.001;
  vec2 uv = gl_FragCoord.xy / u_resolution.xy;
  // Keep the characteristic CRT bow without cutting the pattern into an
  // inset screen. The blend remains inside the full viewport on wide and
  // mobile layouts, while the scanline/grille treatment still reads as CRT.
  vec2 crtUv = clamp(mix(uv, crtCurveUv(uv), 0.42), 0.0, 1.0);

  vec3 result = vec3(0.0);
  for (int sampleIndex = 0; sampleIndex < 4; sampleIndex++) {
    vec2 sampleOffset = vec2(
      float(sampleIndex / 2), float(sampleIndex - (sampleIndex / 2) * 2))
      * 0.5 / u_resolution;
    vec2 offsetUv = uv + sampleOffset;
    vec2 sampleUv = clamp(
      mix(offsetUv, crtCurveUv(offsetUv), 0.42), 0.0, 1.0);
    vec2 p = 50.0 * sampleUv - 25.0;
    p *= 0.75 + 0.05 * mod(time, 10.0);
    p += mod(time, 10.0) - 5.0;
    p.x *= u_resolution.x / u_resolution.y;
    float fade = smoothstep(0.0, 2.0, mod(time, 10.0))
      - smoothstep(8.0, 10.0, mod(time, 10.0));
    float pixelScale = max(1.0, u_resolution.y / 50.0 * 2.0 * fade + 1.0);
    p = floor(p * pixelScale) / pixelScale;
    result += pattern(p, time) * 0.25;
  }

  result = addVignette(result, crtUv);
  result = addCrtMask(result, uv, time);
  result *= vec3(0.78, 1.0, 1.08);
  color = vec4(result, 1.0);
}
")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#020408"
                :commands
                [[:text "CRT PATTERNS // WEBGL2 REQUIRED"
                  24 (- height 24) "#9c7bff" 11]]}}))
          (recur (+ tick 1)))))))
