(ns+
  (:require [studio.draw :as draw]))

;; SCREEN 02 // THE HARA KERNEL
;; This document draws the browser boundary and the media capabilities that a
;; Hara kernel can address through host adapters. The diagram is live HAL.

(defn lerp [a b amount]
  (+ a (* (- b a) amount)))

(defn pulse [tick offset]
  (/ (mod (+ tick offset) 120) 120.0))

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            width (get frame "canvas/width")
            height (get frame "canvas/height")
            cx (* width 0.69)
            cy (* height 0.49)
            left (- cx 235)
            right (+ cx 235)
            top (- cy 190)
            bottom (+ cy 190)
            p1 (pulse tick 0)
            p2 (pulse tick 30)
            p3 (pulse tick 60)
            p4 (pulse tick 90)]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :canvas-2d
               :background "#020408"
               :commands
               [[:grid 42 "rgba(65,245,228,.045)" 1]

                ;; Browser capability boundary.
                [:line (- left 105) (- top 72) (+ right 105) (- top 72) "rgba(65,245,228,.28)" 1]
                [:line (+ right 105) (- top 72) (+ right 105) (+ bottom 72) "rgba(65,245,228,.28)" 1]
                [:line (+ right 105) (+ bottom 72) (- left 105) (+ bottom 72) "rgba(65,245,228,.28)" 1]
                [:line (- left 105) (+ bottom 72) (- left 105) (- top 72) "rgba(65,245,228,.28)" 1]
                [:text "BROWSER HOST // CAPABILITY BOUNDARY" (- left 82) (- top 44) "#8195a8" 11]

                ;; Kernel core.
                [:mist cx cy 170 "#41f5e4" 0.14]
                [:circle cx cy 92 "#061923" 0.98]
                [:circle cx cy 72 "#0b3140" 0.96]
                [:circle cx cy 47 "#102733" 1]
                [:text "HARA" (- cx 24) (- cy 8) "#bafff8" 17]
                [:text "KERNEL" (- cx 30) (+ cy 15) "#41f5e4" 11]
                [:text "HAL DATA ↔ HTA" (- cx 44) (+ cy 36) "#8195a8" 9]

                ;; Capability links.
                [:line (- cx 70) (- cy 54) left top "#41f5e4" 2 0.68]
                [:line (+ cx 70) (- cy 54) right top "#9c7bff" 2 0.68]
                [:line (- cx 72) (+ cy 50) left bottom "#f5d742" 2 0.68]
                [:line (+ cx 72) (+ cy 50) right bottom "#ff2e88" 2 0.68]

                ;; Browser media adapters.
                [:rect (- left 82) (- top 34) 164 68 "#071a21" 0.96]
                [:text "WEB AUDIO" (- left 48) (- top 5) "#41f5e4" 12]
                [:text "AUDIO · MIDI · FFT" (- left 58) (+ top 17) "#8195a8" 9]

                [:rect (- right 82) (- top 34) 164 68 "#120d24" 0.96]
                [:text "VIDEO" (- right 26) (- top 5) "#b69bff" 12]
                [:text "CLIPS · STREAMS" (- right 49) (+ top 17) "#8195a8" 9]

                [:rect (- left 82) (- bottom 34) 164 68 "#201d08" 0.96]
                [:text "CANVAS / WEBGL" (- left 58) (- bottom 5) "#f5d742" 12]
                [:text "2D · 3D · SHADERS" (- left 54) (+ bottom 17) "#8195a8" 9]

                [:rect (- right 82) (- bottom 34) 164 68 "#200817" 0.96]
                [:text "MEDIA OUTPUT" (- right 48) (- bottom 5) "#ff63a4" 12]
                [:text "RECORD · PUBLISH" (- right 54) (+ bottom 17) "#8195a8" 9]

                ;; Moving HTA messages make the host/kernel relationship visible.
                [:circle (lerp cx left p1) (lerp cy top p1) 6 "#bafff8" 0.95]
                [:circle (lerp cx right p2) (lerp cy top p2) 6 "#c7b8ff" 0.95]
                [:circle (lerp cx left p3) (lerp cy bottom p3) 6 "#fff18c" 0.95]
                [:circle (lerp cx right p4) (lerp cy bottom p4) 6 "#ff83b7" 0.95]

                [:text "ONE VALUE" (- cx 250) (+ bottom 98) "#41f5e4" 10]
                [:line (- cx 172) (+ bottom 94) (+ cx 172) (+ bottom 94) "rgba(65,245,228,.42)" 1]
                [:text "INSPECT · TRANSFORM · PLAY · RECORD · PUBLISH" (- cx 166) (+ bottom 116) "#8195a8" 10]]}))
          (recur (+ tick 1)))))))
