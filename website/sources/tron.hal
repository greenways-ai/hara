(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: Four autonomous light cycles hunt, evade, and leave lethal trails.
;; Trails persist for roughly 1.5 screen lengths before fading away.
;; TRY: change cycle-speed to make path finding more or less frantic.
;; TRY: increase the collision-radius for less forgiving light walls.
(def cycle-speed 6)
(def collision-radius 20)
(def probe-spacing 36)
(def planning-interval 12)
(def planner-phases {:cyan 0 :pink 3 :violet 7 :gold 10})
(def directions [[6 0] [0 6] [-6 0] [0 -6]])
(def cycle-order [:cyan :pink :violet :gold])

(defn either [a b] (if a true b))
(defn absolute [value] (if (< value 0) (- 0 value) value))

(defn larger [a b] (if (> a b) a b))
(defn smaller [a b] (if (< a b) a b))

(defn trim-trail! [trail width height]
  ;; Collision probes are 36px apart with overlapping 20px hit radii.
  ;; A shorter retained wall keeps collision work bounded at display rate.
  (let [limit (/ (* (larger width height) 2) (* probe-spacing 2))]
    (if (> (count trail) limit) (. trail (pop-first)) trail)
    trail))

(defn event-direction [events direction]
  (loop [index 0 result direction]
    (if (< index (count events))
      (let [event (nth events index)
            key (get event "key")
            swipe (get event "direction")]
        (recur
          (+ index 1)
          (if (either (= key "ArrowLeft") (= swipe "left"))
            2
            (if (either (= key "ArrowRight") (= swipe "right"))
              0
              (if (either (= key "ArrowUp") (= swipe "up"))
                3
                (if (either (= key "ArrowDown") (= swipe "down"))
                  1 result))))))
      result)))

(defn hit-wall [x y width height]
  (if (< x 24) true
    (if (> x (- width 24)) true
      (if (< y 50) true
        (> y (- height 24))))))

(defn collides [cycle other]
  (if (< (absolute (- (get cycle :x) (get other :x))) collision-radius)
    (< (absolute (- (get cycle :y) (get other :y))) collision-radius)
    false))

(defn trail-hit [x y trail skip-last]
  (let [limit (- (count trail) skip-last)]
    (loop [index 0 hit false]
      (if (if (< index limit) (not hit))
        (let [point (nth trail index)]
          (recur
            (+ index 1)
            (if (< (absolute (- x (nth point 0))) collision-radius)
              (< (absolute (- y (nth point 1))) collision-radius)
              false)))
        hit))))

(defn blocked [name x y state width height]
  (if (hit-wall x y width height)
    true
    (loop [index 0 hit false]
      (if (if (< index (count cycle-order)) (not hit))
        (let [other-name (nth cycle-order index)
              other (get state other-name)
              skip-last (if (= name other-name) 1 0)]
          (recur
            (+ index 1)
            (trail-hit x y (get other :trail) skip-last)))
        hit))))

(defn next-position [cycle direction]
  (let [velocity (nth directions direction)
        x (+ (get cycle :x) (nth velocity 0))
        y (+ (get cycle :y) (nth velocity 1))]
    [x y]))

(defn distance-to [x y target]
  (+ (absolute (- x (get target :x)))
     (absolute (- y (get target :y)))))

(defn safe-run [name cycle direction state width height]
  ;; Look far enough ahead to prefer corridors over locally safe dead ends.
  ;; Four moves is enough to avoid immediate dead ends. Full path planning
  ;; runs only every few frames; intervening frames preserve the chosen line.
  (let [velocity (nth directions direction)]
    (loop [step 1]
      (let [x (+ (get cycle :x) (* step (nth velocity 0)))
            y (+ (get cycle :y) (* step (nth velocity 1)))]
        (if (if (<= step 4) (not (blocked name x y state width height)))
          (recur (+ step 1))
          (- step 1))))))

(defn choose-direction [name cycle target state preferred width height]
  (let [candidates
        [preferred
         (mod (+ preferred 1) 4)
         (mod (+ preferred 3) 4)
         (mod (+ preferred 2) 4)]]
    (loop [index 0 best -1 best-score -10000000]
      (if (< index (count candidates))
        (let [direction (nth candidates index)
              point (next-position cycle direction)
              x (nth point 0)
              y (nth point 1)
              safe (not (blocked name x y state width height))
              runway (if safe
                       (safe-run name cycle direction state width height)
                       0)
              turn-cost (if (= direction preferred) 0 20)
              ;; Survival dominates, but equal corridors still bend toward
              ;; the target so cycles actively pressure one another.
              score (- (* runway 100)
                       (distance-to x y target)
                       turn-cost)]
          (recur
            (+ index 1)
            (if (if safe (> score best-score)) direction best)
            (if (if safe (> score best-score)) score best-score)))
        best))))

(defn advance [cycle direction width height]
  (let [point (next-position cycle direction)
        x (nth point 0)
        y (nth point 1)
        trail (get cycle :trail)
        last-index (- (count trail) 1)
        last-point (nth trail last-index)
        should-extend
        (>= (+ (absolute (- x (nth last-point 0)))
              (absolute (- y (nth last-point 1))))
            probe-spacing)]
    (do
      (if should-extend (. trail (push-last [x y])) trail)
      (trim-trail! trail width height)
      (assoc
      (assoc
        (assoc
          (assoc cycle :x x)
          :y y)
        :direction direction)
      :trail trail))))

(defn initial-state [width height]
  {:cyan {:x 50 :y 76 :direction 0 :trail (array [50 76])}
   :pink {:x (- width 54) :y 108 :direction 2 :trail (array [(- width 54) 108])}
   :violet {:x 72 :y (- height 56) :direction 3 :trail (array [72 (- height 56)])}
   :gold {:x (- width 80) :y (- height 80) :direction 2
          :trail (array [(- width 80) (- height 80)])}})

(defn update-cycle [name target-name state events tick width height]
  (let [cycle (get state name)
        target (get state target-name)
        current (get cycle :direction)
        requested (if (= name :cyan)
                    (event-direction events current)
                    current)
        point (next-position cycle requested)
        path-open (not (blocked name (nth point 0) (nth point 1) state width height))
        should-plan
        (if (= name :cyan)
          (if (> (count events) 0) true
            (if (= (mod (+ tick (get planner-phases name)) planning-interval) 0)
              true (not path-open)))
          (if (= (mod (+ tick (get planner-phases name)) planning-interval) 0)
            true (not path-open)))
        direction
        (if should-plan
          (choose-direction name cycle target state requested width height)
          requested)]
    (if (= direction -1)
      (get (initial-state width height) name)
      (advance cycle direction width height))))

(defn head-crash [name cycle state]
  (loop [index 0 crashed false]
    (if (if (< index (count cycle-order)) (not crashed))
      (let [other-name (nth cycle-order index)]
        (recur
          (+ index 1)
          (if (= name other-name)
            false
            (collides cycle (get state other-name)))))
      crashed)))

(defn update-state [state events tick width height]
  (let [moved
        {:cyan (update-cycle :cyan :pink state events tick width height)
         :pink (update-cycle :pink :violet state events tick width height)
         :violet (update-cycle :violet :gold state events tick width height)
         :gold (update-cycle :gold :cyan state events tick width height)}
        spawn (initial-state width height)]
    {:cyan (if (head-crash :cyan (get moved :cyan) moved)
             (get spawn :cyan) (get moved :cyan))
     :pink (if (head-crash :pink (get moved :pink) moved)
             (get spawn :pink) (get moved :pink))
     :violet (if (head-crash :violet (get moved :violet) moved)
               (get spawn :violet) (get moved :violet))
     :gold (if (head-crash :gold (get moved :gold) moved)
             (get spawn :gold) (get moved :gold))}))

(defn cycle-heads [state]
  (loop [index 0 heads []]
    (if (< index (count cycle-order))
      (let [cycle (get state (nth cycle-order index))]
        (recur (+ index 1) (conj (conj heads (get cycle :x)) (get cycle :y))))
      heads)))

(defn cycle-velocities [state]
  (loop [index 0 velocities []]
    (if (< index (count cycle-order))
      (let [cycle (get state (nth cycle-order index))]
        (recur (+ index 1) (conj velocities (nth directions (get cycle :direction)))))
      velocities)))

(defn initial-trails [state]
  (loop [index 0 trails []]
    (if (< index (count cycle-order))
      (let [cycle (get state (nth cycle-order index))]
        (recur (+ index 1) (conj trails (vec (get cycle :trail)))))
      trails)))

(defn trail-deltas [state previous]
  (loop [index 0 appends [] resets []]
    (if (< index (count cycle-order))
      (let [name (nth cycle-order index)
            cycle (get state name)
            earlier (get previous name)
            trail (get cycle :trail)
            earlier-trail (get earlier :trail)
            count-trail (count trail)
            count-earlier (count earlier-trail)]
        (if (< count-trail count-earlier)
          (recur (+ index 1) appends
                 (conj resets [index (get cycle :x) (get cycle :y)]))
          (if (> count-trail count-earlier)
            (let [point (nth trail (- count-trail 1))]
              (recur (+ index 1)
                     (conj appends [index (nth point 0) (nth point 1)]) resets))
            (recur (+ index 1) appends resets))))
      {:append appends :reset resets})))

(defn render-state [state previous]
  (let [initial (if previous false true)
        delta (if previous (trail-deltas state previous) {:append [] :reset []})]
    {:type :canvas-2d
     :background "#02050b"
     :stateful
     {:kind :tron
      :init initial
      :trails (if initial (initial-trails state) [])
      :heads (cycle-heads state)
      :velocities (cycle-velocities state)
      :append (get delta :append)
      :reset (get delta :reset)}}))

(node/start
  (fn []
    (loop [state nil tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            width (get frame "canvas/width")
            height (get frame "canvas/height")
            events (get frame "input/events")
            current (if state state (initial-state width height))
            ;; Cycles move every display frame, while expensive path planning
            ;; is amortized across a short decision interval.
            next (update-state current events tick width height)]
        (do
          (co/await
            (draw/publish "canvas/background" (render-state next state)))
          (recur next (+ tick 1)))))))
