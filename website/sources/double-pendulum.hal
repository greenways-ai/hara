(ns+
  (:require [studio.draw :as draw]))

;;;;;;;;;;;;;;;;;;;;;;;; Double Pendulum ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Stateful chaotic mechanics using Verlet integration. Rod constraints
;; preserve both lengths while gravity continuously advances the masses.
;; TRY: change gravity or the initial mass positions to change the attractor.

(def gravity 1)
(def trail-limit 180)

(defn absolute [value] (if (< value 0) (- 0 value) value))
(defn smaller [a b] (if (< a b) a b))

(defn square-root [value]
  (if (= value 0)
    0
    (loop [guess (if (> value 1) value 1) step 0]
      (if (< step 7)
        (recur (/ (+ guess (/ value guess)) 2) (+ step 1))
        guess))))

(defn trim [points]
  (if (> (count points) trail-limit) (vec (rest points)) points))

(defn initial-state [width height]
  (let [anchor-x (/ width 2)
        anchor-y (/ height 5)
        length (smaller (/ width 4) (/ height 4))
        first {:x (+ anchor-x (/ (* length 82) 100))
               :y (+ anchor-y (/ (* length 42) 100))}
        second {:x (+ anchor-x (/ (* length 118) 100))
                :y (+ anchor-y (/ (* length 128) 100))}]
    {:anchor-x anchor-x :anchor-y anchor-y :length length
     :first first :first-old {:x (- (get first :x) 2) :y (get first :y)}
     :second second :second-old {:x (+ (get second :x) 1) :y (get second :y)}
     :trail-first [[(get first :x) (get first :y)]]
     :trail-second [[(get second :x) (get second :y)]]}))

(defn verlet [point old]
  {:x (- (* 2 (get point :x)) (get old :x))
   :y (+ (- (* 2 (get point :y)) (get old :y)) gravity)})

(defn constrain-to [point anchor-x anchor-y length]
  (let [dx (- (get point :x) anchor-x)
        dy (- (get point :y) anchor-y)
        distance (square-root (+ (* dx dx) (* dy dy)))]
    (if (= distance 0)
      point
      {:x (+ anchor-x (/ (* dx length) distance))
       :y (+ anchor-y (/ (* dy length) distance))})))

(defn constrain-pair [first second length]
  (let [dx (- (get second :x) (get first :x))
        dy (- (get second :y) (get first :y))
        distance (square-root (+ (* dx dx) (* dy dy)))
        adjust-x (if (= distance 0) 0 (/ (* dx (- distance length)) (* distance 2)))
        adjust-y (if (= distance 0) 0 (/ (* dy (- distance length)) (* distance 2)))]
    {:first {:x (+ (get first :x) adjust-x)
             :y (+ (get first :y) adjust-y)}
     :second {:x (- (get second :x) adjust-x)
              :y (- (get second :y) adjust-y)}}))

(defn solve-constraints [first second anchor-x anchor-y length]
  (loop [first first second second step 0]
    (if (< step 6)
      (let [anchored (constrain-to first anchor-x anchor-y length)
            pair (constrain-pair anchored second length)]
        (recur
          (constrain-to (get pair :first) anchor-x anchor-y length)
          (get pair :second)
          (+ step 1)))
      {:first first :second second})))

(defn update-state [state]
  (let [first (get state :first)
        second (get state :second)
        moved-first (verlet first (get state :first-old))
        moved-second (verlet second (get state :second-old))
        solved
        (solve-constraints
          moved-first moved-second
          (get state :anchor-x) (get state :anchor-y) (get state :length))
        next-first (get solved :first)
        next-second (get solved :second)]
    (assoc
      (assoc
        (assoc
          (assoc
            (assoc
              (assoc state :first-old first)
              :second-old second)
            :first next-first)
          :second next-second)
        :trail-first
        (trim (conj (get state :trail-first)
                    [(get next-first :x) (get next-first :y)])))
      :trail-second
      (trim (conj (get state :trail-second)
                  [(get next-second :x) (get next-second :y)])))))

(defn render-state [state]
  (let [anchor-x (get state :anchor-x)
        anchor-y (get state :anchor-y)
        first (get state :first)
        second (get state :second)]
    {:type :canvas-2d
     :background "#02050b"
     :commands
     [[:polyline (get state :trail-first) "#41f5e4" 3 0.22]
      [:polyline (get state :trail-second) "#ff2e88" 4 0.36]
      [:line anchor-x anchor-y (get first :x) (get first :y)
       "#7390a8" 2 0.58]
      [:line (get first :x) (get first :y)
       (get second :x) (get second :y) "#7390a8" 2 0.58]
      [:circle anchor-x anchor-y 5 "#9c7bff" 1]
      [:circle (get first :x) (get first :y) 11 "#41f5e4" 0.94]
      [:circle (get second :x) (get second :y) 15 "#ff2e88" 0.94]]}))

(node/start
  (fn []
    (loop [state nil tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            width (get frame "canvas/width")
            height (get frame "canvas/height")
            current (if state state (initial-state width height))
            next (if (= (mod tick 2) 0) (update-state current) current)]
        (do
          (co/await
            (draw/render "canvas/background" (render-state next)))
          (recur next (+ tick 1)))))))
