(ns+
  (:require [studio.draw :as draw]))

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :canvas-2d
               :background "#020408"
               :commands
               [[:grid 44 "rgba(65,245,228,.07)" 1]
                [:text "GRID.HAL // LIVE" 24 (- height 24) "#41f5e4" 11]]}))
          (recur (+ tick 1)))))))
