(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: A ray-marched subterranean river with glass, water, and moving light.
;; BASED ON: "Rio Subterraneo" and related volumetric studies supplied by user.
;; REFERENCE: https://www.shadertoy.com/view/4cyyRc
;; TRY: change FAR or the march step count to trade depth for performance.
;; TRY: change the cyan and amber object colors in shadeSurface.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

#define FAR 40.0

float sceneId = 0.0;
vec3 lightPosition;

float hash21(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

vec2 tunnelPath(float z) {
  return vec2(sin(z * 0.15) * 2.4, cos(z * 0.25) * 1.7);
}

float openCave(float time) {
  return tanh(cos(time * 0.05) * 12.0 + 10.0) * 0.5 + 0.5;
}

float movingDepth(float time) {
  return tanh(cos(time * 0.5) * 6.0 + 4.0) * 3.0 + 7.0;
}

float movingSide(float time) {
  return tanh(sin(time) * 5.0 - 3.0) * 4.0;
}

float triangleWave(float x) {
  return abs(x - floor(x) - 0.5);
}

vec3 triangleWave(vec3 x) {
  return abs(x - floor(x) - 0.5);
}

vec3 trap(vec3 x, float phase) {
  return (triangleWave(x - phase * 0.125)
    + triangleWave(x + phase * 0.125)) * 0.5;
}

float waterSurface(vec3 p, float time) {
  p += vec3(0.0, 0.0, time * 4.0);
  return dot(sin(p + sin(p.yzx * 2.0) * cos(p.y)), vec3(0.2)) + 1.0;
}

float sceneMap(vec3 p, float time, bool glassOnly) {
  float stone = dot(
    trap(p * 0.384 + trap(p.yzx * 0.192, 0.75), 0.75),
    vec3(0.666));
  stone = (1.0 - stone) * (cos(p.z * 0.4) + 1.02);
  p.xy -= tunnelPath(p.z);

  float tunnel = 1.5 - length(p.xy * vec2(0.5, 0.7071))
    * openCave(time) + stone;
  float glassBall = length(p - lightPosition) - 1.0;
  tunnel = min(tunnel, glassBall);
  if (glassOnly) {
    sceneId = 1.0;
    return tunnel;
  }

  p.y += waterSurface(p, time);
  sceneId = step(tunnel, p.y);
  return min(tunnel, p.y);
}

float march(vec3 rayOrigin, vec3 rayDirection, float time, bool glassOnly) {
  float travel = 0.0;
  for (int stepIndex = 0; stepIndex < 76; stepIndex++) {
    float distanceToScene = sceneMap(
      rayOrigin + rayDirection * travel, time, glassOnly);
    if (abs(distanceToScene) < 0.001 * (travel * 0.5 + 1.0)
        || travel > FAR) break;
    travel += distanceToScene * 0.8;
  }
  return travel;
}

vec3 surfaceNormal(vec3 p, float time, bool glassOnly, out float edge) {
  vec2 pixel = vec2(6.0 / u_resolution.y, 0.0);
  float center = sceneMap(p, time, glassOnly);
  edge = abs(sceneMap(p + pixel.xyy, time, glassOnly)
      + sceneMap(p - pixel.xyy, time, glassOnly) - center * 2.0)
    + abs(sceneMap(p + pixel.yxy, time, glassOnly)
      + sceneMap(p - pixel.yxy, time, glassOnly) - center * 2.0)
    + abs(sceneMap(p + pixel.yyx, time, glassOnly)
      + sceneMap(p - pixel.yyx, time, glassOnly) - center * 2.0);
  edge = smoothstep(0.0, 1.0, sqrt(edge / pixel.x * 2.0));

  vec2 epsilon = vec2(0.01, 0.0);
  return normalize(vec3(
    sceneMap(p + epsilon.xyy, time, glassOnly)
      - sceneMap(p - epsilon.xyy, time, glassOnly),
    sceneMap(p + epsilon.yxy, time, glassOnly)
      - sceneMap(p - epsilon.yxy, time, glassOnly),
    sceneMap(p + epsilon.yyx, time, glassOnly)
      - sceneMap(p - epsilon.yyx, time, glassOnly)));
}

float noise3(vec3 q) {
  vec2 p = vec2(length(q.zy), q.x);
  vec2 cell = floor(p);
  vec2 local = fract(p);
  local *= local * (3.0 - 2.0 * local);
  return mix(
    mix(hash21(cell), hash21(cell + vec2(1.0, 0.0)), local.x),
    mix(hash21(cell + vec2(0.0, 1.0)),
      hash21(cell + vec2(1.0)), local.x),
    local.y);
}

float bumpValue(vec3 p, float time) {
  return (noise3(p * 5.0 + vec3(0.0, -time * 12.0, 0.0))
    + noise3(p * 4.0 + vec3(-time * 4.0, 0.0, 0.0))
    + noise3(p * 6.0 + vec3(time * 7.0, 0.0, 0.0))) * 0.5;
}

vec3 bumpNormal(vec3 p, vec3 normal, float amount, float time) {
  vec2 epsilon = vec2(0.002, 0.0);
  float center = bumpValue(p, time);
  vec3 gradient = vec3(
    bumpValue(p - epsilon.xyy, time),
    bumpValue(p - epsilon.yxy, time),
    bumpValue(p - epsilon.yyx, time)) - center;
  return normalize((1.0 - normal * dot(normal, normal))
    * gradient * amount / epsilon.x + normal);
}

float ambientOcclusion(vec3 p, vec3 normal, float time) {
  float scale = 2.0;
  float occlusion = 0.0;
  for (int sampleIndex = 0; sampleIndex < 4; sampleIndex++) {
    float horizon = 0.01 + float(sampleIndex) * 0.125;
    float distanceToScene = sceneMap(
      p + normal * horizon, time, false);
    occlusion += (horizon - distanceToScene) * scale;
    scale *= 0.6;
  }
  return clamp(1.0 - occlusion, 0.0, 1.0);
}

vec3 shadeSurface(
  vec3 point, vec3 rayDirection, vec3 normal,
  float edge, float travel, float objectId) {
  vec3 lightDirection = lightPosition - point;
  float lightDistance = max(length(lightDirection), 0.001);
  lightDirection /= lightDistance;
  float attenuation = 1.5 / (
    1.0 + lightDistance * 0.125 + lightDistance * lightDistance * 0.025);
  float diffuse = max(dot(normal, lightDirection), 0.0);
  diffuse = pow(diffuse, 4.0) * 0.66 + pow(diffuse, 8.0) * 0.34;
  float specular = pow(max(
    dot(reflect(-lightDirection, normal), -rayDirection), 0.0), 32.0);
  vec3 material = objectId > 0.5
    ? vec3(1.0, 0.38, 0.22)
    : vec3(0.28, 0.82, 1.0);
  vec3 shaded = material * (
    diffuse + 0.7 + vec3(1.0, 0.55, 0.16) * specular * 2.0);
  return shaded * (1.0 - edge * 0.9) * attenuation;
}

void main() {
  float time = u_time * 0.001;
  vec2 screen = (gl_FragCoord.xy - u_resolution * 0.5) / u_resolution.y;
  vec3 rayOrigin = vec3(0.0, 0.0, time);
  vec3 lookAt = rayOrigin + vec3(0.0, 0.0, 0.25);
  lightPosition = rayOrigin + vec3(0.0, 0.25, movingDepth(time));
  rayOrigin.xy += tunnelPath(rayOrigin.z);
  lookAt.xy += tunnelPath(lookAt.z);
  lightPosition.xy += tunnelPath(lightPosition.z + movingSide(time))
    - vec2(0.0, 1.0);

  vec3 forward = normalize(lookAt - rayOrigin);
  vec3 right = normalize(vec3(forward.z, 0.0, -forward.x));
  vec3 up = cross(forward, right);
  vec3 rayDirection = normalize(
    forward + screen.x * right + screen.y * up);

  float travel = march(rayOrigin, rayDirection, time, false);
  float objectId = sceneId;
  if (travel > FAR) {
    color = vec4(0.001, 0.006, 0.016, 1.0);
    return;
  }

  vec3 point = rayOrigin + rayDirection * travel;
  float edge;
  vec3 normal = surfaceNormal(point, time, false, edge);
  if (objectId < 0.5) normal = bumpNormal(point, normal, 0.04, time);
  vec3 result = shadeSurface(
    point, rayDirection, normal, edge, travel, objectId);

  float fog = travel / FAR + 0.2;
  float occlusion = ambientOcclusion(point, normal, time);
  if (objectId < 0.5) {
    vec3 refracted = refract(rayDirection, normal, 1.0 / 1.33);
    float fresnel = clamp(1.0 + dot(rayDirection, normal), 0.0, 1.0);
    float insideTravel = march(point + refracted * 0.02, refracted, time, true);
    vec3 insidePoint = point + refracted * insideTravel;
    float insideEdge;
    vec3 insideNormal = surfaceNormal(
      insidePoint, time, true, insideEdge);
    vec3 refractedColor = shadeSurface(
      insidePoint, refracted, insideNormal,
      insideEdge, insideTravel, sceneId);
    result = result * 0.2 + mix(
      refractedColor, result, pow(fresnel, 5.0) * 0.4 + 0.2);
  } else {
    result = pow(max(result, 0.0), vec3(0.5))
      * (occlusion + 0.5) * 0.5 - fog * 0.3;
  }

  result = pow(smoothstep(0.05, 0.4, max(result * fog, 0.0)), vec3(0.45));
  float vignette = smoothstep(1.05, 0.25, length(screen));
  color = vec4(result * (0.55 + 0.45 * vignette), 1.0);
}
")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#020408"
                :commands
                [[:text "SUBTERRANEAN // WEBGL2 REQUIRED"
                  24 (- height 24) "#41f5e4" 11]]}}))
          (recur (+ tick 1)))))))
