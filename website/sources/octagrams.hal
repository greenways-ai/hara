(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: A luminous tunnel of repeating, rotating octagram-like box fields.
;; PORT: Adapted from the user-supplied "Octgrams" Shadertoy shader.
;; TRY: change 23.0 in the glow accumulation to sharpen or soften the volume.
;; TRY: change the cyan/blue palette near the end of the fragment shader.
;; NOTE: Time is passed explicitly through the distance functions so this
;; remains deterministic across WebGL2 implementations.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

mat2 rotate2d(float angle) {
  float cosine = cos(angle);
  float sine = sin(angle);
  return mat2(cosine, sine, -sine, cosine);
}

float signedBox(vec3 point, vec3 bounds) {
  vec3 distanceToBounds = abs(point) - bounds;
  return length(max(distanceToBounds, 0.0))
    + min(max(distanceToBounds.x,
      max(distanceToBounds.y, distanceToBounds.z)), 0.0);
}

float boxShape(vec3 point, float scale) {
  point *= scale;
  float base = signedBox(point, vec3(0.4, 0.4, 0.1)) / 1.5;
  point.xy *= 5.0;
  point.y -= 3.5;
  point.xy *= rotate2d(0.75);
  return -base;
}

float boxField(vec3 point, float sampleTime) {
  vec3 origin = point;
  float movement = sin(sampleTime * 0.4) * 2.5;
  float scale = max(0.5, 2.0 - abs(sin(sampleTime * 0.4)) * 1.5);

  point = origin;
  point.y += movement;
  point.xy *= rotate2d(0.8);
  float box1 = boxShape(point, scale);

  point = origin;
  point.y -= movement;
  point.xy *= rotate2d(0.8);
  float box2 = boxShape(point, scale);

  point = origin;
  point.x += movement;
  point.xy *= rotate2d(0.8);
  float box3 = boxShape(point, scale);

  point = origin;
  point.x -= movement;
  point.xy *= rotate2d(0.8);
  float box4 = boxShape(point, scale);

  point = origin;
  point.xy *= rotate2d(0.8);
  float box5 = boxShape(point, 0.5) * 6.0;

  float box6 = boxShape(origin, 0.5) * 6.0;
  return max(max(max(max(max(box1, box2), box3), box4), box5), box6);
}

void main() {
  float time = u_time * 0.001;
  vec2 point = (gl_FragCoord.xy * 2.0 - u_resolution)
    / min(u_resolution.x, u_resolution.y);
  vec3 rayOrigin = vec3(0.0, -0.2, time * 4.0);
  vec3 rayDirection = normalize(vec3(point, 1.5));
  rayDirection.xy *= rotate2d(sin(time * 0.03) * 5.0);
  rayDirection.yz *= rotate2d(sin(time * 0.05) * 0.2);

  float travel = 0.1;
  float accumulation = 0.0;
  for (int stepIndex = 0; stepIndex < 88; stepIndex++) {
    vec3 samplePoint = rayOrigin + rayDirection * travel;
    samplePoint = mod(samplePoint - 2.0, 4.0) - 2.0;
    float sampleTime = time - float(stepIndex) * 0.01;
    float distanceToField = max(
      abs(boxField(samplePoint, sampleTime)), 0.01);
    accumulation += exp(-distanceToField * 23.0);
    travel += distanceToField * 0.55;
  }

  vec3 glow = vec3(accumulation * 0.02);
  vec3 palette = vec3(
    0.015,
    0.20 * abs(sin(time)) + 0.03,
    0.50 + sin(time) * 0.20);
  float depthFade = clamp(
    1.0 - travel * (0.02 + 0.02 * sin(time)), 0.12, 1.0);
  float vignette = smoothstep(1.35, 0.20, length(point));
  color = vec4((glow + palette) * depthFade
    * (0.58 + 0.42 * vignette), 1.0);
}
")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#020408"
                :commands
                [[:text "OCTAGRAMS // WEBGL2 REQUIRED"
                  24 (- height 24) "#4ba8ff" 11]]}}))
          (recur (+ tick 1)))))))
