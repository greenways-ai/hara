(ns+
  (:require [studio.draw :as draw]
            [studio.node :as node]
            [studio.audio :as audio]))

(def audio-spec
  {:tempo 86 :volume 0.16 :root 43.65
   :steps [0 7 12 14 7 3 10 12] :pulse 0.42 :wave "sine"})

(def vertex-shader
  "#version 300 es
precision highp float;
void main() { vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2); gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0); }")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;
float hash(vec2 p) { return fract(sin(dot(p, vec2(41.12,289.34))) * 43758.5453); }
float noise(vec2 p) { vec2 i=floor(p),f=fract(p); f=f*f*(3.0-2.0*f); return mix(mix(hash(i),hash(i+vec2(1.,0.)),f.x),mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.,1.)),f.x),f.y); }
float box(vec2 p,vec2 b) { vec2 d=abs(p)-b; return length(max(d,0.))+min(max(d.x,d.y),0.); }
float emblem(vec2 p) { p=abs(p); float left=box(p-vec2(.12,0.),vec2(.055,.30)); float top=box(p-vec2(0.,.24),vec2(.20,.055)); float right=box(p-vec2(.20,-.06),vec2(.055,.19)); float slash=box(vec2(dot(p,normalize(vec2(.82,.57))),dot(p,normalize(vec2(-.57,.82))))-vec2(0.,-.05),vec2(.25,.055)); return min(min(left,top),min(right,slash)); }
vec3 firework(vec2 uv,float time,float seed) {
  float phase=fract(time*.075+seed);
  float life=smoothstep(0.,.045,phase)*(1.-smoothstep(.44,.9,phase));
  vec2 origin=vec2(hash(vec2(seed,4.1))*1.5-.75,hash(vec2(seed,9.7))*.86-.2);
  vec2 p=uv-origin;
  float radial=length(p), angle=atan(p.y,p.x);
  float spokes=pow(abs(sin(angle*(11.+floor(seed*7.)))),18.);
  float shell=exp(-150.*abs(radial-phase*.72))*spokes;
  float sparks=step(.82,hash(floor(vec2(angle*30.,radial*92.)+seed*73.)))*exp(-35.*abs(radial-phase*.72));
  float flash=exp(-phase*46.)*exp(-radial*34.);
  vec3 flare=mix(vec3(.10,.34,1.),vec3(1.,.06,.62),hash(vec2(seed,2.)));
  return flare*(shell*.72+sparks*.85+flash*1.7)*life;
}
void main() {
  vec2 uv=(2.0*gl_FragCoord.xy-u_resolution.xy)/u_resolution.y;
  float time=u_time*.001, radius=length(uv), a=atan(uv.y,uv.x)+time*.13;
  float grain=noise(vec2(a*13.,radius*26.+time*.32));
  float wobble=(noise(vec2(a*7.,time*.12))-.5)*.027;
  float ring=abs(radius-(.65+wobble))-(.041+grain*.018);
  float ringMask=1.0-smoothstep(0.,.012,ring), gaps=smoothstep(.14,.35,noise(vec2(a*19.,time*.18)));
  vec3 ink=vec3(.002,.006,.012), cyan=vec3(.02,.82,1.), violet=vec3(.38,.12,1.), magenta=vec3(1.,.02,.55);
  vec3 col=ink+mix(violet,cyan,.5+.5*sin(a*3.+grain*7.))*ringMask*gaps*(.48+grain*.88);
  col+=firework(uv,time,.13)+firework(uv,time,.46)+firework(uv,time,.79);
  col+=cyan*exp(-24.*abs(ring))*.16;
  col.r+=1.0*(1.0-smoothstep(0.,.012,abs(length(uv+vec2(.006,0.))-.65)-.038))*.11;
  col.b+=cyan.b*(1.0-smoothstep(0.,.012,abs(length(uv-vec2(.006,0.))-.65)-.038))*.14;
  vec2 logoUv=mat2(cos(time*.055),-sin(time*.055),sin(time*.055),cos(time*.055))*uv;
  float mark=1.0-smoothstep(0.,.017,emblem(logoUv));
  col+=mark*mix(vec3(.025,.07,.11),cyan,noise(logoUv*25.+time*.2)*.42)*.9;
  col+=cyan*mark*exp(-18.*abs(emblem(logoUv)))*.12;
  float stars=step(.994,hash(floor((uv+time*.01)*78.)));
  col+=stars*mix(cyan,magenta,hash(floor(uv*31.)))*.35;
  col*=.91+.09*sin(gl_FragCoord.y*1.7); col+=(hash(gl_FragCoord.xy+time)-.5)*.028;
  color=vec4(col,1.);
}")

(defn audio-control [args]
  (audio/control (get args 0) (get args 1)))

(audio/configure audio-spec)
(node/handle "audio/control" audio-control)

(node/start
  (fn []
    (loop []
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await (draw/render "canvas/background"
                                 {:type :webgl2 :vertex vertex-shader :fragment fragment-shader
                                  :uniforms {"u_time" time "u_resolution" [width height]}
                                  :fallback {:type :canvas-2d :background "#02050b"
                                             :commands [[:circle (/ width 2) (/ height 2) 220 "#41f5e4" 2]
                                                        [:text "SIGNAL RING // WEBGL2 REQUIRED" 24 (- height 24) "#41f5e4" 11]]}}))
          (recur))))))
