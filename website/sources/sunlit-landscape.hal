(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: A moving procedural mountain landscape with mist and sun shafts.
;; PORT: Single-pass adaptation of David Hoskins' multi-buffer landscape.
;; LICENSE: Creative Commons Attribution-NonCommercial-ShareAlike 3.0.
;; NOTE: Procedural FBM replaces the original texture and data-buffer channels.
;; TRY: change CAMERA_SPEED to move more slowly or quickly through the valley.
;; TRY: alter SUN_COLOR and SKY_ZENITH for a different time of day.
;; PERFORMANCE: 88 terrain steps and four FBM octaves keep phones responsive.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

const float FAR = 190.0;
const float CAMERA_SPEED = 2.7;
const vec3 SUN_COLOR = vec3(1.0, 0.72, 0.46);
const vec3 SKY_ZENITH = vec3(0.025, 0.075, 0.19);

float hash21(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

float noise2(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x),
    mix(hash21(i + vec2(0.0, 1.0)),
      hash21(i + vec2(1.0, 1.0)), f.x), f.y);
}

float fbm(vec2 p) {
  float value = 0.0;
  float weight = 0.52;
  mat2 turn = mat2(0.80, -0.60, 0.60, 0.80);
  for (int octave = 0; octave < 5; octave++) {
    value += noise2(p) * weight;
    p = turn * p * 2.03 + vec2(7.1, 3.7);
    weight *= 0.49;
  }
  return value;
}

float terrainHeight(vec2 xz) {
  float broad = fbm(xz * 0.022) * 24.0;
  float ridges = 1.0 - abs(fbm(xz * 0.047 + 9.0) * 2.0 - 1.0);
  ridges = ridges * ridges * 14.0;
  float valley = 12.0 * exp(-abs(xz.x) * 0.055);
  return broad + ridges - valley - 12.5;
}

float terrainMap(vec3 p) {
  return p.y - terrainHeight(p.xz);
}

vec3 terrainNormal(vec3 p, float distanceAlongRay) {
  float e = mix(0.08, 0.48, clamp(distanceAlongRay / FAR, 0.0, 1.0));
  float h = terrainMap(p);
  return normalize(vec3(
    h - terrainMap(p - vec3(e, 0.0, 0.0)),
    e,
    h - terrainMap(p - vec3(0.0, 0.0, e))));
}

mat3 cameraBasis(vec3 origin, vec3 target) {
  vec3 forward = normalize(target - origin);
  vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
  vec3 up = cross(right, forward);
  return mat3(right, up, forward);
}

float marchTerrain(vec3 origin, vec3 ray) {
  float t = 0.8;
  for (int stepIndex = 0; stepIndex < 88; stepIndex++) {
    vec3 p = origin + ray * t;
    float distanceToGround = terrainMap(p);
    if (distanceToGround < max(0.045, t * 0.0012)) return t;
    t += max(0.16, distanceToGround * 0.42);
    if (t > FAR) break;
  }
  return FAR;
}

float cloudField(vec2 p) {
  return smoothstep(0.52, 0.82, fbm(p));
}

vec3 skyColor(vec3 ray, vec3 sunDirection, float time) {
  float horizon = pow(1.0 - max(ray.y, 0.0), 3.0);
  vec3 sky = mix(SKY_ZENITH, vec3(0.31, 0.40, 0.51), horizon);
  float sun = max(dot(ray, sunDirection), 0.0);
  sky += SUN_COLOR * pow(sun, 720.0) * 8.0;
  sky += SUN_COLOR * pow(sun, 18.0) * 0.42;

  vec2 cloudUv = ray.xz / max(ray.y + 0.24, 0.09);
  float clouds = cloudField(cloudUv * 0.17 + vec2(time * 0.009, 0.0));
  float cloudLight = cloudField(cloudUv * 0.17
    + normalize(sunDirection.xz) * 0.035 + vec2(time * 0.009, 0.0));
  vec3 cloudColor = mix(vec3(0.20, 0.24, 0.31), SUN_COLOR,
    clamp((clouds - cloudLight) * 6.0 + 0.36, 0.0, 1.0));
  sky = mix(sky, cloudColor, clouds * smoothstep(0.02, 0.34, ray.y) * 0.7);
  return sky;
}

float sunShafts(vec2 uv, vec2 sunUv, float terrainMask, float time) {
  vec2 delta = uv - sunUv;
  float angle = atan(delta.y, delta.x);
  float radialNoise = noise2(vec2(angle * 18.0, floor(time * 0.18)));
  float beam = pow(max(0.0, 1.0 - length(delta) * 0.72), 3.0);
  beam *= mix(0.36, 1.0, radialNoise);
  return beam * (1.0 - terrainMask) * 0.25;
}

vec3 toneMap(vec3 c) {
  c = c / (1.0 + c);
  return pow(clamp(c, 0.0, 1.0), vec3(0.4545));
}

void main() {
  float time = u_time * 0.001;
  vec2 uv = (gl_FragCoord.xy * 2.0 - u_resolution.xy) / u_resolution.y;

  float travel = time * CAMERA_SPEED;
  vec3 origin = vec3(sin(travel * 0.035) * 5.2,
    8.8 + sin(travel * 0.021) * 1.1, travel);
  vec3 target = vec3(sin((travel + 24.0) * 0.035) * 3.6,
    5.8 + sin(travel * 0.017), travel + 30.0);
  vec3 ray = cameraBasis(origin, target) * normalize(vec3(uv, 1.72));
  vec3 sunDirection = normalize(vec3(-0.34, 0.48, 0.62));

  float distanceAlongRay = marchTerrain(origin, ray);
  float hit = step(distanceAlongRay, FAR - 0.01);
  vec3 result = skyColor(ray, sunDirection, time);

  if (hit > 0.5) {
    vec3 p = origin + ray * distanceAlongRay;
    vec3 normal = terrainNormal(p, distanceAlongRay);
    float diffuse = max(dot(normal, sunDirection), 0.0);
    float rockNoise = fbm(p.xz * 0.09);
    float grass = smoothstep(0.62, 0.92, normal.y)
      * smoothstep(0.28, 0.72, rockNoise);
    vec3 rock = mix(vec3(0.105, 0.085, 0.072),
      vec3(0.31, 0.24, 0.17), rockNoise);
    vec3 material = mix(rock, vec3(0.075, 0.20, 0.12), grass);
    float ambient = 0.20 + normal.y * 0.17;
    result = material * (ambient + diffuse * SUN_COLOR * 1.65);
    float rim = pow(1.0 - max(dot(-ray, normal), 0.0), 4.0);
    result += SUN_COLOR * rim * diffuse * 0.16;

    float mist = 1.0 - exp(-distanceAlongRay * 0.018);
    mist *= mix(0.44, 0.88, smoothstep(-0.15, 0.24, ray.y));
    result = mix(result, skyColor(ray, sunDirection, time), mist);
  }

  vec3 sunCamera = transpose(cameraBasis(origin, target)) * sunDirection;
  vec2 sunUv = sunCamera.xy / max(sunCamera.z, 0.001) * 1.72;
  float shafts = sunShafts(uv, sunUv, hit, time);
  result += SUN_COLOR * shafts;

  vec2 flareVector = uv - sunUv;
  float flare = pow(max(0.0, 1.0 - length(flareVector * 0.55)), 12.0);
  flare += pow(max(0.0, 1.0
    - length(uv + sunUv * 0.42) * 2.7), 4.0) * 0.18;
  result += vec3(0.48, 0.10, 0.16) * flare * step(0.0, sunCamera.z) * 0.32;

  float vignette = smoothstep(1.55, 0.24, dot(uv * 0.72, uv * 0.72));
  result *= mix(0.42, 1.0, vignette);
  color = vec4(toneMap(result * 1.35), 1.0);
}
")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#061126"
                :commands
                [[:text "SUNLIT LANDSCAPE // WEBGL2 REQUIRED"
                  24 (- height 24) "#ffb272" 11]]}}))
          (recur (+ tick 1)))))))
