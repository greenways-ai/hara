(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: A deep star field with several layers of independently twinkling light.
;; TRY: change 90.0 to increase or reduce the density of stars.
;; TRY: change 0.003 to make the stars twinkle faster.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

float hash21(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution.xy;
  vec2 cells = uv * 90.0;
  vec2 id = floor(cells);
  vec2 local = fract(cells) - 0.5;
  float seed = hash21(id);
  float radius = length(local);
  float star = smoothstep(0.09 + seed * 0.07, 0.0, radius);
  float twinkle = 0.45 + 0.55 * sin(u_time * 0.003 + seed * 35.0);
  star *= step(0.91, seed) * twinkle;
  vec3 cyan = vec3(0.20, 0.92, 1.0);
  vec3 violet = vec3(0.68, 0.34, 1.0);
  vec3 tint = mix(cyan, violet, seed);
  vec3 sky = vec3(0.002, 0.006, 0.018) + 0.018 * vec3(uv.y, 0.3, 1.0 - uv.y);
  color = vec4(sky + tint * star * 2.2, 1.0);
}")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#02040c"
                :commands
                [[:text "STARS.HAL // WEBGL2 REQUIRED"
                  24 (- height 24) "#bafff8" 11]]}}))
          (recur (+ tick 1)))))))
