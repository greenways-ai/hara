(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: Endless wind-carved dunes with fine crossed sand ripples and haze.
;; PORT: Mobile-conscious adaptation of the “Desert Sand” Shadertoy study.
;; NOTE: Procedural gradient noise replaces Shadertoy textures and old globals.
;; TRY: change DUNE_HEIGHT to make the terrain flatter or more dramatic.
;; TRY: change RIPPLE_SCALE to make the foreground wind lines finer or broader.
;; PERFORMANCE: Detail fades with distance to suppress moiré and save GPU work.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

const float FAR = 92.0;
const float DUNE_HEIGHT = 3.4;
const float RIPPLE_SCALE = 58.0;

mat2 rotate2(float angle) {
  float c = cos(angle);
  float s = sin(angle);
  return mat2(c, s, -s, c);
}

float hash21(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

vec2 hash22(vec2 p) {
  float n = sin(dot(p, vec2(113.0, 1.0)));
  return fract(vec2(2097152.0, 262144.0) * n) * 2.0 - 1.0;
}

float gradientNoise(vec2 p) {
  vec2 cell = floor(p);
  vec2 local = fract(p);
  vec2 blend = local * local * (3.0 - 2.0 * local);
  float a = dot(hash22(cell), local);
  float b = dot(hash22(cell + vec2(1.0, 0.0)),
    local - vec2(1.0, 0.0));
  float c = dot(hash22(cell + vec2(0.0, 1.0)),
    local - vec2(0.0, 1.0));
  float d = dot(hash22(cell + vec2(1.0)),
    local - vec2(1.0));
  return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y) * 0.5 + 0.5;
}

float valueNoise(vec2 p) {
  vec2 cell = floor(p);
  vec2 local = fract(p);
  local = local * local * (3.0 - 2.0 * local);
  return mix(mix(hash21(cell), hash21(cell + vec2(1.0, 0.0)), local.x),
    mix(hash21(cell + vec2(0.0, 1.0)),
      hash21(cell + vec2(1.0)), local.x), local.y);
}

float fbm(vec2 p) {
  return gradientNoise(p) * 0.57
    + gradientNoise(p * 2.0) * 0.28
    + gradientNoise(p * 4.0) * 0.15;
}

float path(float z) {
  return 4.0 * sin(z * 0.10);
}

float duneField(vec2 p) {
  p *= 0.16;
  float broad = valueNoise(p * 0.52) * 2.0 - 0.5;
  broad = smoothstep(0.0, 1.05, broad);
  float ridge = valueNoise(p * 0.78);
  ridge = 1.0 - abs(ridge - 0.5) * 2.0;
  ridge = smoothstep(0.20, 1.0, ridge * ridge);
  float detail = valueNoise(p * 2.2);
  return broad * 0.70 + ridge * 0.25 + detail * 0.05;
}

float terrainMap(vec3 p) {
  return p.y + (0.5 - duneField(p.xz)) * DUNE_HEIGHT;
}

float marchTerrain(vec3 origin, vec3 ray) {
  float t = 0.0;
  for (int index = 0; index < 82; index++) {
    float h = terrainMap(origin + ray * t);
    if (abs(h) < 0.0015 * (t * 0.12 + 1.0) || t > FAR) break;
    t += max(0.025, h * 0.72);
  }
  return min(t, FAR);
}

vec3 terrainNormal(vec3 p, float distanceAlongRay) {
  float e = mix(0.004, 0.09, clamp(distanceAlongRay / FAR, 0.0, 1.0));
  return normalize(vec3(
    terrainMap(p + vec3(e, 0.0, 0.0))
      - terrainMap(p - vec3(e, 0.0, 0.0)),
    2.0 * e,
    terrainMap(p + vec3(0.0, 0.0, e))
      - terrainMap(p - vec3(0.0, 0.0, e))));
}

float rippleGradient(float x, float offset) {
  x = abs(fract(x / 6.2831853 + offset - 0.25) - 0.5) * 2.0;
  float pointed = clamp(x * x * (-1.0 + 2.0 * x), 0.0, 1.0);
  return mix(smoothstep(0.0, 1.0, x), pointed, 0.18);
}

float rippleLayer(vec2 p) {
  vec2 first = rotate2(0.1745) * p;
  first.y += (gradientNoise(first * 18.0) - 0.5) * 0.05;
  float a = rippleGradient(first.y * RIPPLE_SCALE, 0.0);
  vec2 second = rotate2(-0.157) * p;
  second.y += (gradientNoise(second * 12.0) - 0.5) * 0.05;
  float b = rippleGradient(second.y * RIPPLE_SCALE, 0.5);
  vec2 mixer = rotate2(0.7854) * p;
  float blend = dot(sin(mixer * 12.0 - cos(mixer.yx * 12.0)),
    vec2(0.25)) + 0.5;
  return 1.0 - (1.0 - a * (1.0 - blend)) * (1.0 - b * blend);
}

float sandRipples(vec2 p, float distanceAlongRay) {
  p = vec2(p.y - p.x, p.x + p.y) * 0.17678;
  float first = rippleLayer(p);
  float second = rippleLayer(rotate2(0.2618) * p * 1.25);
  float pattern = mix(first, second,
    smoothstep(0.1, 0.9, gradientNoise(p * 4.0)));
  return pattern / (1.0 + distanceAlongRay * distanceAlongRay * 0.0018);
}

float softShadow(vec3 origin, vec3 direction) {
  float result = 1.0;
  float distanceAlongRay = 0.08;
  for (int index = 0; index < 18; index++) {
    float h = terrainMap(origin + direction * distanceAlongRay);
    result = min(result, 10.0 * h / distanceAlongRay);
    distanceAlongRay += clamp(h, 0.08, 0.65);
    if (result < 0.02 || distanceAlongRay > 22.0) break;
  }
  return clamp(result + 0.08, 0.0, 1.0);
}

vec3 skyColor(vec3 ray, vec3 sunDirection) {
  vec3 horizon = vec3(0.83, 0.63, 0.42);
  vec3 zenith = vec3(0.22, 0.47, 0.82);
  vec3 sky = mix(horizon, zenith,
    pow(max(ray.y + 0.15, 0.0), 0.55));
  float sun = max(dot(sunDirection, ray), 0.0);
  sky += vec3(1.0, 0.64, 0.28) * pow(sun, 16.0) * 0.22;
  sky += vec3(1.0, 0.90, 0.62) * pow(sun, 900.0) * 4.0;
  return sky;
}

float dustMist(vec3 origin, vec3 ray, float endDistance, float time) {
  float mist = 0.0;
  for (int index = 0; index < 14; index++) {
    float t = (float(index) + 0.5) / 14.0 * min(endDistance, FAR);
    vec3 p = origin + ray * t;
    float layer = valueNoise(p.xz * 0.12
      + vec2(time * 0.025, -time * 0.012));
    layer *= smoothstep(5.0, 0.0, p.y);
    mist += layer;
  }
  return mist / 14.0;
}

mat3 cameraBasis(vec3 origin, vec3 target) {
  vec3 forward = normalize(target - origin);
  vec3 right = normalize(vec3(forward.z, 0.0, -forward.x));
  vec3 up = cross(forward, right);
  return mat3(right, up, forward);
}

vec3 toneMap(vec3 c) {
  c = c / (1.0 + c);
  return pow(clamp(c, 0.0, 1.0), vec3(0.4545));
}

void main() {
  float time = u_time * 0.001;
  vec2 uv = (gl_FragCoord.xy * 2.0 - u_resolution.xy) / u_resolution.y;
  float travel = time * 2.0;
  vec3 origin = vec3(path(travel), 1.45, travel);
  vec3 target = vec3(path(travel + 1.8), 1.12, travel + 2.8);
  origin.y -= (0.5 - duneField(origin.xz)) * DUNE_HEIGHT;
  target.y -= (0.5 - duneField(target.xz)) * DUNE_HEIGHT;

  vec3 ray = cameraBasis(origin, target)
    * normalize(vec3(uv * 1.13, 1.55));
  vec3 sunDirection = normalize(vec3(0.26, 0.48, 0.84));
  float distanceAlongRay = marchTerrain(origin, ray);
  vec3 sky = skyColor(ray, sunDirection);
  vec3 result = sky;

  if (distanceAlongRay < FAR) {
    vec3 p = origin + ray * distanceAlongRay;
    vec3 normal = terrainNormal(p, distanceAlongRay);
    float ripples = sandRipples(p.xz, distanceAlongRay);
    normal = normalize(normal + vec3(
      gradientNoise(p.xz * 11.0) - 0.5, 0.0,
      gradientNoise(p.zx * 13.0) - 0.5)
      * ripples * 0.13);
    float diffuse = max(dot(normal, sunDirection), 0.0);
    float shadow = softShadow(p + normal * 0.025, sunDirection);
    float ambient = 0.28 + normal.y * 0.18;
    vec3 paleSand = vec3(1.0, 0.84, 0.54);
    vec3 redSand = vec3(0.62, 0.30, 0.13);
    vec3 material = mix(redSand, paleSand,
      fbm(p.xz * 1.8) * 0.68 + ripples * 0.32);
    material *= 0.72 + ripples * 0.42;
    float specular = pow(max(dot(reflect(-sunDirection, normal), -ray), 0.0), 22.0);
    result = material * (ambient + diffuse * shadow * vec3(1.25, 0.93, 0.70));
    result += vec3(1.0, 0.76, 0.48) * specular * shadow * 0.45;
    float distanceFog = smoothstep(18.0, FAR, distanceAlongRay);
    result = mix(result, sky, distanceFog * 0.82);
  }

  float dust = dustMist(origin, ray, distanceAlongRay, time);
  dust *= 0.22 + smoothstep(0.24, -0.15, ray.y) * 0.44;
  result = mix(result, vec3(0.96, 0.73, 0.48), dust);
  result += vec3(1.0, 0.47, 0.15)
    * pow(max(dot(ray, sunDirection), 0.0), 16.0) * 0.34;

  vec2 screenUv = gl_FragCoord.xy / u_resolution.xy;
  float vignette = pow(16.0 * screenUv.x * screenUv.y
    * (1.0 - screenUv.x) * (1.0 - screenUv.y), 0.08);
  result *= vignette;
  color = vec4(toneMap(result * 1.32), 1.0);
}
")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#25120a"
                :commands
                [[:text "DESERT SAND // WEBGL2 REQUIRED"
                  24 (- height 24) "#ffd28a" 11]]}}))
          (recur (+ tick 1)))))))
