(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: A soft aurora made from three animated shader bands.
;; The browser supplies time and viewport size; HAL owns the visual program.
;; TRY: change 0.45 below to 0.8 for faster movement.
;; TRY: replace the cyan or violet RGB values to create your own palette.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution.xy;
  vec2 p = uv * 2.0 - 1.0;
  p.x *= u_resolution.x / u_resolution.y;
  p.y -= 0.60;
  float t = u_time * 0.00045;
  float bandA = 0.018 / abs(p.y - 0.24 * sin(p.x * 2.2 + t));
  float bandB = 0.012 / abs(p.y + 0.18 * sin(p.x * 3.1 - t * 1.3) + 0.18);
  float bandC = 0.008 / abs(p.y - 0.12 * cos(p.x * 4.3 + t * 0.7) - 0.28);
  vec3 cyan = vec3(0.10, 0.94, 0.86);
  vec3 blue = vec3(0.12, 0.38, 0.96);
  vec3 violet = vec3(0.58, 0.15, 1.0);
  vec3 glow = cyan * bandA + blue * bandB + violet * bandC;
  float vignette = smoothstep(1.35, 0.18, length(p));
  color = vec4(glow * vignette, 1.0);
}")

;; Each frame sends only changing uniforms; the shader remains on the GPU.
(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#02040c"
                :commands
                [[:text "AURORA.HAL // WEBGL2 REQUIRED"
                  24 (- height 24) "#41f5e4" 11]]}}))
          (recur (+ tick 1)))))))
