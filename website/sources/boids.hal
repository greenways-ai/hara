(ns+
  (:require [studio.draw :as draw]))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Boids ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Reynolds-style flocking in Hara: every frame combines separation,
;; alignment, and cohesion from the previous flock state.
;; TRY: change flock-size or neighborhood to alter the emergent formations.

(def flock-size 44)
(def neighborhood 15000)
(def separation-zone 1600)
(def max-speed 9)
(def tail-length 14)

(defn absolute [value] (if (< value 0) (- 0 value) value))
(defn larger [a b] (if (> a b) a b))

(defn array-get [values index] (. values (get index)))
(defn array-set [values index value] (. values (set index value)))
(defn array-push [values value] (. values (push-last value)))

(defn trim-tail! [tail]
  (if (> (count tail) tail-length) (. tail (pop-first)) tail)
  tail)

(defn seed-flock [width height]
  (loop [index 0 xs (array) ys (array) vxs (array) vys (array)
         next-xs (array) next-ys (array) next-vxs (array) next-vys (array)
         tails (array)]
    (if (< index flock-size)
      (let [x (+ 30 (mod (* index 83) (larger 60 (- width 60))))
            y (+ 30 (mod (* index 47) (larger 60 (- height 60))))]
        (do
          (array-push xs x) (array-push ys y)
          (array-push vxs (- (mod (* index 7) 11) 5))
          (array-push vys (- (mod (* index 13) 9) 4))
          (array-push next-xs 0) (array-push next-ys 0)
          (array-push next-vxs 0) (array-push next-vys 0)
          (array-push tails (array [x y]))
          (recur (inc index) xs ys vxs vys next-xs next-ys next-vxs next-vys tails)))
      {:x xs :y ys :vx vxs :vy vys
       :next-x next-xs :next-y next-ys :next-vx next-vxs :next-vy next-vys
       :tails tails})))

(defn neighborhood-force [state boid-index]
  (let [xs (get state :x) ys (get state :y)
        vxs (get state :vx) vys (get state :vy)
        x (array-get xs boid-index) y (array-get ys boid-index)]
  (loop [index 0 neighbors 0
         center-x 0 center-y 0 align-x 0 align-y 0
         separate-x 0 separate-y 0]
    (if (< index (count xs))
      (let [dx (- (array-get xs index) x)
            dy (- (array-get ys index) y)
            distance (+ (* dx dx) (* dy dy))]
        (if (if (> distance 0) (< distance neighborhood))
          (recur
            (+ index 1)
            (+ neighbors 1)
            (+ center-x (array-get xs index))
            (+ center-y (array-get ys index))
            (+ align-x (array-get vxs index))
            (+ align-y (array-get vys index))
            (if (< distance separation-zone) (- separate-x dx) separate-x)
            (if (< distance separation-zone) (- separate-y dy) separate-y))
          (recur
            (+ index 1) neighbors center-x center-y align-x align-y
            separate-x separate-y)))
      (if (= neighbors 0)
        [0 0]
        [(+ (/ (- (/ center-x neighbors) x) 90)
            (/ (- (/ align-x neighbors) (array-get vxs boid-index)) 8)
            (/ separate-x 28))
         (+ (/ (- (/ center-y neighbors) y) 90)
            (/ (- (/ align-y neighbors) (array-get vys boid-index)) 8)
            (/ separate-y 28))])))))

(defn limit-velocity [vx vy]
  (let [magnitude (+ (absolute vx) (absolute vy))]
    (if (> magnitude max-speed)
      [(/ (* vx max-speed) magnitude)
       (/ (* vy max-speed) magnitude)]
      [vx vy])))

(defn wrap [value limit]
  (if (< value -20) (+ limit 20)
    (if (> value (+ limit 20)) -20 value)))

(defn step-flock! [state width height]
  (let [xs (get state :x) ys (get state :y)
        vxs (get state :vx) vys (get state :vy)
        next-xs (get state :next-x) next-ys (get state :next-y)
        next-vxs (get state :next-vx) next-vys (get state :next-vy)
        tails (get state :tails)]
    (loop [index 0]
      (if (< index (count xs))
        (let [force (neighborhood-force state index)
              velocity
              (limit-velocity
                (+ (array-get vxs index) (nth force 0))
                (+ (array-get vys index) (nth force 1)))
              next-vx (nth velocity 0)
              next-vy (nth velocity 1)
              x (wrap (+ (array-get xs index) next-vx) width)
              y (wrap (+ (array-get ys index) next-vy) height)
        tail (array-get tails index)]
          (do
            (array-set next-xs index x) (array-set next-ys index y)
            (array-set next-vxs index next-vx)
            (array-set next-vys index next-vy)
            (array-push tail [x y]) (trim-tail! tail)
            (recur (inc index))))
        {:x next-xs :y next-ys :vx next-vxs :vy next-vys
         :next-x xs :next-y ys :next-vx vxs :next-vy vys :tails tails}))))

(defn boid-commands [state]
  (let [xs (get state :x) ys (get state :y) tails (get state :tails)]
  (loop [index 0 commands (list)]
    (if (< index (count xs))
      (let [x (array-get xs index)
            y (array-get ys index)
            tail (array-get tails index)
            color (if (= (mod index 3) 0) "#9c7bff" "#41f5e4")]
        (recur
          (+ index 1)
          (conj
            (conj
              (conj commands [:polyline (vec tail) color 7 0.12])
              [:polyline (vec tail) color 2 0.72])
            [:circle x y 3 "#efffff" 0.94])))
      commands))))

(node/start
  (fn []
    (loop [flock nil tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            width (get frame "canvas/width")
            height (get frame "canvas/height")
            current (if flock flock (seed-flock width height))
            next (step-flock! current width height)]
        (do
          (co/await
            (draw/publish
              "canvas/background"
              {:type :canvas-2d
               :background "#02050b"
               :commands (boid-commands next)}))
          (recur next (+ tick 1)))))))
