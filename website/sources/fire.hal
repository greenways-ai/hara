(ns+
  (:require [studio.draw :as draw]))

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;
float noise(vec2 p) {
  return fract(sin(dot(p, vec2(12.9898,78.233))) * 43758.5453);
}
void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution.xy;
  float t = u_time * 0.001;
  float n = noise(vec2(uv.x * 18.0, floor(uv.y * 34.0 - t * 9.0)));
  float flame = smoothstep(0.92, 0.08, uv.y) * (0.55 + 0.45 * n);
  vec3 cyan = vec3(0.05, 0.95, 0.88);
  vec3 violet = vec3(0.57, 0.13, 1.0);
  vec3 ink = vec3(0.003, 0.008, 0.02);
  color = vec4(mix(ink, mix(cyan, violet, uv.y), flame), 1.0);
}")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#090313"
                :commands
                [[:grid 32 "rgba(156,123,255,.12)" 1]
                 [:text "FIRE.HAL // WEBGL2 FALLBACK" 24 (- height 24) "#9c7bff" 11]]}}))
          (recur (+ tick 1)))))))
