(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: Raindrop rings refract and light a deep procedural water surface.
;; PORT: Adapted from Zavie / Ctrl-Alt-Test's “H – Immersion” ripple study.
;; ORIGINAL: http://www.ctrl-alt-test.fr/productions/h-immersion/
;; NOTE: Procedural water replaces the original Shadertoy iChannel0 texture.
;; TRY: change CELL_SCALE to make the drops larger or more tightly packed.
;; TRY: change 0.34 in rippleTime to speed up or slow down the rain.
;; PERFORMANCE: Each pixel samples only the nearest 5 × 5 ripple cells.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

const int MAX_RADIUS = 2;
const float CELL_SCALE = 8.5;

float hash12(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 19.19);
  return fract((p3.x + p3.y) * p3.z);
}

vec2 hash22(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 19.19);
  return fract((p3.xx + p3.yz) * p3.zy);
}

float valueNoise(vec2 p) {
  vec2 cell = floor(p);
  vec2 local = fract(p);
  local = local * local * (3.0 - 2.0 * local);
  return mix(mix(hash12(cell), hash12(cell + vec2(1.0, 0.0)), local.x),
    mix(hash12(cell + vec2(0.0, 1.0)),
      hash12(cell + vec2(1.0)), local.x), local.y);
}

float fbm(vec2 p) {
  float value = 0.0;
  float weight = 0.5;
  mat2 turn = mat2(0.80, -0.60, 0.60, 0.80);
  for (int octave = 0; octave < 5; octave++) {
    value += valueNoise(p) * weight;
    p = turn * p * 2.03 + vec2(7.1, 3.4);
    weight *= 0.5;
  }
  return value;
}

vec2 rippleNormal(vec2 uv, float time) {
  vec2 cellOrigin = floor(uv);
  vec2 circles = vec2(0.0);
  for (int y = -MAX_RADIUS; y <= MAX_RADIUS; y++) {
    for (int x = -MAX_RADIUS; x <= MAX_RADIUS; x++) {
      vec2 cell = cellOrigin + vec2(float(x), float(y));
      vec2 center = cell + hash22(cell);
      float rippleTime = fract(time * 0.34 + hash12(cell));
      vec2 vectorToCenter = center - uv;
      float radius = float(MAX_RADIUS + 1) * rippleTime;
      float distanceToRing = length(vectorToCenter) - radius;
      float epsilon = 0.001;
      float nearWave = sin(31.0 * (distanceToRing - epsilon))
        * smoothstep(-0.6, -0.3, distanceToRing - epsilon)
        * smoothstep(0.0, -0.3, distanceToRing - epsilon);
      float farWave = sin(31.0 * (distanceToRing + epsilon))
        * smoothstep(-0.6, -0.3, distanceToRing + epsilon)
        * smoothstep(0.0, -0.3, distanceToRing + epsilon);
      float derivative = (farWave - nearWave) / (2.0 * epsilon);
      vec2 direction = vectorToCenter
        / max(length(vectorToCenter), 0.0001);
      circles += 0.5 * direction * derivative
        * (1.0 - rippleTime) * (1.0 - rippleTime);
    }
  }
  return circles / 25.0;
}

vec3 waterSurface(vec2 uv, float time) {
  vec2 drift = vec2(time * 0.018, -time * 0.012);
  float broad = fbm(uv * 3.2 + drift);
  float detail = fbm(uv * 11.0 - drift * 1.7);
  float crossing = sin((uv.x + uv.y) * 42.0 + detail * 7.0) * 0.5 + 0.5;
  vec3 deep = vec3(0.006, 0.025, 0.055);
  vec3 teal = vec3(0.018, 0.20, 0.25);
  vec3 reflectedSky = vec3(0.10, 0.28, 0.42);
  vec3 water = mix(deep, teal, broad * 0.72);
  water = mix(water, reflectedSky, detail * 0.30);
  water += vec3(0.02, 0.16, 0.19) * crossing * 0.12;
  return water;
}

float rainStreaks(vec2 uv, float time) {
  vec2 grid = vec2(uv.x * 46.0, uv.y * 7.0 + time * 5.6);
  vec2 cell = floor(grid);
  vec2 local = fract(grid);
  float seed = hash12(cell);
  float streak = smoothstep(0.08, 0.0,
    abs(local.x - seed)) * smoothstep(0.84, 0.2, local.y);
  return streak * step(0.78, seed);
}

void main() {
  float time = u_time * 0.001;
  vec2 screenUv = gl_FragCoord.xy / u_resolution.xy;
  vec2 rippleUv = gl_FragCoord.xy / u_resolution.y * CELL_SCALE;
  vec2 circles = rippleNormal(rippleUv, time);
  float normalLength = min(dot(circles, circles), 0.98);
  vec3 normal = vec3(circles, sqrt(1.0 - normalLength));

  float stormPulse = abs(fract(time * 0.05 + 0.5) * 2.0 - 1.0);
  float refraction = mix(0.008, 0.045,
    smoothstep(0.1, 0.6, stormPulse));
  vec2 refractedUv = screenUv - normal.xy * refraction;
  vec3 result = waterSurface(refractedUv, time);

  vec3 lightDirection = normalize(vec3(1.0, 0.7, 0.5));
  float specular = pow(clamp(dot(normal, lightDirection), 0.0, 1.0), 7.0);
  float rim = pow(1.0 - normal.z, 2.0);
  result += vec3(0.58, 0.90, 1.0) * specular * 2.2;
  result += vec3(0.12, 0.55, 0.64) * rim * 0.9;
  result += vec3(0.26, 0.62, 0.72)
    * rainStreaks(screenUv, time) * 0.22;

  float vignette = smoothstep(0.95, 0.22,
    length((screenUv - 0.5) * vec2(u_resolution.x / u_resolution.y, 1.0)));
  result *= 0.56 + vignette * 0.54;
  color = vec4(pow(clamp(result, 0.0, 1.0), vec3(0.82)), 1.0);
}
")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#03121c"
                :commands
                [[:text "RAIN RIPPLES // WEBGL2 REQUIRED"
                  24 (- height 24) "#72e8f2" 11]]}}))
          (recur (+ tick 1)))))))
