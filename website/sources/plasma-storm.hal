(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: Seven layers of warped neon plasma with subtle CRT interference.
;; PORT: Adapted from “Neon Plasma Storm” by Nickenstein79.
;; LICENSE: Creative Commons Attribution-NonCommercial-ShareAlike 3.0.
;; INSPIRED BY: mu6k's Noise Plasma — https://www.shadertoy.com/view/XsS3Rd
;; NOTE: The two Shadertoy noise channels are replaced with procedural noise.
;; TRY: change 7 in the layer loop to trade detail for mobile performance.
;; TRY: change the palette in plasmaMaterial for different storm colors.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

const float TWO_PI = 6.283185307179586;

float hash21(vec2 point) {
  float seed = point.x + point.y * 37.0;
  return fract(sin(seed) * 104003.9);
}

float valueNoise(vec2 point) {
  vec2 cell = floor(point);
  vec2 local = fract(point);
  local = local * local * (3.0 - 2.0 * local);
  return mix(
    mix(hash21(cell), hash21(cell + vec2(1.0, 0.0)), local.x),
    mix(hash21(cell + vec2(0.0, 1.0)),
      hash21(cell + vec2(1.0, 1.0)), local.x),
    local.y);
}

float fbm(vec2 point) {
  float result = 0.0;
  float weight = 0.5;
  for (int octave = 0; octave < 5; octave++) {
    result += valueNoise(point) * weight;
    point = point * 2.03 + vec2(11.7, 7.1);
    weight *= 0.5;
  }
  return result;
}

float oscillate(float minimum, float maximum,
    float period, float time) {
  return (maximum - minimum)
    * (sin(time * TWO_PI / period) * 0.5 + 0.5)
    + minimum;
}

mat2 skewedRotation(float angle, float time) {
  float skew = 1.0 - oscillate(0.0, 0.4, 7.4, time);
  angle = cos(angle * 0.1) * cos(angle * 0.7)
    * cos(angle * 0.73) * 2.0;
  return mat2(
    sin(angle * skew), cos(angle),
    -cos(angle * skew), sin(angle));
}

vec3 plasmaMaterial(vec2 uv, float time) {
  float broadNoise = fbm(uv * 0.10);
  float rings = broadNoise
    - (0.5 + sin(time * 0.5 + sin(uv.x) + sin(uv.y)) * 0.7);
  float filaments = 1.0 / (abs(rings * 1.6) * 10.0 + 1.0);

  float detail = fbm(uv * 0.23 + vec2(time * 0.07, -time * 0.04));
  float colorNoise = fbm(uv * 0.035 + time * 0.19);
  vec3 palette = mix(
    vec3(0.03, 0.92, 0.95),
    vec3(0.88, 0.03, 1.0),
    smoothstep(0.18, 0.84, detail));
  palette = mix(palette, vec3(0.12, 0.24, 1.0), colorNoise * 0.42);
  return palette * filaments * (0.40 + detail * 1.35);
}

vec3 crtFilter(vec3 value, vec2 uv, float time) {
  float fastScan = sin(u_resolution.y * uv.y * 0.70 - time * 10.0);
  float slowScan = sin(u_resolution.y * uv.y * 0.02 + time * 6.0);
  value *= 0.96 + 0.04 * (fastScan + slowScan) * 0.5;
  value += (hash21(uv * u_resolution + floor(time * 24.0)) - 0.5)
    * 0.018;
  return value;
}

void main() {
  float time = u_time * 0.001;
  vec2 uv = gl_FragCoord.xy / u_resolution - 0.5;
  uv.x *= u_resolution.x / u_resolution.y;

  float scale = oscillate(0.5, 2.8, 40.0, time);
  float scalePosition = (scale - 0.5) / (2.8 - 0.5);
  float scroll = mix(4.0, 12.000001, scalePosition);
  vec3 result = vec3(0.0);

  for (int layerIndex = 0; layerIndex < 7; layerIndex++) {
    float layer = float(layerIndex) / 7.0;
    vec2 layerUv = uv;
    layerUv *= skewedRotation(
      time * layer * layer * 12.0 * 0.041, time);
    layerUv *= scale * (layer * layer + 1.0);
    layerUv += scroll + time * 0.125;
    result += plasmaMaterial(layerUv, time + layer * 3.0)
      * (3.5 / 7.0);
  }

  float edge = length(uv * 0.10);
  result = max(vec3(0.0), result - edge);
  result = crtFilter(result, uv, time);
  float brightness = length(result);
  result = mix(result, vec3(brightness),
    clamp(brightness - 0.5, 0.0, 0.52));
  result = 1.0 - exp(-result * 1.35);
  color = vec4(pow(max(result, vec3(0.0)), vec3(0.86)), 1.0);
}
")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#020408"
                :commands
                [[:text "PLASMA STORM // WEBGL2 REQUIRED"
                  24 (- height 24) "#d65cff" 11]]}}))
          (recur (+ tick 1)))))))
