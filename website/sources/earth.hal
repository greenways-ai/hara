(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: A slowly rotating Earth with oceans, land, night lights, and atmosphere.
;; TEXTURE: NASA Visible Earth Blue Marble imagery (public domain).
;; https://visibleearth.nasa.gov/images/57723/the-blue-marble
;; TRY: change 0.00008 to speed up or slow down the planet's rotation.
;; TRY: change the lightDirection vector to move the day/night terminator.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;
uniform sampler2D u_earth;

float hash21(vec2 p) {
  p = fract(p * vec2(123.34, 345.45));
  p += dot(p, p + 34.345);
  return fract(p.x * p.y);
}

void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution.xy;
  vec2 p = uv * 2.0 - 1.0;
  p.x *= u_resolution.x / u_resolution.y;
  float radius = 0.58;
  float r2 = dot(p, p);
  vec3 ink = vec3(0.001, 0.004, 0.014);

  vec2 starCell = floor(uv * vec2(150.0, 95.0));
  float starSeed = hash21(starCell);
  float star = step(0.991, starSeed)
    * (0.35 + 0.65 * sin(u_time * 0.002 + starSeed * 80.0));
  vec3 scene = ink + vec3(0.48, 0.72, 1.0) * star;

  if (r2 < radius * radius) {
    float z = sqrt(radius * radius - r2);
    vec3 normal = normalize(vec3(p.x, p.y, z));
    float longitude = atan(normal.z, normal.x) + u_time * 0.00008;
    float latitude = asin(normal.y);
    vec2 mapUv = vec2(
      fract(longitude / 6.2831853),
      latitude / 3.1415926 + 0.5);
    vec3 surface = texture(u_earth, mapUv).rgb;

    vec3 lightDirection = normalize(vec3(-0.55, 0.20, 0.82));
    float daylight = dot(normal, lightDirection);
    float diffuse = 0.10 + 0.90 * smoothstep(-0.16, 0.45, daylight);

    float rim = pow(1.0 - max(normal.z, 0.0), 3.0);
    float specular = pow(max(dot(reflect(-lightDirection, normal),
      vec3(0.0, 0.0, 1.0)), 0.0), 28.0);
    scene = surface * diffuse
      + vec3(0.16, 0.38, 0.62) * specular
      + vec3(0.05, 0.55, 1.0) * rim;
  }

  float distanceFromEdge = abs(length(p) - radius);
  float atmosphere = smoothstep(0.045, 0.0, distanceFromEdge)
    * smoothstep(radius + 0.065, radius, length(p));
  scene += vec3(0.08, 0.62, 1.0) * atmosphere * 0.75;
  color = vec4(scene, 1.0);
}
")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :textures {"u_earth" "./assets/earth-blue-marble.jpg"}
               :fallback
               {:type :canvas-2d
                :background "#01040e"
                :commands
                [[:text "EARTH.HAL // WEBGL2 REQUIRED"
                  24 (- height 24) "#6ee7ff" 11]]}}))
          (recur (+ tick 1)))))))
