(ns+
  (:require [studio.draw :as draw]))

;; EFFECT: Layered, drifting networks that expand through luminous depth.
;; PORT: “The Universe Within” by Martijn Steinrucken / BigWings (2018).
;; LICENSE: Creative Commons Attribution-NonCommercial-ShareAlike 3.0.
;; TUTORIAL: https://youtu.be/3CycKKJiwis
;; NOTE: Audio FFT and mouse parallax are replaced with procedural pulses and
;; automatic motion so the effect is self-contained and mobile-friendly.
;; TRY: change 4 in the depth loop for more or fewer network layers.
;; TRY: change the three frequencies in baseColor for a different palette.

(def vertex-shader
  "#version 300 es
precision highp float;
void main() {
  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
")

(def fragment-shader
  "#version 300 es
precision highp float;
out vec4 color;
uniform float u_time;
uniform vec2 u_resolution;

float hash21(vec2 point) {
  vec3 value = fract(vec3(point.xyx)
    * vec3(213.897, 653.453, 253.098));
  value += dot(value, value.yzx + 79.76);
  return fract((value.x + value.y) * value.z);
}

vec2 movingPoint(vec2 cell, vec2 offset, float time) {
  float seed = hash21(cell + offset);
  float frequencyX = fract(seed * 10.0);
  float frequencyY = fract(seed * 100.0);
  float phase = time + seed;
  return offset + vec2(
    sin(phase * frequencyX),
    cos(phase * frequencyY)) * 0.4;
}

float segmentDistance(vec2 start, vec2 end, vec2 point) {
  vec2 toPoint = point - start;
  vec2 segment = end - start;
  float interpolation = clamp(
    dot(toPoint, segment) / max(dot(segment, segment), 0.0001),
    0.0, 1.0);
  return length(toPoint - segment * interpolation);
}

float networkLine(vec2 start, vec2 end, vec2 point) {
  float distanceToLine = segmentDistance(start, end, point);
  float lineLength = length(start - end);
  float fade = smoothstep(1.5, 0.5, lineLength);
  fade += smoothstep(0.05, 0.02, abs(lineLength - 0.75));
  return smoothstep(0.04, 0.01, distanceToLine) * fade;
}

float networkLayer(vec2 point, float layer, float time) {
  vec2 cell = floor(point) + layer;
  vec2 local = fract(point) - 0.5;
  vec2 positions[9];
  int positionIndex = 0;
  for (int y = -1; y <= 1; y++) {
    for (int x = -1; x <= 1; x++) {
      positions[positionIndex] = movingPoint(
        cell, vec2(float(x), float(y)), time);
      positionIndex++;
    }
  }

  float result = 0.0;
  float sparkle = 0.0;
  for (int index = 0; index < 9; index++) {
    result += networkLine(positions[4], positions[index], local);
    float distanceToPoint = max(length(local - positions[index]), 0.003);
    float spark = 0.005 / (distanceToPoint * distanceToPoint);
    spark *= smoothstep(1.0, 0.7, distanceToPoint);
    float pulse = sin((fract(positions[index].x)
      + fract(positions[index].y) + time) * 5.0) * 0.4 + 0.6;
    sparkle += spark * pow(pulse, 20.0);
  }

  result += networkLine(positions[1], positions[3], local);
  result += networkLine(positions[1], positions[5], local);
  result += networkLine(positions[7], positions[5], local);
  result += networkLine(positions[7], positions[3], local);

  float sparklePhase = (sin(time + layer)
    + sin(time * 0.1)) * 0.25 + 0.5;
  sparklePhase += pow(sin(time * 0.1) * 0.5 + 0.5, 50.0) * 5.0;
  return result + sparkle * sparklePhase;
}

void main() {
  float seconds = u_time * 0.001;
  vec2 uv = (gl_FragCoord.xy - u_resolution * 0.5)
    / u_resolution.y;
  float depthTime = seconds * 0.1;

  float sine = sin(depthTime);
  float cosine = cos(depthTime);
  mat2 rotation = mat2(cosine, -sine, sine, cosine);
  vec2 space = uv * rotation;
  vec2 parallax = vec2(
    sin(seconds * 0.16),
    cos(seconds * 0.13)) * 0.18;
  parallax *= rotation * 2.0;

  float network = 0.0;
  for (int layerIndex = 0; layerIndex < 4; layerIndex++) {
    float layer = float(layerIndex) / 4.0;
    float depth = fract(depthTime + layer);
    float size = mix(15.0, 1.0, depth);
    float fade = smoothstep(0.0, 0.6, depth)
      * smoothstep(1.0, 0.8, depth);
    network += fade * networkLayer(
      space * size - parallax * depth, layer, seconds);
  }

  // A self-contained low-frequency pulse replaces the original FFT channel.
  float bass = 0.38
    + 0.24 * sin(seconds * 1.7)
    + 0.12 * sin(seconds * 3.4 + 0.7);
  float lowerGlow = max(0.0, -uv.y * bass * 1.6);
  vec3 baseColor = vec3(
    sine,
    cos(depthTime * 0.4),
    -sin(depthTime * 0.24)) * 0.4 + 0.6;
  vec3 result = baseColor * (network + lowerGlow);
  result *= max(0.0, 1.0 - dot(uv, uv) * 0.74);
  result = 1.0 - exp(-result * 1.18);
  color = vec4(result, 1.0);
}
")

(node/start
  (fn []
    (loop [tick 0]
      (let [frame (co/await (draw/next-frame "canvas/background"))
            time (get frame "frame/time-ms")
            width (get frame "canvas/width")
            height (get frame "canvas/height")]
        (do
          (co/await
            (draw/render
              "canvas/background"
              {:type :webgl2
               :vertex vertex-shader
               :fragment fragment-shader
               :uniforms {"u_time" time
                          "u_resolution" [width height]}
               :fallback
               {:type :canvas-2d
                :background "#020408"
                :commands
                [[:text "UNIVERSE WITHIN // WEBGL2 REQUIRED"
                  24 (- height 24) "#9c7bff" 11]]}}))
          (recur (+ tick 1)))))))
