{:hara/type :workspace
 :hara/version "1.0.0"
 :workspace/id :hara-browser-game
 :workspace/layout
 {:layout/type :split
  :layout/direction :horizontal
  :layout/ratio 0.46
  :layout/first {:layout/type :area :layout/area "area/source"}
  :layout/second {:layout/type :area :layout/area "area/game"}}
 :workspace/documents
 [{:document/id "document/tron"
   :document/path "src/tron.hal"
   :document/language :hal
   :document/role :studio/background
   :document/anonymous true}]
 :workspace/areas
 [{:area/id "area/source" :area/type :code-editor :area/title "tron.hal"}
  {:area/id "area/game" :area/type :visual-canvas
   :area/title "HAL-owned Tron" :area/canvas "canvas/background"}]
 :workspace/nodes
 [{:node/id "node/tron"
   :node/type :hal/transform
   :node/document "document/tron"}]
 :workspace/connections []
 :workspace/links
 [{:link/id "link/tron-source"
   :link/document "document/tron"
   :link/area "area/source"
   :link/node "node/tron"}
  {:link/id "link/tron-canvas"
   :link/document "document/tron"
   :link/area "area/game"
   :link/node "node/tron"}]
 :workspace/customizations
 {:canvas/owner "node/tron"
  :input/events [:keyboard :pointer :touch :swipe]
  :recovery/journal true}}
