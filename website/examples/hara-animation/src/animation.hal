(ns hara.animation)

(def animation-pipeline
  {"pipeline/id" "hara-animation"
   "selected" "robot"
   "actions" ["walk" "wave" "jump" "spin" "bow"]
   "nodes"
   [{"id" "cast" "type" "data/character" "label" "01 · CHARACTER"}
    {"id" "director" "type" "hal/action-sequence" "label" "02 · ACTION SCRIPT"}
    {"id" "rig" "type" "animation/rig" "label" "03 · RIG"}
    {"id" "motion" "type" "animation/mixer" "label" "04 · MOTION MIXER"}
    {"id" "stage" "type" "host/canvas" "label" "05 · STAGE"}]
   "connections"
   [{"from" ["cast" "character"] "to" ["rig" "character"] "kind" "control"}
    {"from" ["director" "actions"] "to" ["motion" "queue"] "kind" "sequence"}
    {"from" ["rig" "pose"] "to" ["motion" "rig"] "kind" "pose"}
    {"from" ["motion" "frame"] "to" ["stage" "scene"] "kind" "host"}]})

(defn animation-plan []
  {"character" (get animation-pipeline "selected")
   "actions" (get animation-pipeline "actions")})

(animation-plan)
