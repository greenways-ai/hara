(ns+
  (:require [studio.draw :as draw]))

(defn visualize [input]
  ;; Change these colours in the website source pane, then apply the file.
  ;; The active HAL generation rebuilds while Web Audio keeps playing.
  (assoc input "palette" ["#2fffe0" "#149df2" "#9b35ff"]))

(defn run-visualizer []
  (loop []
    (let [input (co/await (node/in "fft/bins"))]
      (do
        (co/await
          (draw/render "canvas/visualizer"
                       (visualize input)))
        (recur)))))

(node/start run-visualizer)
