(ns+
  (:require [gw.audio.supersonic :as sonic]
            [studio.draw :as draw]))

(def amp-graph
  {"graph/id" "hara-amp"
   "title" "Hara Amp"
   "nodes"
   [{"id" "playlist"
     "type" "data/playlist"
     "label" "01 · PLAYLIST"
     "summary" "The editable program owns the material that can be played."
     "input" "Files, generated tunes, and ordering"
     "output" "Selected playable item"
     "runtime" "HAL workspace data"
     "params" {"selected" 0}}
    {"id" "transport"
     "type" "control/transport"
     "label" "02 · TRANSPORT"
     "summary" "Playback state and musical time drive the selected sequence."
     "input" "Play, pause, tempo, and position"
     "output" "Clock ticks and playback state"
     "runtime" "Supersonic browser provider"
     "params" {"playing" false "tempo" 120 "steps-per-beat" 2}
     "controls" [{"parameter" "playing" "type" "boolean" "label" "PLAYING"}
                  {"parameter" "tempo" "type" "number" "label" "TEMPO"
                   "min" 30 "max" 300 "step" 1}
                  {"parameter" "steps-per-beat" "type" "number" "label" "STEPS / BEAT"
                   "min" 1 "max" 16 "step" 1 "integer" true}]}
    {"id" "sequence"
     "type" "data/sequence"
     "label" "03 · SEQUENCE"
     "summary" "Named notes and rests are stored as offsets from the root."
     "input" "Playlist selection and transport ticks"
     "output" "Current note and gate"
     "runtime" "Supersonic tune state"
     "params" {"steps" [0 7 12 15 19 15 12 7
                        0 7 12 17 19 22 19 15]}
     "controls" [{"parameter" "steps" "type" "steps" "label" "SEQUENCE"}]}
    {"id" "source"
     "type" "wasm/oscillator"
     "label" "04 · WASM SOURCE"
     "summary" "Rust/WASM turns each scheduled note into stereo samples."
     "input" "Current note, root, gate, and waveform"
     "output" "Stereo PCM samples"
     "runtime" "Rust compiled to WebAssembly"
     "params" {"waveform" "sine" "root" 57 "gate" 0.72}
     "controls" [{"parameter" "waveform" "type" "choice" "label" "WAVEFORM"
                   "choices" ["sine" "square" "saw"]}
                  {"parameter" "root" "type" "number" "label" "MIDI ROOT"
                   "min" 0 "max" 127 "step" 1 "integer" true}
                  {"parameter" "gate" "type" "number" "label" "GATE"
                   "min" 0 "max" 1 "step" 0.01}]}
    {"id" "gain"
     "type" "audio/gain"
     "label" "05 · GAIN"
     "summary" "Web Audio applies input gain before tonal processing."
     "input" "Stereo PCM samples"
     "output" "Gain-adjusted samples"
     "runtime" "Browser Web Audio"
     "params" {"preamp" 0}
     "controls" [{"parameter" "preamp" "type" "number" "label" "PREAMP (DB)"
                   "min" -12 "max" 12 "step" 1}]}
    {"id" "eq"
     "type" "audio/equalizer"
     "label" "06 · EQUALIZER"
     "summary" "A ten-band equalizer selects the signal character."
     "input" "Gain-adjusted samples"
     "output" "Equalized samples"
     "runtime" "Browser Web Audio"
     "params" {"character" "hara"}
     "controls" [{"parameter" "character" "type" "choice" "label" "EQ CHARACTER"
                   "choices" [{"value" "flat" "label" "FLAT"}
                              {"value" "hara" "label" "HARA GLOW"}
                              {"value" "bass" "label" "BASS ARC"}
                              {"value" "voice" "label" "VOICE"}]}]}
    {"id" "mixer"
     "type" "audio/mixer"
     "label" "07 · MIXER"
     "summary" "Stereo position and final level are applied before output."
     "input" "Equalized samples"
     "output" "Positioned output samples"
     "runtime" "Browser Web Audio"
     "params" {"balance" 0 "volume" 0.78}
     "controls" [{"parameter" "balance" "type" "number" "label" "BALANCE"
                   "min" -1 "max" 1 "step" 0.05}
                  {"parameter" "volume" "type" "number" "label" "VOLUME"
                   "min" 0 "max" 1 "step" 0.01}]}
    {"id" "output"
     "type" "audio/output"
     "label" "08 · OUTPUT"
     "summary" "The browser sends the processed signal to the selected speakers."
     "input" "Processed stereo samples"
     "output" "Audible sound"
     "runtime" "Browser Web Audio · user gesture required"}
    {"id" "fft"
     "type" "analysis/fft"
     "label" "09 · FFT"
     "summary" "Rust/WASM converts analyser samples into frequency bins."
     "input" "Time-domain analyser samples"
     "output" "Latest frequency-bin frame"
     "runtime" "Rust compiled to WebAssembly"}
    {"id" "visualizer"
     "type" "hal/transform"
     "label" "10 · HAL DOCUMENT"
     "summary" "This live document turns each FFT frame into a host-neutral scene."
     "input" "Latest FFT frame and visual settings"
     "output" "Canvas scene description"
     "runtime" "Live src/amp.hal generation"
     "params" {"mode" "spectrum"}
     "controls" [{"parameter" "mode" "type" "choice" "label" "HAL OUTPUT"
                   "choices" ["spectrum" "scope" "artwork"]}]}
    {"id" "ui"
     "type" "host/canvas-ui"
     "label" "11 · CANVAS / UI"
     "summary" "The host draws the scene and exposes controls that edit this graph."
     "input" "Host-neutral scene and graph status"
     "output" "Browser pixels and control events"
     "runtime" "Browser Canvas and Hara UI"}]
   "connections"
   [{"from" ["playlist" "selected"] "to" ["sequence" "selection"] "kind" "control"}
    {"from" ["transport" "tick"] "to" ["sequence" "tick"] "kind" "control"}
    {"from" ["sequence" "note"] "to" ["source" "note"] "kind" "control"}
    {"from" ["source" "audio"] "to" ["gain" "audio"] "kind" "audio"}
    {"from" ["gain" "audio"] "to" ["eq" "audio"] "kind" "audio"}
    {"from" ["eq" "audio"] "to" ["mixer" "audio"] "kind" "audio"}
    {"from" ["mixer" "audio"] "to" ["output" "audio"] "kind" "audio"}
    {"from" ["mixer" "samples"] "to" ["fft" "samples"] "kind" "analysis"}
    {"from" ["fft" "bins"] "to" ["visualizer" "bins"] "kind" "hta/latest"}
    {"from" ["visualizer" "scene"] "to" ["ui" "scene"] "kind" "host"}]})

(def amp-state (sonic/start amp-graph))

(defn visualize [input]
  (assoc input "palette" ["#2fffe0" "#149df2" "#9b35ff"]))

(defn run-visualizer []
  (loop []
    (let [input (co/await (node/in "fft/bins"))]
      (do
        (co/await (draw/render "canvas/visualizer" (visualize input)))
        (recur)))))

(node/start run-visualizer)
