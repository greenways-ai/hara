(ns scenes.fire (:require [host.browser.canvas :as canvas]))

(def canvas-selector "#scene-canvas")
(def cell-size 8)
(def cols 160)
(def rows 100)

(def state (atom {:grid [] :seed 12345}))

(defn rand []
  "Linear congruential PRNG; returns a float in [0,1)."
  (let [s (:seed @state)
        next (mod (+ (* s 1103515245) 12345) 2147483648)]
    (swap! state assoc :seed next)
    (/ next 2147483648)))

(defn make-row []
  (loop [x 0
         row []]
    (if (= x cols)
      row
      (recur (+ x 1) (conj row 0)))))

(defn make-grid []
  (loop [y 0
         grid []]
    (if (= y rows)
      grid
      (recur (+ y 1) (conj grid (make-row))))))

(defn setup []
  (swap! state assoc :grid (make-grid)))

(defn heat-color [h]
  (cond
    (< h 0.12) "#050505"
    (< h 0.30) "#330000"
    (< h 0.50) "#ff2200"
    (< h 0.70) "#ff6b35"
    (< h 0.88) "#ffcc00"
    :else      "#ffffff"))

(defn tick [dt-ms zoom pan-x pan-y]
  (canvas/clear canvas-selector)
  (let [old-grid (:grid @state)
        new-grid
        (loop [y 0
               grid []]
          (if (= y rows)
            grid
            (recur (+ y 1)
                   (conj grid
                         (loop [x 0
                                row []]
                           (if (= x cols)
                             row
                             (recur (+ x 1)
                                    (conj row
                                          (if (= y (- rows 1))
                                            (if (< (rand) 0.12) 1.0 0.0)
                                            (let [below       (get-in old-grid [(+ y 1) x] 0)
                                                  below-left  (get-in old-grid [(+ y 1) (- x 1)] 0)
                                                  below-right (get-in old-grid [(+ y 1) (+ x 1)] 0)
                                                  avg (/ (+ below below-left below-right) 3.0)
                                                  cooled (* avg 0.92)]
                                              (if (> cooled 1.0) 1.0 cooled))))))))))]
    (swap! state assoc :grid new-grid)
    (loop [y 0]
      (if (= y rows)
        nil
        (do
          (loop [x 0]
            (if (= x cols)
              nil
              (let [h (get-in new-grid [y x] 0)]
                (if (> h 0.05)
                  (let [cx (+ pan-x (* x cell-size zoom))
                        cy (+ pan-y (* y cell-size zoom))
                        size (* cell-size zoom)]
                    (canvas/rect canvas-selector cx cy size size (heat-color h)))
                  nil)
                (recur (+ x 1)))))
          (recur (+ y 1)))))))
