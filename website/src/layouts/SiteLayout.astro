---
import ThemeToggle from "@hara-lang/visual-language/astro/ThemeToggle.astro";
import HaraMark from "@hara-lang/visual-language/astro/HaraMark.astro";
import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/motifs.css";
import "../styles/site.css";
import "../styles/shell.css";
import "@hara-lang/visual-language/theme.js";

const {
  title = "Hara",
  description = "A small, high-performance Lisp for learning to build software from first principles.",
  image = "/og-hara-ribbon.jpg"
} = Astro.props;
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080a0d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hara — Start simple. Build forever." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Hara — Start simple. Build forever." />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/assets/hara-favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><HaraMark size={27} /><span>Hara</span></a>
      <nav aria-label="Primary">
        <a href="/benchmarks/">Benchmarks</a>
        <a href="/docs/start/orientation/">Docs</a>
        <a href="https://specs.hara-lang.org/">Specs</a>
      </nav>
      <div class="header-actions">
        <a class="sign-in" href="https://id.hara-lang.org/">Sign in</a>
        <ThemeToggle />
      </div>
    </header>
    <slot />
    <footer class="site-footer"><span>Hara</span><p>Start simple. Build forever.</p><a href="https://www.greenways.ai/">Built by Greenways</a></footer>
  </body>
</html>
