---
import ThemeToggle from "@hara-lang/visual-language/astro/ThemeToggle.astro";
import HaraMark from "@hara-lang/visual-language/astro/HaraMark.astro";
import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/motifs.css";
import "../styles/site.css";
import "../styles/shell.css";
import "@hara-lang/visual-language/theme.js";

const {
  title = "Hara",
  description = "A small, high-performance Lisp for learning to build software from first principles.",
  image = "/og-hara.jpg",
  imageAlt = "Hara — simple to pick up, fast enough to keep"
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="hara-identity-mode" content="popup" />
    <meta name="theme-color" content="#080a0d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/hara-favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/install-copy.css" />
    <title>{title}</title>
    <script is:inline src="/assets/install-copy.js" defer></script>
    <script is:inline src="/assets/identity-loader.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><HaraMark size={27} /><span>Hara</span></a>
      <nav aria-label="Primary">
        <a href="/benchmarks/">Benchmarks</a>
        <a href="/docs/start/orientation/">Docs</a>
        <a href="https://specs.hara-lang.org/">Specs</a>
      </nav>
      <div class="header-actions">
        <div data-hara-identity>
          <a class="sign-in" data-hara-identity-fallback aria-label="Sign in with GitHub" href="https://id.hara-lang.org/">Sign in</a>
        </div>
        <ThemeToggle />
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <span>Hara</span>
      <p>Start simple. Build forever.</p>
      <p>
        <a href="https://opensource.greenways.ai/open-source/">A Greenways Open Source Project</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/hara-lang/hara/blob/main/LICENSE">Apache-2.0</a>
      </p>
    </footer>
  </body>
</html>
