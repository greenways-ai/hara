---
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import SiteLayout from "../layouts/SiteLayout.astro";
import Motif from "@hara-lang/visual-language/astro/Motif.astro";
import "@hara-lang/live/style.css";
import "../styles/home-interactions.css";

type LanguageMeasurement = {
  runtime: string;
  workload: string;
  status: string;
  analysis?: { steady_ns?: number };
};
type LanguageEvidence = {
  environment: { timestamp: string };
  workload_ids: string[];
  measurements: LanguageMeasurement[];
};
type HttpMeasurement = {
  server: string;
  route: string;
  status: string;
  requests_per_second?: number;
};
type RuntimeEvidence = { http_measurements?: HttpMeasurement[] };

const languageEvidencePath = fileURLToPath(
  new URL("../../../lib/bench/results/language-reference.json", import.meta.url)
);
const runtimeEvidencePath = fileURLToPath(
  new URL("../../../lib/bench/results/reference-v2.json", import.meta.url)
);
const languageEvidence: LanguageEvidence = JSON.parse(
  readFileSync(languageEvidencePath, "utf8")
);
const runtimeEvidence: RuntimeEvidence = JSON.parse(
  readFileSync(runtimeEvidencePath, "utf8")
);
const languageIndex = new Map<string, number>();
for (const row of languageEvidence.measurements) {
  const steady = row.analysis?.steady_ns;
  if (row.status === "ok" && steady != null) {
    languageIndex.set(`${row.runtime}/${row.workload}`, steady);
  }
}
const geometricMean = (values: number[]) =>
  values.length
    ? Math.exp(values.reduce((sum, value) => sum + Math.log(value), 0) / values.length)
    : null;
const languageRatio = (runtime: string) =>
  geometricMean(
    languageEvidence.workload_ids.flatMap((workload) => {
      const hara = languageIndex.get(`hara-rust-full/${workload}`);
      const candidate = languageIndex.get(`${runtime}/${workload}`);
      return hara && candidate ? [candidate / hara] : [];
    })
  );
const formatRatio = (runtime: string) => {
  const ratio = languageRatio(runtime);
  return ratio == null ? "Pending" : `${ratio.toFixed(2)}×`;
};
const hopliteHello = runtimeEvidence.http_measurements?.find(
  (row) =>
    row.server === "hoplite-request" &&
    row.route === "/hello" &&
    row.status === "ok"
);
const hopliteRequests = hopliteHello?.requests_per_second == null
  ? "Pending"
  : Math.round(hopliteHello.requests_per_second).toLocaleString("en-US");
const evidenceDate = new Date(languageEvidence.environment.timestamp).toLocaleDateString(
  "en-AU",
  { day: "numeric", month: "short", year: "numeric" }
);
---
<SiteLayout
  title="Hara — Start simple. Build forever."
  description="Start simple. Build forever. Hara is a modern Lisp for learning to build software from first principles."
>
  <main>
    <Motif kind="edge" class="hero">
      <div class="hero-copy">
        <p class="hara-kicker">A small language · a serious runtime</p>
        <h1>Start simple.<br /><span>Build forever.</span></h1>
        <p>Hara is a modern Lisp for learning to build software from first principles. Start with one visible rule, work live in the browser, and keep the same language as the system grows.</p>
        <div class="actions">
          <a class="button primary" href="https://playground.hara-lang.org/">Try Hara</a>
          <a class="button" href="/docs/start/orientation/">Start learning</a>
        </div>
        <small>Current figures below are generated from committed, checksum-verified benchmark evidence published on {evidenceDate}. <a href="/benchmarks/">Inspect the complete results.</a></small>
      </div>
    </Motif>

    <section class="proof" aria-label="Current Hara benchmark evidence">
      <div><strong>{formatRatio("python-prepared")}</strong><span>vs Python · geometric mean across 8 prepared workloads</span></div>
      <div><strong>{formatRatio("bb-prepared")}</strong><span>vs Babashka · geometric mean across 8 prepared workloads</span></div>
      <div><strong>{formatRatio("sbcl-prepared")}</strong><span>vs SBCL · geometric mean across 8 prepared workloads</span></div>
      <div><strong>{hopliteRequests}</strong><span>Hoplite /hello req/s · one worker · loopback HTTP/1.1</span></div>
    </section>

    <section class="content-section code-showcase">
      <p class="hara-kicker">Hara is Lisp</p>
      <h2>One shape. A great deal of range.</h2>
      <p class="lede">The operation comes first. Parentheses hold a computation, vectors hold ordered values, and maps name facts. That small reading model continues from the first expression into a complete program.</p>
      <div class="code-stage live">
        <div class="code-stage-card" data-live-learn></div>
        <aside>
          <span>Four reading rules</span>
          <strong>Operation first.</strong>
          <p>Code remains ordinary structure: something the runtime, tools, tests, and people can inspect without translating it into a second model.</p>
        </aside>
      </div>
      <a class="text-link" href="/docs/learn-programming/">Learn to read Hara →</a>
    </section>

    <section class="content-section intro">
      <p class="hara-kicker">Build from first principles</p>
      <h2>Learn the parts beneath the frameworks.</h2>
      <p class="lede">Values, functions, decisions, state, events, rendering, and effects are easier to understand when each one is visible. Hara lets you meet them directly, then compose them into a real application.</p>
      <div class="card-grid three">
        <article><span>01 · Learn</span><h3>Start with durable concepts</h3><p>Work with values, functions, persistent collections, explicit state, and host effects—not a temporary teaching notation.</p></article>
        <article><span>02 · Inspect</span><h3>Keep the running system close</h3><p>Write a form, evaluate it, inspect the value, and change the program without turning every experiment into a rebuild.</p></article>
        <article><span>03 · Build</span><h3>Finish a complete program</h3><p>Build Tic Tac Toe from a blank canvas, combining data, rules, state, pointer input, rendering, and a live frame loop.</p></article>
      </div>
      <p class="live-lead">Or watch the parts move first — this Pong rally is one small Hara program, evaluated live by the browser kernel when you press Run.</p>
      <div class="live-stage" data-live-canvas></div>
      <a class="text-link" href="/docs/create/first-game/">Build the first game →</a>
    </section>

    <section class="content-section">
      <p class="hara-kicker">The language you learn is the language you keep</p>
      <h2>Start live. Fit the runtime later.</h2>
      <p class="lede">The host can change without replacing the language or its values. Begin in the browser, then choose Java, native, or web deployment when the program needs it.</p>
      <div class="kernel-picker">
        <div class="kernel-mode-nav">
          <span class="kernel-mode-label">Kernel mode</span>
          <div class="kernel-mode-tabs" role="tablist" aria-label="Kernel mode">
            <button
              class="kernel-mode-tab"
              type="button"
              role="tab"
              id="kernel-tab-java"
              data-kernel-tab="java"
              aria-selected="true"
              aria-controls="kernel-panel-java"
              tabindex="0"
            ><strong>Java</strong><small>JVM / Truffle</small></button>
            <button
              class="kernel-mode-tab"
              type="button"
              role="tab"
              id="kernel-tab-native"
              data-kernel-tab="native"
              aria-selected="false"
              aria-controls="kernel-panel-native"
              tabindex="-1"
            ><strong>Native</strong><small>Rust / Whole-Wasm</small></button>
            <button
              class="kernel-mode-tab"
              type="button"
              role="tab"
              id="kernel-tab-web"
              data-kernel-tab="web"
              aria-selected="false"
              aria-controls="kernel-panel-web"
              tabindex="-1"
            ><strong>Web</strong><small>Browser / WASM</small></button>
          </div>
        </div>
        <div
          class="kernel-spec"
          id="kernel-panel-java"
          role="tabpanel"
          aria-labelledby="kernel-tab-java"
          data-kernel-mode="java"
        >
          <code>Java</code>
          <h3>Work inside the JVM ecosystem.</h3>
          <p>Run with the Truffle runtime, integrate with Java classes and tools, and target Native Image when a self-contained deployment is useful.</p>
          <dl><div><dt>Engine</dt><dd>Truffle AST / HBC4</dd></div><div><dt>Deployment</dt><dd>JVM or Native Image</dd></div><div><dt>Best for</dt><dd>Java systems and language tooling</dd></div></dl>
        </div>
        <div
          class="kernel-spec"
          id="kernel-panel-native"
          role="tabpanel"
          aria-labelledby="kernel-tab-native"
          data-kernel-mode="native"
          hidden
        >
          <code>Native</code>
          <h3>Use the primary high-performance Rust runtime.</h3>
          <p><b>hara-rust-full</b> prepares whole-function WebAssembly and hosts it natively for tools, services, local applications, and embedded products.</p>
          <dl><div><dt>Engine</dt><dd>Whole-Wasm</dd></div><div><dt>Deployment</dt><dd>Native binary or library</dd></div><div><dt>Best for</dt><dd>Services, CLIs, and embedded products</dd></div></dl>
        </div>
        <div
          class="kernel-spec"
          id="kernel-panel-web"
          role="tabpanel"
          aria-labelledby="kernel-tab-web"
          data-kernel-mode="web"
          hidden
        >
          <code>Web</code>
          <h3>Run a real Hara kernel in the browser.</h3>
          <p>Start with the interpreter core, then load VM, trace, or whole-Wasm compilation capabilities only when the application needs them.</p>
          <dl><div><dt>Small</dt><dd>Interpreter core</dd></div><div><dt>Full</dt><dd>VM + whole-Wasm compiler</dd></div><div><dt>Best for</dt><dd>Learning, tools, and browser applications</dd></div></dl>
        </div>
      </div>
      <a class="text-link" href="/benchmarks/">Compare every runtime artifact →</a>
    </section>

    <section class="content-section intro">
      <p class="hara-kicker">Measured in the open</p>
      <h2>Fast is a result, not a tagline.</h2>
      <p class="lede">Hara publishes the code, environment, timing boundaries, raw samples, and expected checksums behind every reference result. The full table remains visible—including the runtimes that are faster.</p>
      <div class="card-grid three">
        <article><span>01 · Equivalent work</span><h3>Eight verified algorithms</h3><p>Arrays, persistent data, recursion, backtracking, branching, range processing, and matrix work share expected results across runtimes.</p></article>
        <article><span>02 · Honest timing</span><h3>Preparation is not execution</h3><p>Startup, preparation, first invocation, warm-up, and steady-state execution are recorded separately where the runtime supports them.</p></article>
        <article><span>03 · Reproducible</span><h3>Follow the evidence</h3><p>Machine details, toolchain versions, source revisions, commands, raw samples, and checksums are committed alongside the report.</p></article>
      </div>
      <a class="text-link" href="/benchmarks/">Inspect every result and method →</a>
    </section>

    <Motif kind="aperture" class="closing">
      <div>
        <p class="hara-kicker">Try the language, not the pitch</p>
        <h2>Learn how programs work. Then build one.</h2>
        <div class="actions">
          <a class="button primary" href="https://playground.hara-lang.org/">Try Hara</a>
          <a class="button" href="/docs/start/orientation/">Read the first lesson</a>
        </div>
      </div>
    </Motif>
  </main>
  <script>
    import { mountLiveCard } from "@hara-lang/live";
    import pongSource from "../../sources/pong.hal?raw";

    // The three reading examples keep their original landing-page text; the
    // static <pre> tabs are replaced by an editable, runnable live card.
    const learnSnippets = [
      { id: "read", title: "Read", kind: "console" as const, source: `(+ 19 23)` },
      { id: "transform", title: "Transform", kind: "console" as const, source: `(def player
  {:name "Nova"
   :score 0})

(assoc player :score 10)` },
      { id: "state", title: "State", kind: "console" as const, source: `(def game
  (atom {:turn :x
         :moves []}))

(swap! game update :moves conj [1 1])
(deref game)` }
    ];
    const learnMount = document.querySelector<HTMLElement>("[data-live-learn]");
    if (learnMount) {
      mountLiveCard(learnMount, { snippets: learnSnippets, activeSnippet: "read" });
    }

    const canvasMount = document.querySelector<HTMLElement>("[data-live-canvas]");
    if (canvasMount) {
      mountLiveCard(canvasMount, {
        snippets: [{ id: "canvas-pong", title: "Pong", kind: "canvas", source: pongSource }],
        activeSnippet: "canvas-pong"
      });
    }

    const kernelTabs = [...document.querySelectorAll<HTMLButtonElement>("[data-kernel-tab]")];
    const kernelTablist = document.querySelector<HTMLElement>(".kernel-mode-tabs");
    const selectKernelMode = (mode: string, focus = false) => {
      for (const tab of kernelTabs) {
        const selected = tab.dataset.kernelTab === mode;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      }
      document.querySelectorAll<HTMLElement>("[data-kernel-mode]").forEach((panel) => {
        panel.hidden = panel.dataset.kernelMode !== mode;
      });
    };
    for (const tab of kernelTabs) {
      tab.addEventListener("click", () => selectKernelMode(tab.dataset.kernelTab ?? "java"));
    }
    kernelTablist?.addEventListener("keydown", (event) => {
      if (!["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
      event.preventDefault();
      const current = Math.max(0, kernelTabs.findIndex((tab) => tab === document.activeElement));
      const forward = event.key === "ArrowDown" || event.key === "ArrowRight";
      const nextIndex = event.key === "Home"
        ? 0
        : event.key === "End"
          ? kernelTabs.length - 1
          : (current + (forward ? 1 : -1) + kernelTabs.length) % kernelTabs.length;
      const next = kernelTabs[nextIndex];
      if (next) selectKernelMode(next.dataset.kernelTab ?? "java", true);
    });
  </script>
</SiteLayout>