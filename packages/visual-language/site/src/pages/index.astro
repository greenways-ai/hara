---
import ThemeToggle from "../../../src/astro/ThemeToggle.astro";
import HaraMark from "../../../src/astro/HaraMark.astro";
import Motif from "../../../src/astro/Motif.astro";
import "../../../src/theme.css";
import "../../../src/motifs.css";
import "../../../src/theme.js";
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Hara visual language: precision materials, themes, motifs, and components."/><link rel="icon" href={`${basePath}hara-logo.svg`} type="image/svg+xml"/><title>Hara Visual Language</title></head>
<body>
  <header><a href="./"><HaraMark size={28}/><b>Hara visual language</b></a><nav><a href="#motifs">Motifs</a><a href="#tokens">Tokens</a><a href="https://github.com/hara-lang/visual-language">Source</a></nav><ThemeToggle/></header>
  <main>
    <Motif kind="edge" class="hero"><div><p class="hara-kicker">Version 1.0</p><h1>Precision<br/>without noise.</h1><p>A shared material, color, motion, and component system for every Hara surface.</p></div></Motif>
    <section id="motifs"><p class="hara-kicker">Matched environments</p><h2>Three motifs. Two material worlds.</h2><div class="motif-grid"><Motif kind="edge"><b>Edge</b></Motif><Motif kind="aperture"><b>Aperture</b></Motif><Motif kind="rack"><b>Rack</b></Motif></div></section>
    <section id="tokens"><p class="hara-kicker">Stable interface</p><h2>Quiet color. Exact behavior.</h2><div class="token-grid"><article><i style="background:var(--hara-bg)"></i><b>Background</b><code>--hara-bg</code></article><article><i style="background:var(--hara-surface-solid)"></i><b>Surface</b><code>--hara-surface-solid</code></article><article><i style="background:var(--hara-signal)"></i><b>Signal</b><code>--hara-signal</code></article><article><i style="background:var(--hara-text)"></i><b>Text</b><code>--hara-text</code></article></div><pre><code>import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/motifs.css";
import &#123; setThemePreference &#125; from "@hara-lang/visual-language/theme.js";</code></pre></section>
  </main><footer>MIT licensed · Built for hara-lang.org</footer>
</body></html>
<style>
  header{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:64px;padding:0 var(--hara-space-page);border-bottom:1px solid var(--hara-line)}header>a{display:flex;align-items:center;gap:.7rem;width:max-content;text-decoration:none}nav{display:flex;gap:1.5rem}nav a{color:var(--hara-muted);font-size:.85rem;text-decoration:none}.hero{min-height:660px;display:flex;align-items:center;padding:var(--hara-space-page)}.hero>div{width:min(var(--hara-content),100%);margin:auto}.hero h1{margin:.2em 0;font-size:clamp(4rem,10vw,8.5rem);line-height:.82;letter-spacing:-.07em}.hero p:last-child{max-width:540px;color:var(--hara-muted);font-size:1.2rem;line-height:1.6}section{width:min(var(--hara-content),calc(100% - 2 * var(--hara-space-page)));margin:auto;padding:110px 0}h2{margin:.25em 0 1em;font-size:clamp(2.5rem,6vw,5rem);letter-spacing:-.055em}.motif-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.motif-grid>.hara-motif{aspect-ratio:1;display:flex;align-items:flex-end;padding:1.2rem;border:1px solid var(--hara-line);border-radius:var(--hara-radius-lg)}.motif-grid .hara-motif::after{background:linear-gradient(0deg,var(--hara-bg),transparent 55%)}.token-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;overflow:hidden;border:1px solid var(--hara-line);border-radius:var(--hara-radius-md);background:var(--hara-line)}article{display:grid;gap:.5rem;padding:1rem;background:var(--hara-surface-solid)}article i{height:80px;border:1px solid var(--hara-line);border-radius:8px}article code{color:var(--hara-muted);font-size:.75rem}pre{margin-top:2rem;padding:1.4rem;overflow:auto;border:1px solid var(--hara-line);border-radius:var(--hara-radius-md);background:var(--hara-surface-solid)}footer{padding:2rem var(--hara-space-page);border-top:1px solid var(--hara-line);color:var(--hara-muted)}@media(max-width:700px){header{grid-template-columns:1fr auto}nav{display:none}.motif-grid,.token-grid{grid-template-columns:1fr}.hero h1{font-size:4rem}}
</style>
