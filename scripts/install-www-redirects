#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${1:-$ROOT/target/www}"
REDIRECTS="$OUT/_redirects"

mkdir -p "$OUT"
touch "$REDIRECTS"

python3 - "$REDIRECTS" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
lines = path.read_text(encoding="utf-8").splitlines()
kept = [
    line
    for line in lines
    if "benchmarks.hara-lang.org" not in line
    and not line.lstrip().startswith("/benchmarks")
]
path.write_text("\n".join(kept).rstrip() + "\n", encoding="utf-8")
PY

if grep -Eq '(^[[:space:]]*/benchmarks|benchmarks\.hara-lang\.org)' "$REDIRECTS"; then
  echo "legacy benchmark proxy rules remain in $REDIRECTS" >&2
  exit 1
fi

echo "Removed legacy benchmark proxy rules from $REDIRECTS; /benchmarks/ is served locally by Astro"
