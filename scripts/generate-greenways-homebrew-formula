#!/usr/bin/env python3
"""Render the source-built Hara formula for the Greenways ecosystem tap."""

from __future__ import annotations

import argparse
import re
from pathlib import Path


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("tag", help="release tag, for example v0.1.0")
    parser.add_argument("revision", help="complete release commit SHA")
    parser.add_argument("output", type=Path)
    args = parser.parse_args()

    if not re.fullmatch(r"v[0-9][0-9A-Za-z.+-]*", args.tag):
        parser.error("tag must be a version beginning with v")
    if not re.fullmatch(r"[0-9a-f]{40}", args.revision):
        parser.error("revision must be a complete lowercase commit SHA")

    version = args.tag[1:]
    rendered = f'''class Hara < Formula
  desc "Symbolic programming language and portable AST kernel"
  homepage "https://www.hara-lang.org"
  url "https://github.com/hara-lang/hara.git",
      tag:      "{args.tag}",
      revision: "{args.revision}"
  license "EPL-2.0"
  head "https://github.com/hara-lang/hara.git", branch: "main"

  depends_on "rust" => :build

  def install
    system "cargo", "build", "--locked", "--release",
           "--manifest-path", "rust/Cargo.toml", "--bin", "hara"
    bin.install "rust/target/release/hara"
  end

  test do
    assert_equal "42", shell_output("#{{bin}}/hara eval '(+ 19 23)'").strip
  end
end
'''

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(rendered)


if __name__ == "__main__":
    main()
