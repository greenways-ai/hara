#!/usr/bin/env python3
"""Render the source-built Hara formula for the hara-lang Homebrew tap."""

from __future__ import annotations

import argparse
import hashlib
import re
import urllib.request
from pathlib import Path


def sha256_url(url: str) -> str:
    request = urllib.request.Request(url, headers={"User-Agent": "hara-release"})
    digest = hashlib.sha256()
    with urllib.request.urlopen(request, timeout=60) as response:
        while chunk := response.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("tag", help="release tag, for example v0.1.0")
    parser.add_argument("revision", help="complete release commit SHA")
    parser.add_argument("output", type=Path)
    args = parser.parse_args()

    if not re.fullmatch(r"v[0-9][0-9A-Za-z.+-]*", args.tag):
        parser.error("tag must be a version beginning with v")
    if not re.fullmatch(r"[0-9a-f]{40}", args.revision):
        parser.error("revision must be a complete lowercase commit SHA")

    version = args.tag[1:]
    archive_url = f"https://github.com/hara-lang/hara/archive/{args.revision}.tar.gz"
    archive_sha256 = sha256_url(archive_url)

    rendered = f'''class Hara < Formula
  desc "Symbolic programming language and portable AST kernel"
  homepage "https://www.hara-lang.org"
  url "{archive_url}"
  version "{version}"
  sha256 "{archive_sha256}"
  license "EPL-2.0"
  head "https://github.com/hara-lang/hara.git", branch: "main"

  depends_on "rust" => :build

  def install
    system "cargo", "install", *std_cargo_args(path: "rust")
  end

  test do
    assert_equal "42", shell_output("#{{bin}}/hara eval '(+ 19 23)'").strip
  end
end
'''

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(rendered, encoding="utf-8")


if __name__ == "__main__":
    main()
