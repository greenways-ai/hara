#!/usr/bin/env bash
# Build the hara wasm runtime for the website, mirroring the "Build Rust WASM
# package" step in .github/workflows/pages.yml. Output lands in
# website/docs/rust/pkg/ (gitignored) so local `mkdocs serve` exposes the same
# /rust/pkg/ paths the deployed site has.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT_DIR="$ROOT/website/docs/rust/pkg"

cargo build --manifest-path "$ROOT/rust/Cargo.toml" --target wasm32-unknown-unknown --release --lib

mkdir -p "$OUT_DIR"
wasm-bindgen --target web --out-dir "$OUT_DIR" \
  "$ROOT/rust/target/wasm32-unknown-unknown/release/hara_wasm.wasm"
echo "Built $OUT_DIR"
