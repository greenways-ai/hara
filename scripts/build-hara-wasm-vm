#!/usr/bin/env bash
# Size-optimized browser package with the persistent bytecode VM enabled.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT_DIR="$ROOT/website/docs/rust/vm-pkg"

"$ROOT/scripts/cargo-wasm-build" \
  --manifest-path "$ROOT/rust/Cargo.toml" \
  --target wasm32-unknown-unknown \
  --profile browser-release \
  --features bytecode-vm \
  --lib

mkdir -p "$OUT_DIR"
wasm-bindgen --target web --out-dir "$OUT_DIR" \
  "$ROOT/rust/target/wasm32-unknown-unknown/browser-release/hara_wasm.wasm"

wc -c "$OUT_DIR/hara_wasm_bg.wasm"
echo "Built $OUT_DIR"
