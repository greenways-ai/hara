#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

collect_files() {
    if [ "$#" -eq 0 ]; then
        find lib/test -name '*.hal' \
            ! -path 'lib/test/std/lib/test.hal' \
            -print | sort
        return
    fi

    local target
    for target in "$@"; do
        if [ -d "$target" ]; then
            find "$target" -name '*.hal' \
                ! -path 'lib/test/std/lib/test.hal'
        elif [ -f "$target" ]; then
            if [ "$target" != 'lib/test/std/lib/test.hal' ]; then
                printf '%s\n' "$target"
            fi
        else
            echo "Test target not found: $target" >&2
            return 2
        fi
    done | sort -u
}

mapfile -t TEST_FILES < <(collect_files "$@")

if [ "${#TEST_FILES[@]}" -eq 0 ]; then
    echo "No library test files selected" >&2
    exit 2
fi

exec cargo run --quiet \
    --manifest-path "$REPO_ROOT/rust/Cargo.toml" \
    --bin hara-test -- \
    --root "$REPO_ROOT" \
    "${TEST_FILES[@]}"
