#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

FRAMEWORK="lib/test/std/lib/test.hal"
FAILURES=0
PASSED=0
TOTAL=0

run_file() {
    local file="$1"
    local output
    local status=0
    output=$("$REPO_ROOT/hara" run "$file" 2>&1) || status=$?

    if [ "$status" -ne 0 ]; then
        echo "FAIL  $file (exit $status)"
        echo "$output" | tail -n 8 | sed 's/^/      /'
        return 1
    fi

    # code.test/fact suites return a one-line structured summary map, either
    # directly or wrapped by pr-str in a quoted string.
    local last_summary
    last_summary=$(echo "$output" | grep -E '^"?\{' | tail -n 1)
    if [ -n "$last_summary" ]; then
        if echo "$last_summary" | grep -q ':status :passed'; then
            local fact_count
            local check_count
            fact_count=$(echo "$last_summary" |
                sed -n 's/.*:facts \([0-9][0-9]*\).*/\1/p')
            check_count=$(echo "$last_summary" |
                sed -n 's/.*:checks \([0-9][0-9]*\).*/\1/p')
            fact_count=${fact_count:-0}
            check_count=${check_count:-0}
            echo "PASS  $file ($fact_count facts, $check_count checks)"
            return 0
        fi
        echo "FAIL  $file"
        echo "$last_summary" | sed 's/^/      /'
        return 1
    fi

    # Compatibility path for older std.lib.test result vectors.
    local last_vector
    last_vector=$(echo "$output" | grep -E '^"?\[' | tail -n 1)

    if [ -z "$last_vector" ]; then
        echo "FAIL  $file (no code.test summary or result vector found)"
        echo "$output" | tail -n 8 | sed 's/^/      /'
        return 1
    fi

    if echo "$last_vector" | grep -q ':pass false'; then
        echo "FAIL  $file"
        echo "$last_vector" | sed 's/^/      /'
        return 1
    fi

    if echo "$last_vector" | grep -q ':pass true'; then
        local count
        count=$(echo "$last_vector" | grep -o ':pass true' | wc -l)
        echo "PASS  $file ($count checks)"
        return 0
    fi

    echo "FAIL  $file (result vector has no :pass markers)"
    echo "$last_vector" | sed 's/^/      /'
    return 1
}

collect_files() {
    if [ "$#" -eq 0 ]; then
        find lib/test -name '*.hal' | sort
        return
    fi

    local target
    for target in "$@"; do
        if [ -d "$target" ]; then
            find "$target" -name '*.hal'
        elif [ -f "$target" ]; then
            printf '%s\n' "$target"
        else
            echo "Test target not found: $target" >&2
            return 2
        fi
    done | sort -u
}

mapfile -t TEST_FILES < <(collect_files "$@")

if [ "${#TEST_FILES[@]}" -eq 0 ]; then
    echo "No library test files selected" >&2
    exit 2
fi

for file in "${TEST_FILES[@]}"; do
    if [ "$file" = "$FRAMEWORK" ]; then
        continue
    fi
    TOTAL=$((TOTAL + 1))
    if run_file "$file"; then
        PASSED=$((PASSED + 1))
    else
        FAILURES=$((FAILURES + 1))
    fi
done

echo ""
echo "lib/test summary: $PASSED passed, $FAILURES failed, $TOTAL total"

if [ "$FAILURES" -ne 0 ]; then
    exit 1
fi
