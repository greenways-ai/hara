#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

mapfile -t TEST_FILES < <(
    find lib/test -name '*.hal' \
        ! -path 'lib/test/std/lib/test.hal' \
        -print | sort
)

if [ "${#TEST_FILES[@]}" -eq 0 ]; then
    echo "No .hal tests found under lib/test" >&2
    exit 2
fi

exec cargo run --quiet \
    --manifest-path "$REPO_ROOT/rust/Cargo.toml" \
    --bin hara-test -- \
    --root "$REPO_ROOT" \
    "${TEST_FILES[@]}"
