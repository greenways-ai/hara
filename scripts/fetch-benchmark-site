#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${HARA_BENCHMARK_OUT_DIR:-$ROOT/target/benchmarks}"
ARCHIVE_URL="${HARA_BENCHMARK_SITE_ARCHIVE:-https://codeload.github.com/hara-lang/hara-benchmarks/tar.gz/refs/heads/benchmark-site}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

archive="$TMP/benchmark-site.tar.gz"
for attempt in 1 2 3 4 5; do
  if curl --fail --location --retry 3 --retry-all-errors --connect-timeout 15 \
      --output "$archive" "$ARCHIVE_URL"; then
    break
  fi
  if [ "$attempt" -eq 5 ]; then
    echo "unable to download the verified benchmark site" >&2
    exit 1
  fi
  sleep $((attempt * 3))
done

tar -xzf "$archive" -C "$TMP"
site_root="$(find "$TMP" -mindepth 1 -maxdepth 1 -type d -name 'hara-benchmarks-*' | head -n 1)"
if [ -z "$site_root" ]; then
  echo "benchmark site archive has no extracted root" >&2
  exit 1
fi

for required in index.html app.js styles.css classes.css data/runs.json data/catalog.json .source-revision; do
  if [ ! -f "$site_root/$required" ]; then
    echo "benchmark site archive is missing $required" >&2
    exit 1
  fi
done

python3 - "$site_root/data/runs.json" <<'PY'
import json
import re
import sys
from pathlib import Path

required = {
    "hara-rust-whole-wasm-prepared",
    "luajit-prepared",
    "pypy-prepared",
    "node-prepared",
    "ruby-yjit-prepared",
    "clojure-prepared",
    "sbcl-prepared",
    "chez-prepared",
    "guile-prepared",
    "bb-prepared",
    "python-prepared",
    "c-prepared",
    "java-prepared",
}
payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
runs = payload.get("runs") or []
if not runs:
    raise SystemExit("benchmark dashboard contains no runs")
run = max(runs, key=lambda item: str(item.get("environment", {}).get("timestamp", "")))
revision = str(run.get("environment", {}).get("benchmark_revision") or "")
if not re.fullmatch(r"[0-9a-f]{40}", revision):
    raise SystemExit("benchmark dashboard lacks an immutable revision")
usable = {}
for row in run.get("measurements", []):
    if row.get("status") == "ok" and row.get("steady_state", {}).get("samples_ns"):
        usable.setdefault(row.get("runtime"), set()).add(row.get("workload"))
missing = sorted(runtime for runtime in required if len(usable.get(runtime, set())) < 6)
if missing:
    raise SystemExit("benchmark dashboard lacks verified coverage for: " + ", ".join(missing))
hara = usable["hara-rust-whole-wasm-prepared"]
insufficient = sorted(
    runtime for runtime in required - {"hara-rust-whole-wasm-prepared"}
    if len(hara & usable[runtime]) < 6
)
if insufficient:
    raise SystemExit("benchmark dashboard lacks shared Hara comparisons for: " + ", ".join(insufficient))
print(f"verified {len(required)} runtime lanes from benchmark revision {revision}")
PY

rm -rf "$OUT"
mkdir -p "$OUT"
cp -R "$site_root/." "$OUT/"
printf 'Fetched verified benchmark site into %s\n' "$OUT"
