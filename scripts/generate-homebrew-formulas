#!/usr/bin/env python3
"""Generate Hara Homebrew formulas from a release checksum manifest."""

from __future__ import annotations

import argparse
from pathlib import Path

TARGETS = {
    "mac_arm": "aarch64-apple-darwin",
    "mac_intel": "x86_64-apple-darwin",
    "linux_intel": "x86_64-unknown-linux-gnu",
}


def checksums(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in path.read_text().splitlines():
        fields = line.split()
        if len(fields) >= 2:
            values[Path(fields[-1].lstrip("*")).name] = fields[0]
    return values


def formula(kind: str, version: str, tag: str, values: dict[str, str]) -> str:
    if kind == "rust":
        class_name = "Hara"
        description = "Programmable runtime-neutral kernel and HAL CLI"
        prefix = "hara-rust"
        executable = "hara"
    else:
        class_name = "HaraTruffle"
        description = "Hara CLI built as a Truffle native image"
        prefix = "hara-truffle"
        executable = "hara-truffle"

    assets = {
        name: f"{prefix}-{tag}-{target}.tar.gz" for name, target in TARGETS.items()
    }
    missing = [asset for asset in assets.values() if asset not in values]
    if missing:
        raise SystemExit("missing checksums: " + ", ".join(missing))

    base = f"https://github.com/hara-lang/hara/releases/download/{tag}"
    return f'''class {class_name} < Formula
  desc "{description}"
  homepage "https://www.hara-lang.org"
  version "{version}"
  license "EPL-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "{base}/{assets['mac_arm']}"
      sha256 "{values[assets['mac_arm']]}"
    else
      url "{base}/{assets['mac_intel']}"
      sha256 "{values[assets['mac_intel']]}"
    end
  end

  on_linux do
    depends_on arch: :x86_64
    url "{base}/{assets['linux_intel']}"
    sha256 "{values[assets['linux_intel']]}"
  end

  def install
    bin.install "{executable}"
  end

  test do
    assert_equal "42", shell_output("#{{bin}}/{executable} eval '(+ 19 23)'").strip
  end
end
'''


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("tag", help="release tag, for example v0.1.1")
    parser.add_argument("checksums", type=Path)
    parser.add_argument("output", type=Path)
    args = parser.parse_args()
    if not args.tag.startswith("v") or len(args.tag) == 1:
        parser.error("tag must start with v")
    version = args.tag[1:]
    values = checksums(args.checksums)
    args.output.mkdir(parents=True, exist_ok=True)
    (args.output / "hara.rb").write_text(formula("rust", version, args.tag, values))
    (args.output / "hara-truffle.rb").write_text(
        formula("truffle", version, args.tag, values)
    )


if __name__ == "__main__":
    main()
