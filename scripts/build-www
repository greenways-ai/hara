#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$ROOT/target/www"
RAW_WASM="$ROOT/rust/raw/target/wasm32-unknown-unknown/release/hara_wasm_raw.wasm"
HIR_OUT="$ROOT/target/www-hir"
HARA_COMPILER="$ROOT/rust/target/debug/hara"

bash "$ROOT/scripts/build-hara-wasm-raw"
cargo build --manifest-path "$ROOT/rust/Cargo.toml" --features hir-encoder --bin hara
rm -rf "$HIR_OUT"
mkdir -p "$HIR_OUT"
"$HARA_COMPILER" compile-hir "$ROOT/lib/src/std/lib/substrate/protocol.hal" --output "$HIR_OUT/substrate-protocol.hir"
"$HARA_COMPILER" compile-hir "$ROOT/lib/src/std/lib/substrate/frame.hal" --output "$HIR_OUT/substrate-frame.hir"
"$HARA_COMPILER" compile-hir "$ROOT/lib/src/std/lib/substrate.hal" --output "$HIR_OUT/substrate.hir"
"$HARA_COMPILER" compile-hir "$ROOT/rust/web/studio/hal/store.hal" --output "$HIR_OUT/studio-store.hir"
"$HARA_COMPILER" compile-hir "$ROOT/rust/web/studio/hal/boot.hal" --output "$HIR_OUT/studio-boot.hir"
"$HARA_COMPILER" compile-hir "$ROOT/rust/web/studio/hal/node.hal" --output "$HIR_OUT/studio-node.hir"
"$HARA_COMPILER" compile-hir "$ROOT/rust/web/studio/hal/draw.hal" --output "$HIR_OUT/studio-draw.hir"
"$HARA_COMPILER" compile-hir "$ROOT/rust/web/studio/hal/program.hal" --output "$HIR_OUT/studio-program.hir"
"$HARA_COMPILER" compile-hir "$ROOT/rust/web/studio/hal/graph.hal" --output "$HIR_OUT/studio-graph.hir"
"$HARA_COMPILER" compile-hir "$ROOT/rust/web/studio/hal/session.hal" --output "$HIR_OUT/studio-session.hir"
"$HARA_COMPILER" compile-hir "$ROOT/rust/web/studio/hal/supersonic.hal" --output "$HIR_OUT/supersonic.hir"

rm -rf "$OUT"
mkdir -p "$OUT/runtime/host" "$OUT/runtime/studio/hal" "$OUT/runtime/std/lib/substrate"
mkdir -p "$OUT/runtime/studio/capabilities"
mkdir -p "$OUT/assets/wasm" "$OUT/assets/hara-amp" "$OUT/examples/hara-amp/src"
mkdir -p "$OUT/sources"
mkdir -p "$OUT/vendor"

cp "$ROOT/website/index.html" \
   "$ROOT/website/app.css" \
   "$ROOT/website/app.js" \
   "$ROOT/website/story.css" \
   "$ROOT/website/story.js" \
   "$ROOT/website/workspaces.js" \
   "$ROOT/website/publishing.js" \
   "$ROOT/website/github-auth.js" \
   "$ROOT/website/ai-adapters.js" \
   "$ROOT/website/creative.js" \
   "$ROOT/website/editor.js" \
   "$ROOT/website/hara-amp.html" \
   "$ROOT/website/hara-amp.css" \
   "$ROOT/website/hara-amp.js" \
   "$ROOT/website/amp-runtime.js" \
   "$ROOT/website/amp-node-graph.js" \
   "$ROOT/website/amp-source-model.js" \
   "$ROOT/website/amp-workspace.js" \
   "$ROOT/website/og.png" \
   "$ROOT/website/scene.js" \
   "$OUT/"
node -e 'process.stdout.write(`globalThis.HARA_GITHUB_OAUTH_CLIENT_ID = ${JSON.stringify(process.env.HARA_GITHUB_OAUTH_CLIENT_ID || "Iv23lixQbnKYwkRBihCQ")};\n`)' \
  > "$OUT/github-auth-config.js"
cp "$ROOT/scripts/install.sh" "$OUT/install.sh"
chmod 755 "$OUT/install.sh"
cp "$RAW_WASM" "$OUT/runtime/hara.wasm"
cp "$ROOT/rust/web/hta.js" \
   "$ROOT/rust/web/hta-worker.js" \
   "$ROOT/rust/web/hta-shared-worker.js" \
   "$ROOT/rust/web/package-cache.js" \
   "$OUT/runtime/"
node "$ROOT/scripts/build-www-harp.mjs" "$OUT/runtime/kernel.harp" \
  "std.lib.substrate.protocol=$HIR_OUT/substrate-protocol.hir" \
  "std.lib.substrate.frame=$HIR_OUT/substrate-frame.hir" \
  "std.lib.substrate=$HIR_OUT/substrate.hir" \
  "studio.store=$HIR_OUT/studio-store.hir" \
  "studio.boot=$HIR_OUT/studio-boot.hir" \
  "studio.node=$HIR_OUT/studio-node.hir" \
  "studio.draw=$HIR_OUT/studio-draw.hir" \
  "studio.program=$HIR_OUT/studio-program.hir" \
  "studio.graph=$HIR_OUT/studio-graph.hir" \
  "studio.session=$HIR_OUT/studio-session.hir" \
  "gw.audio.supersonic=$HIR_OUT/supersonic.hir"
cp "$ROOT/rust/web/host/"*.js "$OUT/runtime/host/"
cp "$ROOT/rust/web/studio/boot.js" \
   "$ROOT/rust/web/studio/broker.js" \
   "$ROOT/rust/web/studio/document-runtime.js" \
   "$ROOT/rust/web/studio/editor-state.js" \
   "$ROOT/rust/web/studio/host-services.js" \
   "$ROOT/rust/web/studio/canvas-runtime.js" \
   "$ROOT/rust/web/studio/capability-registry.js" \
   "$ROOT/rust/web/studio/graph-host.js" \
   "$ROOT/rust/web/studio/module-codec.js" \
   "$ROOT/rust/web/studio/node-runtime.js" \
   "$ROOT/rust/web/studio/program-host.js" \
   "$ROOT/rust/web/studio/program-worker.js" \
   "$ROOT/rust/web/studio/session-router.js" \
   "$ROOT/rust/web/studio/supersonic.js" \
   "$ROOT/rust/web/studio/workspace.js" \
   "$OUT/runtime/studio/"
cp "$ROOT/rust/web/studio/hal/"*.hal "$OUT/runtime/studio/hal/"
cp "$ROOT/rust/web/studio/capabilities/"*.js "$OUT/runtime/studio/capabilities/"
cp "$ROOT/lib/src/std/lib/substrate.hal" "$OUT/runtime/std/lib/substrate.hal"
cp "$ROOT/lib/src/std/lib/substrate/protocol.hal" \
   "$ROOT/lib/src/std/lib/substrate/frame.hal" \
   "$OUT/runtime/std/lib/substrate/"
cp "$ROOT/website/assets/hara-amp/"* "$OUT/assets/hara-amp/"
cp "$ROOT/website/assets/favicon-48.svg" \
   "$ROOT/website/assets/favicon-128.svg" \
   "$ROOT/website/assets/favicon-256.svg" \
   "$ROOT/website/assets/logo.svg" \
   "$ROOT/website/assets/hara-mark.svg" \
   "$ROOT/website/assets/hara-favicon.svg" \
   "$ROOT/website/assets/logo-white.svg" \
   "$OUT/assets/"
cp "$ROOT/website/og-hara-ribbon.png" \
   "$ROOT/website/og-hara-ribbon.jpg" \
   "$OUT/"
cp "$ROOT/website/examples/hara-amp/project.edn" \
   "$ROOT/website/examples/hara-amp/workspace.edn" \
   "$OUT/examples/hara-amp/"
cp "$ROOT/website/examples/hara-amp/src/amp.hal" "$OUT/examples/hara-amp/src/"
mkdir -p "$OUT/examples/studio-backgrounds"
cp "$ROOT/website/examples/studio-backgrounds/project.edn" \
   "$ROOT/website/examples/studio-backgrounds/workspace.edn" \
   "$OUT/examples/studio-backgrounds/"
cp "$ROOT/website/sources/"*.hal "$OUT/sources/"
cp -R "$ROOT/website/vendor/hara-ui" "$OUT/vendor/"

bash "$ROOT/scripts/build-demo-synth-wasm"
bash "$ROOT/scripts/build-demo-fft-wasm"
cp "$ROOT/website/assets/wasm/"*.wasm "$OUT/assets/wasm/"

printf 'Built %s\n' "$OUT"
