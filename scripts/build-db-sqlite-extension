#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WEB="$REPO_ROOT/rust/web"
EXTENSION="$REPO_ROOT/rust/extensions/std-db-sqlite"

if [ ! -x "$WEB/node_modules/.bin/vite" ]; then
  (cd "$WEB" && npm ci)
fi

(
  cd "$EXTENSION"
  npm install --ignore-scripts --no-audit --no-fund
)

(
  cd "$WEB"
  ./node_modules/.bin/vite build --config vite.sqlite-node.config.js
  ./node_modules/.bin/vite build --config vite.sqlite-browser.config.js
  node --test sqlite-provider.test.mjs
  node package-sqlite-extension.mjs
)
